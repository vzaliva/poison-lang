#!/usr/bin/env bash
set -euo pipefail

# Wrapper script for running AI coding agents (Claude, Codex, etc.) in an isolated
# Podman container with access to the Poison Language project and Lean toolchain.
#
# Uses dedicated volumes (ai_agent_*) that are independent from the poison-dev environment.
#
# Usage: ai-agent-jailed <agent> [workspace-dir] [--replace] [--] [agent-args...]
#        claude-jailed [workspace-dir] [--replace] [--] [claude-args...]    (via symlink)
#        codex-jailed [workspace-dir] [--replace] [--] [codex-args...]      (via symlink)
#
# Use "--" so everything after it is passed verbatim to claude/codex (wrapper does not
# add default flags like --continue or "resume --last" after those args). Example:
#   claude-jailed -- -r 52ea7f53-2b6a-4732-9eb7-f7292bd85d36
#   codex-jailed -- resume 019d0c58-596c-7d11-9d9f-75370b031212
#
# Agents:
#   claude   - Anthropic Claude Code
#   codex    - OpenAI Codex
#   bash     - Shell inside the container
#
# Examples:
#   ai-agent-jailed claude
#   ai-agent-jailed claude ~/src/poison-lang-worktree
#   ai-agent-jailed claude --help
#   ai-agent-jailed claude ~/src/poison-lang-worktree --help
#   ai-agent-jailed codex
#   ai-agent-jailed bash
#   claude-jailed           # If symlinked
#   claude-jailed ~/src/poison-lang-worktree
#   codex-jailed --help     # If symlinked
#   codex-jailed --replace  # Replace existing container with same name (Podman)
#   claude-jailed -- -r <session-uuid>   # Resume Claude session (pass-through after --)
#   codex-jailed -- resume <session-id>  # Resume Codex session
#
# Environment variables:
#   POISON_PROJECT_DIR       - Override default project directory (default: ~/src/poison-lang or git root)
#   AI_AGENT_IMAGE           - Override container image (default: localhost/poison-ai-agent:latest)
#   AI_AGENT_CONTAINER_NAME  - Override container name (default: poison-ai-agent-<agent>-<workspace-tag>).
#                              Workspace-tagged names allow running the same agent in multiple workspaces.
#   AI_AGENT_HOST_ELAN       - If set to "off", use a dedicated Elan volume instead of the host.
#                              By default, host ~/.elan is bind-mounted read-only at /home/user/.elan
#                              (reuses your existing toolchains without exposing other host state).

# Detect agent from script name (for symlinks like claude-jailed, codex-jailed)
SCRIPT_NAME="$(basename "$0")"
AGENT=""

case "$SCRIPT_NAME" in
  claude-jailed)
    AGENT="claude"
    ;;
  codex-jailed)
    AGENT="codex"
    ;;
  *)
    # Not a recognized symlink name, expect agent as first argument
    if [ $# -eq 0 ]; then
      echo "Usage: ai-agent-jailed <agent> [workspace-dir] [--replace] [--] [agent-args...]" >&2
      echo "" >&2
      echo "Available agents:" >&2
      echo "  claude   - Anthropic Claude Code" >&2
      echo "  codex    - OpenAI Codex" >&2
      echo "  bash     - Shell inside the container" >&2
      echo "" >&2
      echo "Or create symlinks:" >&2
      echo "  ln -sf ai-agent-jailed claude-jailed" >&2
      echo "  ln -sf ai-agent-jailed codex-jailed" >&2
      exit 1
    fi
    AGENT="$1"
    shift
    ;;
esac

# Optional first arg: workspace/project checkout directory to mount at /work.
# This is accepted when it points to an existing directory.
WORKSPACE_DIR=""
if [ $# -gt 0 ] && [ -d "$1" ]; then
  WORKSPACE_DIR="$(cd "$1" && pwd -P)"
  shift
fi

# Parse --replace: instruct Podman to replace an existing container with the same name.
# Split on "--": after "--", arguments are passed verbatim to claude/codex (no wrapper defaults
# like --continue or "resume --last" appended after the fixed prefix).
PODMAN_REPLACE=""
REMAINING_ARGS=()
for a in "$@"; do
  if [ "$a" = "--replace" ]; then
    PODMAN_REPLACE="--replace"
  else
    REMAINING_ARGS+=("$a")
  fi
done

USE_AGENT_PASSTHROUGH=0
PASS_ARGS=()
BEFORE_DD=()
DD_IDX=-1
for i in "${!REMAINING_ARGS[@]}"; do
  if [ "${REMAINING_ARGS[$i]}" = "--" ]; then
    DD_IDX="$i"
    break
  fi
done

if [ "$DD_IDX" -ge 0 ]; then
  USE_AGENT_PASSTHROUGH=1
  for i in "${!REMAINING_ARGS[@]}"; do
    if [ "$i" -lt "$DD_IDX" ]; then
      BEFORE_DD+=("${REMAINING_ARGS[$i]}")
    elif [ "$i" -gt "$DD_IDX" ]; then
      PASS_ARGS+=("${REMAINING_ARGS[$i]}")
    fi
  done
  if [ "${#BEFORE_DD[@]}" -gt 0 ]; then
    echo "Error: Unknown arguments before '--' (only workspace dir and --replace are allowed there): ${BEFORE_DD[*]}" >&2
    echo "Hint: pass claude/codex options after '--', e.g. codex-jailed -- resume <session-id>" >&2
    exit 1
  fi
else
  PASS_ARGS=("${REMAINING_ARGS[@]}")
fi

# Map agent name to actual command and fixed prefix arguments (arrays for safe quoting).
case "$AGENT" in
  claude)
    CMD="claude"
    # Persist Claude Code auth/config inside the ai_agent_config volume.
    # By default Claude stores state under ~/.claude* (not persisted in this container).
    CLAUDE_CONFIG_DIR="/home/user/.config/poison-claude"
    # Add --dangerously-skip-permissions for smoother operation
    # Also load a persisted MCP config that preconfigures lean-lsp.
    # Claude ignores CLAUDE_CONFIG_DIR for plugins (hardcodes ~/.claude); load lean4 explicitly.
    AGENT_PREFIX_ARGS=(
      --dangerously-skip-permissions
      --mcp-config "${CLAUDE_CONFIG_DIR}/mcp.json"
      --plugin-dir /opt/lean4-skills-seed/plugins/lean4
    )
    ;;
  codex)
    CMD="codex"
    # Use a container-specific CODEX_HOME to avoid touching host ~/.codex.
    # This path is inside the ai_agent_config volume, so auth/config persist.
    CODEX_HOME="/home/user/.config/poison-codex"
    # MCP server env (lean-lsp-mcp defaults to INFO logging, which can break STDIO MCP handshakes
    # if logs end up on stdout). Also pin the Lean project root explicitly.
    LEAN_PROJECT_PATH="/work"
    LEAN_LOG_LEVEL="NONE"
    AGENT_PREFIX_ARGS=( -c cli_auth_credentials_store=file --yolo )
    ;;
  bash|sh)
    CMD="$AGENT"
    AGENT_PREFIX_ARGS=()
    ;;
  *)
    echo "Error: Unknown agent '$AGENT'" >&2
    echo "Available agents: claude, codex, bash" >&2
    exit 1
    ;;
esac

# Build final argv for the agent inside the container.
FINAL_AGENT_ARGS=()
case "$AGENT" in
  claude)
    FINAL_AGENT_ARGS=( "${AGENT_PREFIX_ARGS[@]}" )
    if [ "$USE_AGENT_PASSTHROUGH" -eq 1 ]; then
      FINAL_AGENT_ARGS+=( "${PASS_ARGS[@]}" )
    else
      FINAL_AGENT_ARGS+=( --continue "${PASS_ARGS[@]}" )
    fi
    ;;
  codex)
    FINAL_AGENT_ARGS=( "${AGENT_PREFIX_ARGS[@]}" )
    if [ "$USE_AGENT_PASSTHROUGH" -eq 1 ]; then
      FINAL_AGENT_ARGS+=( "${PASS_ARGS[@]}" )
    else
      FINAL_AGENT_ARGS+=( resume --last "${PASS_ARGS[@]}" )
    fi
    ;;
  bash|sh)
    FINAL_AGENT_ARGS=( "${PASS_ARGS[@]}" )
    ;;
esac

# Determine project root
# Priority:
# 1) workspace-dir positional arg
# 2) POISON_PROJECT_DIR (explicit)
# 3) git root of current working directory (if inside a git repo)
# 4) default ~/src/poison-lang (if it exists)
# 5) git root containing this script (for installed copies/symlinks)
PROJ_DIR="$WORKSPACE_DIR"

if [ -z "$PROJ_DIR" ]; then
  PROJ_DIR="${POISON_PROJECT_DIR:-}"
fi

if [ -z "$PROJ_DIR" ] && command -v git >/dev/null 2>&1; then
  PROJ_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [ -z "$PROJ_DIR" ] && [ -d "$HOME/src/poison-lang" ]; then
  PROJ_DIR="$HOME/src/poison-lang"
fi

if [ -z "$PROJ_DIR" ] && command -v git >/dev/null 2>&1; then
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
  PROJ_DIR="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
fi

if [ -z "$PROJ_DIR" ] || [ ! -d "$PROJ_DIR" ]; then
  echo "Error: Could not determine project directory to mount at /work." >&2
  echo "Set POISON_PROJECT_DIR=/absolute/path/to/poison-lang and retry." >&2
  exit 1
fi

IMAGE="${AI_AGENT_IMAGE:-localhost/poison-ai-agent:latest}"

# Include workspace identity in default container name so the same agent can run
# in parallel across different checkouts/worktrees.
PROJ_BASENAME="$(basename "$PROJ_DIR")"
if command -v sha1sum >/dev/null 2>&1; then
  PROJ_HASH="$(printf '%s' "$PROJ_DIR" | sha1sum | awk '{print substr($1,1,8)}')"
elif command -v shasum >/dev/null 2>&1; then
  PROJ_HASH="$(printf '%s' "$PROJ_DIR" | shasum -a 1 | awk '{print substr($1,1,8)}')"
else
  PROJ_HASH="$(printf '%s' "$PROJ_DIR" | cksum | awk '{print $1}')"
fi
PROJ_TAG="$(printf '%s-%s' "$PROJ_BASENAME" "$PROJ_HASH" | tr -cs 'a-zA-Z0-9_.-' '-')"
CONTAINER_NAME="${AI_AGENT_CONTAINER_NAME:-poison-ai-agent-${AGENT}-${PROJ_TAG}}"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
HOST_USER="$(id -un)"
HOST_GROUP="$(id -gn)"

# Use host timezone in the container (for logs, dates, etc.)
HOST_TZ=""
if [ -n "${TZ:-}" ]; then
  HOST_TZ="$TZ"
fi
if [ -z "$HOST_TZ" ] && command -v timedatectl >/dev/null 2>&1; then
  HOST_TZ="$(timedatectl show -p Timezone --value 2>/dev/null)"
fi
if [ -z "$HOST_TZ" ] && [ -f /etc/timezone ]; then
  HOST_TZ="$(cat /etc/timezone 2>/dev/null | tr -d '\n\r')"
fi
# Linux: /etc/localtime is often a symlink into /usr/share/zoneinfo
if [ -z "$HOST_TZ" ] && [ -L /etc/localtime ]; then
  TZFILE="$(readlink -f /etc/localtime 2>/dev/null)"
  if [ -n "$TZFILE" ] && [ "${TZFILE#/usr/share/zoneinfo/}" != "$TZFILE" ]; then
    HOST_TZ="${TZFILE#/usr/share/zoneinfo/}"
  fi
fi

# Rootless Podman userns mapping: keep container UID/GID aligned with the invoking user.
# This avoids "Permission denied" on /work and ensures tools (e.g. Claude Code) run unprivileged.
PODMAN_USERNS_ARGS=()
if [ "$HOST_UID" -ne 0 ]; then
  PODMAN_USERNS_ARGS+=(--userns=keep-id)
  # Ensure the process does not run as container-root (Claude rejects root when using
  # --dangerously-skip-permissions), while still keeping /work readable via keep-id.
  PODMAN_USERNS_ARGS+=(--user "${HOST_UID}:${HOST_GID}")
fi

# Build podman run command with SSH agent forwarding if available
PODMAN_ARGS=( run --rm -it )
if [ -n "$PODMAN_REPLACE" ]; then
  PODMAN_ARGS+=(--replace)
fi
PODMAN_ARGS+=(
  --name "$CONTAINER_NAME"
  --network host
  "${PODMAN_USERNS_ARGS[@]}"
  -e HOST_UID="$HOST_UID"
  -e HOST_GID="$HOST_GID"
  -e HOST_USER="$HOST_USER"
  -e HOST_GROUP="$HOST_GROUP"
  # Force a stable HOME so tools use persisted state under /home/user.
  # (Without this, Podman may set HOME based on the numeric uid's passwd entry,
  # leading to ~/.ssh, ~/.config, etc. being written somewhere else.)
  -e HOME=/home/user
  -e USER=user
  -e LOGNAME=user
  -e ELAN_HOME=/home/user/.elan
  -e XDG_CACHE_HOME=/home/user/.cache
  -e UV_CACHE_DIR=/home/user/.cache/uv
)
# Pass host timezone into the container when available
if [ -n "${HOST_TZ:-}" ]; then
  PODMAN_ARGS+=(-e TZ="$HOST_TZ")
fi
PODMAN_ARGS+=(
  -v "$PROJ_DIR:/work:Z"
  -v ai_agent_ssh:/home/user/.ssh:rw,U
  -v ai_agent_cache_elan:/home/user/.cache/elan:rw,U
  -v ai_agent_cache_lake:/home/user/.cache/lake:rw,U
  -v ai_agent_cache_uv:/home/user/.cache/uv:rw,U
  -v ai_agent_config:/home/user/.config:rw,U
  -v ai_agent_skills:/home/user/.agents:rw,U
)

# Elan home: by default, bind-mount host ~/.elan read-only.
# Set AI_AGENT_HOST_ELAN=off to use a dedicated volume (ai_agent_elan_home) instead.
case "${AI_AGENT_HOST_ELAN:-}" in
  ""|0|ro)
    if [ -d "$HOME/.elan" ]; then
      PODMAN_ARGS+=(-v "$HOME/.elan:/home/user/.elan:ro,Z")
    else
      # If the host has no ~/.elan yet, fall back to an isolated volume.
      PODMAN_ARGS+=(-v ai_agent_elan_home:/home/user/.elan:rw,U)
    fi
    ;;
  off)
    PODMAN_ARGS+=(-v ai_agent_elan_home:/home/user/.elan:rw,U)
    ;;
  *)
    echo "Error: AI_AGENT_HOST_ELAN must be: off (or unset for default ro)" >&2
    exit 1
    ;;
esac

# Optional per-agent env vars
if [ -n "${CODEX_HOME:-}" ]; then
  PODMAN_ARGS+=(-e CODEX_HOME="$CODEX_HOME")
fi
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  PODMAN_ARGS+=(-e CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR")
fi
if [ -n "${LEAN_PROJECT_PATH:-}" ]; then
  PODMAN_ARGS+=(-e LEAN_PROJECT_PATH="$LEAN_PROJECT_PATH")
fi
if [ -n "${LEAN_LOG_LEVEL:-}" ]; then
  PODMAN_ARGS+=(-e LEAN_LOG_LEVEL="$LEAN_LOG_LEVEL")
fi
# lean4-skills: scripts and refs (Codex skill needs these; Claude gets them from plugin bootstrap)
PODMAN_ARGS+=(
  -e LEAN4_PLUGIN_ROOT=/opt/lean4-skills-seed/plugins/lean4
  -e LEAN4_SCRIPTS=/opt/lean4-skills-seed/plugins/lean4/lib/scripts
  -e LEAN4_REFS=/opt/lean4-skills-seed/plugins/lean4/skills/lean4/references
)

# Forward SSH agent for git authentication
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
  PODMAN_ARGS+=(
    -v "$SSH_AUTH_SOCK:/ssh-agent:ro"
    -e SSH_AUTH_SOCK=/ssh-agent
  )
fi

PODMAN_ARGS+=(
  -w /work
  "$IMAGE"
  "$CMD"
)

PODMAN_ARGS+=( "${FINAL_AGENT_ARGS[@]}" )

exec podman "${PODMAN_ARGS[@]}"
