#!/usr/bin/env bash
set -euo pipefail

# Build the AI agent container image. Used by both claude-jailed and codex-jailed
# (one image, per-agent container names at run time).
# Run this when there are new versions of Codex, Claude Code, or lean4-skills
# so the image gets fresh copies. Run from the repo root (where Containerfile.ai-agent lives).
#
# To update only a specific component without full cache bust:
#   podman build --build-arg LEAN4_SKILLS_UPDATE=$(date +%s) -t ... -f Containerfile.ai-agent .

if [ ! -f Containerfile.ai-agent ]; then
  echo "Error: Containerfile.ai-agent not found in $(pwd)" >&2
  exit 1
fi

# Stage proof-* skills from the local Claude Code installation (following symlinks).
# These are copied into the image so agents have them without depending on ai-skills repo.
PROOF_SKILLS=( proof-step proof-step-review proof-planning )
SKILL_SRC="${HOME}/.claude/skills"
STAGE_DIR=".build-cache/proof-skills"

rm -rf "${STAGE_DIR}"
mkdir -p "${STAGE_DIR}"
for skill in "${PROOF_SKILLS[@]}"; do
  if [ -d "${SKILL_SRC}/${skill}" ]; then
    cp -rL "${SKILL_SRC}/${skill}" "${STAGE_DIR}/${skill}"
  else
    echo "Warning: skill ${skill} not found at ${SKILL_SRC}/${skill}, skipping" >&2
  fi
done

CACHE_BUST="$(date +%s)"
exec podman build \
  --build-arg CODEX_UPDATE="$CACHE_BUST" \
  --build-arg CLAUDE_UPDATE="$CACHE_BUST" \
  --build-arg LEAN4_SKILLS_UPDATE="$CACHE_BUST" \
  --build-arg PROOF_SKILLS_UPDATE="$CACHE_BUST" \
  -t localhost/poison-ai-agent:latest \
  -f Containerfile.ai-agent \
  .
