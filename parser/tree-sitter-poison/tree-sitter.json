{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "poison",
      "camelcase": "Poison",
      "title": "Poison",
      "scope": "source.poison",
      "file-types": [
        "poison"
      ],
      "injection-regex": "^poison$",
      "class-name": "TreeSitterPoison"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Poison grammar for tree-sitter",
    "authors": [
      {
        "name": "Jay Choudhary"
      }
    ],
    "links": {
      "repository": "https://github.com/vzaliva/poison-lang"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}