                          cases htc''
                      | false =>
                          simp [typecheckVar, hlookup_ctx, hpred', hqt, htag', hft, pure, Except.pure] at htc''
                          cases htc''
                          simp [hpred']
                have hnclos : closureCapturedVarsRegime predSat ctxᵢ.regime res.qualType μ v :=
