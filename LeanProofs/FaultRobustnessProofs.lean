                              hnclos
            | some tv =>
                cases tv with
                | mk b deps =>
                    have htag' : ctxᵢ.tagEnv[k]? = some (TagVal.mk b deps) := by
                      simpa [Std.ExtTreeMap.get?_eq_getElem?] using htag
                    cases b with
                    | true =>
                        have hres :
                            res.qualType = ⟨qt.etyp, ctxᵢ.pc, Predicate.noPred⟩ := by
