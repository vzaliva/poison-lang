      | nil =>
          simp [List.foldlM_nil, pure, Except.pure] at hfold
          subst acc'
          have hqeq : qt_acc = qt := by
            have hqeq_opt : some qt_acc = some qt := by
              calc
                some qt_acc = acc.2.1.lookup l := hlookup_acc.symm
                _ = some qt := hlookup_out
