                              hnclos
                        | true =>
                            have hholds_qt : qtypPredHolds predSat qt μ v := (hconsist.1 rfl)
                            have hholds_res : qtypPredHolds predSat res.qualType μ v :=
                              qtypPredHolds_transport_pred (predSat := predSat) (qt := qt) (qt' := res.qualType)
