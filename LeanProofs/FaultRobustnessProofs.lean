  StepFR .ioFree ctxᵢ (Expr.unaryop op e) res predSat tm := by
  have htc' : typecheckUnaryOp .ioFree ctxᵢ op e (Nat.succ fuel') = .ok res := by
    simp [typecheck, typecheckExpr_unaryop_succ] at htc
    exact htc
