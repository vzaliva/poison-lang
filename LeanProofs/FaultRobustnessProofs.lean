                      | true =>
                          -- Function types throw error, contradicts htc''
                          simp [typecheckVar, hlookup_ctx, hpred', hqt, hft, throw] at htc''
                          cases htc''
                      | false =>
                          simp [typecheckVar, hlookup_ctx, hpred', hqt, htag', hft, pure, Except.pure] at htc''
                          cases htc''
                          simp [hpred']
