private lemma agreeValueUnder_clean_extends_sameMem
  {predSat : PredSat} {R : Regime} {μ₀ μ₁ : Memory}
  {θ₀ θ₁ θ₀' θ₁' : RealizationMap} {qt : QTyp} {v₀ v₁ : Value} :
