  agreeValueUnder predSat R μ₀ μ₁ θ₀' θ₁' qt v₀ v₁ := by
  intro hclean hθ₀ hθ₁ hagree
  exact agreeValueUnder_clean_extends
    (fun _ _ => Iff.rfl) (fun _ _ => Iff.rfl) hclean hθ₀ hθ₁ hagree

