                        simp [hnp] at htag_qt
                    | guardOnly_ok _k hgo =>
                        exfalso
                        simp [hpred] at hgo
                    | withPred_ok k' arg_name' pred_body' var_env' v' b' hclos hregime hvar hconsist =>
