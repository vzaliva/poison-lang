    exact valueConsistentWithRegime.noTag (by simp [qtypGuardTag, h_ret_pred])
      (closureCapturedVarsRegime_nonClosure_of_nonFunctionType
        (by rw [h_ret_etyp]; exact valueHasETyp_of_evalUnaryOp op v₁' o₁ θ₁'
