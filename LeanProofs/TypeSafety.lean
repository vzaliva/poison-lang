/-- joinTypeResults preserves predTagsBounded: if the first result is bounded, and each rest
    result is bounded, the joined result is bounded at maxNextTag. -/
private lemma joinTypeResults_predTagsBounded_memEnv
    (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) (nt : Tag)
    (hjoin : joinTypeResults ctx r rs = .ok res)
    (hMemR : predTagsBoundedInMemEnv r.memEnv' nt)
    (hPredR : predTagBounded nt r.qualType.pred)
    (hAllRs : ∀ r' ∈ rs, predTagsBoundedInMemEnv r'.memEnv' nt ∧ predTagBounded nt r'.qualType.pred) :
    predTagsBoundedInMemEnv res.memEnv' nt ∧ predTagBounded nt res.qualType.pred := by
  -- Follow the pattern of joinTypeResults_tagEnvBounded
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  -- Fold invariant: memEnv bounded ∧ pred bounded, given all results are bounded
  have h_fold_inv :
      ∀ (rss : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        (∀ r' ∈ rss, predTagsBoundedInMemEnv r'.memEnv' nt ∧ predTagBounded nt r'.qualType.pred) →
        List.foldlM joinStep acc rss = Except.ok acc' →
        predTagsBoundedInMemEnv acc.2.1 nt →
        predTagBounded nt acc.2.2.2.1 →
        predTagsBoundedInMemEnv acc'.2.1 nt ∧ predTagBounded nt acc'.2.2.2.1 := by
    intro rss acc acc' hAll h hbMem hbPred
    induction rss generalizing acc with
    | nil => simp [List.foldlM_nil, pure, Except.pure] at h; rw [← h]; exact ⟨hbMem, hbPred⟩
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at h
            have hx := hAll x (.head xs)
            have hAll_xs : ∀ r' ∈ xs, predTagsBoundedInMemEnv r'.memEnv' nt ∧ predTagBounded nt r'.qualType.pred :=
              fun r' hr' => hAll r' (.tail x hr')
            exact ih _ hAll_xs h
              (predTagsBoundedInMemEnv_joinMemEnvsStrong hbMem hx.1)
              (by rw [hqx] at hx; exact predTagBounded_joinPredicates hbPred hx.2)
  -- Apply the fold invariant
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe,
            MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err => erw [hcheck] at hjoin; simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin; simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err => erw [hfold] at hjoin; simp at hjoin
          | ok a =>
              erw [hfold] at hjoin; simp at hjoin
              subst res; simp
              have ⟨hbMem', hbPred'⟩ := h_fold_inv rs _ _ hAllRs hfold hMemR (by rw [hqt] at hPredR; exact hPredR)
              constructor
              · exact hbMem'
              · -- finalPred: if function type → noPred, else joinedPred
                split <;> first | exact predTagBounded_noPred _ | exact hbPred'

/-- joinTypeResults preserves etypClosuresFullBounded through the ETyp join fold. -/
private lemma joinTypeResults_etypClosuresFullBounded
    (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) (nt : Tag)
    (hjoin : joinTypeResults ctx r rs = .ok res)
    (hClosR : etypClosuresFullBounded r.qualType.etyp nt)
    (hAllRs : ∀ r' ∈ rs, etypClosuresFullBounded r'.qualType.etyp nt) :
    etypClosuresFullBounded res.qualType.etyp nt := by
  -- Same joinStep as in joinTypeResults_predTagsBounded_memEnv
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, _resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 _resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  -- Fold invariant: etyp closure-bounded
  have h_fold_inv :
      ∀ (rss : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        (∀ r' ∈ rss, etypClosuresFullBounded r'.qualType.etyp nt) →
        List.foldlM joinStep acc rss = Except.ok acc' →
        etypClosuresFullBounded acc.1 nt →
        etypClosuresFullBounded acc'.1 nt := by
    intro rss acc acc' hAll h hbClos
    induction rss generalizing acc with
    | nil => simp [List.foldlM_nil, pure, Except.pure] at h; rw [← h]; exact hbClos
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at h
            have hx := hAll x (.head xs)
            have hAll_xs : ∀ r' ∈ xs, etypClosuresFullBounded r'.qualType.etyp nt :=
              fun r' hr' => hAll r' (.tail x hr')
            exact ih _ hAll_xs h
              (by rw [hqx] at hx
                  exact etypClosuresFullBounded_joinETyps (p1 := acc.2.2.1) (p2 := resPoison) hbClos hx)
  -- Apply the fold invariant
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe,
            MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err => erw [hcheck] at hjoin; simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin; simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err => erw [hfold] at hjoin; simp at hjoin
          | ok a =>
              erw [hfold] at hjoin; simp at hjoin
              subst res; simp
              exact h_fold_inv rs _ _ hAllRs hfold (by rw [hqt] at hClosR; exact hClosR)

/-- closureEnvBoundedInCtx is preserved through updateCtxFromResult. -/
private lemma closureEnvBoundedInCtx_of_update
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (r : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok r)
    (hclosure : closureEnvBoundedInCtx ctx) :
    closureEnvBoundedInCtx (updateCtxFromResult ctx r) :=
  varEnvClosuresCapturedBounded_mono hclosure
    (typecheck_normal_nextTag_mono ctx e fuel r htc)

/-- typecheckDeref always produces ETyp.int as result etyp.
    All branches of the deref code return etyp=int. -/
private lemma typecheckDeref_etyp_int (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (h : typecheckDeref ctx e fuel = .ok res) : res.qualType.etyp = ETyp.int := by
  unfold typecheckDeref at h
  cases fuel with
  | zero => simp at h
  | succ fuel' =>
    simp only [bind, Except.bind, pure, Except.pure] at h
    repeat (first | split at h | simp at h | (cases h; rfl))

/-- The LocSet fold in typecheckDeref produces a pred that is bounded.
    Helper for typecheckDeref_pred_bounded. -/
private lemma deref_fold_pred_bounded
    (memEnv : MemoryTypeEnv) (nt : Tag)
    (hMem : predTagsBoundedInMemEnv memEnv nt)
    (init : Poison × Option Predicate) (result : Poison × Option Predicate)
    (hinit : ∀ q, init.2 = some q → predTagBounded nt q)
    (locs : List Loc)
    (hfold : List.foldlM (fun (x : Poison × Option Predicate) (l : Loc) =>
        match memEnv.lookup l with
        | some qt => Except.ok (joinPoison x.1 qt.poison,
            match x.2 with
            | none => some qt.pred
            | some p => some (joinPredicates p qt.pred))
        | none => Except.error s!"Location {l} not found in memory environment") init locs = Except.ok result) :
    ∀ q, result.2 = some q → predTagBounded nt q := by
  induction locs generalizing init with
  | nil => simp [List.foldlM_nil, pure, Except.pure] at hfold; rw [← hfold]; exact hinit
  | cons l rest ih =>
    simp [List.foldlM_cons, bind, Except.bind] at hfold
    cases hlookup : memEnv.lookup l with
    | none => rw [hlookup] at hfold; simp at hfold
    | some qt =>
      rw [hlookup] at hfold; simp at hfold
      exact ih _ (by
        intro q hq
        cases hinit2 : init.2 with
        | none => simp [hinit2] at hq; subst q; exact hMem l qt hlookup
        | some p' => simp [hinit2] at hq; subst q
                     exact predTagBounded_joinPredicates (hinit p' hinit2) (hMem l qt hlookup)) hfold

/-- typecheckDeref result pred is bounded: it is either noPred (trivially bounded)
    or a pred derived from memory cells (bounded by memEnv boundedness). -/
private lemma typecheckDeref_pred_bounded (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (r1 : TypeResult)
    (hte : typecheckExpr ctx e (fuel - 1) = .ok r1)
    (hMem : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
    (h : typecheckDeref ctx e fuel = .ok res) :
    predTagBounded r1.nextTag' res.qualType.pred := by
  unfold typecheckDeref at h
  cases fuel with
  | zero => simp at h
  | succ fuel' =>
    -- All deref branches produce noPred or a pred from memory cells (bounded).
    -- The fold over memory cells produces bounded preds (by deref_fold_pred_bounded).
    -- Brute-force through all branches.
    simp only [bind, Except.bind, pure, Except.pure, Nat.add_sub_cancel] at h hte
    rw [hte] at h; simp at h
    rcases hqr : r1.qualType with ⟨etyp1, poisonRef, predRef⟩
    rw [hqr] at h; simp at h
    cases etyp1 <;> simp at h
    -- Only ETyp.ref ls survives. Exhaust all branches.
    rename_i ls
    split at h
    · simp at h -- ls empty → error
    · -- ls non-empty. Case on foldM result.
      split at h
      · simp at h -- fold error
      · -- fold ok. Case on poisonRef.
        rename_i hne v
        split at h
        · cases h; exact predTagBounded_noPred _ -- poisonRef true → noPred
        · -- poisonRef false. Case on merged pred.
          -- Context: hne : Bool × Option Predicate (fold result value)
          --          v : ls.foldM ... = ok hne (fold equation)
          -- First establish that the fold result pred is bounded.
          have hfold_list := v
          simp [LocSet.foldM, Std.ExtTreeSet.foldlM_eq_foldlM_toList] at hfold_list
          have hv_bounded : ∀ p, hne.2 = some p → predTagBounded r1.nextTag' p :=
            deref_fold_pred_bounded r1.memEnv' r1.nextTag' hMem
              (false, none) hne (by intro q hq; simp at hq) ls.toList hfold_list
          -- Exhaust all remaining branches via repeat split
          repeat (first | split at h | simp at h)
          -- Close goals: h_1 is noPred (subst), h_2/h_3 need split on tagEnv
          all_goals first
            | (subst h; exact predTagBounded_noPred _)
            | -- h_2 or h_3: h has match on tagEnv[k]?
              (repeat (first | split at h | simp at h)
               all_goals (try simp at h)
               all_goals first
                 | (subst h; exact predTagBounded_noPred _)
                 | (subst h; simp [Option.getD]
                    cases hv2 : hne.2 with
                    | none => exact predTagBounded_noPred _
                    | some p' => simp; exact hv_bounded p' hv2))

/-- typecheckAssign memEnv is bounded: the result memEnv' is r2.memEnv' updated at locations
    in ls with a pred that is either noPred or pred2 (both bounded). -/
private lemma typecheckAssign_memEnv_bounded (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (r1 r2 : TypeResult) (ls : LocSet)
    (hte1 : typecheckExpr ctx e1 (fuel - 1) = .ok r1)
    (hrefTyp : r1.qualType.etyp = ETyp.ref ls)
    (hte2 : typecheckExpr (updateCtxFromResult ctx r1) e2 (fuel - 1) = .ok r2)
    (hInt2 : r2.qualType.etyp = ETyp.int)
    (hMemR2 : predTagsBoundedInMemEnv r2.memEnv' r2.nextTag')
    (hPredR2 : predTagBounded r2.nextTag' r2.qualType.pred)
    (h : typecheckAssign ctx e1 e2 fuel = .ok res) :
    predTagsBoundedInMemEnv res.memEnv' r2.nextTag' := by
  unfold typecheckAssign at h
  cases fuel with
  | zero => simp at h
  | succ fuel' =>
    simp only [bind, Except.bind, pure, Except.pure, Nat.add_sub_cancel] at h hte1 hte2
    rw [hte1] at h; simp at h
    rcases hqr : r1.qualType with ⟨etyp1, p1, pred1⟩
    rw [hqr] at h; simp at h
    rw [hqr] at hrefTyp; simp at hrefTyp; subst hrefTyp
    simp at h
    -- Now h has the e2 evaluation
    rw [show typecheckExpr (updateCtxFromResult ctx r1) e2 fuel' = typecheckExpr
        ⟨ctx.pc, r1.regime', r1.memEnv', ctx.varEnv, ctx.bindEnv, r1.tagEnv', r1.nextLoc', r1.nextTag', r1.nextBind', ctx.pureCtx, ctx.externRegime, ctx.externRefAllowed, r1.declared'⟩
        e2 fuel' from by simp [updateCtxFromResult]] at hte2
    rw [hte2] at h; simp at h
    rcases hqr2 : r2.qualType with ⟨etyp2, p2, pred2⟩
    rw [hqr2] at h; simp at h
    rw [hqr2] at hInt2; simp at hInt2; subst hInt2
    simp at h
    -- h now has the memEnv computation
    -- storedPred = if p1 || ctx.pc then noPred else pred2
    -- memEnv' = match ls.toList with | [l] => updateMemEnv ... | _ => updateLocsetWeak ...
    cases h; simp
    -- Goal: predTagsBoundedInMemEnv (match ...) r2.nextTag'
    -- The stored pred is bounded (either noPred or pred2 from IH)
    have hStoredPred : predTagBounded r2.nextTag'
        (if p1 = true ∨ ctx.pc = true then Predicate.noPred else pred2) := by
      split
      · exact predTagBounded_noPred _
      · rw [hqr2] at hPredR2; exact hPredR2
    cases hls : ExtTreeSet.toList ls with
    | nil => simp
             exact predTagsBoundedInMemEnv_updateLocsetWeak hMemR2 hStoredPred
    | cons l rest =>
      cases rest with
      | nil => -- singleton: match [l] with | [l] => updateMemEnv
        simp; exact predTagsBoundedInMemEnv_update hMemR2 hStoredPred
      | cons l2 rest' => -- non-singleton: updateLocsetWeak
        simp; exact predTagsBoundedInMemEnv_updateLocsetWeak hMemR2 hStoredPred

private lemma typecheckExpr_preserves_combined_main :
    ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
    typecheckExpr ctx e fuel = .ok res →
    predTagsBoundedInCtx ctx →
    closureEnvBoundedInCtx ctx →
    predTagsBoundedInMemEnv res.memEnv' res.nextTag' ∧
    qtypPredTagBounded res.qualType res.nextTag' ∧
    etypClosuresFullBounded res.qualType.etyp res.nextTag' := by
  intro ctx e fuel res htc hpred hclosure
  revert ctx e res htc hpred hclosure
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
      intro ctx e res htc hpred hclosure
      have IH_fuel : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheckExpr ctx' e' m = .ok res' → predTagsBoundedInCtx ctx' →
          closureEnvBoundedInCtx ctx' →
          predTagsBoundedInMemEnv res'.memEnv' res'.nextTag' ∧
          qtypPredTagBounded res'.qualType res'.nextTag' ∧
          etypClosuresFullBounded res'.qualType.etyp res'.nextTag' :=
        fun m h_lt e' ctx' res' htc' hpred' hclosure' => IH m h_lt ctx' e' res' htc' hpred' hclosure'
      cases fuel with
      | zero => simp [typecheckExpr] at htc
      | succ fuel' =>
          unfold typecheckExpr at htc
          unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
          cases e with
          | num _n | bool _b | unit | str _s =>
              simp at htc; cases htc
              exact ⟨hpred.2, predTagBounded_noPred _, trivial⟩
          | fn _x _st1 _body _st2 =>
              have hfn := typecheckFn_ok_eq htc; subst hfn
              refine ⟨hpred.2, predTagBounded_noPred _, ?_⟩
              show etypClosuresFullBounded
                (ETyp.arrow _st1 _st2 ctx.pc [FnTClosure.regular _x _body (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv)]) ctx.nextTag
              intro tcl hmem
              simp at hmem; subst hmem
              exact capturedEnvFullBounded_of_toCaptured hpred.1 hclosure
          | pfn _x _st1 _body _st2 =>
              simp [typecheckPfn, Bind.bind, Except.bind] at htc
              cases h_topexpr : _body.toPExpr with
              | error _ => simp [h_topexpr] at htc
              | ok pbody =>
                  simp [h_topexpr, pure, Except.pure] at htc; cases htc
                  refine ⟨hpred.2, predTagBounded_noPred _, ?_⟩
                  show etypClosuresFullBounded
                    (ETyp.parrow _st1 _st2 false [PFnTClosure.regular _x pbody (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv)]) ctx.nextTag
                  intro tcl hmem
                  simp at hmem; subst hmem
                  exact capturedEnvFullBounded_of_toCaptured hpred.1 hclosure
          | externFn _id _arg _argTyp _argPoison _argPred _retSpec _effects cap =>
              obtain ⟨argQt, _, htc_res⟩ :=
                typecheckExternFn_ok_res_eq ctx _id _arg _argTyp _argPoison _argPred _retSpec _effects res htc
              subst htc_res
              refine ⟨hpred.2, predTagBounded_noPred _, ?_⟩
              show etypClosuresFullBounded
                (ETyp.arrow _argTyp (parseReturnType _retSpec) false [FnTClosure.extern _id _arg _retSpec _effects (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt cap])
                  ctx.nextTag
              intro tcl hmem
              simp at hmem; subst hmem
              exact capturedEnvFullBounded_of_toCaptured hpred.1 hclosure
          | externPfn _id _arg _argTyp _argPoison _argPred _retSpec _captures =>
              obtain ⟨argQt, _, htc_res⟩ :=
                typecheckExternPfn_ok_res_eq ctx _id _arg _argTyp _argPoison _argPred _retSpec res htc
              subst htc_res
              refine ⟨hpred.2, predTagBounded_noPred _, ?_⟩
              show etypClosuresFullBounded
                (ETyp.parrow _argTyp (parseReturnType _retSpec) false [PFnTClosure.extern _id _arg _retSpec (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt _captures]) ctx.nextTag
              intro tcl hmem
              simp at hmem; subst hmem
              exact capturedEnvFullBounded_of_toCaptured hpred.1 hclosure
          | externRef _id _rp _rpred _cp _cpred =>
              simp at htc
              have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
              subst hres
              refine ⟨?_, predTagBounded_noPred _, trivial⟩
              intro l qt hl
              by_cases heq : l = ctx.nextLoc
              · subst heq
                simp only [updateMemEnv, MemoryTypeEnv.lookup, ExtTreeMap.get?_eq_getElem?,
                  Std.ExtTreeMap.getElem?_insert_self, Option.map] at hl
                simp only [Option.some.injEq] at hl; subst hl
                simp only [qtypPredTagBounded]
                exact predTagBounded_noPred ctx.nextTag
              · rw [MemoryTypeEnv_lookup_updateMemEnv_ne heq] at hl
                exact hpred.2 l qt hl
          | var x =>
              -- All branches of typecheckVar preserve memEnv and nextTag
              -- and produce pred that is either noPred or from ctx.varEnv
              unfold typecheckVar at htc
              cases h_lookup : ctx.varEnv.lookup x with
              | none => simp [h_lookup] at htc
              | some qt =>
                  simp [h_lookup] at htc
                  have hqt_closure := hclosure x qt h_lookup
                  cases qt with
                  | mk etyp poison pred =>
                      cases pred with
                      | noPred =>
                          simp at htc; cases htc
                          exact ⟨hpred.2, predTagBounded_noPred _, hqt_closure⟩
                      | guardOnly k =>
                          simp at htc
                          cases hft : etyp.isFunctionType with
                          | true =>
                              simp [hft, Bind.bind, Except.bind] at htc
                          | false =>
                              simp [hft] at htc
                              cases htagopt : ctx.tagEnv.get? k with
                              | none =>
                                  have htagopt' : ctx.tagEnv[k]? = none := by
                                    simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                                  simp [htagopt', pure, Except.pure] at htc; cases htc
                                  exact ⟨hpred.2, hpred.1 x ⟨etyp, poison, Predicate.guardOnly k⟩ h_lookup, hqt_closure⟩
                              | some tv =>
                                  have htagopt' : ctx.tagEnv[k]? = some tv := by
                                    simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                                  cases tv with
                                  | mk val deps =>
                                      cases val with
                                      | true =>
                                          simp [htagopt', pure, Except.pure] at htc; cases htc
                                          exact ⟨hpred.2, predTagBounded_noPred _, hqt_closure⟩
                                      | false =>
                                          simp [htagopt', pure, Except.pure] at htc; cases htc
                                          exact ⟨hpred.2, predTagBounded_noPred _, hqt_closure⟩
                      | guardClosure k arg body env =>
                          simp at htc
                          cases hft : etyp.isFunctionType with
                          | true =>
                              simp [hft, Bind.bind, Except.bind] at htc
                          | false =>
                              simp [hft] at htc
                              cases htagopt : ctx.tagEnv.get? k with
                              | none =>
                                  have htagopt' : ctx.tagEnv[k]? = none := by
                                    simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                                  simp [htagopt', pure, Except.pure] at htc; cases htc
                                  exact ⟨hpred.2, hpred.1 x ⟨etyp, poison, Predicate.guardClosure k arg body env⟩ h_lookup, hqt_closure⟩
                              | some tv =>
                                  have htagopt' : ctx.tagEnv[k]? = some tv := by
                                    simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                                  cases tv with
                                  | mk val deps =>
                                      cases val with
                                      | true =>
                                          simp [htagopt', pure, Except.pure] at htc; cases htc
                                          exact ⟨hpred.2, predTagBounded_noPred _, hqt_closure⟩
                                      | false =>
                                          simp [htagopt', pure, Except.pure] at htc; cases htc
                                          exact ⟨hpred.2, predTagBounded_noPred _, hqt_closure⟩
          | unaryop op e1 =>
              -- htc : typecheckUnaryOp ctx op e1 fuel' = .ok res
              unfold typecheckUnaryOp at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      cases hop : opUnaryEType? op etyp1 with
                      | none => simp [hop] at htc
                      | some outType =>
                          simp [hop, pure, Except.pure] at htc; cases htc
                          have h_lt : fuel'' < fuel' + 1 := by omega
                          have hIH := IH_fuel fuel'' h_lt e1 ctx r1
                            (by simpa [typecheck] using hte1) hpred hclosure
                          refine ⟨hIH.1, predTagBounded_noPred _, ?_⟩
                          -- outType = bool (from opUnaryEType?)
                          unfold opUnaryEType? at hop
                          split at hop <;> (cases hop; try trivial)
          | op e1 _op e2 =>
              -- htc : typecheckOp ctx e1 e2 fuel' _op = .ok res
              unfold typecheckOp at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      let ctx' : TypeContext := updateCtxFromResult ctx r1
                      cases hte2 : typecheckExpr ctx' e2 fuel'' with
                      | error err => erw [hte2] at htc; simp at htc
                      | ok r2 =>
                          erw [hte2] at htc
                          rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                          simp [hq2] at htc
                          cases hop : opEType? _op etyp1 etyp2 with
                          | none => simp [hop] at htc
                          | some outType =>
                              simp [hop, pure, Except.pure] at htc; cases htc
                              have h_lt : fuel'' < fuel' + 1 := by omega
                              have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                                simpa [typecheck] using hte1
                              have hIH1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hpred hclosure

                              have hpred' : predTagsBoundedInCtx ctx' :=
                                ⟨predTagsBoundedInVarEnv_mono hpred.1
                                  (typecheck_normal_nextTag_mono ctx e1 fuel'' r1 hte1'), hIH1.1⟩
                              have hIH2 := IH_fuel fuel'' h_lt e2 ctx' r2
                                (by simpa [typecheck, ctx'] using hte2) hpred' (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)
                              refine ⟨hIH2.1, predTagBounded_noPred _, ?_⟩
                              unfold opEType? at hop
                              split at hop <;> cases hop <;> trivial
          | seq e1 e2 =>
              unfold typecheckSeq at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      let ctx' := updateCtxFromResult ctx r1
                      cases hte2 : typecheckExpr ctx' e2 fuel'' with
                      | error err => simp [hte2, ctx'] at htc
                      | ok r2 =>
                          simp [hte2, ctx'] at htc
                          have hres : { r2 with tagLog' := r1.tagLog' ++ r2.tagLog' } = res := by
                            simpa [pure, Except.pure] using htc
                          have h_lt : fuel'' < fuel' + 1 := by omega
                          have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                            simpa [typecheck] using hte1
                          have hIH1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hpred hclosure

                          have hpred' : predTagsBoundedInCtx ctx' :=
                            ⟨predTagsBoundedInVarEnv_mono hpred.1
                              (typecheck_normal_nextTag_mono ctx e1 fuel'' r1 hte1'), hIH1.1⟩
                          have hIH2 := IH_fuel fuel'' h_lt e2 ctx' r2
                            (by simpa [typecheck, ctx'] using hte2) hpred' (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)

                          simpa [← hres] using hIH2
          | vlet x e1 e2 =>
              unfold typecheckVlet at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  have mk_ctx2 : ∀ r1 : TypeResult,
                      typecheckExpr ctx e1 fuel'' = .ok r1 →
                      let ctx2 := { updateCtxFromResult ctx r1 with
                                    varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                      predTagsBoundedInCtx ctx2 ∧ closureEnvBoundedInCtx ctx2 := by
                    intro r1 hte1
                    have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by simpa [typecheck] using hte1
                    have hmono1 := typecheck_normal_nextTag_mono ctx e1 fuel'' r1 hte1'
                    have hIH1 := IH_fuel fuel'' (by omega) e1 ctx r1 hte1' hpred hclosure
                    exact ⟨⟨predTagsBoundedInVarEnv_update
                        (predTagsBoundedInVarEnv_mono hpred.1 hmono1)
                        hIH1.2.1, hIH1.1⟩,
                      varEnvClosuresCapturedBounded_update
                        (varEnvClosuresCapturedBounded_mono hclosure hmono1) hIH1.2.2⟩
                  -- Macro for the vlet subcases: unpack e1/e2, apply combined IH
                  have vlet_close : ∀ r1 : TypeResult,
                      typecheckExpr ctx e1 fuel'' = .ok r1 →
                      ∀ r2 : TypeResult,
                      typecheckExpr { updateCtxFromResult ctx r1 with
                        varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 } e2 fuel'' = .ok r2 →
                      predTagsBoundedInMemEnv r2.memEnv' r2.nextTag' ∧
                      predTagBounded r2.nextTag' r2.qualType.pred ∧
                      etypClosuresFullBounded r2.qualType.etyp r2.nextTag' := by
                    intro r1 hte1 r2 hte2
                    have ⟨hp, hc⟩ := mk_ctx2 r1 hte1
                    have hIH2 := IH_fuel fuel'' (by omega) e2 _ r2
                      (by simpa [typecheck] using hte2) hp hc
                    exact ⟨hIH2.1, hIH2.2.1, hIH2.2.2⟩

                  cases hlookup : ctx.varEnv.lookup x with
                  | none =>
                      simp [hlookup] at htc
                      cases hte1 : typecheckExpr ctx e1 fuel'' with
                      | error err => simp [hte1] at htc
                      | ok r1 =>
                          simp [hte1] at htc
                          let ctx2 : TypeContext := { updateCtxFromResult ctx r1 with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                          cases hte2 : typecheckExpr ctx2 e2 fuel'' with
                          | error err => erw [hte2] at htc; simp at htc
                          | ok r2 =>
                              erw [hte2] at htc; simp at htc
                              rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                              simp [hq2, pure, Except.pure] at htc; cases htc
                              have hc := vlet_close r1 hte1 r2 hte2
                              exact ⟨hc.1, by simp [qtypPredTagBounded, hq2] at hc ⊢; exact hc.2.1,
                                by simp [hq2] at hc ⊢; exact hc.2.2⟩
                  | some qtOuter =>
                      simp [hlookup] at htc
                      cases hpredOuter : qtOuter.pred with
                      | guardClosure k arg body env =>
                          simp [hpredOuter] at htc
                          by_cases hregSome : (ctx.regime.lookup? k).isSome = true
                          · simp [hregSome] at htc
                          · simp [hregSome] at htc
                            cases hte1 : typecheckExpr ctx e1 fuel'' with
                            | error err => simp [hte1] at htc
                            | ok r1 =>
                                simp [hte1] at htc
                                let ctx2 : TypeContext := { updateCtxFromResult ctx r1 with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                                cases hte2 : typecheckExpr ctx2 e2 fuel'' with
                                | error err => erw [hte2] at htc; simp at htc
                                | ok r2 =>
                                    erw [hte2] at htc; simp at htc
                                    rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                    simp [hq2, pure, Except.pure] at htc; cases htc
                                    have hc := vlet_close r1 hte1 r2 hte2
                                    exact ⟨hc.1, by simp [qtypPredTagBounded, hq2] at hc ⊢; exact hc.2⟩
                      | guardOnly k =>
                          simp [hpredOuter] at htc
                          cases hte1 : typecheckExpr ctx e1 fuel'' with
                          | error err => simp [hte1] at htc
                          | ok r1 =>
                              simp [hte1] at htc
                              let ctx2 : TypeContext := { updateCtxFromResult ctx r1 with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                              cases hte2 : typecheckExpr ctx2 e2 fuel'' with
                              | error err => erw [hte2] at htc; simp at htc
                              | ok r2 =>
                                  erw [hte2] at htc; simp at htc
                                  rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                  simp [hq2, pure, Except.pure] at htc; cases htc
                                  have hc := vlet_close r1 hte1 r2 hte2
                                  exact ⟨hc.1, by simp [qtypPredTagBounded, hq2] at hc ⊢; exact hc.2⟩
                      | noPred =>
                          simp [hpredOuter] at htc
                          cases hte1 : typecheckExpr ctx e1 fuel'' with
                          | error err => simp [hte1] at htc
                          | ok r1 =>
                              simp [hte1] at htc
                              let ctx2 : TypeContext := { updateCtxFromResult ctx r1 with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                              cases hte2 : typecheckExpr ctx2 e2 fuel'' with
                              | error err => erw [hte2] at htc; simp at htc
                              | ok r2 =>
                                  erw [hte2] at htc; simp at htc
                                  rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                  simp [hq2, pure, Except.pure] at htc; cases htc
                                  have hc := vlet_close r1 hte1 r2 hte2
                                  exact ⟨hc.1, by simp [qtypPredTagBounded, hq2] at hc ⊢; exact hc.2⟩
          | newRef e1 =>
              -- Use structure lemma
              have htcNew : typecheckNewRef ctx e1 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckNewRef_structure ctx e1 fuel' res htcNew with
                ⟨r1, l, hte1, hl, _hInt, _hrefTyp, _hpc, hpredNoPred, hmemEnv, _htagEnv, _hnextLoc, hnextTag, _hregime⟩
              have h_lt_raw : fuel' - 1 < fuel' + 1 := by omega
              have hIH1 := IH_fuel (fuel' - 1) h_lt_raw e1 ctx r1 hte1 hpred hclosure

              rw [hnextTag]
              refine ⟨?_, ?_, ?_⟩
              · -- predTagsBoundedInMemEnv (updateMemEnv r1.memEnv' l storedQt) r1.nextTag'
                rw [hmemEnv]
                apply predTagsBoundedInMemEnv_update hIH1.1
                -- storedQt.pred is either noPred or r1.qualType.pred
                show predTagBounded r1.nextTag' (if ctx.pc then Predicate.noPred else r1.qualType.pred)
                split
                · exact predTagBounded_noPred _
                · exact hIH1.2.1
              · -- pred = noPred
                simp only [qtypPredTagBounded, hpredNoPred]; exact predTagBounded_noPred _
              · -- closure: result etyp is ref (no closures)
                rcases typecheckNewRef_structure ctx e1 fuel' res htcNew with
                  ⟨_, _, _, _, _, hrefTyp, _⟩
                rw [hrefTyp]; trivial
          | assign e1 e2 =>
              -- Use structure lemma
              have htcAssign : typecheckAssign ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckAssign_structure ctx e1 e2 fuel' res htcAssign with
                ⟨r1, r2, ls, hte1, _hrefTyp, hte2, _hInt2, _hnextLoc, hnextTag, _hregime,
                 _hunit, _hpoison, hpredNoPred⟩
              have h_lt_raw : fuel' - 1 < fuel' + 1 := by omega
              have hIH1 := IH_fuel (fuel' - 1) h_lt_raw e1 ctx r1 hte1 hpred hclosure

              have hpred' : predTagsBoundedInCtx (updateCtxFromResult ctx r1) :=
                ⟨predTagsBoundedInVarEnv_mono hpred.1
                  (typecheck_normal_nextTag_mono ctx e1 (fuel' - 1) r1 hte1), hIH1.1⟩
              have hIH2 := IH_fuel (fuel' - 1) h_lt_raw e2 (updateCtxFromResult ctx r1) r2 hte2 hpred' (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)

              rw [hnextTag]
              refine ⟨?_, ?_, ?_⟩
              · -- memEnv bounded via typecheckAssign_memEnv_bounded
                have hPredR2 : predTagBounded r2.nextTag' r2.qualType.pred := by
                  have := hIH2.2.1; simp [qtypPredTagBounded] at this; exact this
                exact typecheckAssign_memEnv_bounded ctx e1 e2 fuel' res r1 r2 ls
                  hte1 _hrefTyp hte2 _hInt2 hIH2.1 hPredR2 htcAssign
              · simp only [qtypPredTagBounded, hpredNoPred]; exact predTagBounded_noPred _
              · -- closure: result etyp is unit (no closures)
                rcases typecheckAssign_structure ctx e1 e2 fuel' res htcAssign with
                  ⟨_, _, _, _, _, _, _, _, _, _, hunit, _⟩
                rw [hunit]; trivial
          | deref e1 =>
              -- Use structure lemma
              have htcDeref : typecheckDeref ctx e1 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              cases hfuel : fuel' with
              | zero => simp [hfuel, typecheckDeref] at htcDeref
              | succ fuel'' =>
                  have h_lt : fuel'' < fuel' + 1 := by omega
                  obtain ⟨r1, hte1, hmem_eq, _hte_eq, _hnl_eq, hnt_eq, _⟩ :=
                    typecheckDeref_structure ctx e1 (fuel'' + 1) res (by rwa [← hfuel])
                  simp only [Nat.add_sub_cancel] at hte1
                  have hIH1 := IH_fuel fuel'' h_lt e1 ctx r1
                    (by simpa [typecheck] using hte1) hpred hclosure

                  rw [hmem_eq, hnt_eq]
                  refine ⟨hIH1.1, ?_, ?_⟩
                  · -- Use standalone deref pred bounded lemma
                    exact typecheckDeref_pred_bounded ctx e1 fuel' res r1
                      (by rw [hfuel, Nat.add_sub_cancel]; exact hte1) hIH1.1 htcDeref
                  · -- closure: result etyp = int (no closures)
                    suffices h : res.qualType.etyp = ETyp.int by rw [hmem_eq, hnt_eq] at *; rw [h]; trivial
                    exact typecheckDeref_etyp_int ctx e1 fuel' res htcDeref
          | ite e1 e2 e3 =>
              have htcIf : typecheckIf ctx e1 e2 e3 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              have hite_nopred := typecheckIf_pred_noPred ctx e1 e2 e3 fuel' res htcIf
              rcases typecheckIf_structure ctx e1 e2 e3 fuel' res htcIf with
                htrue | hfalse | hstd
              · -- Mode 1: matchGuard succeeds, R(k) = some true
                obtain ⟨k, deps, hmatch, _hR, _res1, _htc1, _, res2, res3, htc2, htc3,
                  hmemEnv, _, _hresQT, hresNext, _, _, _, hresEtyp⟩ := htrue
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                have hmono1 := typecheck_normal_nextTag_mono { ctx with pureCtx := true } e1 _ _res1 _htc1
                have hIH2 := IH_fuel (fuel' - 1) h_fuelm1 e2 _ res2 htc2
                  ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono1,
                   predTagsBoundedInMemEnv_mono hpred.2 hmono1⟩
                  (varEnvClosuresCapturedBounded_mono hclosure hmono1)
                rw [hresNext]
                refine ⟨?_, ?_, ?_⟩
                · -- memEnv' = res2.memEnv' (mode 1 uses true branch only)
                  rw [hmemEnv]
                  exact predTagsBoundedInMemEnv_mono hIH2.1 (Nat.le_max_left _ _)
                · simp only [qtypPredTagBounded, hite_nopred]; exact predTagBounded_noPred _
                · rw [hresEtyp]
                  exact etypClosuresFullBounded_mono hIH2.2.2 (Nat.le_max_left _ _)
              · -- Mode 2: matchGuard succeeds, R(k) = some false
                obtain ⟨k, deps, hmatch, _hR, _res1, _htc1, _, res2, res3, htc2, htc3,
                  hmemEnv, _, _hresQT, hresNext, _, _, _, hresEtyp⟩ := hfalse
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                have hmono2 := typecheck_normal_nextTag_mono
                  { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩,
                             nextTag := _res1.nextTag', nextBind := _res1.nextBind',
                             declaredExternRefs := _res1.declared' } e2 _ res2 htc2
                have hmono1 := typecheck_normal_nextTag_mono { ctx with pureCtx := true } e1 _ _res1 _htc1
                have hmono12 : ctx.nextTag ≤ res2.nextTag' := Nat.le_trans hmono1 hmono2
                have hIH3 := IH_fuel (fuel' - 1) h_fuelm1 e3 _ res3 htc3
                  ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono12,
                   predTagsBoundedInMemEnv_mono hpred.2 hmono12⟩
                  (varEnvClosuresCapturedBounded_mono hclosure hmono12)
                rw [hresNext]
                refine ⟨?_, ?_, ?_⟩
                · -- memEnv' = res3.memEnv' (mode 2 uses false branch only)
                  rw [hmemEnv]
                  exact predTagsBoundedInMemEnv_mono hIH3.1 (Nat.le_max_right _ _)
                · simp only [qtypPredTagBounded, hite_nopred]; exact predTagBounded_noPred _
                · rw [hresEtyp]
                  exact etypClosuresFullBounded_mono hIH3.2.2 (Nat.le_max_right _ _)
              · -- Standard case (mode 3/4)
                obtain ⟨_, res1, htc1, _hbool1, ⟨res2, htc2, ⟨res3, htc3, hmemEnv, _,
                  _hresQT, hresNextTag, _, _, _, hresEtyp, _⟩⟩⟩ := hstd
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                have hIH1 := IH_fuel (fuel' - 1) h_fuelm1 e1 ctx res1 htc1 hpred hclosure
                have hmono1 := typecheck_normal_nextTag_mono ctx e1 _ res1 htc1
                have hmono2 := typecheck_normal_nextTag_mono _ e2 _ res2 htc2
                have hIH2 := IH_fuel (fuel' - 1) h_fuelm1 e2 _ res2 htc2 (by
                  exact ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono1, hIH1.1⟩)
                  (closureEnvBoundedInCtx_of_update ctx e1 _ res1 htc1 hclosure)
                have hIH3 := IH_fuel (fuel' - 1) h_fuelm1 e3 _ res3 htc3 (by
                  exact ⟨predTagsBoundedInVarEnv_mono hpred.1
                    (Nat.le_trans hmono1 hmono2),
                    predTagsBoundedInMemEnv_mono hIH1.1 hmono2⟩)
                  (varEnvClosuresCapturedBounded_mono hclosure (Nat.le_trans hmono1 hmono2))
                rw [hresNextTag]
                refine ⟨?_, ?_, ?_⟩
                · -- memEnv' = joinMemEnvsStrong res2.memEnv' res3.memEnv'
                  rw [hmemEnv]
                  exact predTagsBoundedInMemEnv_joinMemEnvsStrong
                    (predTagsBoundedInMemEnv_mono hIH2.1 (Nat.le_max_left _ _))
                    (predTagsBoundedInMemEnv_mono hIH3.1 (Nat.le_max_right _ _))
                · simp only [qtypPredTagBounded, hite_nopred]; exact predTagBounded_noPred _
                · rw [hresEtyp]
                  exact etypClosuresFullBounded_joinETyps
                    (etypClosuresFullBounded_mono hIH2.2.2 (Nat.le_max_left _ _))
                    (etypClosuresFullBounded_mono hIH3.2.2 (Nat.le_max_right _ _))
          | app e1 e2 =>
              -- Reduce to typecheckApp
              have htcApp : typecheckApp ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              -- Unfold typecheckApp
              unfold typecheckApp at htcApp
              cases fuel' with
              | zero => simp at htcApp
              | succ fuel'' =>
                simp at htcApp
                simp [bind, Except.bind] at htcApp
                rcases hcte2 : typecheckExpr ctx e2 _ with _ | ⟨res2⟩
                  <;> rw [hcte2] at htcApp <;> simp at htcApp
                rcases hq2 : res2.qualType with ⟨etyp2, poison2, pred2⟩
                simp [hq2] at htcApp
                set ctx' : TypeContext := {
                  pc := ctx.pc, regime := res2.regime', memEnv := res2.memEnv',
                  varEnv := ctx.varEnv, bindEnv := ctx.bindEnv, tagEnv := res2.tagEnv', nextLoc := res2.nextLoc',
                  nextTag := res2.nextTag', nextBind := res2.nextBind', pureCtx := ctx.pureCtx,
                  externRegime := ctx.externRegime,
                  externRefAllowed := ctx.externRefAllowed,
                  declaredExternRefs := res2.declared' } with hctx'
                rcases htce1 : typecheckExpr ctx' e1 _ with _ | ⟨res1⟩
                  <;> rw [htce1] at htcApp <;> simp at htcApp
                rcases hq1 : res1.qualType with ⟨etyp1, poison1, pred1⟩
                simp [hq1] at htcApp
                -- IH on e2 and e1
                have h_fuel : fuel'' < fuel'' + 1 + 1 := by omega
                have hIH2 := IH_fuel fuel'' h_fuel e2 ctx res2 hcte2 hpred hclosure

                have hmono2 := typecheck_normal_nextTag_mono ctx e2 fuel'' res2 hcte2
                have hpredCtx' : predTagsBoundedInCtx ctx' := by
                  simp only [predTagsBoundedInCtx, hctx']
                  exact ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono2, hIH2.1⟩
                have hIH1 := IH_fuel fuel'' h_fuel e1 ctx' res1 htce1 hpredCtx' (varEnvClosuresCapturedBounded_mono hclosure hmono2)

                have hmono1 := typecheck_normal_nextTag_mono ctx' e1 fuel'' res1 htce1
                -- IH for applyXTClosure (needs fuel < fuel''+1+1)
                have IH' : ∀ m < fuel'', ∀ (e' : Expr) (ctx'' : TypeContext) (res' : TypeResult),
                    typecheckExpr ctx'' e' m = .ok res' → predTagsBoundedInCtx ctx'' →
                    closureEnvBoundedInCtx ctx'' →
                    predTagsBoundedInMemEnv res'.memEnv' res'.nextTag' ∧
                    qtypPredTagBounded res'.qualType res'.nextTag' ∧
                    etypClosuresFullBounded res'.qualType.etyp res'.nextTag' :=
                  fun m hm e' ctx'' res' htc' hb hcl =>
                    IH_fuel m (by omega) e' ctx'' res' htc' hb hcl
                -- Pred of e2 result is bounded
                have hpred2 : predTagBounded res1.nextTag' pred2 := by
                  have : predTagBounded res2.nextTag' pred2 := by
                    have := hIH2.2.1; simp [qtypPredTagBounded, hq2] at this; exact this
                  exact predTagBounded_mono this hmono1
                -- Arg closures: from hIH2.2.2 + monotonicity
                have hclosure_arg : etypClosuresFullBounded etyp2 res1.nextTag' := by
                  have h2 := hIH2.2.2; simp [hq2] at h2
                  exact etypClosuresFullBounded_mono h2 hmono1
                -- Case split on etyp1 (arrow vs parrow vs other)
                rcases etyp1 with _ | _ | _ | _ | _ | ⟨t1, t2, p, fs⟩ | _
                  <;> simp at htcApp
                · -- arrow case
                  rcases hctxPure : ctx.pureCtx <;> simp [hctxPure] at htcApp
                  rcases fs with _ | ⟨f, fs'⟩ <;> simp at htcApp
                  rcases hsub1 : isErasureOf t1 _
                    <;> rw [hsub1] at htcApp <;> simp at htcApp
                  rcases happly :
                      applyFnTClosureAtCursor f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1
                        (res1.nextTag', res1.nextLoc') res1.nextBind' fuel'' with _ | ⟨r⟩
                    <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htcApp
                  -- Get full 3-tuple for first closure result r
                  have hIH1_clos := hIH1.2.2
                  simp [hq1] at hIH1_clos
                  have hR : predTagsBoundedInMemEnv r.memEnv' r.nextTag' ∧
                      qtypPredTagBounded r.qualType r.nextTag' ∧
                      etypClosuresFullBounded r.qualType.etyp r.nextTag' := by
                    have hcapt_f := hIH1_clos f (List.Mem.head _)
                    exact applyFnTClosureAtCursor_predTagsBounded f ctx t1 t2 p
                      poison1 etyp2 poison2 pred2 res1 r (res1.nextTag', res1.nextLoc') res1.nextBind'
                      fuel'' IH' (Nat.le_refl _) hIH1.1 hcapt_f hpred2 hclosure_arg happly
                  rcases hrest :
                      applyClosuresThreaded
                        (fun tcl cursor bn =>
                          applyFnTClosureAtCursor tcl t1 t2 p poison1 etyp2 poison2 pred2
                            ctx res1 cursor bn fuel'')
                        fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
                    <;> simp [hrest] at htcApp
                  obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
                      res = { joined with tagLog' := L } := by
                    cases hj : joinTypeResults ctx r rs' with
                    | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htcApp
                    | ok joined =>
                        simp [pure, Except.pure, hj, Functor.map, Except.map] at htcApp
                        exact ⟨joined, _, rfl, htcApp.symm⟩
                  have hr_base_le : res1.nextTag' ≤ r.nextTag' := by
                    have hmono := applyFnTClosureAtCursor_nextTag_mono_normal f ctx t1 t2 p
                      poison1 etyp2 poison2 pred2 res1 r (res1.nextTag', res1.nextLoc') res1.nextBind'
                      fuel'' (fun m hm e c r htc => typecheck_normal_nextTag_mono c e m r htc)
                      happly
                    simpa using hmono
                  have htail := applyFnClosuresThreaded_forall_predTagsBounded fs' ctx t1 t2 p
                    poison1 etyp2 poison2 pred2 res1 (r.nextTag', r.nextLoc') r.nextBind' fuel''
                    IH' hr_base_le hIH1.1 (fun t ht => hIH1_clos t (.tail f ht))
                    hpred2 hclosure_arg rs' hrest
                  have hAllRs' : ∀ ri ∈ rs', predTagsBoundedInMemEnv ri.memEnv' ri.nextTag' ∧
                      qtypPredTagBounded ri.qualType ri.nextTag' ∧
                      etypClosuresFullBounded ri.qualType.etyp ri.nextTag' := htail.1
                  -- Use join lemmas: all results bounded, mono up to res.nextTag' = max
                  -- res.nextTag' is the max of all nextTag' values
                  have hntmax := joinTypeResults_nextTag_eq_max ctx r rs' res hjoin
                  -- Each result bounded at its own nextTag'; mono up to res.nextTag'
                  -- r1.nextTag' ≤ res.nextTag' (first of max list)
                  have hr1_le : r.nextTag' ≤ res.nextTag' := by
                    rw [hntmax]; simpa [List.max] using foldl_max_ge_init r.nextTag' _
                  -- Each ri.nextTag' ≤ res.nextTag' (member of max list)
                  have hAllRs_at_nt : ∀ ri ∈ rs',
                      predTagsBoundedInMemEnv ri.memEnv' res.nextTag' ∧
                      predTagBounded res.nextTag' ri.qualType.pred := by
                    intro ri hri
                    have hb := hAllRs' ri hri
                    have hri_le : ri.nextTag' ≤ res.nextTag' := by
                      rw [hntmax]; simp [List.max]
                      exact foldl_max_ge_elem _ _ _ (List.mem_map.mpr ⟨ri, hri, rfl⟩)
                    exact ⟨predTagsBoundedInMemEnv_mono hb.1 hri_le,
                           predTagBounded_mono hb.2.1 hri_le⟩
                  have hjPT := joinTypeResults_predTagsBounded_memEnv ctx r rs' res res.nextTag'
                    hjoin (predTagsBoundedInMemEnv_mono hR.1 hr1_le) (predTagBounded_mono hR.2.1 hr1_le)
                    hAllRs_at_nt
                  -- Closure part
                  have hAllRs_clos : ∀ ri ∈ rs', etypClosuresFullBounded ri.qualType.etyp res.nextTag' := by
                    intro ri hri
                    have hri_le : ri.nextTag' ≤ res.nextTag' := by
                      rw [hntmax]; simp [List.max]
                      exact foldl_max_ge_elem _ _ _ (List.mem_map.mpr ⟨ri, hri, rfl⟩)
                    exact etypClosuresFullBounded_mono (hAllRs' ri hri).2.2 hri_le
                  exact ⟨hjPT.1,
                    ⟨hjPT.2, joinTypeResults_etypClosuresFullBounded ctx r rs' res res.nextTag'
                      hjoin (etypClosuresFullBounded_mono hR.2.2 hr1_le) hAllRs_clos⟩⟩
                · -- parrow case
                  rename_i st1 st2 p tcls
                  rcases tcls with _ | ⟨f, fs'⟩ <;> simp at htcApp
                  rcases hsub1 : isErasureOf st1 _
                    <;> rw [hsub1] at htcApp <;> simp at htcApp
                  rcases happly :
                      applyPFnTClosureAtCursor f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1
                        (res1.nextTag', res1.nextLoc') res1.nextBind' fuel'' with _ | ⟨r⟩
                    <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htcApp
                  -- Get full 3-tuple for first closure result r
                  have hIH1_clos := hIH1.2.2
                  simp [hq1] at hIH1_clos
                  have hR : predTagsBoundedInMemEnv r.memEnv' r.nextTag' ∧
                      qtypPredTagBounded r.qualType r.nextTag' ∧
                      etypClosuresFullBounded r.qualType.etyp r.nextTag' := by
                    have hcapt_f := hIH1_clos f (List.Mem.head _)
                    exact applyPFnTClosureAtCursor_predTagsBounded f ctx st1 st2 p
                      poison1 etyp2 poison2 pred2 res1 r (res1.nextTag', res1.nextLoc') res1.nextBind'
                      fuel'' IH' (Nat.le_refl _) hIH1.1 hcapt_f hpred2 hclosure_arg happly
                  rcases hrest :
                      applyClosuresThreaded
                        (fun tcl cursor bn =>
                          applyPFnTClosureAtCursor tcl st1 st2 p poison1 etyp2 poison2 pred2
                            ctx res1 cursor bn fuel'')
                        fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
                    <;> simp [hrest] at htcApp
                  obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
                      res = { joined with tagLog' := L } := by
                    cases hj : joinTypeResults ctx r rs' with
                    | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htcApp
                    | ok joined =>
                        simp [pure, Except.pure, hj, Functor.map, Except.map] at htcApp
                        exact ⟨joined, _, rfl, htcApp.symm⟩
                  have hr_base_le : res1.nextTag' ≤ r.nextTag' := by
                    have hmono := applyPFnTClosureAtCursor_nextTag_mono_normal f ctx st1 st2 p
                      poison1 etyp2 poison2 pred2 res1 r (res1.nextTag', res1.nextLoc') res1.nextBind'
                      fuel'' (fun m hm e c r htc => typecheck_normal_nextTag_mono c e m r htc)
                      happly
                    simpa using hmono
                  have htail := applyPFnClosuresThreaded_forall_predTagsBounded fs' ctx st1 st2 p
                    poison1 etyp2 poison2 pred2 res1 (r.nextTag', r.nextLoc') r.nextBind' fuel''
                    IH' hr_base_le hIH1.1 (fun t ht => hIH1_clos t (.tail f ht))
                    hpred2 hclosure_arg rs' hrest
                  have hAllRs' : ∀ ri ∈ rs', predTagsBoundedInMemEnv ri.memEnv' ri.nextTag' ∧
                      qtypPredTagBounded ri.qualType ri.nextTag' ∧
                      etypClosuresFullBounded ri.qualType.etyp ri.nextTag' := htail.1
                  -- Join: mono everything up to res.nextTag' = max of all nextTag'
                  have hntmax := joinTypeResults_nextTag_eq_max ctx r rs' res hjoin
                  have hr1_le : r.nextTag' ≤ res.nextTag' := by
                    rw [hntmax]; simpa [List.max] using foldl_max_ge_init r.nextTag' _
                  have hAllRs_at_nt : ∀ ri ∈ rs',
                      predTagsBoundedInMemEnv ri.memEnv' res.nextTag' ∧
                      predTagBounded res.nextTag' ri.qualType.pred := by
                    intro ri hri
                    have hb := hAllRs' ri hri
                    have hri_le : ri.nextTag' ≤ res.nextTag' := by
                      rw [hntmax]; simp [List.max]
                      exact foldl_max_ge_elem _ _ _ (List.mem_map.mpr ⟨ri, hri, rfl⟩)
                    exact ⟨predTagsBoundedInMemEnv_mono hb.1 hri_le,
                           predTagBounded_mono hb.2.1 hri_le⟩
                  have hjPT := joinTypeResults_predTagsBounded_memEnv ctx r rs' res res.nextTag'
                    hjoin (predTagsBoundedInMemEnv_mono hR.1 hr1_le) (predTagBounded_mono hR.2.1 hr1_le)
                    hAllRs_at_nt
                  have hAllRs_clos : ∀ ri ∈ rs', etypClosuresFullBounded ri.qualType.etyp res.nextTag' := by
                    intro ri hri
                    have hri_le : ri.nextTag' ≤ res.nextTag' := by
                      rw [hntmax]; simp [List.max]
                      exact foldl_max_ge_elem _ _ _ (List.mem_map.mpr ⟨ri, hri, rfl⟩)
                    exact etypClosuresFullBounded_mono (hAllRs' ri hri).2.2 hri_le
                  exact ⟨hjPT.1,
                    ⟨hjPT.2, joinTypeResults_etypClosuresFullBounded ctx r rs' res res.nextTag'
                      hjoin (etypClosuresFullBounded_mono hR.2.2 hr1_le) hAllRs_clos⟩⟩
          | externVal _id typ poison pred =>
              obtain ⟨_, tagMapping, nextTag', resolvedPred, surfResult, halloc, hresolve, hsurf,
                rfl⟩ := typecheckExternVal_ok_shape htc
              have hpredBound : predTagBounded nextTag' resolvedPred :=
                resolveSyntaxPred_predTagBounded pred ctx.varEnv ctx.bindEnv tagMapping
                  ctx.nextTag nextTag' resolvedPred halloc hresolve
              have hmono := collectAndAllocExternTags_nextTag_ge
                [pred] ctx.nextTag tagMapping nextTag' halloc
              have hmono := collectAndAllocExternTags_nextTag_ge
                [pred] ctx.nextTag tagMapping nextTag' halloc
              -- Analyze surfaceSpecToQTyp to determine memEnv and qualType
              unfold surfaceSpecToQTyp at hsurf
              cases typ with
              | int =>
                simp [pure, Except.pure, bind, Except.bind] at hsurf; cases hsurf
                exact ⟨predTagsBoundedInMemEnv_mono hpred.2 hmono, hpredBound, trivial⟩
              | bool =>
                simp [pure, Except.pure, bind, Except.bind] at hsurf; cases hsurf
                exact ⟨predTagsBoundedInMemEnv_mono hpred.2 hmono, hpredBound, trivial⟩
              | unit =>
                simp [pure, Except.pure, bind, Except.bind] at hsurf; cases hsurf
                exact ⟨predTagsBoundedInMemEnv_mono hpred.2 hmono, hpredBound, trivial⟩
              | string =>
                simp [pure, Except.pure, bind, Except.bind] at hsurf; cases hsurf
                exact ⟨predTagsBoundedInMemEnv_mono hpred.2 hmono, hpredBound, trivial⟩
              | ref t =>
                simp [bind, Except.bind] at hsurf
              | arrow _ _ =>
                simp [bind, Except.bind] at hsurf

lemma typecheckExpr_preserves_predTagsBounded
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx) :
    predTagsBoundedInMemEnv res.memEnv' res.nextTag' ∧
    qtypPredTagBounded res.qualType res.nextTag' :=
  let h := typecheckExpr_preserves_combined_main ctx e fuel res htc hpred hclosure
  ⟨h.1, h.2.1⟩

/-- Public accessor for the result qtyp's closure-tag bound (third component of the combined
    preservation).  Used to bound captured environments of closures in extern application proofs. -/
lemma typecheckExpr_preserves_qualType_closures_bounded
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx) :
    etypClosuresFullBounded res.qualType.etyp res.nextTag' :=
  (typecheckExpr_preserves_combined_main ctx e fuel res htc hpred hclosure).2.2

private lemma predTagsBoundedInCtx_of_updateCtxFromResult
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (r : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok r)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx) :
    predTagsBoundedInCtx (updateCtxFromResult ctx r) :=
  ⟨predTagsBoundedInVarEnv_mono hpred.1
      (typecheck_normal_nextTag_mono ctx e fuel r htc),
   (typecheckExpr_preserves_predTagsBounded ctx e fuel r htc hpred hclosure).1⟩

/-- typecheckExpr preserves etypClosuresFullBounded.
    All closures in the result ETyp have fully bounded captured environments.
    A projection from the combined induction (`typecheckExpr_preserves_combined_main`). -/
lemma typecheckExpr_preserves_closureCapturedBounded
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx) :
    etypClosuresFullBounded res.qualType.etyp res.nextTag' :=
  (typecheckExpr_preserves_combined_main ctx e fuel res htc hpred hclosure).2.2

/-- Monotonicity of tagEnvBounded under larger nextTag. -/
lemma tagEnvBounded_mono (tagEnv : TagEnv) (nt nt' : Tag)
    (hb : tagEnvBounded tagEnv nt) (hle : nt ≤ nt') : tagEnvBounded tagEnv nt' := by
  intro k hk
  exact Nat.lt_of_lt_of_le (hb k hk) hle

/-- invalidateTagDeps only removes entries; the bound is preserved. -/
private lemma invalidateTagDeps_preserves_tagEnvBounded (te : TagEnv) (ls : LocSet) (nt : Tag)
    (hb : tagEnvBounded te nt) : tagEnvBounded (invalidateTagDeps te ls) nt := by
  intro k hk
  apply hb
  intro hte
  apply hk
  unfold invalidateTagDeps
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_filter]
  -- te[k]?.pfilter f = none because te[k]? = none
  have hk' : te[k]? = none := by simpa [Std.ExtTreeMap.get?_eq_getElem?] using hte
  rw [hk']
  simp [Option.pfilter]

/-- joinTagEnvs only keeps entries present in env1 (since all cases with otv1=none → none). -/
private lemma joinTagEnvs_get_none_of_left_none
    (env1 env2 : TagEnv) (k : Tag)
    (h1 : env1.get? k = none) :
    (joinTagEnvs env1 env2).get? k = none := by
  -- The join function f returns none when otv1 = none (all pattern cases)
  -- So if env1[k]? = none, (joinTagEnvs env1 env2)[k]? = none
  classical
  let ks := (env1.keys ++ env2.keys).eraseDups
  let f : Tag → Option TagVal → Option TagVal → Option TagVal :=
    fun _ otv1 otv2 =>
      match otv1, otv2 with
      | some { value := b1, deps := deps1 }, some { value := b2, deps := deps2 } =>
        if (b1 == b2) = true then some { value := b1, deps := deps1.union deps2 } else none
      | some _, none => none
      | none, some _ => none
      | none, none => none
  have hjoin_eq : joinTagEnvs env1 env2 = combineExtTreeMaps env1 env2 f := rfl
  rw [hjoin_eq, Std.ExtTreeMap.get?_eq_getElem?, combineExtTreeMaps]
  by_cases hmem : k ∈ ks
  · have hgo := combineExtTreeMaps_go_get_mem env1 env2 f ks ({} : TagEnv) k hmem
    simp only [f] at hgo ⊢
    rw [hgo, h1]
    cases ExtTreeMap.get? env2 k <;> simp
  · have hgo := combineExtTreeMaps_go_get_not_mem env1 env2 f ks ({} : TagEnv) k hmem
    simp only [f] at hgo ⊢
    rw [hgo]
    simp

/-- joinTagEnvs preserves tagEnvBounded for the left argument's bound. -/
private lemma joinTagEnvs_preserves_tagEnvBounded
    (env1 env2 : TagEnv) (nt : Tag)
    (hb : tagEnvBounded env1 nt) :
    tagEnvBounded (joinTagEnvs env1 env2) nt := by
  intro k hk
  apply hb
  intro h1
  exact hk (joinTagEnvs_get_none_of_left_none env1 env2 k h1)

/-- typecheckVar preserves tagEnv (all branches return ctx.tagEnv). -/
private lemma typecheckVar_preserves_tagEnv_aux (ctx : TypeContext) (x : Name) (res : TypeResult) :
    typecheckVar ctx x = .ok res → res.tagEnv' = ctx.tagEnv := by
  intro htc
  unfold typecheckVar at htc
  cases h_lookup : ctx.varEnv.lookup x with
  | none => simp [h_lookup] at htc
  | some qt =>
      simp [h_lookup] at htc
      cases qt with
      | mk etyp poison pred =>
          cases pred with
          | noPred =>
              simp at htc
              -- htc : Except.ok {..., tagEnv' := ctx.tagEnv, ...} = Except.ok res
              exact (congrArg TypeResult.tagEnv' (Except.ok.inj htc)).symm
          | guardOnly k =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none :=
                        by simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      -- htc : {..., tagEnv' := ctx.tagEnv, ...} = res
                      exact (congrArg TypeResult.tagEnv' htc).symm
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ :=
                            by simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b <;> simp [pure, Except.pure] at htc <;>
                            exact (congrArg TypeResult.tagEnv' htc).symm
          | guardClosure k _ _ _ =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none :=
                        by simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      exact (congrArg TypeResult.tagEnv' htc).symm
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ :=
                            by simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b <;> simp [pure, Except.pure] at htc <;>
                            exact (congrArg TypeResult.tagEnv' htc).symm

/-- applyFnTClosure preserves tagEnvBounded when the input result is bounded. Takes an IH
    to avoid forward dependency on typecheckExpr_preserves_tagEnvBounded. -/
private lemma applyFnTClosure_tagEnvBounded_normal
  (tcl : FnTClosure) (ctx : TypeContext)
  (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheckExpr ctx' e' m = .ok res' → tagEnvBoundedInCtx ctx' →
        predTagsBoundedInCtx ctx' → closureEnvBoundedInCtx ctx' →
        tagEnvBounded res'.tagEnv' res'.nextTag')
  (hbound_r1 : tagEnvBounded r1.tagEnv' r1.nextTag')
  (hpred_r1 : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
  (henv_captured : match tcl with
    | .regular _ _ env => CapturedEnvFullBounded env r1.nextTag'
    | .extern _ _ _ _ env _ _ => CapturedEnvFullBounded env r1.nextTag')
  (hpred_argPred : predTagBounded r1.nextTag' argPred)
  (hclosure_arg : etypClosuresFullBounded argEtyp r1.nextTag') :
  applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
  tagEnvBounded r2.tagEnv' r2.nextTag' := by
  intro happly
  unfold applyFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ fuel' =>
    cases tcl with
    | regular x body env =>
        simp [bind, Except.bind] at happly
        rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
          <;> rw [htc] at happly <;> simp at happly
        rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
        simp [hqt] at happly
        cases hsub : isErasureOf st2 _ with
        | false => rw [hsub] at happly; simp at happly
        | true =>
            rw [hsub] at happly
            simp [pure, Except.pure] at happly
            subst r2
            set ctx'' : TypeContext := {
              pc := joinPoison p (joinPoison p1 ctx.pc),
              regime := r1.regime',
              memEnv := r1.memEnv',
              varEnv := (VarTypeEnv.ofCaptured env).update x
                  { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred },
              bindEnv := BindEnv.bindParam env x r1.nextBind', tagEnv := r1.tagEnv',
              nextLoc := r1.nextLoc',
              nextTag := r1.nextTag', nextBind := r1.nextBind' + 1,
              pureCtx := ctx.pureCtx,
              externRegime := ctx.externRegime,
              externRefAllowed := false,
              declaredExternRefs := r1.declared' } with hctx''
            have htc' : typecheckExpr ctx'' body fuel' = .ok r := by simpa [hctx''] using htc
            exact IH fuel' (Nat.lt_succ_self fuel') body ctx'' r htc'
              (by simp only [tagEnvBoundedInCtx, hctx'']; exact hbound_r1)
              (by simp only [predTagsBoundedInCtx, hctx'']
                  constructor
                  · intro v qt' hlookup
                    simp [VarTypeEnv.update, VarTypeEnv.lookup] at hlookup
                    rw [Std.ExtTreeMap.getElem?_insert] at hlookup
                    split at hlookup
                    · simp at hlookup; subst qt'; exact hpred_argPred
                    · exact predTagsBoundedInVarEnv_ofCaptured
                        (capturedPredTagsBounded_of_fullBounded henv_captured) v qt'
                        (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)
                  · exact hpred_r1)
              (by simp only [closureEnvBoundedInCtx, hctx'']
                  exact varEnvClosuresCapturedBounded_update
                    (varEnvClosuresCapturedBounded_ofCaptured henv_captured) hclosure_arg)
    | extern id x retSpec effects capturedEnv declaredArgQt captures =>
        simp [bind, Except.bind, pure, Except.pure] at happly
        -- Leading argument-condition gate: throw branch is impossible on .ok.
        split at happly
        · simp at happly
        split at happly
        · simp at happly
        · rename_i heq'
          have htag := collectAndAllocExternTags_nextTag_ge _ _ _ _ heq'
          split at happly
          · simp at happly
          · split at happly
            · split at happly
              · simp at happly
              · rename_i resolvedPred hresolve
                split at happly
                · simp at happly
                · split at happly
                  · exact nomatch happly
                  simp only [Except.ok.injEq] at happly; rw [← happly]; simp only []
                  -- The invalidated input tagEnv stays below `r1.nextTag' ≤ nt'`;
                  -- the freshly installed return guard is below `nt'` by the
                  -- mapping freshness bound.
                  intro k hk
                  rcases Option.ne_none_iff_exists'.mp hk with ⟨tv, htv⟩
                  rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv htv with
                    htv1 | ⟨_hR, _eff, _heff, an, pb, ve, hres⟩
                  · rcases installReturnGuard_get?_cases _ _ _ _ k tv htv1 with hold | ⟨_hR, an, pb, ve, hrp⟩
                    · exact Nat.lt_of_lt_of_le
                        (hbound_r1 k (invalidateTagDeps_get?_ne_none_imp _ _ k
                          (Option.ne_none_iff_exists'.mpr ⟨tv, hold⟩))) htag
                    · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                        _ _ _ _ resolvedPred hresolve k an pb ve hrp
                      exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ heq' idx k hidx
                  · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                      _ _ _ _ _ hres k an pb ve rfl
                    exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ heq' idx k hidx
            · split at happly
              · simp at happly
              · next v hresolve =>
                have hresolve_tag : v.2 = _ := resolveArgCondQTyp_snd hresolve
                split at happly
                · exact nomatch happly
                simp only [Except.ok.injEq] at happly; rw [← happly]; simp only []
                rw [hresolve_tag]
                intro k hk
                rcases Option.ne_none_iff_exists'.mp hk with ⟨tv, htv⟩
                rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv htv with
                  hold | ⟨_hR, _eff, _heff, an, pb, ve, hres⟩
                · exact Nat.lt_of_lt_of_le
                    (hbound_r1 k (invalidateTagDeps_get?_ne_none_imp _ _ k
                      (Option.ne_none_iff_exists'.mpr ⟨tv, hold⟩))) htag
                · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                    _ _ _ _ _ hres k an pb ve rfl
                  exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ heq' idx k hidx
            · split at happly
              · simp at happly
              · next v hresolve =>
                have hresolve_tag : v.2 = _ := resolveArgCondQTyp_snd hresolve
                split at happly
                · exact nomatch happly
                simp only [Except.ok.injEq] at happly; rw [← happly]; simp only []
                rw [hresolve_tag]
                intro k hk
                rcases Option.ne_none_iff_exists'.mp hk with ⟨tv, htv⟩
                rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv htv with
                  hold | ⟨_hR, _eff, _heff, an, pb, ve, hres⟩
                · exact Nat.lt_of_lt_of_le
                    (hbound_r1 k (invalidateTagDeps_get?_ne_none_imp _ _ k
                      (Option.ne_none_iff_exists'.mpr ⟨tv, hold⟩))) htag
                · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                    _ _ _ _ _ hres k an pb ve rfl
                  exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ heq' idx k hidx

/-- applyPFnTClosure preserves tagEnvBounded when the input result is bounded. Takes an IH
    to avoid forward dependency on typecheckExpr_preserves_tagEnvBounded. -/
private lemma applyPFnTClosure_tagEnvBounded_normal
  (tcl : PFnTClosure) (ctx : TypeContext)
  (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheckExpr ctx' e' m = .ok res' → tagEnvBoundedInCtx ctx' →
        predTagsBoundedInCtx ctx' → closureEnvBoundedInCtx ctx' →
        tagEnvBounded res'.tagEnv' res'.nextTag')
  (hbound_r1 : tagEnvBounded r1.tagEnv' r1.nextTag')
  (hpred_r1 : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
  (henv_captured : match tcl with
    | .regular _ _ env => CapturedEnvFullBounded env r1.nextTag'
    | .extern _ _ _ env _ _ => CapturedEnvFullBounded env r1.nextTag')
  (hpred_argPred : predTagBounded r1.nextTag' argPred)
  (hclosure_arg : etypClosuresFullBounded argEtyp r1.nextTag') :
  applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
  tagEnvBounded r2.tagEnv' r2.nextTag' := by
  intro happly
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ fuel' =>
    cases tcl with
    | regular x body env =>
        simp [bind, Except.bind] at happly
        rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
          <;> rw [htc] at happly <;> simp at happly
        rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
        simp [hqt] at happly
        cases hsub : isErasureOf st2 _ with
        | false => rw [hsub] at happly; simp at happly
        | true =>
            rw [hsub] at happly
            simp [pure, Except.pure] at happly
            subst r2
            set ctx'' : TypeContext := {
              pc := joinPoison p (joinPoison ctx.pc p1),
              regime := r1.regime',
              memEnv := r1.memEnv',
              varEnv := (VarTypeEnv.ofCaptured env).update x
                  { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred },
              bindEnv := BindEnv.bindParam env x r1.nextBind', tagEnv := r1.tagEnv',
              nextLoc := r1.nextLoc',
              nextTag := r1.nextTag', nextBind := r1.nextBind' + 1,
              pureCtx := true,
              externRegime := ctx.externRegime,
              externRefAllowed := false,
              declaredExternRefs := r1.declared' } with hctx''
            have htc' : typecheckExpr ctx'' body.toExpr fuel' = .ok r := by simpa [hctx''] using htc
            exact IH fuel' (Nat.lt_succ_self fuel') body.toExpr ctx'' r htc'
              (by simp only [tagEnvBoundedInCtx, hctx'']; exact hbound_r1)
              (by simp only [predTagsBoundedInCtx, hctx'']
                  constructor
                  · intro v qt' hlookup
                    simp [VarTypeEnv.update, VarTypeEnv.lookup] at hlookup
                    rw [Std.ExtTreeMap.getElem?_insert] at hlookup
                    split at hlookup
                    · simp at hlookup; subst qt'; exact hpred_argPred
                    · exact predTagsBoundedInVarEnv_ofCaptured
                        (capturedPredTagsBounded_of_fullBounded henv_captured) v qt'
                        (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)
                  · exact hpred_r1)
              (by simp only [closureEnvBoundedInCtx, hctx'']
                  exact varEnvClosuresCapturedBounded_update
                    (varEnvClosuresCapturedBounded_ofCaptured henv_captured) hclosure_arg)
    | extern id x retSpec capturedEnv declaredArgQt captures =>
        simp [bind, Except.bind] at happly
        -- Leading argument-condition gate: throw branch is impossible on .ok.
        split at happly
        · simp at happly
        simp only [pure, Except.pure] at happly
        split at happly
        · -- simple case
          split at happly
          · simp at happly
          · rename_i heq'
            have htag := collectAndAllocExternTags_nextTag_ge _ _ _ _ heq'
            split at happly
            · simp at happly
            · rename_i resolvedPred hresolve
              split at happly
              · simp at happly
              · split at happly
                · exact nomatch happly
                simp only [Except.ok.injEq] at happly; rw [← happly]; simp only []
                -- The input tagEnv stays below `r1.nextTag' ≤ nt'`; the
                -- freshly installed return guard is below `nt'` by mapping freshness.
                intro k hk
                rcases Option.ne_none_iff_exists'.mp hk with ⟨tv, htv⟩
                rcases installReturnGuard_get?_cases _ _ _ _ k tv htv with hold | ⟨_hR, an, pb, ve, hrp⟩
                · exact Nat.lt_of_lt_of_le
                    (hbound_r1 k (Option.ne_none_iff_exists'.mpr ⟨tv, hold⟩)) htag
                · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                    _ _ _ _ resolvedPred hresolve k an pb ve hrp
                  exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ heq' idx k hidx
        · -- nestedFn case
          split at happly
          · simp at happly
          · next v hresolve =>
            have hresolve_tag : v.2 = r1.nextTag' := resolveArgCondQTyp_snd hresolve
            simp only [Except.ok.injEq] at happly; rw [← happly]
            simp only []; rw [hresolve_tag]; exact hbound_r1
        · -- nestedPfn case
          split at happly
          · simp at happly
          · next v hresolve =>
            have hresolve_tag : v.2 = r1.nextTag' := resolveArgCondQTyp_snd hresolve
            simp only [Except.ok.injEq] at happly; rw [← happly]
            simp only []; rw [hresolve_tag]; exact hbound_r1

/-- joinTypeResults preserves tagEnvBounded from the first result's bound. -/
private lemma joinTypeResults_tagEnvBounded
    (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) (nt : Tag)
    (hjoin : joinTypeResults ctx r rs = .ok res)
    (hbound : tagEnvBounded r.tagEnv' nt) :
    tagEnvBounded res.tagEnv' nt := by
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_tagEnv :
      ∀ (rss : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rss = Except.ok acc' →
        tagEnvBounded acc.2.2.2.2.1 nt →
        tagEnvBounded acc'.2.2.2.2.1 nt := by
    intro rss acc acc' h hb
    induction rss generalizing acc with
    | nil => simp [List.foldlM_nil, pure, Except.pure] at h; rw [← h]; exact hb
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at h
            apply ih _ h
            intro k hk; apply hb; intro hnone; apply hk
            classical
            let ks := (acc.2.2.2.2.1.keys ++ x.tagEnv'.keys).eraseDups
            let f : Tag → Option TagVal → Option TagVal → Option TagVal :=
              fun _ otv1 otv2 => match otv1, otv2 with
                | some { value := b1, deps := deps1 }, some { value := b2, deps := deps2 } =>
                  if (b1 == b2) = true then some { value := b1, deps := deps1.union deps2 } else none
                | some _, none => none | none, some _ => none | none, none => none
            have hjoin_eq : joinTagEnvs acc.2.2.2.2.1 x.tagEnv' = combineExtTreeMaps acc.2.2.2.2.1 x.tagEnv' f := rfl
            rw [hjoin_eq, Std.ExtTreeMap.get?_eq_getElem?, combineExtTreeMaps]
            by_cases hmem : k ∈ ks
            · have hgo := combineExtTreeMaps_go_get_mem acc.2.2.2.2.1 x.tagEnv' f ks ({} : TagEnv) k hmem
              simp only [f] at hgo ⊢; rw [hgo, hnone]
              cases Std.ExtTreeMap.get? x.tagEnv' k <;> simp
            · have hgo := combineExtTreeMaps_go_get_not_mem acc.2.2.2.2.1 x.tagEnv' f ks ({} : TagEnv) k hmem
              simp only [f] at hgo ⊢; rw [hgo]; simp
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe,
            MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err => erw [hcheck] at hjoin; simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin; simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err => erw [hfold] at hjoin; simp at hjoin
          | ok a =>
              erw [hfold] at hjoin; simp at hjoin
              subst res; simp
              exact h_fold_tagEnv rs _ _ hfold hbound

/-- typecheckApp preserves tagEnvBounded. Takes an IH to avoid forward reference. -/
private lemma typecheckApp_tagEnvBounded_normal (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat)
    (res : TypeResult) (hbound : tagEnvBoundedInCtx ctx)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheckExpr ctx' e' m = .ok res' → tagEnvBoundedInCtx ctx' →
          predTagsBoundedInCtx ctx' → closureEnvBoundedInCtx ctx' →
          tagEnvBounded res'.tagEnv' res'.nextTag') :
    typecheckApp ctx e1 e2 fuel = .ok res →
    tagEnvBounded res.tagEnv' res.nextTag' := by
  intro htc
  unfold typecheckApp at htc
  cases fuel <;> simp at htc
  rename_i fuel'
  simp [bind, Except.bind] at htc
  rcases hcte2 : typecheckExpr ctx e2 _ with _ | ⟨res2⟩
    <;> rw [hcte2] at htc <;> simp at htc
  rcases hq2 : res2.qualType with ⟨etyp2, poison2, pred2⟩
  simp [hq2] at htc
  set ctx' : TypeContext := {
    pc := ctx.pc,
    regime := res2.regime',
    memEnv := res2.memEnv',
    varEnv := ctx.varEnv,
    bindEnv := ctx.bindEnv, tagEnv := res2.tagEnv',
    nextLoc := res2.nextLoc',
    nextTag := res2.nextTag', nextBind := res2.nextBind',
    pureCtx := ctx.pureCtx,
    externRegime := ctx.externRegime,
    externRefAllowed := ctx.externRefAllowed,
    declaredExternRefs := res2.declared' } with hctx'
  rcases htce1 : typecheckExpr ctx' e1 _ with _ | ⟨res1⟩
    <;> rw [htce1] at htc <;> simp at htc
  rcases hq1 : res1.qualType with ⟨etyp1, poison1, pred1⟩
  simp [hq1] at htc
  have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
  have IH' : ∀ m < fuel', ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheckExpr ctx' e' m = .ok res' → tagEnvBoundedInCtx ctx' →
      predTagsBoundedInCtx ctx' → closureEnvBoundedInCtx ctx' →
      tagEnvBounded res'.tagEnv' res'.nextTag' :=
    fun m hm e' ctx'' res' htc' hb hp hc => IH m (Nat.lt_trans hm h_fuel) e' ctx'' res' htc' hb hp hc
  have hbound2 : tagEnvBounded res2.tagEnv' res2.nextTag' :=
    IH fuel' h_fuel e2 ctx res2 hcte2 hbound hpred hclosure
  have hmono2 := typecheck_normal_nextTag_mono ctx e2 fuel' res2 hcte2
  have hpredCtx' : predTagsBoundedInCtx ctx' := by
    simp only [predTagsBoundedInCtx, hctx']
    exact ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono2,
           (typecheckExpr_preserves_predTagsBounded ctx e2 fuel' res2 hcte2 hpred hclosure).1⟩
  have hclosureCtx' : closureEnvBoundedInCtx ctx' :=
    by simp only [closureEnvBoundedInCtx, hctx']; exact varEnvClosuresCapturedBounded_mono hclosure hmono2
  have hbound1 : tagEnvBounded res1.tagEnv' res1.nextTag' :=
    IH fuel' h_fuel e1 ctx' res1 htce1
      (by simp only [tagEnvBoundedInCtx, hctx']; exact hbound2)
      hpredCtx' hclosureCtx'
  rcases etyp1 with _ | _ | _ | _ | _ | ⟨t1, t2, p, fs⟩ | _
    <;> simp at htc
  · rcases hctxPure : ctx.pureCtx <;> simp [hctxPure] at htc
    rcases fs with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf t1 _
      <;> rw [hsub1] at htc <;> simp at htc
    rcases happly :
        applyFnTClosureAtCursor f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyFnTClosureAtCursor tcl t1 t2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
        res = { joined with tagLog' := L } := by
      cases hj : joinTypeResults ctx r rs' with
      | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, _, rfl, htc.symm⟩
    -- Get combined IH results for closure/pred evidence
    have hIH1_combined := typecheckExpr_preserves_combined_main ctx' e1 fuel' res1 htce1 hpredCtx' hclosureCtx'
    have hIH2_combined := typecheckExpr_preserves_combined_main ctx e2 fuel' res2 hcte2 hpred hclosure
    have hIH1_clos := hIH1_combined.2.2; simp [hq1] at hIH1_clos
    have hcapt_f := hIH1_clos f (List.Mem.head _)
    have hpred2_bound : predTagBounded res1.nextTag' pred2 := by
      have := hIH2_combined.2.1; simp [qtypPredTagBounded, hq2] at this
      exact predTagBounded_mono this (typecheck_normal_nextTag_mono ctx' e1 fuel' res1 htce1)
    have hclosure_arg : etypClosuresFullBounded etyp2 res1.nextTag' := by
      have h2 := hIH2_combined.2.2; simp [hq2] at h2
      exact etypClosuresFullBounded_mono h2 (typecheck_normal_nextTag_mono ctx' e1 fuel' res1 htce1)
    have hbound_r : tagEnvBounded r.tagEnv' r.nextTag' :=
      applyFnTClosure_tagEnvBounded_normal f ctx t1 t2 p poison1 etyp2 poison2 pred2 res1 r fuel' IH'
        hbound1 hIH1_combined.1 hcapt_f hpred2_bound hclosure_arg
        (by
          unfold applyFnTClosure
          unfold applyFnTClosureAtCursor at happly
          simpa using happly)
    have hboundJoin : tagEnvBounded res.tagEnv' r.nextTag' :=
      joinTypeResults_tagEnvBounded ctx r rs' res r.nextTag' hjoin hbound_r
    have h_join_next : res.nextTag' =
        List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      joinTypeResults_nextTag_eq_max ctx r rs' res hjoin
    have h_r_le_max : r.nextTag' ≤
        List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) := by
      simpa [List.max] using foldl_max_ge_init r.nextTag' (rs'.map TypeResult.nextTag')
    intro k hk
    exact Nat.lt_of_lt_of_le (hboundJoin k hk) (h_join_next ▸ h_r_le_max)
  · rename_i st1 st2 p tcls
    rcases tcls with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf st1 _
      <;> rw [hsub1] at htc <;> simp at htc
    rcases happly :
        applyPFnTClosureAtCursor f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyPFnTClosureAtCursor tcl st1 st2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
        res = { joined with tagLog' := L } := by
      cases hj : joinTypeResults ctx r rs' with
      | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, _, rfl, htc.symm⟩
    have hbound_r : tagEnvBounded r.tagEnv' r.nextTag' :=
      by
        have hIH1_combined := typecheckExpr_preserves_combined_main ctx' e1 fuel' res1 htce1 hpredCtx' hclosureCtx'
        have hIH2_combined := typecheckExpr_preserves_combined_main ctx e2 fuel' res2 hcte2 hpred hclosure
        have hIH1_clos := hIH1_combined.2.2; simp [hq1] at hIH1_clos
        have hcapt_f := hIH1_clos f (List.Mem.head _)
        have hpred2_bound : predTagBounded res1.nextTag' pred2 := by
          have := hIH2_combined.2.1; simp [qtypPredTagBounded, hq2] at this
          exact predTagBounded_mono this (typecheck_normal_nextTag_mono ctx' e1 fuel' res1 htce1)
        have hclosure_arg : etypClosuresFullBounded etyp2 res1.nextTag' := by
          have h2 := hIH2_combined.2.2; simp [hq2] at h2
          exact etypClosuresFullBounded_mono h2 (typecheck_normal_nextTag_mono ctx' e1 fuel' res1 htce1)
        exact applyPFnTClosure_tagEnvBounded_normal f ctx st1 st2 p poison1 etyp2 poison2 pred2 res1 r fuel' IH'
          hbound1 hIH1_combined.1 hcapt_f hpred2_bound hclosure_arg
          (by
            unfold applyPFnTClosure
            unfold applyPFnTClosureAtCursor at happly
            simpa using happly)
    have hboundJoin : tagEnvBounded res.tagEnv' r.nextTag' :=
      joinTypeResults_tagEnvBounded ctx r rs' res r.nextTag' hjoin hbound_r
    have h_join_next : res.nextTag' =
        List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      joinTypeResults_nextTag_eq_max ctx r rs' res hjoin
    have h_r_le_max : r.nextTag' ≤
        List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) := by
      simpa [List.max] using foldl_max_ge_init r.nextTag' (rs'.map TypeResult.nextTag')
    intro k hk
    exact Nat.lt_of_lt_of_le (hboundJoin k hk) (h_join_next ▸ h_r_le_max)

/-- The main induction: typecheckExpr preserves tagEnvBounded. -/
private lemma typecheckExpr_preserves_tagEnvBounded_main :
    ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
    typecheckExpr ctx e fuel = .ok res →
    tagEnvBoundedInCtx ctx →
    predTagsBoundedInCtx ctx →
    closureEnvBoundedInCtx ctx →
    tagEnvBounded res.tagEnv' res.nextTag' := by
  intro ctx e fuel res htc hbound hpred hclosure
  revert ctx e res htc hbound hpred hclosure
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
      intro ctx e res htc hbound hpred hclosure
      have IH_fuel : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheckExpr ctx' e' m = .ok res' →
          tagEnvBoundedInCtx ctx' →
          predTagsBoundedInCtx ctx' →
          closureEnvBoundedInCtx ctx' →
          tagEnvBounded res'.tagEnv' res'.nextTag' :=
        fun m h_lt e' ctx' res' htc' hbound' hpred' hclosure' => IH m h_lt ctx' e' res' htc' hbound' hpred' hclosure'
      cases fuel with
      | zero => simp [typecheckExpr] at htc
      | succ fuel' =>
          unfold typecheckExpr at htc
          unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
          cases e with
          | num _n | bool _b | unit | str _s =>
              simp at htc; cases htc; exact hbound
          | var x =>
              have hnext := typecheckVar_preserves_nextTag ctx x res htc
              have htagEnv : res.tagEnv' = ctx.tagEnv :=
                typecheckVar_preserves_tagEnv_aux ctx x res htc
              rw [htagEnv, hnext]; exact hbound
          | fn _x _st1 _body _st2 =>
              have hfn := typecheckFn_ok_eq htc; subst hfn; exact hbound
          | pfn _x _st1 _body _st2 =>
              simp [typecheckPfn, Bind.bind, Except.bind] at htc
              cases h_topexpr : _body.toPExpr with
              | error _ => simp [h_topexpr] at htc
              | ok _ => simp [h_topexpr] at htc; cases htc; exact hbound
          | externVal _id typ poison pred =>
              obtain ⟨_, tagMapping, nextTag', resolvedPred, _, halloc, hresolve, _, rfl⟩ :=
                typecheckExternVal_ok_shape htc
              have hmono := collectAndAllocExternTags_nextTag_ge [pred] ctx.nextTag tagMapping
                nextTag' halloc
              -- The input tag environment stays below `ctx.nextTag ≤ nextTag'`; the
              -- installed guard is below `nextTag'` by the mapping freshness bound.
              intro k hk
              rcases Option.ne_none_iff_exists'.mp hk with ⟨tv, htv⟩
              rcases installReturnGuard_get?_cases _ _ _ _ k tv htv with hold | ⟨_hR, an, pb, ve, hrp⟩
              · exact Nat.lt_of_lt_of_le (hbound k (Option.ne_none_iff_exists'.mpr ⟨tv, hold⟩)) hmono
              · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                  _ _ _ _ resolvedPred hresolve k an pb ve hrp
                exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ halloc idx k hidx
          | externFn _id _arg _argTyp _argPoison _argPred _retSpec _effects =>
              have hpres := typecheckExternFn_preserves_nextTag ctx _id _arg _argTyp _argPoison _argPred _retSpec _effects res htc
              have htagEnv : res.tagEnv' = ctx.tagEnv := by
                obtain ⟨argQt, _, hres⟩ :=
                  typecheckExternFn_ok_res_eq ctx _id _arg _argTyp _argPoison _argPred _retSpec _effects res htc
                rw [hres]
              rw [htagEnv, hpres]; exact hbound
          | externPfn _id _arg _argTyp _argPoison _argPred _retSpec _captures =>
              have hpres := typecheckExternPfn_preserves_nextTag ctx _id _arg _argTyp _argPoison _argPred _retSpec res htc
              have htagEnv : res.tagEnv' = ctx.tagEnv := by
                obtain ⟨argQt, _, hres⟩ :=
                  typecheckExternPfn_ok_res_eq ctx _id _arg _argTyp _argPoison _argPred _retSpec res htc
                rw [hres]
              rw [htagEnv, hpres]; exact hbound
          | externRef _id _rp _rpred _cp _cpred =>
              simp at htc
              have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
              subst hres
              exact tagEnvBounded_mono ctx.tagEnv ctx.nextTag ctx.nextTag hbound (Nat.le_refl _)
          | unaryop op e1 =>
              -- htc : typecheckUnaryOp ctx op e1 fuel' = .ok res
              unfold typecheckUnaryOp at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      cases hop : opUnaryEType? op etyp1 with
                      | none => simp [hop] at htc
                      | some outType =>
                          simp [hop, pure, Except.pure] at htc; cases htc
                          have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                            simpa [typecheck] using hte1
                          have h_lt : fuel'' < fuel' + 1 := by omega
                          exact IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
          | op e1 _op e2 =>
              -- htc : typecheckOp ctx e1 e2 fuel' _op = .ok res
              unfold typecheckOp at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      let ctx' : TypeContext := updateCtxFromResult ctx r1
                      cases hte2 : typecheckExpr ctx' e2 fuel'' with
                      | error err => erw [hte2] at htc; simp at htc
                      | ok r2 =>
                          erw [hte2] at htc
                          rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                          simp [hq2] at htc
                          cases hop : opEType? _op etyp1 etyp2 with
                          | none => simp [hop] at htc
                          | some outType =>
                              simp [hop, pure, Except.pure] at htc; cases htc
                              have h_lt : fuel'' < fuel' + 1 := by omega
                              have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                                simpa [typecheck] using hte1
                              have hbound1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
                              have hte2' : typecheck ctx' e2 fuel'' = .ok r2 := by
                                simpa [typecheck, ctx'] using hte2
                              exact IH_fuel fuel'' h_lt e2 ctx' r2 hte2'
                                (by simp only [tagEnvBoundedInCtx, updateCtxFromResult, ctx']; exact hbound1)
                                (predTagsBoundedInCtx_of_updateCtxFromResult ctx e1 fuel'' r1
                                  (by simpa [typecheck] using hte1) hpred hclosure)
                                (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)
          | seq e1 e2 =>
              unfold typecheckSeq at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      let ctx' := updateCtxFromResult ctx r1
                      cases hte2 : typecheckExpr ctx' e2 fuel'' with
                      | error err => simp [hte2, ctx'] at htc
                      | ok r2 =>
                          simp [hte2, ctx'] at htc
                          have hres : { r2 with tagLog' := r1.tagLog' ++ r2.tagLog' } = res := by
                            simpa [pure, Except.pure] using htc
                          have h_lt : fuel'' < fuel' + 1 := by omega
                          have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                            simpa [typecheck] using hte1
                          have hbound1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
                          have hte2' : typecheck ctx' e2 fuel'' = .ok r2 := by
                            simpa [typecheck, ctx'] using hte2
                          have hbound2 := IH_fuel fuel'' h_lt e2 ctx' r2 hte2'
                            (by simp only [tagEnvBoundedInCtx, updateCtxFromResult, ctx']; exact hbound1)
                            (predTagsBoundedInCtx_of_updateCtxFromResult ctx e1 fuel'' r1
                              (by simpa [typecheck] using hte1) hpred hclosure)
                            (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)
                          simpa [← hres] using hbound2
          | vlet x e1 e2 =>
              unfold typecheckVlet at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  -- Handle all three predicate subcases for the outer vlet
                  -- Using a common proof pattern
                  have step_e1_e2 : ∀ (ctx1 : TypeContext),
                      ctx1.tagEnv = ctx.tagEnv → ctx1.nextTag = ctx.nextTag →
                      predTagsBoundedInCtx ctx1 →
                      closureEnvBoundedInCtx ctx1 →
                      ∀ r1 : TypeResult, typecheckExpr ctx1 e1 fuel'' = .ok r1 →
                      ∀ (ctx2 : TypeContext),
                      ctx2.tagEnv = r1.tagEnv' → ctx2.nextTag = r1.nextTag' →
                      predTagsBoundedInCtx ctx2 →
                      closureEnvBoundedInCtx ctx2 →
                      ∀ r2 : TypeResult, typecheckExpr ctx2 e2 fuel'' = .ok r2 →
                      r2.nextTag' = res.nextTag' → r2.tagEnv' = res.tagEnv' →
                      tagEnvBounded res.tagEnv' res.nextTag' := by
                    intro ctx1 hctx1Tag hctx1Next hpred1 hclosure1 r1 hte1
                      ctx2 hctx2Tag hctx2Next hpred2 hclosure2 r2 hte2 hresnext hresTag
                    have h_lt : fuel'' < fuel' + 1 := by omega
                    have hte1' : typecheck ctx1 e1 fuel'' = .ok r1 := by
                      simpa [typecheck] using hte1
                    have hbound1 := IH_fuel fuel'' h_lt e1 ctx1 r1 hte1'
                      (by simp only [tagEnvBoundedInCtx, hctx1Tag, hctx1Next]; exact hbound) hpred1 hclosure1
                    have hte2' : typecheck ctx2 e2 fuel'' = .ok r2 := by
                      simpa [typecheck] using hte2
                    have hbound2 := IH_fuel fuel'' h_lt e2 ctx2 r2 hte2'
                      (by simp only [tagEnvBoundedInCtx, hctx2Tag, hctx2Next]; exact hbound1) hpred2 hclosure2
                    simpa [hresnext, hresTag] using hbound2
                  cases hlookup : ctx.varEnv.lookup x with
                  | none =>
                      simp [hlookup] at htc
                      cases hte1 : typecheckExpr ctx e1 fuel'' with
                      | error err => simp [hte1] at htc
                      | ok r1 =>
                          simp [hte1] at htc
                          let ctxBase := updateCtxFromResult ctx r1
                          let ctx' : TypeContext := { ctxBase with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                          cases hte2 : typecheckExpr ctx' e2 fuel'' with
                          | error err => erw [hte2] at htc; simp at htc
                          | ok r2 =>
                              erw [hte2] at htc; simp at htc
                              rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                              simp [hq2, pure, Except.pure] at htc
                              have hpred_ctx2 : predTagsBoundedInCtx ctx' :=
                                ⟨predTagsBoundedInVarEnv_update
                                  (predTagsBoundedInVarEnv_mono hpred.1
                                    (typecheck_normal_nextTag_mono _ e1 _ r1 (by simpa [typecheck] using hte1)))
                                  ((typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).2),
                                 (typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).1⟩
                              have hclosure_ctx2 : closureEnvBoundedInCtx ctx' :=
                                varEnvClosuresCapturedBounded_update
                                  (closureEnvBoundedInCtx_of_update ctx e1 _ r1 hte1 hclosure)
                                  (typecheckExpr_preserves_closureCapturedBounded ctx e1 _ r1 hte1 hpred hclosure)
                              exact step_e1_e2 ctx rfl rfl hpred hclosure r1 hte1 ctx' rfl rfl hpred_ctx2 hclosure_ctx2 r2 hte2
                                (by simpa using congrArg TypeResult.nextTag' htc)
                                (by simpa using congrArg TypeResult.tagEnv' htc)
                  | some qtOuter =>
                      simp [hlookup] at htc
                      cases hpredOuter : qtOuter.pred with
                      | guardClosure k arg body env =>
                          simp [hpredOuter] at htc
                          by_cases hregSome : (ctx.regime.lookup? k).isSome = true
                          · simp [hregSome] at htc
                          · simp [hregSome] at htc
                            cases hte1 : typecheckExpr ctx e1 fuel'' with
                            | error err => simp [hte1] at htc
                            | ok r1 =>
                                simp [hte1] at htc
                                let ctxBase := updateCtxFromResult ctx r1
                                let ctx' : TypeContext := { ctxBase with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                                cases hte2 : typecheckExpr ctx' e2 fuel'' with
                                | error err => erw [hte2] at htc; simp at htc
                                | ok r2 =>
                                    erw [hte2] at htc; simp at htc
                                    rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                    simp [hq2, pure, Except.pure] at htc
                                    have hpred_ctx2 : predTagsBoundedInCtx ctx' :=
                                      ⟨predTagsBoundedInVarEnv_update
                                        (predTagsBoundedInVarEnv_mono hpred.1
                                          (typecheck_normal_nextTag_mono _ e1 _ r1 (by simpa [typecheck] using hte1)))
                                        ((typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).2),
                                       (typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).1⟩
                                    have hclosure_ctx2 : closureEnvBoundedInCtx ctx' :=
                                      varEnvClosuresCapturedBounded_update
                                        (closureEnvBoundedInCtx_of_update ctx e1 _ r1 hte1 hclosure)
                                        (typecheckExpr_preserves_closureCapturedBounded ctx e1 _ r1 hte1 hpred hclosure)
                                    exact step_e1_e2 ctx rfl rfl hpred hclosure r1 hte1 ctx' rfl rfl hpred_ctx2 hclosure_ctx2 r2 hte2
                                      (by simpa using congrArg TypeResult.nextTag' htc)
                                      (by simpa using congrArg TypeResult.tagEnv' htc)
                      | guardOnly k =>
                          simp [hpredOuter] at htc
                          cases hte1 : typecheckExpr ctx e1 fuel'' with
                          | error err => simp [hte1] at htc
                          | ok r1 =>
                              simp [hte1] at htc
                              let ctxBase := updateCtxFromResult ctx r1
                              let ctx' : TypeContext := { ctxBase with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                              cases hte2 : typecheckExpr ctx' e2 fuel'' with
                              | error err => erw [hte2] at htc; simp at htc
                              | ok r2 =>
                                  erw [hte2] at htc; simp at htc
                                  rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                  simp [hq2, pure, Except.pure] at htc
                                  have hpred_ctx2 : predTagsBoundedInCtx ctx' :=
                                    ⟨predTagsBoundedInVarEnv_update
                                      (predTagsBoundedInVarEnv_mono hpred.1
                                        (typecheck_normal_nextTag_mono _ e1 _ r1 (by simpa [typecheck] using hte1)))
                                      ((typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).2),
                                     (typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).1⟩
                                  have hclosure_ctx2 : closureEnvBoundedInCtx ctx' :=
                                    varEnvClosuresCapturedBounded_update
                                      (closureEnvBoundedInCtx_of_update ctx e1 _ r1 hte1 hclosure)
                                      (typecheckExpr_preserves_closureCapturedBounded ctx e1 _ r1 hte1 hpred hclosure)
                                  exact step_e1_e2 ctx rfl rfl hpred hclosure r1 hte1 ctx' rfl rfl hpred_ctx2 hclosure_ctx2 r2 hte2
                                    (by simpa using congrArg TypeResult.nextTag' htc)
                                    (by simpa using congrArg TypeResult.tagEnv' htc)
                      | noPred =>
                          simp [hpredOuter] at htc
                          cases hte1 : typecheckExpr ctx e1 fuel'' with
                          | error err => simp [hte1] at htc
                          | ok r1 =>
                              simp [hte1] at htc
                              let ctxBase := updateCtxFromResult ctx r1
                              let ctx' : TypeContext := { ctxBase with varEnv := ctx.varEnv.update x r1.qualType, bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                              cases hte2 : typecheckExpr ctx' e2 fuel'' with
                              | error err => erw [hte2] at htc; simp at htc
                              | ok r2 =>
                                  erw [hte2] at htc; simp at htc
                                  rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                                  simp [hq2, pure, Except.pure] at htc
                                  have hpred_ctx2 : predTagsBoundedInCtx ctx' :=
                                    ⟨predTagsBoundedInVarEnv_update
                                      (predTagsBoundedInVarEnv_mono hpred.1
                                        (typecheck_normal_nextTag_mono _ e1 _ r1 (by simpa [typecheck] using hte1)))
                                      ((typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).2),
                                     (typecheckExpr_preserves_predTagsBounded _ e1 _ r1 hte1 hpred hclosure).1⟩
                                  have hclosure_ctx2 : closureEnvBoundedInCtx ctx' :=
                                    varEnvClosuresCapturedBounded_update
                                      (closureEnvBoundedInCtx_of_update ctx e1 _ r1 hte1 hclosure)
                                      (typecheckExpr_preserves_closureCapturedBounded ctx e1 _ r1 hte1 hpred hclosure)
                                  exact step_e1_e2 ctx rfl rfl hpred hclosure r1 hte1 ctx' rfl rfl hpred_ctx2 hclosure_ctx2 r2 hte2
                                    (by simpa using congrArg TypeResult.nextTag' htc)
                                    (by simpa using congrArg TypeResult.tagEnv' htc)
          | newRef e1 =>
              unfold typecheckNewRef at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      by_cases hInt : etyp1 = ETyp.int
                      · simp [hInt, freshTLocRes, pure, Except.pure] at htc; cases htc
                        have h_lt : fuel'' < fuel' + 1 := by omega
                        have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                          simpa [typecheck] using hte1
                        exact IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
                      · exfalso; simp [hInt] at htc
          | assign e1 e2 =>
              unfold typecheckAssign at htc
              cases hfuel : fuel' with
              | zero => simp [hfuel] at htc
              | succ fuel'' =>
                  rw [hfuel] at htc
                  simp [bind, Except.bind] at htc
                  cases hte1 : typecheckExpr ctx e1 fuel'' with
                  | error err => simp [hte1] at htc
                  | ok r1 =>
                      simp [hte1] at htc
                      rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
                      simp [hq1] at htc
                      cases etyp1 with
                      | int => simp at htc
                      | bool => simp at htc
                      | unit => simp at htc
                      | string => simp at htc
                      | arrow st1 st2 p tcls => simp at htc
                      | parrow st1 st2 p tcls => simp at htc
                      | ref ls =>
                          simp at htc
                          let ctx' : TypeContext := updateCtxFromResult ctx r1
                          cases hte2 : typecheckExpr ctx' e2 fuel'' with
                          | error err => erw [hte2] at htc; simp at htc
                          | ok r2 =>
                              erw [hte2] at htc; simp at htc
                              rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                              simp [hq2] at htc
                              by_cases hInt2 : etyp2 = ETyp.int
                              · simp [hInt2, pure, Except.pure] at htc
                                have hresnext : r2.nextTag' = res.nextTag' := by
                                  simpa using congrArg TypeResult.nextTag' htc
                                have hresTagInv : invalidateTagDeps r2.tagEnv' ls = res.tagEnv' := by
                                  simpa using congrArg TypeResult.tagEnv' htc
                                have h_lt : fuel'' < fuel' + 1 := by omega
                                have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by
                                  simpa [typecheck] using hte1
                                have hbound1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
                                have hte2' : typecheck ctx' e2 fuel'' = .ok r2 := by
                                  simpa [typecheck, ctx'] using hte2
                                have hbound2 := IH_fuel fuel'' h_lt e2 ctx' r2 hte2'
                                  (by simp only [tagEnvBoundedInCtx, updateCtxFromResult, ctx']; exact hbound1)
                                  (predTagsBoundedInCtx_of_updateCtxFromResult ctx e1 fuel'' r1
                                    (by simpa [typecheck] using hte1) hpred hclosure)
                                  (closureEnvBoundedInCtx_of_update ctx e1 _ r1 (by simpa [typecheck] using hte1) hclosure)
                                have hboundInv := invalidateTagDeps_preserves_tagEnvBounded
                                  r2.tagEnv' ls r2.nextTag' hbound2
                                rw [← hresTagInv, ← hresnext]; exact hboundInv
                              · exfalso; simp [hInt2] at htc
          | deref e1 =>
              -- Save original htc before unfolding for structure lemma
              have htc_deref : typecheckDeref ctx e1 fuel' = .ok res := by
                simpa [typecheckDeref] using htc
              cases hfuel : fuel' with
              | zero =>
                  simp [hfuel, typecheckDeref] at htc
              | succ fuel'' =>
                  have h_lt : fuel'' < fuel' + 1 := by omega
                  obtain ⟨r1, hte1, _, hte_eq, _, hnt_eq, _⟩ :=
                    typecheckDeref_structure ctx e1 (fuel'' + 1) res (by rwa [← hfuel])
                  simp only [Nat.add_sub_cancel] at hte1
                  have hte1' : typecheck ctx e1 fuel'' = .ok r1 := by simpa [typecheck] using hte1
                  have hbound1 := IH_fuel fuel'' h_lt e1 ctx r1 hte1' hbound hpred hclosure
                  rw [hte_eq, hnt_eq]; exact hbound1
          | ite e1 e2 e3 =>
              -- Convert htc to typecheckIf form
              have htcIf : typecheckIf ctx e1 e2 e3 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
              rcases typecheckIf_structure ctx e1 e2 e3 fuel' res htcIf with
                htrue | hfalse | hstd
              · -- Mode 1: matchGuard succeeds, R(k) = some true
                obtain ⟨k, deps, hmatch, _hR, _res1, _htc1, _, res2, res3, htc2, htc3,
                  _, hresTag, _, hresNext, _, _, _⟩ := htrue
                have hk_lt : k < ctx.nextTag :=
                  matchGuard_tag_bounded e1 ctx.memEnv ctx.varEnv ctx.bindEnv (fuel' - 1) k deps ctx.nextTag
                    hmatch hpred.1 hpred.2
                have hmono1 : ctx.nextTag ≤ _res1.nextTag' :=
                  typecheck_normal_nextTag_mono { ctx with pureCtx := true } e1 _ _res1 _htc1
                have hboundTrue : tagEnvBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := _res1.nextTag', nextBind := _res1.nextBind', declaredExternRefs := _res1.declared' } :=
                  tagEnvBounded_insert_of_lt ctx.tagEnv _res1.nextTag' k _
                    (tagEnvBounded_mono ctx.tagEnv ctx.nextTag _res1.nextTag' hbound hmono1)
                    (Nat.lt_of_lt_of_le hk_lt hmono1)
                have hpredTrue : predTagsBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := _res1.nextTag', nextBind := _res1.nextBind', declaredExternRefs := _res1.declared' } :=
                  ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono1,
                   predTagsBoundedInMemEnv_mono hpred.2 hmono1⟩
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                have hclosureTrue : closureEnvBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := _res1.nextTag', nextBind := _res1.nextBind', declaredExternRefs := _res1.declared' } :=
                  varEnvClosuresCapturedBounded_mono hclosure hmono1
                have hbound2 := IH_fuel (fuel' - 1) h_fuelm1 e2 _ res2 htc2 hboundTrue hpredTrue hclosureTrue
                rw [hresTag, hresNext]
                exact tagEnvBounded_mono _ res2.nextTag' _ hbound2 (Nat.le_max_left _ _)
              · -- Mode 2: matchGuard succeeds, R(k) = some false
                obtain ⟨k, deps, hmatch, _hR, _res1, _htc1, _, res2, res3, htc2, htc3,
                  _, hresTag, _, hresNext, _, _, _⟩ := hfalse
                have hk_lt : k < ctx.nextTag :=
                  matchGuard_tag_bounded e1 ctx.memEnv ctx.varEnv ctx.bindEnv (fuel' - 1) k deps ctx.nextTag
                    hmatch hpred.1 hpred.2
                have hmono2 : ctx.nextTag ≤ res2.nextTag' :=
                  Nat.le_trans
                    (typecheck_normal_nextTag_mono { ctx with pureCtx := true } e1 _ _res1 _htc1)
                    (typecheck_normal_nextTag_mono
                      { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := _res1.nextTag', nextBind := _res1.nextBind', declaredExternRefs := _res1.declared' } e2 _ res2 htc2)
                have hboundFalse : tagEnvBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                               nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind', declaredExternRefs := res2.declared' } := by
                  simp only [tagEnvBoundedInCtx]
                  exact tagEnvBounded_insert_of_lt ctx.tagEnv res2.nextTag' k _
                    (tagEnvBounded_mono ctx.tagEnv ctx.nextTag res2.nextTag' hbound hmono2)
                    (Nat.lt_of_lt_of_le hk_lt hmono2)
                have hpredFalse : predTagsBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                               nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind', declaredExternRefs := res2.declared' } :=
                  ⟨predTagsBoundedInVarEnv_mono hpred.1 hmono2,
                   predTagsBoundedInMemEnv_mono hpred.2 hmono2⟩
                have hclosureFalse : closureEnvBoundedInCtx
                    { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                               nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind', declaredExternRefs := res2.declared' } :=
                  varEnvClosuresCapturedBounded_mono hclosure hmono2
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                have hbound3 := IH_fuel (fuel' - 1) h_fuelm1 e3 _ res3 htc3 hboundFalse hpredFalse hclosureFalse
                rw [hresTag, hresNext]
                exact tagEnvBounded_mono _ res3.nextTag' _ hbound3 (Nat.le_max_right _ _)
              · -- Standard case: no known regime value, conservative join
                obtain ⟨_, res1, htc1, _hbool1, ⟨res2, htc2, ⟨res3, htc3, _, hresTagEnv,
                  _, hresNextTag, _, _, _, _⟩⟩⟩ := hstd
                -- ctxForE2 has tagEnv = res1.tagEnv', nextTag = res1.nextTag'
                -- ctxForE3 has tagEnv = res2.tagEnv', nextTag = res2.nextTag'
                -- (the structure lemma uses `let`-bound ctx', ctx'', ctxForE3)
                -- fuel' - 1 < fuel' + 1
                have h_fuelm1 : fuel' - 1 < fuel' + 1 := by omega
                -- Bound for res1 from ctx
                have hbound1 : tagEnvBounded res1.tagEnv' res1.nextTag' :=
                  IH_fuel (fuel' - 1) h_fuelm1 e1 ctx res1 htc1 hbound hpred hclosure
                -- Bound for res2: the context for e2 has tagEnv = res1.tagEnv', nextTag = res1.nextTag'
                have hbound2 : tagEnvBounded res2.tagEnv' res2.nextTag' := by
                  apply IH_fuel (fuel' - 1) h_fuelm1 e2 _ res2 htc2
                  · simp only [tagEnvBoundedInCtx]; exact hbound1
                  · exact ⟨predTagsBoundedInVarEnv_mono hpred.1
                      (typecheck_normal_nextTag_mono ctx e1 _ res1 htc1),
                    (typecheckExpr_preserves_predTagsBounded ctx e1 _ res1 htc1 hpred hclosure).1⟩
                  · exact closureEnvBoundedInCtx_of_update ctx e1 _ res1 htc1 hclosure
                -- res.tagEnv' = joinTagEnvs res2.tagEnv' res3.tagEnv'
                -- joinTagEnvs is bounded by res2's bound ≤ max res2 res3
                rw [hresTagEnv, hresNextTag]
                exact tagEnvBounded_mono _ res2.nextTag' _
                  (joinTagEnvs_preserves_tagEnvBounded res2.tagEnv' res3.tagEnv' res2.nextTag' hbound2)
                  (Nat.le_max_left _ _)
          | app e1 e2 =>
              have htcApp : typecheckApp ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              have IH_fuel' : ∀ m < fuel', ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
                  typecheckExpr ctx' e' m = .ok res' → tagEnvBoundedInCtx ctx' →
                  predTagsBoundedInCtx ctx' →
                  closureEnvBoundedInCtx ctx' →
                  tagEnvBounded res'.tagEnv' res'.nextTag' :=
                fun m hm e' ctx' res' htc' hb hp hc =>
                  IH_fuel m (Nat.lt_trans hm (Nat.lt_succ_self fuel')) e' ctx' res' htc' hb hp hc
              exact typecheckApp_tagEnvBounded_normal ctx e1 e2 fuel' res hbound hpred hclosure IH_fuel' htcApp

private lemma typecheckExpr_preserves_tagEnvBounded
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hbound : tagEnvBoundedInCtx ctx)
    (hpred : predTagsBoundedInCtx ctx)
    (hclosure : closureEnvBoundedInCtx ctx) :
    tagEnvBounded res.tagEnv' res.nextTag' :=
  typecheckExpr_preserves_tagEnvBounded_main ctx e fuel res htc hbound hpred hclosure

/-- TagBoundedCtx is preserved across typechecking for the ctxAfter pattern. -/
lemma typecheckExpr_preserves_TagBoundedCtx
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hb : TagBoundedCtx ctx) :
    TagBoundedCtx (ctxAfter ctx res) := by
  obtain ⟨hbound, hpred, hclosure⟩ := hb
  refine ⟨?_, ?_, ?_⟩
  · exact typecheckExpr_preserves_tagEnvBounded ctx e fuel res htc hbound hpred hclosure
  · constructor
    · exact predTagsBoundedInVarEnv_mono hpred.1
        (typecheck_normal_nextTag_mono ctx e fuel res (by simpa [typecheck] using htc))
    · exact (typecheckExpr_preserves_predTagsBounded ctx e fuel res htc hpred hclosure).1
  · exact varEnvClosuresCapturedBounded_mono hclosure
      (typecheck_normal_nextTag_mono ctx e fuel res (by simpa [typecheck] using htc))

/-- TagBoundedCtx is preserved when the varEnv is updated with the result's qualType.
    This is used by the vlet case to construct TagBoundedCtx for the intermediate context
    where the let-bound variable is added. -/
lemma typecheckExpr_TagBoundedCtx_varEnv_update
    (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (htc : typecheckExpr ctx e fuel = .ok res)
    (hb : TagBoundedCtx ctx)
    (x : Name) :
    TagBoundedCtx
      { ctxAfter ctx res with varEnv := ctx.varEnv.update x res.qualType, bindEnv := ctx.bindEnv.insert x res.nextBind', nextBind := res.nextBind' + 1 } := by
  obtain ⟨hbound, hpred, hclosure⟩ := hb
  have hmono := typecheck_normal_nextTag_mono ctx e fuel res (by simpa [typecheck] using htc)
  have hpredRes := (typecheckExpr_preserves_predTagsBounded ctx e fuel res htc hpred hclosure).2
  have hclosureRes := typecheckExpr_preserves_closureCapturedBounded ctx e fuel res htc hpred hclosure
  refine ⟨?_, ?_, ?_⟩
  · -- tagEnvBoundedInCtx: independent of varEnv
    exact typecheckExpr_preserves_tagEnvBounded ctx e fuel res htc hbound hpred hclosure
  · -- predTagsBoundedInCtx: varEnv component needs update
    constructor
    · exact predTagsBoundedInVarEnv_update (predTagsBoundedInVarEnv_mono hpred.1 hmono) hpredRes
    · exact (typecheckExpr_preserves_predTagsBounded ctx e fuel res htc hpred hclosure).1
  · -- closureEnvBoundedInCtx: varEnv component needs update
    exact varEnvClosuresCapturedBounded_update (varEnvClosuresCapturedBounded_mono hclosure hmono) hclosureRes

-- Helper lemmas for typecheck_nextLoc_mono proof

private lemma typecheckVar_nextLoc_mono (ctx : TypeContext) (x : Name) (res : TypeResult) :
  typecheckVar ctx x = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  unfold typecheckVar at htc
  cases h_lookup : ctx.varEnv.lookup x with
  | none =>
      simp [h_lookup] at htc
  | some qt =>
      simp [h_lookup] at htc
      cases qt with
      | mk etyp poison pred =>
          cases pred with
          | noPred =>
              simp at htc
              injection htc with h_eq
              subst h_eq
              exact le_rfl
          | guardOnly k =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  -- Function types throw error, contradicts htc : throw ... = Except.ok res
                  simp [hft, throw] at htc
                  -- htc is now: Except.error ... = Except.ok res, which is a contradiction
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      exact le_rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              exact le_rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              exact le_rfl
          | guardClosure k _ _ _ =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  -- Function types throw error, contradicts htc : throw ... = Except.ok res
                  simp [hft, throw] at htc
                  -- htc is now: Except.error ... = Except.ok res, which is a contradiction
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      exact le_rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              exact le_rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              exact le_rfl

private lemma typecheckOp_nextLoc_mono (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (op : Op) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckOp ctx e1 e2 fuel op = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckOp_structure ctx e1 e2 op fuel res htc
  rcases hstruct with ⟨result1, result2, _result_etyp, htc1, htc2, _hop, _hmem, _htag, hnextloc, _hnexttag, _⟩
  cases fuel with
  | zero => unfold typecheckOp at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e1 fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e1 ctx result1 htc1_simp
      let ctx' := { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' }
      have htc2_simp : typecheckExpr ctx' e2 fuel' = .ok result2 := by simpa using! htc2
      have IH2 := IH fuel' h_fuel e2 ctx' result2 htc2_simp
      have h_ctx'_nextLoc : ctx'.nextLoc = result1.nextLoc' := by rfl
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ = ctx'.nextLoc := h_ctx'_nextLoc.symm
        _ ≤ result2.nextLoc' := IH2
        _ = res.nextLoc' := hnextloc.symm

private lemma typecheckSeq_nextLoc_mono (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckSeq ctx e1 e2 fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckSeq_structure ctx e1 e2 fuel res htc
  rcases hstruct with ⟨result1, ctx', res, htc1, hctx', htc2, rfl⟩
  cases fuel with
  | zero => unfold typecheckSeq at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e1 fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e1 ctx result1 htc1_simp
      have htc2_simp : typecheckExpr ctx' e2 fuel' = .ok res := by simpa using htc2
      have IH2 := IH fuel' h_fuel e2 ctx' res htc2_simp
      have h_ctx'_nextLoc : ctx'.nextLoc = result1.nextLoc' := by simp [hctx', updateCtxFromResult]
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ = ctx'.nextLoc := h_ctx'_nextLoc.symm
        _ ≤ res.nextLoc' := IH2

private lemma typecheckNewRef_nextLoc_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckNewRef ctx e fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckNewRef_structure ctx e fuel res htc
  rcases hstruct with ⟨result1, _l, htc1, _hl, _hetyp, _hqtetyp, _hqtpoison, _hqtpred, _hmem, _htag, hnextloc, _hnexttag, _hregime⟩
  cases fuel with
  | zero => unfold typecheckNewRef at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e ctx result1 htc1_simp
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ ≤ result1.nextLoc' + 1 := Nat.le_succ result1.nextLoc'
        _ = res.nextLoc' := hnextloc.symm

-- Helper lemma: List.foldl preserves initial value as lower bound when step function is monotone
private lemma List.foldl_ge_init_of_step_ge {α β : Type*} [Preorder α] {f : α → β → α}
    (h : ∀ acc x, acc ≤ f acc x) (init : α) (l : List β) :
    init ≤ List.foldl f init l := by
  induction l generalizing init with
  | nil => rfl
  | cons x xs ih =>
      calc init
        _ ≤ f init x := h init x
        _ ≤ List.foldl f (f init x) xs := ih (f init x)

-- Helper lemma for typecheckAssign: nextLoc' is at least result2.nextLoc'
private lemma typecheckAssign_preserves_nextLoc (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult) :
  typecheckAssign ctx e1 e2 fuel = .ok res →
  ∃ (result1 result2 : TypeResult) (ctx' : TypeContext),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    ctx' = { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' } ∧
    typecheckExpr ctx' e2 (fuel - 1) = .ok result2 ∧
    result2.nextLoc' ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckAssign_structure ctx e1 e2 fuel res htc
  rcases hstruct with ⟨result1, result2, ls, htc1, _hetyp1, htc2, _hetyp2, hnextloc, _hnexttag, _⟩
  let ctx' := { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' }
  have h_ineq : result2.nextLoc' ≤ LocSet.fold ls result2.nextLoc' (fun acc l => max acc (l + 1)) := by
    have h_mono : ∀ acc l, acc ≤ max acc (l + 1) := by
      intro acc l
      exact Nat.le_max_left acc (l + 1)
    unfold LocSet.fold
    rw [ExtTreeSet.foldl_eq_foldl_toList]
    exact List.foldl_ge_init_of_step_ge h_mono result2.nextLoc' ls.toList
  -- Rewrite res.nextLoc' using hnextloc to match h_ineq
  rw [hnextloc]
  exact ⟨result1, result2, ctx', htc1, rfl, htc2, h_ineq⟩

private lemma typecheckAssign_nextLoc_mono (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckAssign ctx e1 e2 fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckAssign_preserves_nextLoc ctx e1 e2 fuel res htc
  rcases hstruct with ⟨result1, result2, ctx', htc1, hctx', htc2, hnextloc⟩
  cases fuel with
  | zero => unfold typecheckAssign at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e1 fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e1 ctx result1 htc1_simp
      have htc2_simp : typecheckExpr ctx' e2 fuel' = .ok result2 := by simpa using htc2
      have IH2 := IH fuel' h_fuel e2 ctx' result2 htc2_simp
      have h_ctx'_nextLoc : ctx'.nextLoc = result1.nextLoc' := by simp [hctx']
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ = ctx'.nextLoc := h_ctx'_nextLoc.symm
        _ ≤ result2.nextLoc' := IH2
        _ ≤ res.nextLoc' := hnextloc

-- Helper lemma for typecheckDeref: all branches preserve nextLoc'
private lemma typecheckDeref_preserves_nextLoc (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  typecheckDeref ctx e fuel = .ok res →
  ∃ (result1 : TypeResult),
    typecheckExpr ctx e (fuel - 1) = .ok result1 ∧
    res.nextLoc' = result1.nextLoc' := by
  intro htc
  have hstruct := typecheckDeref_structure ctx e fuel res htc
  rcases hstruct with ⟨result1, htc1, _hmem, _htag, hnextloc, _hnexttag, _hregime⟩
  exact ⟨result1, htc1, hnextloc⟩

private lemma typecheckDeref_nextLoc_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckDeref ctx e fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckDeref_preserves_nextLoc ctx e fuel res htc
  rcases hstruct with ⟨result1, htc1, hnextloc⟩
  cases fuel with
  | zero => unfold typecheckDeref at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e ctx result1 htc1_simp
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
