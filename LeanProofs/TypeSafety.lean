-- Regime join and invalidation lemmas (inputs to the regime-monotonicity proof below)

private lemma combineExtTreeMaps_getElem?_of_none_none
    (m1 m2 : ExtTreeMap Nat β)
    (f : Nat → Option β → Option β → Option β)
    (k : Nat)
    (hnone : f k none none = none) :
    (combineExtTreeMaps m1 m2 f)[k]? =
      match f k m1[k]? m2[k]? with
      | some v => some v
      | none => none := by
  classical
  let ks := (m1.keys ++ m2.keys).eraseDups
  by_cases hmem : k ∈ ks
  · have hgo := combineExtTreeMaps_go_get_mem m1 m2 f ks ({} : ExtTreeMap Nat β) k hmem
    simpa [combineExtTreeMaps, ks] using hgo
  · have hk_not_m1 : k ∉ m1 := by
      intro hk
      have hk_keys : k ∈ m1.keys := (ExtTreeMap.mem_keys).2 hk
      have hk_in_append : k ∈ m1.keys ++ m2.keys := List.mem_append_left _ hk_keys
      exact hmem (List.mem_eraseDups_of_mem hk_in_append)
    have hk_not_m2 : k ∉ m2 := by
      intro hk
      have hk_keys : k ∈ m2.keys := (ExtTreeMap.mem_keys).2 hk
      have hk_in_append : k ∈ m1.keys ++ m2.keys := List.mem_append_right _ hk_keys
      exact hmem (List.mem_eraseDups_of_mem hk_in_append)
    have hm1_none : m1[k]? = none := ExtTreeMap.getElem?_eq_none hk_not_m1
    have hm2_none : m2[k]? = none := ExtTreeMap.getElem?_eq_none hk_not_m2
    have hgo := combineExtTreeMaps_go_get_not_mem m1 m2 f ks ({} : ExtTreeMap Nat β) k hmem
    have hgo' : (combineExtTreeMaps m1 m2 f)[k]? = none := by
      simpa [combineExtTreeMaps, ks] using hgo
    rw [hgo']
    simp [hm1_none, hm2_none, hnone]

private lemma joinRegimes_combine_fun_eq :
    (fun (_ : Tag) (ob1 ob2 : Option Bool) =>
      match ob1, ob2 with
      | some b1, some b2 => if b1 == b2 then some b1 else none
      | _, _ => none) =
    (fun (_ : Tag) (ob1 ob2 : Option Bool) =>
      match ob1, ob2 with
      | some b1, some b2 => if b1 = b2 then some b1 else none
      | _, _ => none) := by
  funext k ob1 ob2
  cases ob1 <;> cases ob2 <;> simp

private lemma joinRegimes_lookup_of_some_some
    (R1 R2 : Regime) (k : Tag) (b : Bool)
    (h1 : R1.lookup? k = some b)
    (h2 : R2.lookup? k = some b) :
    (joinRegimes R1 R2).lookup? k = some b := by
  have hmap1 : R1.get? k = some b := h1
  have hmap2 : R2.get? k = some b := h2
  have hmap1' : R1[k]? = some b := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap1
  have hmap2' : R2[k]? = some b := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap2
  have hcombine :
      (combineExtTreeMaps R1 R2
        (fun _ ob1 ob2 =>
          match ob1, ob2 with
          | some b1, some b2 => if b1 == b2 then some b1 else none
          | _, _ => none)).get? k = some b := by
    have hcombine0 := combineExtTreeMaps_getElem?_of_none_none R1 R2
      (fun _ ob1 ob2 =>
        match ob1, ob2 with
        | some b1, some b2 => if b1 = b2 then some b1 else none
        | _, _ => none) k rfl
    have hcombine0s :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 = b2 then some b1 else none
            | _, _ => none))[k]? = some b := by
      simpa [hmap1', hmap2'] using hcombine0
    have hcombine0' :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 == b2 then some b1 else none
            | _, _ => none))[k]? = some b := by
      simpa [joinRegimes_combine_fun_eq] using hcombine0s
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine0'
  unfold Regime.lookup?
  simpa [joinRegimes] using! hcombine

private lemma joinRegimes_lookup_of_left_none
    (R1 R2 : Regime) (k : Tag)
    (h1 : R1.lookup? k = none) :
    (joinRegimes R1 R2).lookup? k = none := by
  have hmap1 : R1.get? k = none := h1
  have hmap1' : R1[k]? = none := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap1
  have hcombine :
      (combineExtTreeMaps R1 R2
        (fun _ ob1 ob2 =>
          match ob1, ob2 with
          | some b1, some b2 => if b1 == b2 then some b1 else none
          | _, _ => none)).get? k = none := by
    have hcombine0 := combineExtTreeMaps_getElem?_of_none_none R1 R2
      (fun _ ob1 ob2 =>
        match ob1, ob2 with
        | some b1, some b2 => if b1 = b2 then some b1 else none
        | _, _ => none) k rfl
    have hcombine0s :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 = b2 then some b1 else none
            | _, _ => none))[k]? = none := by
      simpa [hmap1'] using hcombine0
    have hcombine0' :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 == b2 then some b1 else none
            | _, _ => none))[k]? = none := by
      simpa [joinRegimes_combine_fun_eq] using hcombine0s
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine0'
  unfold Regime.lookup?
  simpa [joinRegimes] using! hcombine

private lemma joinRegimes_lookup_of_right_none
    (R1 R2 : Regime) (k : Tag)
    (h2 : R2.lookup? k = none) :
    (joinRegimes R1 R2).lookup? k = none := by
  have hmap2 : R2.get? k = none := h2
  have hmap2' : R2[k]? = none := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap2
  have hcombine :
      (combineExtTreeMaps R1 R2
        (fun _ ob1 ob2 =>
          match ob1, ob2 with
          | some b1, some b2 => if b1 == b2 then some b1 else none
          | _, _ => none)).get? k = none := by
    have hcombine0 := combineExtTreeMaps_getElem?_of_none_none R1 R2
      (fun _ ob1 ob2 =>
        match ob1, ob2 with
        | some b1, some b2 => if b1 = b2 then some b1 else none
        | _, _ => none) k rfl
    have hcombine0s :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 = b2 then some b1 else none
            | _, _ => none))[k]? = none := by
      simpa [hmap2'] using hcombine0
    have hcombine0' :
        (combineExtTreeMaps R1 R2
          (fun _ ob1 ob2 =>
            match ob1, ob2 with
            | some b1, some b2 => if b1 == b2 then some b1 else none
            | _, _ => none))[k]? = none := by
      simpa [joinRegimes_combine_fun_eq] using hcombine0s
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine0'
  unfold Regime.lookup?
  simpa [joinRegimes] using! hcombine

lemma joinRegimes_lookup_some_left
    (R1 R2 : Regime) (k : Tag) (b : Bool) :
    (joinRegimes R1 R2).lookup? k = some b →
    R1.lookup? k = some b := by
  intro hjoin
  let f : Tag → Option Bool → Option Bool → Option Bool := fun _ ob1 ob2 =>
    match ob1, ob2 with
    | some b1, some b2 => if b1 = b2 then some b1 else none
    | _, _ => none
  have hcombine : (combineExtTreeMaps R1 R2 f).get? k = some b := by
    unfold Regime.lookup? at hjoin
    simp [joinRegimes] at hjoin
    exact hjoin
  simp only [combineExtTreeMaps] at hcombine
  have hk_mem : k ∈ (R1.keys ++ R2.keys).eraseDups := by
    by_contra hnot
    have hgo_not :=
      combineExtTreeMaps_go_get_not_mem R1 R2 f
        (R1.keys ++ R2.keys).eraseDups ({} : ExtTreeMap Tag Bool) k hnot
    have hempty : (({} : ExtTreeMap Tag Bool)[k]?) = none := by
      rfl
    rw [hempty] at hgo_not
    have hcombine_get : (combineExtTreeMaps.go R1 R2 f (R1.keys ++ R2.keys).eraseDups
        ({} : ExtTreeMap Tag Bool))[k]? = some b := by
      simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine
    rw [hgo_not] at hcombine_get
    simp at hcombine_get
  have hgo :=
    combineExtTreeMaps_go_get_mem R1 R2 f
      (R1.keys ++ R2.keys).eraseDups ({} : ExtTreeMap Tag Bool) k hk_mem
  have hcombine_get :
      (combineExtTreeMaps.go R1 R2 f (R1.keys ++ R2.keys).eraseDups
        ({} : ExtTreeMap Tag Bool))[k]? = some b := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine
  rw [hcombine_get] at hgo
  simp only [f] at hgo
  cases h1 : R1[k]? <;> cases h2 : R2[k]? <;> simp [h1, h2] at hgo
  rename_i b1 b2
  by_cases hbeq : b1 = b2
  · simp [hbeq] at hgo
    have hb2 : b = b2 := by simpa using hgo
    have hb1 : b = b1 := by
      calc
        b = b2 := hb2
        _ = b1 := hbeq.symm
    have hmap1 : R1.get? k = some b := by
      have hmap1' : R1[k]? = some b := by simpa [hb1] using h1
      simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap1'
    exact hmap1
  · simp [hbeq] at hgo

lemma joinRegimes_lookup_some_right
    (R1 R2 : Regime) (k : Tag) (b : Bool) :
    (joinRegimes R1 R2).lookup? k = some b →
    R2.lookup? k = some b := by
  intro hjoin
  let f : Tag → Option Bool → Option Bool → Option Bool := fun _ ob1 ob2 =>
    match ob1, ob2 with
    | some b1, some b2 => if b1 = b2 then some b1 else none
    | _, _ => none
  have hcombine : (combineExtTreeMaps R1 R2 f).get? k = some b := by
    unfold Regime.lookup? at hjoin
    simp [joinRegimes] at hjoin
    exact hjoin
  simp only [combineExtTreeMaps] at hcombine
  have hk_mem : k ∈ (R1.keys ++ R2.keys).eraseDups := by
    by_contra hnot
    have hgo_not :=
      combineExtTreeMaps_go_get_not_mem R1 R2 f
        (R1.keys ++ R2.keys).eraseDups ({} : ExtTreeMap Tag Bool) k hnot
    have hempty : (({} : ExtTreeMap Tag Bool)[k]?) = none := by
      rfl
    rw [hempty] at hgo_not
    have hcombine_get :
        (combineExtTreeMaps.go R1 R2 f (R1.keys ++ R2.keys).eraseDups
          ({} : ExtTreeMap Tag Bool))[k]? = some b := by
      simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine
    rw [hgo_not] at hcombine_get
    simp at hcombine_get
  have hgo :=
    combineExtTreeMaps_go_get_mem R1 R2 f
      (R1.keys ++ R2.keys).eraseDups ({} : ExtTreeMap Tag Bool) k hk_mem
  have hcombine_get :
      (combineExtTreeMaps.go R1 R2 f (R1.keys ++ R2.keys).eraseDups
        ({} : ExtTreeMap Tag Bool))[k]? = some b := by
    simpa [Std.ExtTreeMap.get?_eq_getElem?] using hcombine
  rw [hcombine_get] at hgo
  simp only [f] at hgo
  cases h1 : R1[k]? <;> cases h2 : R2[k]? <;> simp [h1, h2] at hgo
  rename_i b1 b2
  by_cases hbeq : b1 = b2
  · simp [hbeq] at hgo
    have hb2 : b = b2 := by simpa using hgo
    have hmap2 : R2.get? k = some b := by
      have hmap2' : R2[k]? = some b := by simpa [hb2] using h2
      simpa [Std.ExtTreeMap.get?_eq_getElem?] using hmap2'
    exact hmap2
  · simp [hbeq] at hgo

private lemma joinRegimes_no_new_left
    (R1 R2 : Regime) (k : Tag)
    (hjoin : (joinRegimes R1 R2).lookup? k ≠ none) :
    R1.lookup? k ≠ none := by
  intro h1none
  have hnone : (joinRegimes R1 R2).lookup? k = none :=
    joinRegimes_lookup_of_left_none R1 R2 k h1none
  exact hjoin hnone

lemma invalidateRegimeDeps_monotone
    (R : Regime) (env : TagEnv) (ls : LocSet) :
    Regime.monotoneStep R (invalidateRegimeDeps R env ls) := by
  refine ⟨?_, ?_⟩
  · intro k b hkR
    have hkmap : R[k]? = some b := by
      simpa [Std.ExtTreeMap.get?_eq_getElem?] using! hkR
    have hmapFiltered :
        (R.filter (fun k _ =>
          (ExtTreeMap.filter (fun x tv => !tv.deps.any (ExtTreeSet.contains ls)) env).contains k))[k]? =
        Option.filter
          (fun _ =>
            (ExtTreeMap.filter (fun x tv => !tv.deps.any (ExtTreeSet.contains ls)) env).contains k)
          (some b) := by
      rw [Std.ExtTreeMap.getElem?_filter']
      simp [hkmap]
    unfold invalidateRegimeDeps Regime.lookup?
    simp [hmapFiltered]
    exact em (k ∈ ExtTreeMap.filter (fun x tv => !tv.deps.any (ExtTreeSet.contains ls)) env)
  · intro k hkInv
    by_contra hkRnone
    have hnone : (invalidateRegimeDeps R env ls).lookup? k = none := by
      have hkmapNone : R[k]? = none := by
        rw [← Std.ExtTreeMap.get?_eq_getElem?]; exact hkRnone
      have hmapFilteredNone :
          (R.filter (fun k _ =>
            (ExtTreeMap.filter (fun x tv => !tv.deps.any (ExtTreeSet.contains ls)) env).contains k))[k]? =
          Option.filter
            (fun _ =>
              (ExtTreeMap.filter (fun x tv => !tv.deps.any (ExtTreeSet.contains ls)) env).contains k)
            (none : Option Bool) := by
        rw [Std.ExtTreeMap.getElem?_filter']
        simp [hkmapNone]
      unfold invalidateRegimeDeps Regime.lookup?
      simp [hmapFilteredNone]
    exact hkInv hnone

-- Helper lemmas for nextTag monotonicity (argument-condition resolution, extern declarations, join)

private lemma TypecheckM_pure_eq {α} (a : α) : (Pure.pure a : TypecheckM α) = Except.ok a := rfl

/-- `nextTag` passthrough: `resolveArgCondQTyp` never advances `nextTag`. -/
private lemma resolveArgCondQTyp_snd
    {argTyp : Typ} {argPoison : Bool} {argPred : SyntaxPredicate}
    {varEnv : VarTypeEnv} {nt0 : Tag} {r : QTyp × Tag} :
    resolveArgCondQTyp argTyp argPoison argPred varEnv nt0 = .ok r → r.2 = nt0 := by
  intro h
  unfold resolveArgCondQTyp at h
  cases hq : resolveArgCondQTyp' argTyp argPoison argPred varEnv with
  | error e => rw [hq] at h; simp [bind, Except.bind] at h
  | ok qt =>
      rw [hq] at h
      simp only [bind, Except.bind, TypecheckM_pure_eq, Except.ok.injEq] at h
      rw [← h]

/-- The poison flag of the resolved argument-condition `QTyp` is exactly the
    declared `argPoison`: `resolveArgCondQTyp'` returns `⟨etyp, argPoison, _⟩`. -/
private lemma resolveArgCondQTyp'_poison
    {argTyp : Typ} {argPoison : Bool} {argPred : SyntaxPredicate}
    {varEnv : VarTypeEnv} {qt : QTyp} :
    resolveArgCondQTyp' argTyp argPoison argPred varEnv = .ok qt → qt.poison = argPoison := by
  intro h
  unfold resolveArgCondQTyp' at h
  cases argPred with
  | guardClosure idx arg body =>
      cases hpe : body.toPExpr with
      | error e =>
          simp [bind, Except.bind, hpe] at h
      | ok pe =>
          cases ha : argTypToETyp argTyp <;>
            simp_all [bind, Except.bind, pure, Except.pure, argTypToETyp]
          all_goals (subst qt; rfl)
  | guardOnly idx =>
      cases ha : argTypToETyp argTyp <;>
        simp_all [bind, Except.bind, pure, Except.pure, argTypToETyp]
      all_goals (subst qt; rfl)
  | noPred =>
      cases ha : argTypToETyp argTyp <;>
        simp_all [bind, Except.bind, pure, Except.pure, argTypToETyp]
      all_goals (subst qt; rfl)

/-- The poison flag of the resolved argument-condition `QTyp` (the first
    projection of `resolveArgCondQTyp`) is exactly the declared `argPoison`. -/
lemma resolveArgCondQTyp_fst_poison
    {argTyp : Typ} {argPoison : Bool} {argPred : SyntaxPredicate}
    {varEnv : VarTypeEnv} {nt0 : Tag} {r : QTyp × Tag} :
    resolveArgCondQTyp argTyp argPoison argPred varEnv nt0 = .ok r → r.1.poison = argPoison := by
  intro h
  unfold resolveArgCondQTyp at h
  cases hq : resolveArgCondQTyp' argTyp argPoison argPred varEnv with
  | error e => rw [hq] at h; simp [bind, Except.bind] at h
  | ok qt =>
      rw [hq] at h
      simp only [bind, Except.bind, TypecheckM_pure_eq, Except.ok.injEq] at h
      rw [← h]
      exact resolveArgCondQTyp'_poison hq

/-- A successful `checkExternDeclSite` means the declaration is typed where
    extern declarations may appear: outside fn/pfn bodies and outside an `if`
    condition that matches a guard. -/
lemma checkExternDeclSite_ok_allowed {ctx : TypeContext} {kind : String} {id : ExternId}
    {nested : List ExternId} {u : Unit}
    (h : checkExternDeclSite ctx kind id nested = .ok u) :
    ctx.pureCtx = false ∧ ctx.externRefAllowed = true := by
  unfold checkExternDeclSite at h
  cases hp : ctx.pureCtx <;> cases ha : ctx.externRefAllowed <;>
    simp [hp, ha, bind, Except.bind, throw, throwThe, MonadExceptOf.throw] at h ⊢

/-- A successful `typecheckExternFn` passed the declaration-site check. -/
lemma typecheckExternFn_ok_declSite {ctx : TypeContext} {id : ExternId} {arg : Name}
    {argTyp : Typ} {argPoison : Bool} {argPred : SyntaxPredicate} {retSpec : ExternReturn}
    {effects : List Effect} {captures : List Capture} {fuel : Nat} {res : TypeResult}
    (h : typecheckExternFn ctx id arg argTyp argPoison argPred retSpec effects captures fuel = .ok res) :
    checkExternDeclSite ctx "fn" id retSpec.declIds = .ok PUnit.unit := by
  cases c_eq : checkExternDeclSite ctx "fn" id retSpec.declIds with
  | error e =>
      unfold typecheckExternFn at h
      rw [c_eq] at h
      cases h
  | ok a => rfl

/-- A successful `typecheckExternPfn` passed the declaration-site check. -/
lemma typecheckExternPfn_ok_declSite {ctx : TypeContext} {id : ExternId} {arg : Name}
    {argTyp : Typ} {argPoison : Bool} {argPred : SyntaxPredicate} {retSpec : ExternReturn}
    {captures : List Capture} {fuel : Nat} {res : TypeResult}
    (h : typecheckExternPfn ctx id arg argTyp argPoison argPred retSpec captures fuel = .ok res) :
    checkExternDeclSite ctx "pfn" id retSpec.declIds = .ok PUnit.unit := by
  cases c_eq : checkExternDeclSite ctx "pfn" id retSpec.declIds with
  | error e =>
      unfold typecheckExternPfn at h
      rw [c_eq] at h
      cases h
  | ok a => rfl

/-- Helper: when `typecheckExternFn` accepts an extern, the result is
    structurally the success record (the two front-guards `checkExternInput…`
    have succeeded). We state this as an inversion lemma so downstream proofs
    can keep using `cases htc; rfl`-style reasoning without unfolding the
    guards.  Proof defers the guard-pair analysis to `simp` + `split`. -/

lemma typecheckExternFn_ok_res_eq
    (ctx : TypeContext) (id : ExternId) (arg : Name) (argTyp : Typ)
    (argPoison : Bool) (argPred : SyntaxPredicate)
    (retSpec : ExternReturn) (effects : List Effect) {captures : List Capture} {fuel : Nat} (res : TypeResult) :
    typecheckExternFn ctx id arg argTyp argPoison argPred retSpec effects captures fuel = .ok res →
    ∃ argQt,
      argQt.poison = argPoison ∧
      res =
        { qualType :=
            ⟨ETyp.arrow argTyp (parseReturnType retSpec) ctx.pc
              [FnTClosure.extern id arg retSpec effects (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt captures],
             ctx.pc, Predicate.noPred⟩,
          memEnv' := ctx.memEnv, tagEnv' := ctx.tagEnv,
          nextLoc' := ctx.nextLoc, nextTag' := ctx.nextTag, nextBind' := ctx.nextBind,
          regime' := ctx.regime,
          declared' := id :: (retSpec.declIds ++ ctx.declaredExternRefs) } := by
  intro h
  have h0ok : checkExternDeclSite ctx "fn" id retSpec.declIds = .ok PUnit.unit :=
    typecheckExternFn_ok_declSite h
  have h1ok : checkExternInputFirstOrder argTyp = .ok PUnit.unit := by
    cases argTyp
    case int | bool | unit | string =>
      simp [checkExternInputFirstOrder, TypecheckM_pure_eq]
    case ref t =>
      cases t
      case int =>
        simp [checkExternInputFirstOrder, TypecheckM_pure_eq]
      case bool | unit | string | ref _t' | arrow _t1 _t2 =>
        exfalso
        unfold typecheckExternFn at h
        simp [h0ok, checkExternInputFirstOrder, bind, Except.bind] at h
    case arrow a b =>
        exfalso
        unfold typecheckExternFn at h
        simp [h0ok, checkExternInputFirstOrder, bind, Except.bind] at h
  have h2ok : checkExternReturnInputsFirstOrder retSpec = .ok PUnit.unit := by
    let c := checkExternReturnInputsFirstOrder retSpec
    cases c_eq : c with
    | error e =>
      have c_err : checkExternReturnInputsFirstOrder retSpec = .error e := c_eq
      unfold typecheckExternFn at h
      rw [h0ok, h1ok, c_err] at h
      cases h
    | ok a =>
      have hca : checkExternReturnInputsFirstOrder retSpec = .ok a := c_eq
      have ha' : a = PUnit.unit := Subsingleton.elim a PUnit.unit
      exact hca.trans (congrArg Except.ok ha')
  have h3ok : checkExternGuardBodies ctx.varEnv fuel arg argTyp argPoison argPred retSpec
      effects captures = .ok PUnit.unit := by
    cases c_eq : checkExternGuardBodies ctx.varEnv fuel arg argTyp argPoison argPred retSpec
        effects captures with
    | error e =>
      unfold typecheckExternFn at h
      rw [h0ok, h1ok, h2ok, c_eq] at h
      cases h
    | ok a => rfl
  cases hr : resolveArgCondQTyp argTyp argPoison argPred ctx.varEnv ctx.nextTag with
  | error e =>
      exfalso
      unfold typecheckExternFn at h
      simp [h0ok, h1ok, h2ok, h3ok, bind, Except.bind, hr] at h
  | ok p =>
      obtain ⟨argQt, nt⟩ := p
      have hpoison : argQt.poison = argPoison := resolveArgCondQTyp_fst_poison hr
      have hnt : nt = ctx.nextTag := resolveArgCondQTyp_snd hr
      subst hnt
      refine ⟨argQt, hpoison, ?_⟩
      have hdef :
          typecheckExternFn ctx id arg argTyp argPoison argPred retSpec effects captures fuel
            = .ok { qualType :=
                      ⟨ETyp.arrow argTyp (parseReturnType retSpec) ctx.pc
                        [FnTClosure.extern id arg retSpec effects (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt captures],
                        ctx.pc, Predicate.noPred⟩,
                    memEnv' := ctx.memEnv, tagEnv' := ctx.tagEnv,
                    nextLoc' := ctx.nextLoc, nextTag' := ctx.nextTag, nextBind' := ctx.nextBind,
                    regime' := ctx.regime,
                    declared' := id :: (retSpec.declIds ++ ctx.declaredExternRefs) } := by
        simp [typecheckExternFn, h0ok, h1ok, h2ok, h3ok, hr, bind, Except.bind, TypecheckM_pure_eq]
      exact (by injection h.symm.trans hdef)

lemma typecheckExternPfn_ok_res_eq
  (ctx : TypeContext) (id : ExternId) (arg : Name) (argTyp : Typ)
    (argPoison : Bool) (argPred : SyntaxPredicate)
    (retSpec : ExternReturn) {captures : List Capture} {fuel : Nat} (res : TypeResult) :
    typecheckExternPfn ctx id arg argTyp argPoison argPred retSpec captures fuel = .ok res →
    ∃ argQt,
      argQt.poison = argPoison ∧
      res =
        { qualType :=
            ⟨ETyp.parrow argTyp (parseReturnType retSpec) ctx.pc
              [PFnTClosure.extern id arg retSpec (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt captures],
             ctx.pc, Predicate.noPred⟩,
          memEnv' := ctx.memEnv, tagEnv' := ctx.tagEnv,
          nextLoc' := ctx.nextLoc, nextTag' := ctx.nextTag, nextBind' := ctx.nextBind,
          regime' := ctx.regime,
          declared' := id :: (retSpec.declIds ++ ctx.declaredExternRefs) } := by
  intro h
  have h0ok : checkExternDeclSite ctx "pfn" id retSpec.declIds = .ok PUnit.unit :=
    typecheckExternPfn_ok_declSite h
  have h1ok : checkExternInputFirstOrder argTyp = .ok PUnit.unit := by
    cases argTyp
    case int | bool | unit | string =>
      simp [checkExternInputFirstOrder, TypecheckM_pure_eq]
    case ref t =>
      cases t
      case int =>
        simp [checkExternInputFirstOrder, TypecheckM_pure_eq]
      case bool | unit | string | ref _t' | arrow _t1 _t2 =>
        exfalso
        unfold typecheckExternPfn at h
        simp [h0ok, checkExternInputFirstOrder, bind, Except.bind] at h
    case arrow a b =>
        exfalso
        unfold typecheckExternPfn at h
        simp [h0ok, checkExternInputFirstOrder, bind, Except.bind] at h
  have h2ok : checkExternReturnInputsFirstOrder retSpec = .ok PUnit.unit := by
    let c := checkExternReturnInputsFirstOrder retSpec
    cases c_eq : c with
    | error e =>
      have c_err : checkExternReturnInputsFirstOrder retSpec = .error e := c_eq
      unfold typecheckExternPfn at h
      rw [h0ok, h1ok, c_err] at h
      cases h
    | ok a =>
      have hca : checkExternReturnInputsFirstOrder retSpec = .ok a := c_eq
      have ha' : a = PUnit.unit := Subsingleton.elim a PUnit.unit
      exact hca.trans (congrArg Except.ok ha')
  have h3ok : checkExternGuardBodies ctx.varEnv fuel arg argTyp argPoison argPred retSpec
      [] captures = .ok PUnit.unit := by
    cases c_eq : checkExternGuardBodies ctx.varEnv fuel arg argTyp argPoison argPred retSpec
        [] captures with
    | error e =>
      unfold typecheckExternPfn at h
      rw [h0ok, h1ok, h2ok, c_eq] at h
      cases h
    | ok a => rfl
  cases hr : resolveArgCondQTyp argTyp argPoison argPred ctx.varEnv ctx.nextTag with
  | error e =>
      exfalso
      unfold typecheckExternPfn at h
      simp [h0ok, h1ok, h2ok, h3ok, bind, Except.bind, hr] at h
  | ok p =>
      obtain ⟨argQt, nt⟩ := p
      have hpoison : argQt.poison = argPoison := resolveArgCondQTyp_fst_poison hr
      have hnt : nt = ctx.nextTag := resolveArgCondQTyp_snd hr
      subst hnt
      refine ⟨argQt, hpoison, ?_⟩
      have hdef :
          typecheckExternPfn ctx id arg argTyp argPoison argPred retSpec captures fuel
            = .ok { qualType :=
                      ⟨ETyp.parrow argTyp (parseReturnType retSpec) ctx.pc
                        [PFnTClosure.extern id arg retSpec (VarTypeEnv.toCaptured ctx.varEnv ctx.bindEnv) argQt captures],
                        ctx.pc, Predicate.noPred⟩,
                    memEnv' := ctx.memEnv, tagEnv' := ctx.tagEnv,
                    nextLoc' := ctx.nextLoc, nextTag' := ctx.nextTag, nextBind' := ctx.nextBind,
                    regime' := ctx.regime,
                    declared' := id :: (retSpec.declIds ++ ctx.declaredExternRefs) } := by
        simp [typecheckExternPfn, h0ok, h1ok, h2ok, h3ok, hr, bind, Except.bind, TypecheckM_pure_eq]
      exact (by injection h.symm.trans hdef)

private lemma typecheckExternRef_ok_res_eq
    (ctx : TypeContext) (id : ExternId)
    (rp : Bool) (rpred : SyntaxPredicate)
    (cp : Bool) (cpred : SyntaxPredicate) (res : TypeResult) :
    typecheckExternRef ctx id rp rpred cp cpred = .ok res →
    res = { qualType := ⟨ETyp.ref (LocSet.singleton ctx.nextLoc), false, Predicate.noPred⟩,
            memEnv' := updateMemEnv ctx.memEnv ctx.nextLoc ⟨ETyp.int, true, Predicate.noPred⟩,
            tagEnv' := ctx.tagEnv, nextLoc' := ctx.nextLoc + 1, nextTag' := ctx.nextTag, nextBind' := ctx.nextBind,
            regime' := ctx.regime, declared' := id :: ctx.declaredExternRefs } := by
  intro h
  simp only [typecheckExternRef, bind, Except.bind, Bool.not_eq_true', pure, Except.pure,
             Bool.or_eq_true] at h
  split at h
  · simp at h
  · split at h
    · simp at h
    · split at h
      · split at h
        · simp only [Except.ok.injEq] at h; exact h.symm
        · simp at h
        · simp at h
      · simp at h

lemma joinTypeResults_nextTag_eq_max
  (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) :
    joinTypeResults ctx r rs = .ok res →
    res.nextTag' = List.max (r.nextTag' :: rs.map TypeResult.nextTag') (by intro h; cases h) := by
  intro hjoin
  -- Helper: the join fold computes the max of nextTag' across the list.
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_nextTag :
      ∀ (rs : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs = Except.ok acc' →
        acc'.2.2.2.2.2.2.2 = List.foldl max acc.2.2.2.2.2.2.2 (rs.map TypeResult.nextTag') := by
    intro rs acc acc' h
    induction rs generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at h
        cases h
        simp
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at h
            -- h is now about the tail fold; apply the IH.
            have h' := ih _ h
            -- foldl on a cons updates the max with the head.
            simpa [List.foldl_cons] using h'
  -- Unfold joinTypeResults and split on the fold checks.
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err =>
          erw [hcheck] at hjoin
          simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin
          simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err =>
              erw [hfold] at hjoin
              simp at hjoin
          | ok a =>
              erw [hfold] at hjoin
              simp at hjoin
              subst res
              simp
              have h_fold := h_fold_nextTag rs _ _ hfold
              -- List.max on a non-empty list is foldl max.
              simpa [List.max] using h_fold

-- ================================================================
-- Exact next-tag preservation for variables
-- ================================================================

lemma typecheckVar_preserves_nextTag (ctx : TypeContext) (x : Name) (res : TypeResult) :
  typecheckVar ctx x = .ok res →
  res.nextTag' = ctx.nextTag := by
  intro htc
  unfold typecheckVar at htc
  cases h_lookup : ctx.varEnv.lookup x with
  | none =>
      simp [h_lookup] at htc
  | some qt =>
      simp [h_lookup] at htc
      cases qt with
      | mk etyp poison pred =>
          cases pred with
          | noPred =>
              simp at htc
              injection htc with h_eq
              subst h_eq
              rfl
          | guardOnly k =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
          | guardClosure k _ _ _ =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl

-- ==========================================================================
-- PFnTClosure.extern structural lemmas
-- All branches of applyPFnTClosure for PFnTClosure.extern set
-- memEnv'/regime-base = result2's values; the simple-return branch's tagEnv'
-- additionally materialises the regime-determined return guard
-- (`installReturnGuard`).
-- ==========================================================================

lemma applyPFnTClosure_extern_memEnv_eq
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2) :
  r2.memEnv' = r1.memEnv' := by
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ n =>
      -- The extern case is a leading argument-condition gate (`if !… then throw`)
      -- followed by the per-retSpec monadic body; on `.ok`, every error/throw leaf
      -- is impossible and every success leaf returns a record sharing r1's memEnv.
      simp only [bind, Except.bind] at happly
      repeat' split at happly
      all_goals
        first
        | simp only [reduceCtorEq] at happly
        | (simp only [pure, Except.pure, Except.ok.injEq] at happly; subst happly; rfl)

/-- `invalidateTagDeps` only removes entries (it is a `filter`), so a surviving entry
    keeps its original value.  Shared monotonicity fact for the effect
    invalidation. -/
lemma invalidateTagDeps_get?_some_imp
    (env : TagEnv) (ls : LocSet) (k : Tag) (tv : TagVal)
    (h : (invalidateTagDeps env ls).get? k = some tv) :
    env.get? k = some tv := by
  unfold invalidateTagDeps at h
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_filter'] at h
  rw [Std.ExtTreeMap.get?_eq_getElem?]
  cases hg : env[k]? with
  | none => rw [hg] at h; simp at h
  | some tv' =>
      rw [hg] at h
      simp only [Option.filter] at h
      split at h
      · simpa using h
      · simp at h

/-- A surviving entry of `invalidateTagDeps` is non-none in the original tagEnv. -/
lemma invalidateTagDeps_get?_ne_none_imp
    (env : TagEnv) (ls : LocSet) (k : Tag)
    (h : (invalidateTagDeps env ls).get? k ≠ none) :
    env.get? k ≠ none := by
  intro hnone
  rcases Option.ne_none_iff_exists'.mp h with ⟨tv, htv⟩
  rw [invalidateTagDeps_get?_some_imp env ls k tv htv] at hnone
  simp at hnone

/-- `invalidateRegimeDepsEffect` only removes regime entries (it is a `filter`), so a
    surviving entry keeps its original value: the result is a sub-map of `R`. -/
lemma invalidateRegimeDepsEffect_lookup_some_imp
    (R : Regime) (env : TagEnv) (ls : LocSet) (k : Tag) (b : Bool)
    (h : (invalidateRegimeDepsEffect R env ls).lookup? k = some b) :
    R.lookup? k = some b := by
  unfold invalidateRegimeDepsEffect at h
  unfold Regime.lookup? at h ⊢
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_filter'] at h
  rw [Std.ExtTreeMap.get?_eq_getElem?]
  exact (Option.filter_eq_some_iff.mp h).1

/-- A tag surviving `invalidateTagDeps` has its dependencies disjoint from the written
    locs (that is why it survived the `filter`). -/
private lemma invalidateTagDeps_survive_get
    (env : TagEnv) (ls : LocSet) (k : Tag)
    (h : (invalidateTagDeps env ls).get? k ≠ none) :
    ∃ tv, env.get? k = some tv ∧ tv.deps.any ls.contains = false := by
  rcases Option.ne_none_iff_exists'.mp h with ⟨tv, htv⟩
  unfold invalidateTagDeps at htv
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_filter'] at htv
  obtain ⟨hget, hp⟩ := Option.filter_eq_some_iff.mp htv
  refine ⟨tv, ?_, ?_⟩
  · rw [Std.ExtTreeMap.get?_eq_getElem?]; exact hget
  · simpa using hp

/-- Effect-path analogue of `invalidateRegimeDeps_monotone`: the effect regime
    invalidation is a strong (`monotoneStep`) regime step — it only removes entries and
    preserves the values it keeps.  (Proved from the sub-map fact
    `invalidateRegimeDepsEffect_lookup_some_imp`.) -/
lemma invalidateRegimeDepsEffect_monotone
    (R : Regime) (env : TagEnv) (ls : LocSet) :
    Regime.monotoneStep R (invalidateRegimeDepsEffect R env ls) := by
  refine ⟨?_, ?_⟩
  · intro k b hkR
    cases hinv : (invalidateRegimeDepsEffect R env ls).lookup? k with
    | none => exact Or.inr rfl
    | some b' =>
        have hb' := invalidateRegimeDepsEffect_lookup_some_imp R env ls k b' hinv
        have hbb : b' = b := Option.some.inj (hb'.symm.trans hkR)
        subst hbb
        exact Or.inl rfl
  · intro k hk
    rcases Option.ne_none_iff_exists'.mp hk with ⟨b, hb⟩
    rw [invalidateRegimeDepsEffect_lookup_some_imp R env ls k b hb]
    exact Option.some_ne_none b

/-- Surviving-tag regime preservation for the effect invalidation: if `k`
    survives `invalidateTagDeps` (its deps avoid the written locs), then its regime value
    is preserved by `invalidateRegimeDepsEffect` (the coordinated filter keeps it). -/
lemma invalidateRegimeDepsEffect_lookup_preserve_of_survive
    (R : Regime) (env : TagEnv) (ls : LocSet) (k : Tag) (b : Bool)
    (hsurvive : (invalidateTagDeps env ls).get? k ≠ none)
    (hk : R.lookup? k = some b) :
    (invalidateRegimeDepsEffect R env ls).lookup? k = some b := by
  obtain ⟨tv, hget, hdisj⟩ := invalidateTagDeps_survive_get env ls k hsurvive
  unfold invalidateRegimeDepsEffect
  unfold Regime.lookup? at hk ⊢
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_filter']
  rw [Std.ExtTreeMap.get?_eq_getElem?] at hk
  rw [Option.filter_eq_some_iff]
  refine ⟨hk, ?_⟩
  simp only [Std.ExtTreeMap.get?_eq_getElem?] at hget
  simp [hget, hdisj]

/-- A resolved guard-closure predicate's tag comes from the extern call's fresh tag
    mapping (`resolveSyntaxPred` only mints `guardClosure` tags via `mapping.get?`). -/
lemma resolveSyntaxPred_guardClosure_tag_from_mapping
    (pred : SyntaxPredicate) (varEnv : VarTypeEnv) (binds : BindEnv)
    (mapping : TagMapping) (resolvedPred : Predicate)
    (hresolve : resolveSyntaxPred pred varEnv binds mapping = .ok resolvedPred)
    (k : Tag) (arg_name : Name) (pred_body : PExpr) (var_env : CapturedVarEnv)
    (hpred : resolvedPred = Predicate.guardClosure k arg_name pred_body var_env) :
    ∃ (idx : TagIndex), mapping.get? idx = some k := by
  cases pred with
  | noPred =>
    simp [resolveSyntaxPred, pure, Except.pure] at hresolve
    simp [← hresolve] at hpred
  | guardOnly idx =>
    simp only [resolveSyntaxPred] at hresolve
    split at hresolve
    · simp [pure, Except.pure] at hresolve; simp [← hresolve] at hpred
    · simp at hresolve
  | guardClosure idx arg body =>
    simp only [resolveSyntaxPred, bind, Except.bind] at hresolve
    split at hresolve
    · rename_i tag htag
      cases htoPExpr : body.toPExpr with
      | error e => simp [htoPExpr] at hresolve
      | ok pbody =>
        simp only [htoPExpr, pure, Except.pure, Except.ok.injEq] at hresolve
        rw [← hresolve] at hpred
        have htageq : tag = k := ((Predicate.guardClosure.injEq _ _ _ _ _ _ _ _).mp hpred).1
        exact ⟨idx, htageq ▸ htag⟩
    · simp at hresolve

/-- Case analysis of a lookup in `installReturnGuard`'s output: either the key was
    already bound (and is unchanged), or it is the freshly installed return-guard tag,
    whose tag-environment value is exactly the gating regime's value at that tag. -/
lemma installReturnGuard_get?_cases
    (env : TagEnv) (rp : Predicate) (R : Regime) (fuel : Nat) (k : Tag) (tv : TagVal)
    (h : (installReturnGuard env rp R fuel).get? k = some tv) :
    env.get? k = some tv ∨
      (R.lookup? k = some tv.value ∧
        ∃ an pb ve, rp = Predicate.guardClosure k an pb ve) := by
  unfold installReturnGuard at h
  split at h
  · rename_i k' an pb ve
    split at h
    · rename_i b hR
      split at h
      · rename_i deps _hdeps
        by_cases hcmp : compare k' k = Ordering.eq
        · have hk' : k' = k := (Nat.compare_eq_eq).1 hcmp
          subst hk'
          rw [Std.ExtTreeMap.get?_eq_getElem?,
            Std.ExtTreeMap.getElem?_insert_self] at h
          have htv : tv = ⟨b, deps⟩ := (Option.some.inj h).symm
          refine Or.inr ⟨?_, an, pb, ve, rfl⟩
          rw [htv]
          exact hR
        · rw [Std.ExtTreeMap.get?_eq_getElem?] at h
          rw [Std.ExtTreeMap.getElem?_insert] at h
          simp only [hcmp, ite_false] at h
          rw [← Std.ExtTreeMap.get?_eq_getElem?] at h
          exact Or.inl h
      · exact Or.inl h
    · exact Or.inl h
  · exact Or.inl h

/-- A lookup in an inserted tag environment: the inserted key, or an old binding. -/
private lemma tagEnv_get?_insert_cases (env : TagEnv) (k' k : Tag) (v tv : TagVal)
    (h : (env.insert k' v).get? k = some tv) :
    (k' = k ∧ tv = v) ∨ env.get? k = some tv := by
  by_cases hcmp : compare k' k = Ordering.eq
  · have hk' : k' = k := (Nat.compare_eq_eq).1 hcmp
    subst hk'
    rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_insert_self] at h
    exact Or.inl ⟨rfl, (Option.some.inj h).symm⟩
  · rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_insert] at h
    simp only [hcmp, ite_false] at h
    rw [← Std.ExtTreeMap.get?_eq_getElem?] at h
    exact Or.inr h

/-- One effect of `installEffectGuards`: the environment is unchanged, or it gains
    the tag of the guard closure the effect's predicate resolves to, with the
    regime's value at that tag. -/
private lemma installEffectGuards_single_get?_cases
    (acc : TagEnv) (effect : Effect) (unifiedEnv : VarTypeEnv) (unifiedBinds : BindEnv) (tagMapping : TagMapping)
    (pc : Poison) (R : Regime) (fuel : Nat) (k : Tag) (tv : TagVal)
    (h : (installEffectGuards acc [effect] unifiedEnv unifiedBinds tagMapping pc R fuel).get? k = some tv) :
    acc.get? k = some tv ∨
      (R.lookup? k = some tv.value ∧
        ∃ an pb ve, resolveSyntaxPred effect.pred unifiedEnv unifiedBinds tagMapping =
          .ok (Predicate.guardClosure k an pb ve)) := by
  obtain ⟨⟨v⟩, _epois, epred⟩ := effect
  simp only [installEffectGuards, List.foldl] at h
  cases hl : unifiedEnv.lookup v with
  | none => simp only [hl] at h; exact Or.inl h
  | some qt =>
    simp only [hl] at h
    cases he : qt.etyp
    case ref ls =>
      simp only [he] at h
      cases hp : pc with
      | true => simp only [hp, ite_true] at h; exact Or.inl h
      | false =>
        simp only [hp, Bool.false_eq_true, ite_false] at h
        cases hr : resolveSyntaxPred epred unifiedEnv unifiedBinds tagMapping with
        | error _ => simp only [hr] at h; exact Or.inl h
        | ok rp =>
          simp only [hr] at h
          cases rp with
          | guardClosure k' an pb ve =>
            simp only at h
            cases hR : R.lookup? k' with
            | none => simp only [hR] at h; exact Or.inl h
            | some b =>
              simp only [hR] at h
              cases hd : extractDepsFromPred (Predicate.guardClosure k' an pb ve) fuel with
              | error _ => simp only [hd] at h; exact Or.inl h
              | ok deps =>
                simp only [hd] at h
                cases ha : acc.get? k' <;> simp only [ha] at h
                all_goals
                  rcases tagEnv_get?_insert_cases _ _ _ _ _ h with ⟨hk, htv⟩ | hold
                  · subst hk htv
                    exact Or.inr ⟨hR, an, pb, ve, rfl⟩
                  · exact Or.inl hold
          | guardOnly _ => simp only at h; exact Or.inl h
          | noPred => simp only at h; exact Or.inl h
    all_goals (simp only [he] at h; exact Or.inl h)

/-- Case analysis of a lookup in `installEffectGuards`'s output: either the key was
    already bound (and is unchanged), or it is the tag of a guard closure that the
    predicate of one of the effects resolves to, whose tag-environment value is the
    regime's value at that tag. -/
lemma installEffectGuards_get?_cases
    (env : TagEnv) (effects : List Effect) (unifiedEnv : VarTypeEnv) (unifiedBinds : BindEnv) (tagMapping : TagMapping)
    (pc : Poison) (R : Regime) (fuel : Nat) (k : Tag) (tv : TagVal)
    (h : (installEffectGuards env effects unifiedEnv unifiedBinds tagMapping pc R fuel).get? k = some tv) :
    env.get? k = some tv ∨
      (R.lookup? k = some tv.value ∧
        ∃ effect ∈ effects, ∃ an pb ve,
          resolveSyntaxPred effect.pred unifiedEnv unifiedBinds tagMapping =
            .ok (Predicate.guardClosure k an pb ve)) := by
  induction effects generalizing env with
  | nil => exact Or.inl (by simpa [installEffectGuards] using h)
  | cons e es ih =>
      have hfold : installEffectGuards env (e :: es) unifiedEnv unifiedBinds tagMapping pc R fuel =
          installEffectGuards (installEffectGuards env [e] unifiedEnv unifiedBinds tagMapping pc R fuel)
            es unifiedEnv unifiedBinds tagMapping pc R fuel := by
        simp only [installEffectGuards, List.foldl]
      rw [hfold] at h
      rcases ih _ h with h1 | ⟨hR, e', he', an, pb, ve, hres⟩
      · rcases installEffectGuards_single_get?_cases _ _ _ _ _ _ _ _ k tv h1 with
          h0 | ⟨hR, an, pb, ve, hres⟩
        · exact Or.inl h0
        · exact Or.inr ⟨hR, e, List.mem_cons_self .., an, pb, ve, hres⟩
      · exact Or.inr ⟨hR, e', List.mem_cons_of_mem _ he', an, pb, ve, hres⟩

/-- A predicate that is not a guard with a body does not resolve to one. -/
private lemma resolveSyntaxPred_ne_guardClosure
    (sp : SyntaxPredicate) (env : VarTypeEnv) (binds : BindEnv) (tagMapping : TagMapping)
    (hsp : ∀ idx arg body, sp ≠ SyntaxPredicate.guardClosure idx arg body)
    (k : Tag) (an : Name) (pb : PExpr) (ve : CapturedVarEnv) :
    resolveSyntaxPred sp env binds tagMapping ≠ .ok (Predicate.guardClosure k an pb ve) := by
  cases sp with
  | noPred => simp [resolveSyntaxPred, pure, Except.pure]
  | guardOnly idx =>
      simp only [resolveSyntaxPred]
      split <;> simp [pure, Except.pure, throw, throwThe, MonadExceptOf.throw]
  | guardClosure idx arg body => exact absurd rfl (hsp idx arg body)

/-- `installEffectGuards` records nothing when no effect predicate is a guard with a
    body. -/
lemma installEffectGuards_eq_self
    (env : TagEnv) (effects : List Effect) (unifiedEnv : VarTypeEnv) (unifiedBinds : BindEnv) (tagMapping : TagMapping)
    (pc : Poison) (R : Regime) (fuel : Nat)
    (heff : ∀ effect ∈ effects, ∀ idx arg body,
      effect.pred ≠ SyntaxPredicate.guardClosure idx arg body) :
    installEffectGuards env effects unifiedEnv unifiedBinds tagMapping pc R fuel = env := by
  induction effects generalizing env with
  | nil => simp [installEffectGuards]
  | cons e es ih =>
      have hfold : installEffectGuards env (e :: es) unifiedEnv unifiedBinds tagMapping pc R fuel =
          installEffectGuards (installEffectGuards env [e] unifiedEnv unifiedBinds tagMapping pc R fuel)
            es unifiedEnv unifiedBinds tagMapping pc R fuel := by
        simp only [installEffectGuards, List.foldl]
      have hstep : installEffectGuards env [e] unifiedEnv unifiedBinds tagMapping pc R fuel = env := by
        have hne := resolveSyntaxPred_ne_guardClosure e.pred unifiedEnv unifiedBinds tagMapping
          (heff e (List.mem_cons_self ..))
        obtain ⟨⟨v⟩, _epois, epred⟩ := e
        simp only [installEffectGuards, List.foldl]
        cases hl : unifiedEnv.lookup v with
        | none => rfl
        | some qt =>
          dsimp only
          cases he : qt.etyp
          case ref ls =>
            dsimp only
            cases hp : pc with
            | true => simp only [ite_true]
            | false =>
              -- The wildcard branch of the match on the resolved predicate is
              -- discharged by `hne`.
              simp only [Bool.false_eq_true, ite_false]
          all_goals rfl
      rw [hfold, hstep]
      exact ih env (fun e' he' => heff e' (List.mem_cons_of_mem _ he'))

-- The extern tagEnv shape lemmas (`applyFnTClosure_extern_tagEnv_get_cases`
-- and `applyPFnTClosure_extern_tagEnv_get_cases`) live below, after the
-- `collectAndAllocExternTags` freshness lemmas they depend on.

/-- All tags in the tagEnv are strictly below nextTag. This is a typechecker invariant
    that ensures freshly allocated tags (from collectAndAllocExternTags) are absent from
    the tagEnv. -/
def tagEnvBounded (tagEnv : TagEnv) (nextTag : Tag) : Prop :=
  ∀ k, tagEnv.get? k ≠ none → k < nextTag

/-- Context-level version: the tagEnv is bounded by nextTag. -/
abbrev tagEnvBoundedInCtx (ctx : TypeContext) : Prop :=
  tagEnvBounded ctx.tagEnv ctx.nextTag

/-- A predicate's guard tag (if any) is below the given bound. -/
private def predTagBounded (bound : Tag) (p : Predicate) : Prop :=
  match p with
  | Predicate.guardClosure k _ _ _ => k < bound
  | Predicate.guardOnly k => k < bound
  | Predicate.noPred => True

/-- A QTyp's predicate guard tag is below the given bound. -/
abbrev qtypPredTagBounded (qt : QTyp) (bound : Tag) : Prop :=
  predTagBounded bound qt.pred

/-- All predicate guard tags in a variable environment are below the given bound. -/
private def predTagsBoundedInVarEnv (S : VarTypeEnv) (bound : Tag) : Prop :=
  ∀ x qt, S.lookup x = some qt → qtypPredTagBounded qt bound

/-- All predicate guard tags in a memory environment are below the given bound. -/
def predTagsBoundedInMemEnv (G : MemoryTypeEnv) (bound : Tag) : Prop :=
  ∀ l qt, G.lookup l = some qt → qtypPredTagBounded qt bound

/-- Both varEnv and memEnv predicate guard tags are bounded by ctx.nextTag. -/
def predTagsBoundedInCtx (ctx : TypeContext) : Prop :=
  predTagsBoundedInVarEnv ctx.varEnv ctx.nextTag ∧
  predTagsBoundedInMemEnv ctx.memEnv ctx.nextTag

/-- Helper: the tag-allocating forIn loop in collectAndAllocExternTags never decreases the tag counter. -/
private lemma forIn_tag_incr_ge
    (L : List (TagIndex × Name × Expr))
    (init_map : ExtTreeMap TagIndex Tag compare) (init_tag : Tag)
    (r : MProd (ExtTreeMap TagIndex Tag compare) Tag)
    (h : (forIn L ⟨init_map, init_tag⟩
      (fun (x : TagIndex × Name × Expr) (r : MProd (ExtTreeMap TagIndex Tag compare) Tag) =>
        (Except.ok (ForInStep.yield ⟨r.fst.insert x.1 r.snd, r.snd + 1⟩) : Except String _))
      = Except.ok r)) :
    init_tag ≤ r.snd := by
  induction L generalizing init_map init_tag with
  | nil =>
    simp only [forIn, List.forIn'_nil, pure, Except.pure, Except.ok.injEq] at h
    cases h; exact Nat.le_refl _
  | cons hd tl ih =>
    simp only [forIn, List.forIn'_cons, bind, Except.bind] at h
    exact Nat.le_trans (Nat.le_succ _) (ih _ _ h)

/-- collectAndAllocExternTags never decreases nextTag: the returned nextTag' ≥ input nextTag. -/
lemma collectAndAllocExternTags_nextTag_ge (preds : List SyntaxPredicate) (t : Tag)
    (map : ExtTreeMap TagIndex Tag) (t' : Tag) :
    collectAndAllocExternTags preds t = .ok (map, t') → t ≤ t' := by
  intro h
  unfold collectAndAllocExternTags at h
  simp only [bind, Except.bind, pure, Except.pure] at h
  revert h
  split
  · intro h; exact absurd h (by simp)
  · rename_i v _
    split
    · intro h; exact absurd h (by simp)
    · split
      · intro h; exact absurd h (by simp)
      · rename_i result hpass3
        intro h
        have heq := Except.ok.inj h
        have htagEq := (Prod.mk.inj heq).2
        rw [← htagEq]
        exact forIn_tag_incr_ge v.snd ∅ t result hpass3

/-- Helper: all values in the mapping produced by the forIn loop in
    collectAndAllocExternTags are ≥ the base tag. -/
private lemma forIn_tag_mapping_values_ge
    (L : List (TagIndex × Name × Expr))
    (init_map : ExtTreeMap TagIndex Tag compare) (init_tag base_tag : Tag)
    (r : MProd (ExtTreeMap TagIndex Tag compare) Tag)
    (hbase : base_tag ≤ init_tag)
    (hinit : ∀ (idx : TagIndex) (tag : Tag), init_map.get? idx = some tag → base_tag ≤ tag)
    (h : (forIn L ⟨init_map, init_tag⟩
      (fun (x : TagIndex × Name × Expr) (r : MProd (ExtTreeMap TagIndex Tag compare) Tag) =>
        (Except.ok (ForInStep.yield ⟨r.fst.insert x.1 r.snd, r.snd + 1⟩) : Except String _))
      = Except.ok r)) :
    ∀ (idx : TagIndex) (tag : Tag), r.fst.get? idx = some tag → base_tag ≤ tag := by
  induction L generalizing init_map init_tag with
  | nil =>
    simp only [forIn, List.forIn'_nil, pure, Except.pure, Except.ok.injEq] at h
    cases h; exact hinit
  | cons hd tl ih =>
    simp only [forIn, List.forIn'_cons, bind, Except.bind] at h
    apply ih (init_map.insert hd.1 init_tag) (init_tag + 1) (Nat.le_trans hbase (Nat.le_succ _)) _ h
    intro idx tag hget
    rw [ExtTreeMap.get?_eq_getElem?, ExtTreeMap.getElem?_insert] at hget
    split at hget
    · exact (Option.some.inj hget).symm ▸ hbase
    · rw [← ExtTreeMap.get?_eq_getElem?] at hget; exact hinit idx tag hget

/-- All concrete tags in the mapping produced by collectAndAllocExternTags are ≥ the input nextTag. -/
lemma collectAndAllocExternTags_mapping_values_ge (preds : List SyntaxPredicate) (t : Tag)
    (map : ExtTreeMap TagIndex Tag) (t' : Tag)
    (htc : collectAndAllocExternTags preds t = .ok (map, t'))
    (idx : TagIndex) (tag : Tag)
    (hget : map.get? idx = some tag) :
    t ≤ tag := by
  unfold collectAndAllocExternTags at htc
  simp only [bind, Except.bind, pure, Except.pure] at htc
  revert htc
  split
  · intro h; exact absurd h (by simp)
  · rename_i v _
    split
    · intro h; exact absurd h (by simp)
    · split
      · intro h; exact absurd h (by simp)
      · rename_i result hpass3
        intro htc
        have heq := Except.ok.inj htc
        have hmapEq := (Prod.mk.inj heq).1
        rw [← hmapEq] at hget
        refine forIn_tag_mapping_values_ge v.snd ∅ t t result (Nat.le_refl _) ?_ hpass3 idx tag hget
        intro idx' tag' hget'
        simp [ExtTreeMap.get?_eq_getElem?] at hget'

/-- Helper: all values in the mapping produced by the forIn loop are strictly less than the
    final tag counter. -/
private lemma forIn_tag_mapping_values_lt
    (L : List (TagIndex × Name × Expr))
    (init_map : ExtTreeMap TagIndex Tag compare) (init_tag : Tag)
    (r : MProd (ExtTreeMap TagIndex Tag compare) Tag)
    (hinit : ∀ (idx : TagIndex) (tag : Tag), init_map.get? idx = some tag → tag < init_tag)
    (h : (forIn L ⟨init_map, init_tag⟩
      (fun (x : TagIndex × Name × Expr) (r : MProd (ExtTreeMap TagIndex Tag compare) Tag) =>
        (Except.ok (ForInStep.yield ⟨r.fst.insert x.1 r.snd, r.snd + 1⟩) : Except String _))
      = Except.ok r)) :
    ∀ (idx : TagIndex) (tag : Tag), r.fst.get? idx = some tag → tag < r.snd := by
  induction L generalizing init_map init_tag with
  | nil =>
    simp only [forIn, List.forIn'_nil, pure, Except.pure, Except.ok.injEq] at h
    cases h; exact hinit
  | cons hd tl ih =>
    simp only [forIn, List.forIn'_cons, bind, Except.bind] at h
    apply ih (init_map.insert hd.1 init_tag) (init_tag + 1) _ h
    intro idx tag hget
    rw [ExtTreeMap.get?_eq_getElem?, ExtTreeMap.getElem?_insert] at hget
    split at hget
    · exact (Option.some.inj hget).symm ▸ Nat.lt_succ_self _
    · rw [← ExtTreeMap.get?_eq_getElem?] at hget
      exact Nat.lt_trans (hinit idx tag hget) (Nat.lt_succ_self _)

/-- All concrete tags in the mapping produced by collectAndAllocExternTags are strictly less than
    the returned nextTag'. -/
lemma collectAndAllocExternTags_mapping_values_lt (preds : List SyntaxPredicate) (t : Tag)
    (map : ExtTreeMap TagIndex Tag) (t' : Tag)
    (htc : collectAndAllocExternTags preds t = .ok (map, t'))
    (idx : TagIndex) (tag : Tag)
    (hget : map.get? idx = some tag) :
    tag < t' := by
  unfold collectAndAllocExternTags at htc
  simp only [bind, Except.bind, pure, Except.pure] at htc
  revert htc
  split
  · intro h; exact absurd h (by simp)
  · rename_i v _
    split
    · intro h; exact absurd h (by simp)
    · split
      · intro h; exact absurd h (by simp)
      · rename_i result hpass3
        intro htc
        have heq := Except.ok.inj htc
        have hmapEq := (Prod.mk.inj heq).1
        have htagEq := (Prod.mk.inj heq).2
        rw [← hmapEq] at hget
        rw [← htagEq]
        refine forIn_tag_mapping_values_lt v.snd ∅ t result ?_ hpass3 idx tag hget
        intro idx' tag' hget'
        simp [ExtTreeMap.get?_eq_getElem?] at hget'

/-- Helper: the tag-allocating loop in collectAndAllocExternTags keeps mapping values
    injective. Each inserted value is the current cursor, and every old value is strictly
    below that cursor. -/
private lemma forIn_tag_mapping_values_injective
    (L : List (TagIndex × Name × Expr))
    (init_map : ExtTreeMap TagIndex Tag compare) (init_tag : Tag)
    (r : MProd (ExtTreeMap TagIndex Tag compare) Tag)
    (hinit_lt : ∀ (idx : TagIndex) (tag : Tag), init_map.get? idx = some tag → tag < init_tag)
    (hinit_inj : ∀ (idx₁ idx₂ : TagIndex) (tag : Tag),
      init_map.get? idx₁ = some tag → init_map.get? idx₂ = some tag → idx₁ = idx₂)
    (h : (forIn L ⟨init_map, init_tag⟩
      (fun (x : TagIndex × Name × Expr) (r : MProd (ExtTreeMap TagIndex Tag compare) Tag) =>
        (Except.ok (ForInStep.yield ⟨r.fst.insert x.1 r.snd, r.snd + 1⟩) : Except String _))
      = Except.ok r)) :
    ∀ (idx₁ idx₂ : TagIndex) (tag : Tag),
      r.fst.get? idx₁ = some tag → r.fst.get? idx₂ = some tag → idx₁ = idx₂ := by
  induction L generalizing init_map init_tag with
  | nil =>
    simp only [forIn, List.forIn'_nil, pure, Except.pure, Except.ok.injEq] at h
    cases h
    exact hinit_inj
  | cons hd tl ih =>
    simp only [forIn, List.forIn'_cons, bind, Except.bind] at h
    refine ih (init_map.insert hd.1 init_tag) (init_tag + 1) ?_ ?_ h
    · intro idx tag hget
      rw [ExtTreeMap.get?_eq_getElem?, ExtTreeMap.getElem?_insert] at hget
      split at hget
      · exact (Option.some.inj hget).symm ▸ Nat.lt_succ_self _
      · rw [← ExtTreeMap.get?_eq_getElem?] at hget
        exact Nat.lt_trans (hinit_lt idx tag hget) (Nat.lt_succ_self _)
    · intro idx₁ idx₂ tag hget₁ hget₂
      refine ExtTreeMap_insert_preserves_injectivity init_map hd.1 init_tag ?_ hinit_inj
        idx₁ idx₂ tag hget₁ hget₂
      intro idx hget
      have hlt := hinit_lt idx init_tag hget
      exact Nat.lt_irrefl _ hlt

-- ==========================================================================
-- FnTClosure.extern / PFnTClosure.extern tagEnv shape lemmas (installReturnGuard).
-- The extern output tagEnv is the (fn: effect-invalidated) input tagEnv with
-- the regime-determined return guard installed (`installReturnGuard`): any
-- output binding is either an (invalidated) input binding or the freshly
-- installed guard, whose value the output regime interprets.
-- ==========================================================================

lemma applyFnTClosure_extern_tagEnv_get_cases
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (effects : List Effect) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (tv : TagVal) (h : r2.tagEnv'.get? k = some tv) :
  (invalidateTagDeps r1.tagEnv'
    (effectTargetLocs effects
      (VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
        ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩))).get? k = some tv ∨
    (r1.nextTag' ≤ k ∧ k < r2.nextTag' ∧ r2.regime'.lookup? k = some tv.value) := by
  unfold applyFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ n =>
      simp only [bind, Except.bind] at happly
      split at happly
      · exact nomatch happly
      simp only [pure, Except.pure] at happly
      split at happly
      · exact nomatch happly
      · next tmRes hcollect =>
        obtain ⟨tm, nt'⟩ := tmRes
        split at happly
        · exact nomatch happly
        · split at happly
          · -- ExternReturn.simple
            split at happly
            · exact nomatch happly
            · next resolvedPred hresolve =>
              split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                cases happly
                rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv h with
                  h1 | ⟨hR, _eff, _heff, an, pb, ve, hres⟩
                · rcases installReturnGuard_get?_cases _ _ _ _ k tv h1 with hold | ⟨hR, an, pb, ve, hrp⟩
                  · exact Or.inl hold
                  · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                      _ _ _ tm resolvedPred hresolve k an pb ve hrp
                    exact Or.inr
                      ⟨collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx k hidx,
                       collectAndAllocExternTags_mapping_values_lt _ _ _ _ hcollect idx k hidx,
                       hR⟩
                · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                    _ _ _ tm _ hres k an pb ve rfl
                  exact Or.inr
                    ⟨collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx k hidx,
                     collectAndAllocExternTags_mapping_values_lt _ _ _ _ hcollect idx k hidx,
                     hR⟩
          · -- ExternReturn.nestedFn
            split at happly
            · exact nomatch happly
            · next v hargCond =>
              split at happly
              · exact nomatch happly
              cases happly
              rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv h with
                hold | ⟨hR, _eff, _heff, an, pb, ve, hres⟩
              · exact Or.inl hold
              · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                  _ _ _ tm _ hres k an pb ve rfl
                refine Or.inr
                  ⟨collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx k hidx, ?_, hR⟩
                rw [resolveArgCondQTyp_snd hargCond]
                exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ hcollect idx k hidx
          · -- ExternReturn.nestedPfn
            split at happly
            · exact nomatch happly
            · next v hargCond =>
              split at happly
              · exact nomatch happly
              cases happly
              rcases installEffectGuards_get?_cases _ _ _ _ _ _ _ _ k tv h with
                hold | ⟨hR, _eff, _heff, an, pb, ve, hres⟩
              · exact Or.inl hold
              · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                  _ _ _ tm _ hres k an pb ve rfl
                refine Or.inr
                  ⟨collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx k hidx, ?_, hR⟩
                rw [resolveArgCondQTyp_snd hargCond]
                exact collectAndAllocExternTags_mapping_values_lt _ _ _ _ hcollect idx k hidx

lemma applyPFnTClosure_extern_tagEnv_get_cases
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (tv : TagVal) (h : r2.tagEnv'.get? k = some tv) :
  r1.tagEnv'.get? k = some tv ∨
    (r1.nextTag' ≤ k ∧ k < r2.nextTag' ∧ r2.regime'.lookup? k = some tv.value) := by
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ n =>
      simp only [bind, Except.bind] at happly
      split at happly
      · exact nomatch happly
      simp only [pure, Except.pure] at happly
      split at happly
      · -- ExternReturn.simple
        split at happly
        · exact nomatch happly
        · next tmRes hcollect =>
          obtain ⟨tm, nt'⟩ := tmRes
          split at happly
          · exact nomatch happly
          · next resolvedPred hresolve =>
            split at happly
            · exact nomatch happly
            · split at happly
              · exact nomatch happly
              cases happly
              rcases installReturnGuard_get?_cases _ _ _ _ k tv h with hold | ⟨hR, an, pb, ve, hrp⟩
              · exact Or.inl hold
              · obtain ⟨idx, hidx⟩ := resolveSyntaxPred_guardClosure_tag_from_mapping
                  _ _ _ tm resolvedPred hresolve k an pb ve hrp
                exact Or.inr
                  ⟨collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx k hidx,
                   collectAndAllocExternTags_mapping_values_lt _ _ _ _ hcollect idx k hidx,
                   hR⟩
      · -- ExternReturn.nestedFn
        split at happly
        · exact nomatch happly
        · cases happly; exact Or.inl h
      · -- ExternReturn.nestedPfn
        split at happly
        · exact nomatch happly
        · cases happly; exact Or.inl h

/-- The mapping produced by collectAndAllocExternTags is injective in its concrete tags. -/
lemma collectAndAllocExternTags_mapping_values_injective (preds : List SyntaxPredicate) (t : Tag)
    (map : ExtTreeMap TagIndex Tag) (t' : Tag)
    (htc : collectAndAllocExternTags preds t = .ok (map, t'))
    (idx₁ idx₂ : TagIndex) (tag : Tag)
    (hget₁ : map.get? idx₁ = some tag)
    (hget₂ : map.get? idx₂ = some tag) :
    idx₁ = idx₂ := by
  unfold collectAndAllocExternTags at htc
  simp only [bind, Except.bind, pure, Except.pure] at htc
  revert htc
  split
  · intro h; exact absurd h (by simp)
  · rename_i v _
    split
    · intro h; exact absurd h (by simp)
    · split
      · intro h; exact absurd h (by simp)
      · rename_i result hpass3
        intro htc
        have heq := Except.ok.inj htc
        have hmapEq := (Prod.mk.inj heq).1
        rw [← hmapEq] at hget₁ hget₂
        refine forIn_tag_mapping_values_injective v.snd ∅ t result ?_ ?_ hpass3
          idx₁ idx₂ tag hget₁ hget₂
        · intro idx tag hget
          simp [ExtTreeMap.get?_eq_getElem?] at hget
        · intro idx₁ idx₂ tag hget₁ hget₂
          simp [ExtTreeMap.get?_eq_getElem?] at hget₁

private abbrev CollectExternSeenState :=
  MProd (List TagIndex) (List (TagIndex × Name × Expr))

private def collectAndAllocExternTags_seenStep
    (pred : SyntaxPredicate) (r : CollectExternSeenState) :
    Except String (ForInStep CollectExternSeenState) :=
  match pred with
  | SyntaxPredicate.guardClosure idx name body =>
      match r.snd.find? (fun (x : TagIndex × Name × Expr) => x.1 == idx) with
      | some (_, name', body') =>
          if ¬ name = name' ∨ beqExpr body body' = false then
            Except.error s!"Conflicting guardClosure definitions for tag index {repr idx.val}"
          else
            Except.ok (ForInStep.yield ⟨r.fst, r.snd⟩)
      | none =>
          Except.ok (ForInStep.yield ⟨r.fst, r.snd ++ [(idx, name, body)]⟩)
  | SyntaxPredicate.guardOnly idx =>
      Except.ok (ForInStep.yield ⟨r.fst ++ [idx], r.snd⟩)
  | SyntaxPredicate.noPred =>
      Except.ok (ForInStep.yield ⟨r.fst, r.snd⟩)

private lemma collectAndAllocExternTags_seenLoop_consistent
    (xs : List SyntaxPredicate) (guardOnlyIndices : List TagIndex)
    (seen : List (TagIndex × Name × Expr)) (r : CollectExternSeenState)
    (hseen_cons : ∀ {idx : TagIndex} {arg₁ arg₂ : Name} {body₁ body₂ : Expr},
      (idx, arg₁, body₁) ∈ seen →
      (idx, arg₂, body₂) ∈ seen →
      arg₁ = arg₂ ∧ body₁ = body₂)
    (h : forIn xs ⟨guardOnlyIndices, seen⟩ collectAndAllocExternTags_seenStep = .ok r) :
    (∀ {idx : TagIndex} {arg body arg' body'},
      (idx, arg, body) ∈ seen →
      SyntaxPredicate.guardClosure idx arg' body' ∈ xs →
      arg = arg' ∧ body = body') ∧
    (∀ {idx : TagIndex} {arg₁ arg₂ : Name} {body₁ body₂ : Expr},
      SyntaxPredicate.guardClosure idx arg₁ body₁ ∈ xs →
      SyntaxPredicate.guardClosure idx arg₂ body₂ ∈ xs →
      arg₁ = arg₂ ∧ body₁ = body₂) := by
  induction xs generalizing guardOnlyIndices seen with
  | nil =>
      constructor
      · intro idx arg body arg' body' _ hmem
        cases hmem
      · intro idx arg₁ arg₂ body₁ body₂ hmem _
        cases hmem
  | cons pred rest ih =>
      cases pred with
      | noPred =>
          simp only [collectAndAllocExternTags_seenStep, forIn, List.forIn'_cons,
            bind, Except.bind] at h
          have ihres := ih guardOnlyIndices seen hseen_cons h
          constructor
          · intro idx arg body arg' body' hseen hmem
            simp at hmem
            exact ihres.1 hseen hmem
          · intro idx arg₁ arg₂ body₁ body₂ hmem₁ hmem₂
            simp at hmem₁ hmem₂
            exact ihres.2 hmem₁ hmem₂
      | guardOnly idx₀ =>
          simp only [collectAndAllocExternTags_seenStep, forIn, List.forIn'_cons,
            bind, Except.bind] at h
          have ihres := ih (guardOnlyIndices ++ [idx₀]) seen hseen_cons h
          constructor
          · intro idx arg body arg' body' hseen hmem
            simp at hmem
            exact ihres.1 hseen hmem
          · intro idx arg₁ arg₂ body₁ body₂ hmem₁ hmem₂
            simp at hmem₁ hmem₂
            exact ihres.2 hmem₁ hmem₂
      | guardClosure idx₀ arg₀ body₀ =>
          simp only [forIn, List.forIn'_cons, bind, Except.bind] at h
          simp only [collectAndAllocExternTags_seenStep] at h
          cases hfind : List.find? (fun (x : TagIndex × Name × Expr) => x.1 == idx₀) seen with
          | some found =>
            rcases found with ⟨idxSeen, restFound⟩
            rcases restFound with ⟨argSeen, bodySeen⟩
            by_cases hconflict : ¬ arg₀ = argSeen ∨ beqExpr body₀ bodySeen = false
            · simp [hfind, hconflict] at h
            · simp [hfind, hconflict] at h
              have hidxSeen : idxSeen = idx₀ := by
                have hp := List.find?_some hfind
                simpa using (LawfulBEq.eq_of_beq hp : idxSeen = idx₀)
              have hfound_mem : (idxSeen, argSeen, bodySeen) ∈ seen :=
                List.mem_of_find?_eq_some hfind
              subst idxSeen
              have hname_eq : arg₀ = argSeen := by
                exact not_not.mp (fun hne => hconflict (Or.inl hne))
              have hbody_eq : body₀ = bodySeen := by
                have hp : beqExpr body₀ bodySeen = true := by
                  cases hbody : beqExpr body₀ bodySeen
                  · exact (hconflict (Or.inr hbody)).elim
                  · rfl
                exact LawfulBEq.eq_of_beq hp
              have hfound_mem' : (idx₀, argSeen, bodySeen) ∈ seen := hfound_mem
              have ihres := ih guardOnlyIndices seen hseen_cons h
              constructor
              · intro idx arg body arg' body' hseen hmem
                simp only [List.mem_cons] at hmem
                rcases hmem with hhead | htail
                · have h_eqs :=
                    (SyntaxPredicate.guardClosure.injEq idx arg' body' idx₀ arg₀ body₀).mp hhead
                  obtain ⟨hidx, harg, hbody⟩ := h_eqs
                  subst idx
                  have hagree := hseen_cons hseen hfound_mem'
                  exact ⟨hagree.1.trans hname_eq.symm |>.trans harg.symm,
                    hagree.2.trans hbody_eq.symm |>.trans hbody.symm⟩
                · exact ihres.1 hseen htail
              · intro idx arg₁ arg₂ body₁ body₂ hmem₁ hmem₂
                simp only [List.mem_cons] at hmem₁ hmem₂
                rcases hmem₁ with hhead₁ | htail₁ <;> rcases hmem₂ with hhead₂ | htail₂
                · have h_eqs₁ :=
                    (SyntaxPredicate.guardClosure.injEq idx arg₁ body₁ idx₀ arg₀ body₀).mp hhead₁
                  have h_eqs₂ :=
                    (SyntaxPredicate.guardClosure.injEq idx arg₂ body₂ idx₀ arg₀ body₀).mp hhead₂
                  obtain ⟨_, harg₁, hbody₁⟩ := h_eqs₁
                  obtain ⟨_, harg₂, hbody₂⟩ := h_eqs₂
                  exact ⟨harg₁.trans harg₂.symm, hbody₁.trans hbody₂.symm⟩
                · have h_eqs₁ :=
                    (SyntaxPredicate.guardClosure.injEq idx arg₁ body₁ idx₀ arg₀ body₀).mp hhead₁
                  obtain ⟨hidx₁, harg₁, hbody₁⟩ := h_eqs₁
                  subst idx
                  have htail_agree := ihres.1 hfound_mem' htail₂
                  exact ⟨harg₁.trans (hname_eq.trans htail_agree.1),
                    hbody₁.trans (hbody_eq.trans htail_agree.2)⟩
                · have h_eqs₂ :=
                    (SyntaxPredicate.guardClosure.injEq idx arg₂ body₂ idx₀ arg₀ body₀).mp hhead₂
                  obtain ⟨hidx₂, harg₂, hbody₂⟩ := h_eqs₂
                  subst idx
                  have htail_agree := ihres.1 hfound_mem' htail₁
                  exact ⟨htail_agree.1.symm.trans (hname_eq.symm.trans harg₂.symm),
                    htail_agree.2.symm.trans (hbody_eq.symm.trans hbody₂.symm)⟩
                · exact ihres.2 htail₁ htail₂
          | none =>
            simp [hfind] at h
            have htail :
                forIn rest ⟨guardOnlyIndices, seen ++ [(idx₀, arg₀, body₀)]⟩
                  collectAndAllocExternTags_seenStep = .ok r := by
              simpa [collectAndAllocExternTags_seenStep] using! h
            have hseen_cons' :
                ∀ {idx : TagIndex} {arg₁ arg₂ : Name} {body₁ body₂ : Expr},
                  (idx, arg₁, body₁) ∈ seen ++ [(idx₀, arg₀, body₀)] →
                  (idx, arg₂, body₂) ∈ seen ++ [(idx₀, arg₀, body₀)] →
                  arg₁ = arg₂ ∧ body₁ = body₂ := by
              intro idx arg₁ arg₂ body₁ body₂ hm₁ hm₂
              simp only [List.mem_append, List.mem_singleton] at hm₁ hm₂
              rcases hm₁ with hm₁ | hm₁ <;> rcases hm₂ with hm₂ | hm₂
              · exact hseen_cons hm₁ hm₂
              · cases hm₂
                have hnone := (List.find?_eq_none.mp hfind) (idx₀, arg₁, body₁) hm₁
                have hp : (((idx₀, arg₁, body₁) : TagIndex × Name × Expr).1 == idx₀) = true := by
                  simp
                exact (hnone hp).elim
              · cases hm₁
                have hnone := (List.find?_eq_none.mp hfind) (idx₀, arg₂, body₂) hm₂
                have hp : (((idx₀, arg₂, body₂) : TagIndex × Name × Expr).1 == idx₀) = true := by
                  simp
                exact (hnone hp).elim
              · cases hm₁
                cases hm₂
                exact ⟨rfl, rfl⟩
            have ihres := ih guardOnlyIndices (seen ++ [(idx₀, arg₀, body₀)]) hseen_cons' htail
            constructor
            · intro idx arg body arg' body' hseen hmem
              simp only [List.mem_cons] at hmem
              rcases hmem with hhead | htail
              · have h_eqs :=
                  (SyntaxPredicate.guardClosure.injEq idx arg' body' idx₀ arg₀ body₀).mp hhead
                obtain ⟨hidx, harg, hbody⟩ := h_eqs
                subst idx
                have hold : (idx₀, arg, body) ∈ seen ++ [(idx₀, arg₀, body₀)] := by
                  exact List.mem_append_left _ hseen
                have hnew : (idx₀, arg₀, body₀) ∈ seen ++ [(idx₀, arg₀, body₀)] := by
                  exact List.mem_append_right _ (by simp)
                have hagree := hseen_cons' hold hnew
                exact ⟨hagree.1.trans harg.symm, hagree.2.trans hbody.symm⟩
              · have hnew : (idx, arg, body) ∈ seen ++ [(idx₀, arg₀, body₀)] := by
                  exact List.mem_append_left _ hseen
                exact ihres.1 hnew htail
            · intro idx arg₁ arg₂ body₁ body₂ hmem₁ hmem₂
              simp only [List.mem_cons] at hmem₁ hmem₂
              rcases hmem₁ with hhead₁ | htail₁ <;> rcases hmem₂ with hhead₂ | htail₂
              · have h_eqs₁ :=
                  (SyntaxPredicate.guardClosure.injEq idx arg₁ body₁ idx₀ arg₀ body₀).mp hhead₁
                have h_eqs₂ :=
                  (SyntaxPredicate.guardClosure.injEq idx arg₂ body₂ idx₀ arg₀ body₀).mp hhead₂
                obtain ⟨_, harg₁, hbody₁⟩ := h_eqs₁
                obtain ⟨_, harg₂, hbody₂⟩ := h_eqs₂
                exact ⟨harg₁.trans harg₂.symm, hbody₁.trans hbody₂.symm⟩
              · have h_eqs₁ :=
                  (SyntaxPredicate.guardClosure.injEq idx arg₁ body₁ idx₀ arg₀ body₀).mp hhead₁
                obtain ⟨hidx₁, harg₁, hbody₁⟩ := h_eqs₁
                subst idx
                have hnew : (idx₀, arg₀, body₀) ∈ seen ++ [(idx₀, arg₀, body₀)] := by
                  exact List.mem_append_right _ (by simp)
                have hagree := ihres.1 hnew htail₂
                exact ⟨harg₁.trans hagree.1, hbody₁.trans hagree.2⟩
              · have h_eqs₂ :=
                  (SyntaxPredicate.guardClosure.injEq idx arg₂ body₂ idx₀ arg₀ body₀).mp hhead₂
                obtain ⟨hidx₂, harg₂, hbody₂⟩ := h_eqs₂
                subst idx
                have hnew : (idx₀, arg₀, body₀) ∈ seen ++ [(idx₀, arg₀, body₀)] := by
                  exact List.mem_append_right _ (by simp)
                have hagree := ihres.1 hnew htail₁
                exact ⟨hagree.1.symm.trans harg₂.symm, hagree.2.symm.trans hbody₂.symm⟩
              · exact ihres.2 htail₁ htail₂

/-- Successful extern-tag allocation rejects conflicting guardClosure definitions
    for the same symbolic tag index. -/
theorem collectAndAllocExternTags_consistent_preds
    (preds : List SyntaxPredicate) (nextTag : Tag)
    (mapping : TagMapping) (nextTag' : Tag)
    (h_alloc : collectAndAllocExternTags preds nextTag = .ok (mapping, nextTag'))
    {idx : TagIndex} {arg₁ arg₂ : Name} {body₁ body₂ : Expr} :
    SyntaxPredicate.guardClosure idx arg₁ body₁ ∈ preds →
    SyntaxPredicate.guardClosure idx arg₂ body₂ ∈ preds →
    arg₁ = arg₂ ∧ body₁ = body₂ := by
  unfold collectAndAllocExternTags at h_alloc
  simp only [bind, Except.bind, pure, Except.pure] at h_alloc
  revert h_alloc
  split
  · intro h
    exact absurd h (by simp)
  · rename_i v hpass1
    intro h_alloc
    have hpass1' :
        forIn preds ⟨([] : List TagIndex), ([] : List (TagIndex × Name × Expr))⟩
          collectAndAllocExternTags_seenStep = .ok v := by
      simpa [collectAndAllocExternTags_seenStep] using! hpass1
    refine (collectAndAllocExternTags_seenLoop_consistent preds [] [] v ?_ hpass1').2
    intro idx arg₁ arg₂ body₁ body₂ hmem
    cases hmem

/-- resolveSyntaxPred produces a predicate whose tag is bounded by t' when the tag mapping
    comes from collectAndAllocExternTags. -/
private lemma resolveSyntaxPred_predTagBounded
    (pred : SyntaxPredicate) (varEnv : VarTypeEnv) (binds : BindEnv)
    (mapping : ExtTreeMap TagIndex Tag) (t t' : Tag)
    (resolvedPred : Predicate)
    (htc_alloc : collectAndAllocExternTags [pred] t = .ok (mapping, t'))
    (htc_resolve : resolveSyntaxPred pred varEnv binds mapping = .ok resolvedPred) :
    predTagBounded t' resolvedPred := by
  unfold resolveSyntaxPred at htc_resolve
  cases pred with
  | guardClosure idx arg body =>
    simp [bind, Except.bind, pure, Except.pure] at htc_resolve
    split at htc_resolve
    · rename_i tag hget
      have hget' : mapping.get? idx = some tag := by
        rwa [ExtTreeMap.get?_eq_getElem?]
      cases hbody : body.toPExpr with
      | error => simp [hbody] at htc_resolve
      | ok pbody =>
        simp [hbody] at htc_resolve
        rw [← htc_resolve]; simp [predTagBounded]
        exact collectAndAllocExternTags_mapping_values_lt
          [SyntaxPredicate.guardClosure idx arg body] t mapping t' htc_alloc idx tag hget'
    · simp at htc_resolve
  | guardOnly idx =>
    simp [pure, Except.pure] at htc_resolve
    split at htc_resolve
    · rename_i tag hget
      have hget' : mapping.get? idx = some tag := by
        rwa [ExtTreeMap.get?_eq_getElem?]
      simp at htc_resolve
      rw [← htc_resolve]; simp [predTagBounded]
      exact collectAndAllocExternTags_mapping_values_lt
        [SyntaxPredicate.guardOnly idx] t mapping t' htc_alloc idx tag hget'
    · simp at htc_resolve
  | noPred =>
    simp [pure, Except.pure] at htc_resolve
    rw [← htc_resolve]; trivial

/-- A successful `typecheckExternVal` passed the declaration-site check. -/
theorem typecheckExternVal_ok_declSite {ctx : TypeContext} {id : ExternId} {typ : Typ}
    {poison : Bool} {pred : SyntaxPredicate} {fuel : Nat} {res : TypeResult}
    (htc : typecheckExternVal ctx id typ poison pred fuel = .ok res) :
    checkExternDeclSite ctx "val" id [] = .ok PUnit.unit := by
  cases c_eq : checkExternDeclSite ctx "val" id [] with
  | error e =>
      unfold typecheckExternVal at htc
      rw [c_eq] at htc
      cases htc
  | ok a => rfl

/-- The result of a successful `extern val` declaration: the fresh tags, the
    resolved guard and the converted surface type, with the policy applied to
    the fresh tags and the guard installed in the tag environment. A clean
    declaration has no predicate. -/
theorem typecheckExternVal_ok_shape {ctx : TypeContext} {id : ExternId} {typ : Typ}
    {poison : Bool} {pred : SyntaxPredicate} {fuel : Nat} {res : TypeResult}
    (htc : typecheckExternVal ctx id typ poison pred fuel = .ok res) :
    (poison = false → pred = .noPred) ∧
    ∃ (tagMapping : TagMapping) (nextTag' : Tag) (resolvedPred : Predicate)
      (surfResult : QTyp × TypeContext),
      collectAndAllocExternTags [pred] ctx.nextTag = .ok (tagMapping, nextTag') ∧
      resolveSyntaxPred pred ctx.varEnv ctx.bindEnv tagMapping = .ok resolvedPred ∧
      surfaceSpecToQTyp typ poison resolvedPred ctx = .ok surfResult ∧
      res = { qualType := surfResult.1, memEnv' := surfResult.2.memEnv,
              tagEnv' := installReturnGuard ctx.tagEnv resolvedPred
                (applyExternRegimePolicy ctx.regime id ctx.externRegime tagMapping) fuel,
              nextLoc' := surfResult.2.nextLoc, nextTag' := nextTag', nextBind' := surfResult.2.nextBind,
              regime' := applyExternRegimePolicy ctx.regime id ctx.externRegime tagMapping,
              declared' := id :: ctx.declaredExternRefs,
              tagLog' := externTagLog [pred] ctx.varEnv ctx.bindEnv tagMapping } := by
  have h0ok := typecheckExternVal_ok_declSite htc
  unfold typecheckExternVal at htc
  rw [h0ok] at htc
  simp only [bind, Except.bind] at htc
  split at htc
  · simp at htc
  · simp at htc
  · rename_i h1 h2
    refine ⟨fun hp => ?_, ?_⟩
    · subst hp
      cases pred with
      | noPred => rfl
      | guardOnly a => exact absurd rfl (h1 a)
      | guardClosure a b c => exact absurd rfl (h2 a b c)
    · simp only [pure, Except.pure] at htc
      cases halloc : collectAndAllocExternTags [pred] ctx.nextTag with
      | error err => simp [halloc] at htc
      | ok result =>
        rcases result with ⟨tagMapping, nextTag'⟩
        simp only [halloc] at htc
        cases hresolve : resolveSyntaxPred pred ctx.varEnv ctx.bindEnv tagMapping with
        | error err => simp [hresolve] at htc
        | ok resolvedPred =>
          simp only [hresolve] at htc
          cases hsurf : surfaceSpecToQTyp typ poison resolvedPred ctx with
          | error err => simp [hsurf] at htc
          | ok surfResult =>
            cases hreq : checkGuardBody ctx.varEnv fuel pred with
            | error err => simp [hsurf, hreq] at htc
            | ok _ =>
              simp only [hsurf, hreq, Except.ok.injEq] at htc
              exact ⟨tagMapping, nextTag', resolvedPred, surfResult, rfl, hresolve, hsurf, htc.symm⟩

-- nextTag monotonicity: per-construct lemmas and the main induction (`typecheck_nextTag_mono`)

private lemma typecheckExternVal_nextTag_mono
    (ctx : TypeContext) (id : ExternId) (typ : Typ)
    (poison : Bool) (pred : SyntaxPredicate) (fuel : Nat) (res : TypeResult) :
    typecheckExternVal ctx id typ poison pred fuel = .ok res →
    ctx.nextTag ≤ res.nextTag' := by
  intro htc
  obtain ⟨_, tagMapping, nextTag', _, _, halloc, _, _, rfl⟩ := typecheckExternVal_ok_shape htc
  exact collectAndAllocExternTags_nextTag_ge [pred] ctx.nextTag tagMapping nextTag' halloc

private lemma typecheckExternFn_preserves_nextTag
    (ctx : TypeContext) (id : ExternId) (arg : Name) (argTyp : Typ)
    (argPoison : Bool) (argPred : SyntaxPredicate)
    (retSpec : ExternReturn) (effects : List Effect) {fuel : Nat} (res : TypeResult) :
    typecheckExternFn ctx id arg argTyp argPoison argPred retSpec effects captures fuel = .ok res →
    res.nextTag' = ctx.nextTag := by
  intro htc
  obtain ⟨argQt, _, hres⟩ :=
    typecheckExternFn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec effects res htc
  rw [hres]

private lemma typecheckExternPfn_preserves_nextTag
    (ctx : TypeContext) (id : ExternId) (arg : Name) (argTyp : Typ)
    (argPoison : Bool) (argPred : SyntaxPredicate)
    (retSpec : ExternReturn) {fuel : Nat} (res : TypeResult) :
    typecheckExternPfn ctx id arg argTyp argPoison argPred retSpec captures fuel = .ok res →
    res.nextTag' = ctx.nextTag := by
  intro htc
  obtain ⟨argQt, _, hres⟩ :=
    typecheckExternPfn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec res htc
  rw [hres]

private lemma applyFnTClosure_nextTag_mono_normal
  (tcl : FnTClosure) (ctx : TypeContext)
  (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' → ctx'.nextTag ≤ res'.nextTag') :
  applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
  r1.nextTag' ≤ r2.nextTag' := by
  intro happly
  unfold applyFnTClosure at happly
  cases fuel with
  | zero =>
      simp at happly
  | succ fuel' =>
      cases tcl with
      | regular x body env =>
          simp [bind, Except.bind] at happly
          rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
            <;> rw [htc] at happly
            <;> simp at happly
          rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
          simp [hqt] at happly
          cases hsub : isErasureOf st2 _ with
          | false =>
              rw [hsub] at happly
              simp at happly
          | true =>
              rw [hsub] at happly
              simp [pure, Except.pure] at happly
              subst r2
              set ctx' : TypeContext := {
                pc := joinPoison p (joinPoison p1 ctx.pc),
                regime := r1.regime',
                memEnv := r1.memEnv',
                varEnv := (VarTypeEnv.ofCaptured env).update x
                    { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred },
                bindEnv := BindEnv.bindParam env x r1.nextBind', tagEnv := r1.tagEnv',
                nextLoc := r1.nextLoc',
                nextTag := r1.nextTag', nextBind := r1.nextBind' + 1,
                pureCtx := ctx.pureCtx,
                externRegime := ctx.externRegime,
                externRefAllowed := false,
                declaredExternRefs := r1.declared' } with hctx'
              have htc' : typecheck ctx' body fuel' = .ok r := by
                simpa [typecheck, hctx'] using htc
              have hmono := IH fuel' (Nat.lt_succ_self fuel') body ctx' r htc'
              simpa [hctx'] using hmono
      | extern id x retSpec effects capturedEnv declaredArgQt captures =>
          simp [bind, Except.bind, pure, Except.pure] at happly
          -- Leading argument-condition gate: throw branch is impossible on .ok.
          split at happly
          · simp at happly
          -- Extern case: r2.nextTag' = v.2 from collectAndAllocExternTags, and v.2 ≥ r1.nextTag'
          split at happly
          · simp at happly
          · rename_i heq'
            have htag := collectAndAllocExternTags_nextTag_ge _ _ _ _ heq'
            split at happly
            · simp at happly
            · split at happly
              · split at happly
                · simp at happly
                · split at happly
                  · simp at happly
                  · split at happly
                    · exact nomatch happly
                    simp only [Except.ok.injEq] at happly; rw [← happly]; exact htag
              · split at happly
                · simp at happly
                · rename_i hresolve
                  split at happly
                  · exact nomatch happly
                  simp only [Except.ok.injEq] at happly; rw [← happly]
                  exact htag.trans (Nat.le_of_eq (resolveArgCondQTyp_snd hresolve).symm)
              · split at happly
                · simp at happly
                · rename_i hresolve
                  split at happly
                  · exact nomatch happly
                  simp only [Except.ok.injEq] at happly; rw [← happly]
                  exact htag.trans (Nat.le_of_eq (resolveArgCondQTyp_snd hresolve).symm)

private lemma applyPFnTClosure_nextTag_mono_normal
  (tcl : PFnTClosure) (ctx : TypeContext)
  (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' → ctx'.nextTag ≤ res'.nextTag') :
  applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
  r1.nextTag' ≤ r2.nextTag' := by
  intro happly
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero =>
      simp at happly
  | succ fuel' =>
      cases tcl with
      | regular x body env =>
          simp [bind, Except.bind] at happly
          rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
            <;> rw [htc] at happly
            <;> simp at happly
          rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
          simp [hqt] at happly
          cases hsub : isErasureOf st2 _ with
          | false =>
              rw [hsub] at happly
              simp at happly
          | true =>
              rw [hsub] at happly
              simp [pure, Except.pure] at happly
              subst r2
              set ctx' : TypeContext := {
                pc := joinPoison p (joinPoison ctx.pc p1),
                regime := r1.regime',
                memEnv := r1.memEnv',
                varEnv := (VarTypeEnv.ofCaptured env).update x
                    { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred },
                bindEnv := BindEnv.bindParam env x r1.nextBind', tagEnv := r1.tagEnv',
                nextLoc := r1.nextLoc',
                nextTag := r1.nextTag', nextBind := r1.nextBind' + 1,
                pureCtx := true,
                externRegime := ctx.externRegime,
                externRefAllowed := false,
                declaredExternRefs := r1.declared' } with hctx'
              have htc' : typecheck ctx' body.toExpr fuel' = .ok r := by
                simpa [typecheck, hctx'] using htc
              have hmono := IH fuel' (Nat.lt_succ_self fuel') body.toExpr ctx' r htc'
              simpa [hctx'] using hmono
      | extern id x retSpec capturedEnv declaredArgQt captures =>
          simp [bind, Except.bind] at happly
          -- Leading argument-condition gate: throw branch is impossible on .ok.
          split at happly
          · simp at happly
          simp only [pure, Except.pure] at happly
          -- Extern case: simple uses collectAndAllocExternTags (≥ r1.nextTag');
          -- nestedFn/nestedPfn use resolveArgCondQTyp which leaves nextTag unchanged (Nat.le_refl)
          split at happly
          · -- simple case: allocates tags
            split at happly
            · simp at happly
            · rename_i heq'
              have htag := collectAndAllocExternTags_nextTag_ge _ _ _ _ heq'
              split at happly
              · simp at happly
              · split at happly
                · simp at happly
                · split at happly
                  · exact nomatch happly
                  simp only [Except.ok.injEq] at happly
                  rw [← happly]; exact htag
          · -- nestedFn: resolveArgCondQTyp leaves nextTag unchanged
            split at happly
            · simp at happly
            · rename_i hresolve
              simp only [Except.ok.injEq] at happly
              rw [← happly]
              exact Nat.le_of_eq (resolveArgCondQTyp_snd hresolve).symm
          · -- nestedPfn: resolveArgCondQTyp leaves nextTag unchanged
            split at happly
            · simp at happly
            · rename_i hresolve
              simp only [Except.ok.injEq] at happly
              rw [← happly]
              exact Nat.le_of_eq (resolveArgCondQTyp_snd hresolve).symm

private lemma foldl_max_ge_init (a : Nat) (xs : List Nat) :
    a ≤ List.foldl max a xs := by
  induction xs generalizing a with
  | nil =>
      simp
  | cons x xs ih =>
      calc
        a ≤ max a x := Nat.le_max_left a x
        _ ≤ List.foldl max (max a x) xs := ih (max a x)

private lemma foldl_max_ge_elem : ∀ (a : Nat) (xs : List Nat) (x : Nat),
    x ∈ xs → x ≤ List.foldl max a xs
  | _, _ :: _, _, .head _ => Nat.le_trans (Nat.le_max_right _ _) (foldl_max_ge_init _ _)
  | _, z :: ys, x, .tail _ hmem => foldl_max_ge_elem (max _ z) ys x hmem

private lemma typecheckApp_nextTag_mono_normal (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckApp ctx e1 e2 fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckApp at htc
  cases fuel <;> simp at htc
  rename_i fuel'
  simp [bind, Except.bind] at htc
  rcases hcte2 : typecheckExpr ctx e2 _ with _ | ⟨res2⟩
    <;> rw [hcte2] at htc
    <;> simp at htc
  rcases hq2 : res2.qualType with ⟨etyp2, poison2, pred2⟩
  simp [hq2] at htc
  set ctx' : TypeContext := {
    pc := ctx.pc,
    regime := res2.regime',
    memEnv := res2.memEnv',
    varEnv := ctx.varEnv,
    bindEnv := ctx.bindEnv, tagEnv := res2.tagEnv',
    nextLoc := res2.nextLoc',
    nextTag := res2.nextTag', nextBind := res2.nextBind',
    pureCtx := ctx.pureCtx,
    externRegime := ctx.externRegime,
    externRefAllowed := ctx.externRefAllowed,
    declaredExternRefs := res2.declared' } with hctx'
  rcases htce1 : typecheckExpr ctx' e1 _ with _ | ⟨res1⟩
    <;> rw [htce1] at htc
    <;> simp at htc
  rcases hq1 : res1.qualType with ⟨etyp1, poison1, pred1⟩
  simp [hq1] at htc
  rcases etyp1 with _ | _ | _ | _ | _ | ⟨t1, t2, p, fs⟩ | _
    <;> simp at htc
  · rcases hctxPure : ctx.pureCtx <;> simp [hctxPure] at htc
    rcases fs with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf t1 _
      <;> rw [hsub1] at htc
      <;> simp at htc
    rcases happly :
        applyFnTClosureAtCursor f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyFnTClosureAtCursor tcl t1 t2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨joined, hjoin, hres⟩ : ∃ joined, joinTypeResults ctx r rs' = .ok joined ∧
        { joined with tagLog' := res2.tagLog' ++ (res1.tagLog' ++ joined.tagLog') } = res := by
      cases hj : joinTypeResults ctx r rs' with
      | error e =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, rfl, htc⟩
    subst hres
    have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
    have hcte2' : typecheck ctx e2 fuel' = .ok res2 := by
      simpa [typecheck] using hcte2
    have h2 := IH fuel' h_fuel e2 ctx res2 hcte2'
    have htce1' : typecheck ctx' e1 fuel' = .ok res1 := by
      simpa [typecheck] using htce1
    have h1 := IH fuel' h_fuel e1 ctx' res1 htce1'
    have h_res2_le_res1 : res2.nextTag' ≤ res1.nextTag' := by
      simpa [hctx'] using h1
    have IH' :
        ∀ m < fuel', ∀ (e : Expr) (ctx'' : TypeContext) (res' : TypeResult),
          typecheck ctx'' e m = .ok res' → ctx''.nextTag ≤ res'.nextTag' := by
      intro m hm e ctx'' res' htc'
      exact IH m (Nat.lt_trans hm h_fuel) e ctx'' res' htc'
    have happly_old :
        applyFnTClosure f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1 fuel' = .ok r := by
      unfold applyFnTClosure
      unfold applyFnTClosureAtCursor at happly
      simpa using happly
    have h_r_mono : res1.nextTag' ≤ r.nextTag' := by
      exact applyFnTClosure_nextTag_mono_normal f ctx t1 t2 p poison1 etyp2 poison2 pred2 res1 r fuel' IH' happly_old
    have h_join :
        joined.nextTag' =
          List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      joinTypeResults_nextTag_eq_max ctx r rs' joined hjoin
    have h_ctx_le_r : ctx.nextTag ≤ r.nextTag' := by
      exact Nat.le_trans h2 (Nat.le_trans h_res2_le_res1 h_r_mono)
    have h_r_le_max :
        r.nextTag' ≤ List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) := by
      simpa [List.max] using foldl_max_ge_init r.nextTag' (rs'.map TypeResult.nextTag')
    have h_ctx_le_max :
        ctx.nextTag ≤ List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      Nat.le_trans h_ctx_le_r h_r_le_max
    simpa [h_join] using h_ctx_le_max
  · rename_i st1 st2 p tcls
    rcases tcls with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf st1 _
      <;> rw [hsub1] at htc
      <;> simp at htc
    rcases happly :
        applyPFnTClosureAtCursor f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyPFnTClosureAtCursor tcl st1 st2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨joined, hjoin, hres⟩ : ∃ joined, joinTypeResults ctx r rs' = .ok joined ∧
        { joined with tagLog' := res2.tagLog' ++ (res1.tagLog' ++ joined.tagLog') } = res := by
      cases hj : joinTypeResults ctx r rs' with
      | error e =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, rfl, htc⟩
    subst hres
    have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
    have hcte2' : typecheck ctx e2 fuel' = .ok res2 := by
      simpa [typecheck] using hcte2
    have h2 := IH fuel' h_fuel e2 ctx res2 hcte2'
    have htce1' : typecheck ctx' e1 fuel' = .ok res1 := by
      simpa [typecheck] using htce1
    have h1 := IH fuel' h_fuel e1 ctx' res1 htce1'
    have h_res2_le_res1 : res2.nextTag' ≤ res1.nextTag' := by
      simpa [hctx'] using h1
    have IH' :
        ∀ m < fuel', ∀ (e : Expr) (ctx'' : TypeContext) (res' : TypeResult),
          typecheck ctx'' e m = .ok res' → ctx''.nextTag ≤ res'.nextTag' := by
      intro m hm e ctx'' res' htc'
      exact IH m (Nat.lt_trans hm h_fuel) e ctx'' res' htc'
    have happly_old :
        applyPFnTClosure f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1 fuel' = .ok r := by
      unfold applyPFnTClosure
      unfold applyPFnTClosureAtCursor at happly
      simpa using happly
    have h_r_mono : res1.nextTag' ≤ r.nextTag' := by
      exact applyPFnTClosure_nextTag_mono_normal f ctx st1 st2 p poison1 etyp2 poison2 pred2 res1 r fuel' IH' happly_old
    have h_join :
        joined.nextTag' =
          List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      joinTypeResults_nextTag_eq_max ctx r rs' joined hjoin
    have h_ctx_le_r : ctx.nextTag ≤ r.nextTag' := by
      exact Nat.le_trans h2 (Nat.le_trans h_res2_le_res1 h_r_mono)
    have h_r_le_max :
        r.nextTag' ≤ List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) := by
      simpa [List.max] using foldl_max_ge_init r.nextTag' (rs'.map TypeResult.nextTag')
    have h_ctx_le_max :
        ctx.nextTag ≤ List.max (r.nextTag' :: rs'.map TypeResult.nextTag') (by intro h; cases h) :=
      Nat.le_trans h_ctx_le_r h_r_le_max
    simpa [h_join] using h_ctx_le_max

private lemma typecheckUnaryOp_nextTag_mono_normal (ctx : TypeContext) (op : UnaryOp) (e : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckUnaryOp ctx op e fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckUnaryOp at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hte : typecheckExpr ctx e fuel' with
      | error err =>
          simp [hte] at htc
      | ok r1 =>
          simp [hte] at htc
          rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
          simp [hq1] at htc
          cases hop : opUnaryEType? op etyp1 with
          | none =>
              simp [hop] at htc
          | some outType =>
              simp [hop, pure, Except.pure] at htc
              cases htc
              have hte' : typecheck ctx e fuel' = .ok r1 := by
                simpa [typecheck] using hte
              exact IH fuel' (Nat.lt_succ_self fuel') e ctx r1 hte'

private lemma typecheckOp_nextTag_mono_normal (ctx : TypeContext) (e1 e2 : Expr)
    (fuel : Nat) (op : Op) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckOp ctx e1 e2 fuel op = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckOp at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hte1 : typecheckExpr ctx e1 fuel' with
      | error err =>
          simp [hte1] at htc
      | ok r1 =>
          simp [hte1] at htc
          rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
          simp [hq1] at htc
          let ctx' : TypeContext := updateCtxFromResult ctx r1
          cases hte2 : typecheckExpr ctx' e2 fuel' with
          | error err =>
              erw [hte2] at htc
              simp at htc
          | ok r2 =>
              erw [hte2] at htc
              simp at htc
              rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
              simp [hq2] at htc
              cases hop : opEType? op etyp1 etyp2 with
              | none =>
                  simp [hop] at htc
              | some outType =>
                  simp [hop, pure, Except.pure] at htc
                  cases htc
                  have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                    simpa [typecheck] using hte1
                  have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                  have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                    simpa [typecheck, ctx'] using hte2
                  have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
                  exact Nat.le_trans h1 (by simpa [ctx'] using! h2)

private lemma typecheckSeq_nextTag_mono_normal (ctx : TypeContext) (e1 e2 : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckSeq ctx e1 e2 fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckSeq at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hte1 : typecheckExpr ctx e1 fuel' with
      | error err =>
          simp [hte1] at htc
      | ok r1 =>
          simp [hte1] at htc
          let ctx' := updateCtxFromResult ctx r1
          cases hte2 : typecheckExpr ctx' e2 fuel' with
          | error err =>
              simp [hte2, ctx'] at htc
          | ok r2 =>
              simp [hte2, ctx'] at htc
              have hres : { r2 with tagLog' := r1.tagLog' ++ r2.tagLog' } = res := by
                simpa [pure, Except.pure] using htc
              have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                simpa [typecheck] using hte1
              have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
              have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                simpa [typecheck, ctx'] using hte2
              have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
              have hctx : ctx.nextTag ≤ r2.nextTag' := Nat.le_trans h1 (by simpa [ctx', updateCtxFromResult] using h2)
              simpa [← hres] using hctx

private lemma typecheckNewRef_nextTag_mono_normal (ctx : TypeContext) (e : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
