/-- Abbreviation for the three-part ref-location context inputs. -/
private abbrev refLocsCtxInputs (ctx : TypeContext) : Prop :=
  (∀ l, ctx.memEnv.contains l → l < ctx.nextLoc) ∧
  varEnvRefLocsBounded ctx.varEnv ctx.nextLoc ∧
  varEnvClosuresCapturedRefLocsBounded ctx.varEnv ctx.nextLoc

/-- Convert typecheckExpr to typecheck (they are definitionally equal). -/
private lemma typecheck_of_typecheckExpr {ctx : TypeContext} {e : Expr} {fuel : Nat} {res : TypeResult}
    (h : typecheckExpr ctx e fuel = .ok res) : typecheck ctx e fuel = .ok res := h

/-- Main theorem: typechecking preserves `wfTypeResult` and ref-location boundedness for
    result etyp.  Strong induction on fuel.
    Hypotheses: the context's memEnv is well-formed, and varEnv entries and their
    closures have ref-locations bounded by nextLoc.
    Conclusion: the result is well-formed (`wfTypeResult`), and the result etyp's
    ref-locations and closure captured-env ref-locations are bounded by the result's nextLoc'. -/
private lemma typecheckExpr_preserves_refLocs_main :
    ∀ (fuel : Nat) (ctx : TypeContext) (e : Expr) (res : TypeResult),
    refLocsCtxInputs ctx →
    typecheck ctx e fuel = .ok res →
    refLocsResultOutputs res := by
  intro fuel
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
    intro ctx e res hwfCtx htc
    obtain ⟨hwfMem, hrlCtx, hclCtx⟩ := hwfCtx
    have IH' : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
        wfTypeContext ctx' →
        typecheck ctx' e' m = .ok res' → refLocsResultOutputs res' := by
      intro m hm e' ctx' res'; exact IH m hm ctx' e' res'
    have hnextLocMono : ctx.nextLoc ≤ res.nextLoc' :=
      typecheck_nextLoc_mono_main ctx e fuel res htc
    unfold typecheck at htc
    cases fuel with
    | zero => unfold typecheckExpr at htc; simp at htc
    | succ fuel' =>
      unfold typecheckExpr at htc
      unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      cases e with
      -- ────────────────── Trivial cases: result etyp is int/bool/unit/string ──────────────────
      | num _ | bool _ | unit | str _ =>
        simp [pure, Except.pure] at htc; cases htc
        exact ⟨hwfMem, trivial, trivial⟩

      -- ────────────────── var: etyp from varEnv lookup ──────────────────
      | var x =>
        simp at htc
        unfold typecheckVar at htc
        simp only [bind, Except.bind] at htc
        cases hlookup : ctx.varEnv.lookup x with
        | none => simp [hlookup] at htc
        | some qt =>
          simp [hlookup] at htc
          -- All typecheckVar paths return memEnv' = ctx.memEnv, nextLoc' = ctx.nextLoc
          -- and qualType.etyp = qt.etyp (or a subset)
          -- The key fact: etypRefLocsBounded qt.etyp ctx.nextLoc from hrlCtx
          have hrl_qt : etypRefLocsBounded qt.etyp ctx.nextLoc := hrlCtx x qt hlookup
          have hcl_qt : etypClosuresCapturedRefLocsBounded qt.etyp ctx.nextLoc := hclCtx x qt hlookup
          -- All paths through typecheckVar return nextLoc' = ctx.nextLoc
          -- and the result etyp is qt.etyp (possibly with pred changed)
          -- Since nextLoc' = ctx.nextLoc, the bounds transfer directly
          cases qt with
          | mk etyp poison pred =>
            simp at htc
            cases pred with
            | noPred =>
              simp [pure, Except.pure] at htc; cases htc
              exact ⟨hwfMem, hrl_qt, hcl_qt⟩
            | guardOnly k =>
              simp at htc
              by_cases hfn : etyp.isFunctionType
              · simp [hfn] at htc
              · simp [hfn] at htc
                revert htc; generalize ctx.tagEnv[k]? = tv
                cases tv with
                | none => intro htc; simp at htc; cases htc; exact ⟨hwfMem, hrl_qt, hcl_qt⟩
                | some tv => cases tv with | mk val deps =>
                  cases val <;> intro htc <;> simp at htc <;> cases htc <;> exact ⟨hwfMem, hrl_qt, hcl_qt⟩
            | guardClosure k tcls ptcls body_t =>
              simp at htc
              by_cases hfn : etyp.isFunctionType
              · simp [hfn] at htc
              · simp [hfn] at htc
                revert htc; generalize ctx.tagEnv[k]? = tv
                cases tv with
                | none => intro htc; simp at htc; cases htc; exact ⟨hwfMem, hrl_qt, hcl_qt⟩
                | some tv => cases tv with | mk val deps =>
                  cases val <;> intro htc <;> simp at htc <;> cases htc <;> exact ⟨hwfMem, hrl_qt, hcl_qt⟩

      -- ────────────────── fn: captures varEnv into closure ──────────────────
      | fn x st1 body st2 =>
        have hfn := typecheckFn_ok_eq htc; subst hfn
        -- Result etyp = arrow st1 st2 ctx.pc [FnTClosure.regular x body (toCaptured ctx.varEnv ctx.bindEnv)]
        -- etypRefLocsBounded for arrow is True
        refine ⟨hwfMem, trivial, ?_⟩
        -- etypClosuresCapturedRefLocsBounded: one closure, need CapturedEnvRefLocsFullBounded
        intro tcl hmem
        simp at hmem; subst hmem
        exact CapturedEnvRefLocsFullBounded_of_toCaptured hrlCtx hclCtx

      -- ────────────────── pfn: captures varEnv into closure ──────────────────
      | pfn x st1 body st2 =>
        unfold typecheckPfn at htc
        simp [bind, Except.bind] at htc
        cases h_topexpr : body.toPExpr with
        | error _ => simp [h_topexpr] at htc
        | ok pbody =>
          simp [h_topexpr, pure, Except.pure] at htc; cases htc
          refine ⟨hwfMem, trivial, ?_⟩
          intro tcl hmem
          simp at hmem; subst hmem
          exact CapturedEnvRefLocsFullBounded_of_toCaptured hrlCtx hclCtx

      -- ────────────────── externFn: captures varEnv into closure ──────────────────
      | externFn id x argTyp argPoison argPred retSpec effects =>
        obtain ⟨argQt, _, htc_res⟩ :=
          typecheckExternFn_ok_res_eq ctx id x argTyp argPoison argPred retSpec effects res htc
        subst htc_res
        refine ⟨hwfMem, trivial, ?_⟩
        intro tcl hmem
        simp at hmem; subst hmem
        exact CapturedEnvRefLocsFullBounded_of_toCaptured hrlCtx hclCtx

      -- ────────────────── externPfn: captures varEnv into closure ──────────────────
      | externPfn id x argTyp argPoison argPred retSpec =>
        obtain ⟨argQt, _, htc_res⟩ :=
          typecheckExternPfn_ok_res_eq ctx id x argTyp argPoison argPred retSpec res htc
        subst htc_res
        refine ⟨hwfMem, trivial, ?_⟩
        intro tcl hmem
        simp at hmem; subst hmem
        exact CapturedEnvRefLocsFullBounded_of_toCaptured hrlCtx hclCtx

      -- ────────────────── externRef: allocates one fresh ref location ──────────────────
      | externRef _id _rp _rpred _cp _cpred =>
        simp at htc
        have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
        subst hres
        refine ⟨?_, ?_, trivial⟩
        · -- wfTypeResult: all locs in memEnv' are < nextLoc'
          intro l' hl'
          rcases updateMemEnv_contains_eq_or_old ctx.memEnv ctx.nextLoc l' _ hl' with h | h
          · rw [h]; exact Nat.lt_succ_self _
          · exact Nat.lt_of_lt_of_le (hwfMem l' h) (Nat.le_succ _)
        · -- etypRefLocsBounded for ref (singleton ctx.nextLoc) bounded by ctx.nextLoc + 1
          intro l hmem
          simp [LocSet.singleton] at hmem
          subst hmem; exact Nat.lt_succ_self _

      -- ────────────────── externVal: result from surfaceSpecToQTyp ──────────────────
      | externVal typ poison pred =>
        -- externVal: result etyp is int, bool, unit, string, or ref with fresh loc
        -- All have trivial or freshly-bounded ref-locs
        have h0ok := typecheckExternVal_ok_declSite htc
        simp only [typecheckExternVal] at htc
        rw [h0ok] at htc
        simp [Bind.bind, Except.bind, pure, Except.pure] at htc
        split at htc <;> simp (config := { failIfUnchanged := false }) at htc
        split at htc <;> simp (config := { failIfUnchanged := false }) at htc
        split at htc <;> simp (config := { failIfUnchanged := false }) at htc
        split at htc <;> simp (config := { failIfUnchanged := false }) at htc
        split at htc <;> simp (config := { failIfUnchanged := false }) at htc
        cases htc
        rename_i _surf _heqSurf _ _ _
        unfold surfaceSpecToQTyp at _heqSurf
        split at _heqSurf <;> simp [bind, Except.bind, pure, Except.pure] at _heqSurf
        · cases _heqSurf; exact ⟨hwfMem, trivial, trivial⟩  -- int
        · cases _heqSurf; exact ⟨hwfMem, trivial, trivial⟩  -- bool
        · cases _heqSurf; exact ⟨hwfMem, trivial, trivial⟩  -- unit
        · cases _heqSurf; exact ⟨hwfMem, trivial, trivial⟩  -- string

      -- ────────────────── op: result etyp from opEType? (always int or bool) ──────────────────
      | op e1 oper e2 =>
        simp at htc
        have hstruct := typecheckOp_structure ctx e1 e2 oper fuel' res htc
        rcases hstruct with ⟨r1_op, r2_op, result_etyp, htc1_op, htc2_op, hop,
          hmem_op, _, hnextloc_op, _, _, hretyp, _, _⟩
        have hmono1_op := typecheck_nextLoc_mono_main ctx e1 (fuel' - 1) r1_op htc1_op
        have hIH1_op := IH' (fuel' - 1) (by omega) e1 ctx r1_op ⟨hwfMem, hrlCtx, hclCtx⟩ htc1_op
        have hwfCtx2 := wfTypeContext_of_wfTypeResult ctx r1_op hIH1_op.1 ⟨hwfMem, hrlCtx, hclCtx⟩ hmono1_op
        have hwfR2 := (IH' (fuel' - 1) (by omega) e2 _ r2_op hwfCtx2 htc2_op).1
        refine ⟨by intro l h; rw [hmem_op] at h; rw [hnextloc_op]; exact hwfR2 l h, ?_⟩
        show etypRefLocsBounded res.qualType.etyp res.nextLoc' ∧
             etypClosuresCapturedRefLocsBounded res.qualType.etyp res.nextLoc'
        rw [hretyp]
        cases result_etyp with
        | int | bool | unit | string => exact ⟨trivial, trivial⟩
        | ref ls => exact absurd hop (by unfold opEType?; split <;> simp)
        | arrow _ _ _ _ => exact absurd hop (by unfold opEType?; split <;> simp)
        | parrow _ _ _ _ => exact absurd hop (by unfold opEType?; split <;> simp)

      -- ────────────────── unaryop: result etyp from opUnaryEType? (always bool) ──────────────────
      | unaryop oper e1 =>
        simp at htc
        have hstruct := typecheckUnaryOp_structure ctx oper e1 fuel' res htc
        rcases hstruct with ⟨r1_uo, result_etyp, htc1_uo, hop, hmem_uo, _, hnextloc_uo, _, _, hretyp, _, _⟩
        have hwfR1 := (IH' (fuel' - 1) (by omega) e1 ctx r1_uo ⟨hwfMem, hrlCtx, hclCtx⟩ htc1_uo).1
        refine ⟨by intro l h; rw [hmem_uo] at h; rw [hnextloc_uo]; exact hwfR1 l h, ?_⟩
        show etypRefLocsBounded res.qualType.etyp res.nextLoc' ∧
             etypClosuresCapturedRefLocsBounded res.qualType.etyp res.nextLoc'
        rw [hretyp]
        cases result_etyp with
        | int | bool | unit | string => exact ⟨trivial, trivial⟩
        | ref ls => exact absurd hop (by unfold opUnaryEType?; split <;> simp)
        | arrow _ _ _ _ => exact absurd hop (by unfold opUnaryEType?; split <;> simp)
        | parrow _ _ _ _ => exact absurd hop (by unfold opUnaryEType?; split <;> simp)

      -- ────────────────── newRef: result etyp is ref with fresh location ──────────────────
      | newRef e1 =>
        simp at htc
        have hstruct := typecheckNewRef_structure ctx e1 fuel' res htc
        rcases hstruct with ⟨result1, l, htc1, hl, _, hretyp, _, _, hmem_nr, _, hnextloc, _, _⟩
        have hwfR1 := (IH' (fuel' - 1) (by omega) e1 ctx result1 ⟨hwfMem, hrlCtx, hclCtx⟩ htc1).1
        refine ⟨by intro l' hl'; rw [hmem_nr] at hl'; rw [hnextloc]
                   rcases updateMemEnv_contains_eq_or_old _ _ l' _ hl' with heq | hold
                   · rw [heq, hl]; exact Nat.lt_succ_self _
                   · exact Nat.lt_of_lt_of_le (hwfR1 l' hold) (Nat.le_succ _), ?_, ?_⟩
        · rw [hretyp, hl, hnextloc]
          intro l' hmem
          simp [LocSet.singleton] at hmem
          subst hmem; exact Nat.lt_succ_self _
        · rw [hretyp]; trivial

      -- ────────────────── assign: result etyp is unit ──────────────────
      | assign e1 e2 =>
        simp at htc
        have IH_wf : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
            wfTypeContext ctx' → typecheck ctx' e m = .ok res' → wfTypeResult res' :=
          fun m hm e' c r' hwfc htc' => (IH' m (by omega) e' c r' hwfc htc').1
        have hstruct := typecheckAssign_structure ctx e1 e2 fuel' res htc
        obtain ⟨_, _, _, _, _, _, _, _, _, _, hretyp, -⟩ := hstruct
        refine ⟨typecheckAssign_wfTypeResult ctx e1 e2 fuel' res ⟨hwfMem, hrlCtx, hclCtx⟩ IH_wf htc, ?_⟩
        rw [hretyp]; exact ⟨trivial, trivial⟩

      -- ────────────────── deref: result etyp is int ──────────────────
      | deref e1 =>
        simp at htc
        have IH_wf : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
            wfTypeContext ctx' → typecheck ctx' e m = .ok res' → wfTypeResult res' :=
          fun m hm e' c r' hwfc htc' => (IH' m (by omega) e' c r' hwfc htc').1
        refine ⟨typecheckDeref_wfTypeResult ctx e1 fuel' res ⟨hwfMem, hrlCtx, hclCtx⟩ IH_wf htc, ?_⟩
        rw [typecheckDeref_etyp_int ctx e1 fuel' res htc]
        exact ⟨trivial, trivial⟩

      -- ────────────────── seq: result from e2 ──────────────────
      | seq e1 e2 =>
        simp at htc
        have hstruct := typecheckSeq_structure ctx e1 e2 fuel' res htc
        rcases hstruct with ⟨result1, ctx', res, htc1, hctx', htc2, rfl⟩
        have htc1' : typecheck ctx e1 (fuel' - 1) = .ok result1 := by simpa using! htc1
        have hmono1 := typecheck_nextLoc_mono_main ctx e1 (fuel' - 1) result1 htc1'
        have hwf1 := (IH' (fuel' - 1) (by omega) e1 ctx result1 ⟨hwfMem, hrlCtx, hclCtx⟩ htc1').1
        have hctx'_inputs : refLocsCtxInputs ctx' := by
          rw [hctx']; simp only [refLocsCtxInputs, updateCtxFromResult]
          exact ⟨hwf1, varEnvRefLocsBounded_mono hrlCtx hmono1,
                 varEnvClosuresCapturedRefLocsBounded_mono hclCtx hmono1⟩
        have htc2' : typecheck ctx' e2 (fuel' - 1) = .ok res := by simpa using! htc2
        exact IH' (fuel' - 1) (by omega) e2 ctx' res hctx'_inputs htc2'

      -- ────────────────── vlet: bind x to e1 result, then e2 ──────────────────
      | vlet x e1 e2 =>
        simp at htc
        have hstruct := typecheckVlet_structure ctx x e1 e2 fuel' res htc
        rcases hstruct with ⟨result1, result2, ctx', htc1, hctx', htc2, hretyp2,
          hmem, _, hnextloc, _, _, _, _⟩
        have htc1' : typecheck ctx e1 (fuel' - 1) = .ok result1 := by simpa using! htc1
        have hmono1 := typecheck_nextLoc_mono_main ctx e1 (fuel' - 1) result1 htc1'
        have hwf1 := (IH' (fuel' - 1) (by omega) e1 ctx result1 ⟨hwfMem, hrlCtx, hclCtx⟩ htc1').1
        have hIH1 := IH' (fuel' - 1) (by omega) e1 ctx result1 ⟨hwfMem, hrlCtx, hclCtx⟩ htc1'
        have hctx'_inputs : refLocsCtxInputs ctx' := by
          rw [hctx']; simp only [refLocsCtxInputs]
          exact ⟨hwf1,
                 varEnvRefLocsBounded_update (varEnvRefLocsBounded_mono hrlCtx hmono1) hIH1.2.1,
                 varEnvClosuresCapturedRefLocsBounded_update
                   (varEnvClosuresCapturedRefLocsBounded_mono hclCtx hmono1) hIH1.2.2⟩
        have htc2' : typecheck ctx' e2 (fuel' - 1) = .ok result2 := by simpa using! htc2
        have hIH2 := IH' (fuel' - 1) (by omega) e2 ctx' result2 hctx'_inputs htc2'
        exact ⟨by intro l h; rw [hmem] at h; rw [hnextloc]; exact hIH2.1 l h,
               by rw [hretyp2, hnextloc]; exact hIH2.2.1,
               by rw [hretyp2, hnextloc]; exact hIH2.2.2⟩

      -- ────────────────── ite: three modes ──────────────────
      | ite e1 e2 e3 =>
        simp at htc
        show refLocsResultOutputs res
        -- Compute wfTypeResult once using per-case helper
        have IH_wf : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
            wfTypeContext ctx' → typecheck ctx' e m = .ok res' → wfTypeResult res' :=
          fun m hm e' c r' hwfc htc' => (IH' m (by omega) e' c r' hwfc htc').1
        have hwfRes := typecheckIf_wfTypeResult ctx e1 e2 e3 fuel' res ⟨hwfMem, hrlCtx, hclCtx⟩ IH_wf htc
        have hstruct := typecheckIf_structure ctx e1 e2 e3 fuel' res htc
        rcases hstruct with hmode1 | hmode2 | hmode3
        · -- Mode 1 (true branch): res.etyp = res2.etyp, nextLoc' = max
          obtain ⟨k, deps, _, _, res1, _, _, res2, _, htc_e2, _, _, _, hnextloc, _, _, _, -, hretyp⟩ := hmode1
          let ctxTrue := { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := res1.nextTag', nextBind := res1.nextBind', declaredExternRefs := res1.declared' }
          have htc2' : typecheck ctxTrue e2 (fuel' - 1) = .ok res2 := htc_e2
          have hIH2 := IH' (fuel' - 1) (by omega) e2 ctxTrue res2 ⟨hwfMem, hrlCtx, hclCtx⟩ htc2'
          refine ⟨hwfRes, ?_, ?_⟩
          · rw [hretyp, hnextloc]
            exact etypRefLocsBounded_mono hIH2.2.1 (Nat.le_max_left _ _)
          · rw [hretyp, hnextloc]
            exact etypClosuresCapturedRefLocsBounded_mono hIH2.2.2 (Nat.le_max_left _ _)
        · -- Mode 2 (false branch): res.etyp = res3.etyp, nextLoc' = max
          obtain ⟨k, deps, _, _, res1, _, _, res2, res3, htc_e2, htc_e3, _, _, hnextloc, _, _, _, -, hretyp⟩ := hmode2
          let ctxTrue := { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := res1.nextTag', nextBind := res1.nextBind', declaredExternRefs := res1.declared' }
          have hmono2 : ctx.nextLoc ≤ res2.nextLoc' :=
            typecheck_nextLoc_mono_main ctxTrue e2 (fuel' - 1) res2 htc_e2
          let ctxFalse : TypeContext :=
            { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                       nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind',
                       declaredExternRefs := res2.declared' }
          have hIH3 := IH' (fuel' - 1) (by omega) e3 ctxFalse res3
            ⟨fun l h => Nat.lt_of_lt_of_le (hwfMem l h) hmono2,
             varEnvRefLocsBounded_mono hrlCtx hmono2,
             varEnvClosuresCapturedRefLocsBounded_mono hclCtx hmono2⟩ htc_e3
          refine ⟨hwfRes, ?_, ?_⟩
          · rw [hretyp, hnextloc]
            exact etypRefLocsBounded_mono hIH3.2.1 (Nat.le_max_right _ _)
          · rw [hretyp, hnextloc]
            exact etypClosuresCapturedRefLocsBounded_mono hIH3.2.2 (Nat.le_max_right _ _)
        · -- Mode 3 (conservative): res.etyp = joinETyps res2 res3, nextLoc' = max
          obtain ⟨_, hmode3_rest⟩ := hmode3
          obtain ⟨res1, htc_e1, _, res2, htc_e2, res3, htc_e3,
            _, _, hnextloc, _, _, _, -, hretyp, -⟩ := hmode3_rest
          have htc1' := typecheck_of_typecheckExpr htc_e1
          have hmono1 := typecheck_nextLoc_mono_main ctx e1 (fuel' - 1) res1 htc1'
          have hwf1 := (IH' (fuel' - 1) (by omega) e1 ctx res1 ⟨hwfMem, hrlCtx, hclCtx⟩ htc1').1
          -- IH on e2: ctx for e2 has memEnv/nextLoc from res1, varEnv from ctx
          have hIH2 := IH' (fuel' - 1) (by omega) e2 _ res2 (by
            exact ⟨hwf1, varEnvRefLocsBounded_mono hrlCtx hmono1,
              varEnvClosuresCapturedRefLocsBounded_mono hclCtx hmono1⟩)
            (typecheck_of_typecheckExpr htc_e2)
          -- IH on e3: ctx has nextLoc = res2.nextLoc'
          have hmono12 : res1.nextLoc' ≤ res2.nextLoc' :=
            typecheck_nextLoc_mono_main _ e2 (fuel' - 1) res2 (typecheck_of_typecheckExpr htc_e2)
          have hIH3 := IH' (fuel' - 1) (by omega) e3 _ res3 (by
            exact ⟨fun l h => Nat.lt_of_lt_of_le (hwf1 l h) hmono12,
                   varEnvRefLocsBounded_mono hrlCtx (Nat.le_trans hmono1 hmono12),
                   varEnvClosuresCapturedRefLocsBounded_mono hclCtx (Nat.le_trans hmono1 hmono12)⟩)
            (typecheck_of_typecheckExpr htc_e3)
          refine ⟨hwfRes, ?_, ?_⟩
          · rw [hretyp, hnextloc]
            exact etypRefLocsBounded_joinETyps
                   (etypRefLocsBounded_mono hIH2.2.1 (Nat.le_max_left _ _))
                   (etypRefLocsBounded_mono hIH3.2.1 (Nat.le_max_right _ _))
          · rw [hretyp, hnextloc]
            exact etypClosuresCapturedRefLocsBounded_joinETyps
                   (etypClosuresCapturedRefLocsBounded_mono hIH2.2.2 (Nat.le_max_left _ _))
                   (etypClosuresCapturedRefLocsBounded_mono hIH3.2.2 (Nat.le_max_right _ _))

      -- ────────────────── app: closure application + join ──────────────────
      | app e1 e2 =>
        simp at htc
        show refLocsResultOutputs res
        -- Unfold typecheckApp
        unfold typecheckApp at htc
        cases fuel' with
        | zero => simp at htc
        | succ fuel'' =>
          simp at htc
          simp [bind, Except.bind] at htc
          -- Step 1: IH on e2 (argument, typechecked first)
          cases htc2 : typecheckExpr ctx e2 fuel'' with
          | error _ => simp [htc2] at htc
          | ok result2 =>
            simp [htc2] at htc
            have hmono2 : ctx.nextLoc ≤ result2.nextLoc' :=
              typecheck_nextLoc_mono_main ctx e2 fuel'' result2 htc2
            have hIH_e2 := IH' fuel'' (by omega) e2 ctx result2
              ⟨hwfMem, hrlCtx, hclCtx⟩ htc2
            -- Case-split on result2.qualType (needed for simp to reduce match in htc)
            cases hqt2 : result2.qualType with
            | mk etyp2 p2 pred2 =>
              simp [hqt2] at htc
              -- Build context for e1
              have hwf_ctx' : wfTypeContext (updateCtxFromResult ctx result2) :=
                ⟨hIH_e2.1, varEnvRefLocsBounded_mono hrlCtx hmono2,
                 varEnvClosuresCapturedRefLocsBounded_mono hclCtx hmono2⟩
              cases htc1 : typecheckExpr { ctx with memEnv := result2.memEnv', tagEnv := result2.tagEnv', nextLoc := result2.nextLoc', nextTag := result2.nextTag', nextBind := result2.nextBind', regime := result2.regime', declaredExternRefs := result2.declared' } e1 fuel'' with
              | error _ => simp [htc1] at htc
              | ok result1 =>
                simp [htc1] at htc
                have hIH_e1 := IH' fuel'' (by omega) e1 _ result1 hwf_ctx' htc1
                have hwf1 : wfTypeResult result1 := hIH_e1.1
                have hmono_e1 : result2.nextLoc' ≤ result1.nextLoc' :=
                  typecheck_nextLoc_mono_main _ e1 fuel'' result1 htc1
                have hArgRefLocs : etypRefLocsBounded etyp2 result1.nextLoc' := by
                  have := hIH_e2.2.1; simp [hqt2] at this
                  exact etypRefLocsBounded_mono this hmono_e1
                have hClosRefLocs := hIH_e1.2.2
                cases hqt1 : result1.qualType with
                | mk etyp1 p1_val pred1 =>
                  simp [hqt1] at htc hClosRefLocs
                  cases etyp1 with
                | arrow st1 st2 p tcls =>
                  simp at htc
                  by_cases hpure : ctx.pureCtx = true
                  · simp [hpure] at htc
                  · simp [hpure] at htc
                    by_cases hempty : tcls = []
                    · simp [hempty] at htc
                    · simp [hempty] at htc
                      by_cases hsub : isErasureOf st1 { etyp := etyp2, poison := p2, pred := pred2 } = false
                      · simp [hsub] at htc
                      · push Not at hsub
                        simp [hsub] at htc
                        cases tcls with
                        | nil =>
                            exact False.elim (hempty rfl)
                        | cons firstClosure restClosures =>
                          cases happly :
                              applyFnTClosureAtCursor firstClosure st1 st2 p p1_val etyp2 p2
                                pred2 ctx result1 (result1.nextTag', result1.nextLoc') result1.nextBind' fuel'' with
                          | error _ =>
                              simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                          | ok firstResult =>
                            simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                            cases hrest :
                                applyClosuresThreaded
                                  (fun tcl cursor bn =>
                                    applyFnTClosureAtCursor tcl st1 st2 p p1_val etyp2 p2
                                      pred2 ctx result1 cursor bn fuel'')
                                  restClosures (firstResult.nextTag', firstResult.nextLoc') firstResult.nextBind' with
                            | error _ =>
                                simp [hrest] at htc
                            | ok restResults =>
                              simp [hrest, pure, Except.pure] at htc
                              obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx firstResult restResults = .ok joined ∧
                                  res = { joined with tagLog' := L } := by
                                cases hj : joinTypeResults ctx firstResult restResults with
                                | error e => simp [hj, Functor.map, Except.map] at htc
                                | ok joined =>
                                    simp [hj, Functor.map, Except.map] at htc
                                    exact ⟨joined, _, rfl, htc.symm⟩
                              have hcaptLocs :
                                  ∀ tcl ∈ firstClosure :: restClosures, match tcl with
                                    | .regular _ _ env =>
                                        CapturedEnvRefLocsFullBounded env result1.nextLoc'
                                    | .extern _ _ _ _ env _ _ =>
                                        CapturedEnvRefLocsFullBounded env result1.nextLoc' := by
                                intro tcl htcl
                                exact hClosRefLocs tcl htcl
                              have hArgClosRefLocs :
                                  etypClosuresCapturedRefLocsBounded etyp2 result1.nextLoc' := by
                                have := hIH_e2.2.2
                                simp [hqt2] at this
                                exact etypClosuresCapturedRefLocsBounded_mono this hmono_e1
                              have hthread :
                                  applyClosuresThreaded
                                    (fun tcl cursor bn =>
                                      applyFnTClosureAtCursor tcl st1 st2 p p1_val etyp2 p2
                                        pred2 ctx result1 cursor bn fuel'')
                                    (firstClosure :: restClosures)
                                    (result1.nextTag', result1.nextLoc') result1.nextBind' =
                                      .ok (firstResult :: restResults) := by
                                simp [applyClosuresThreaded, happly, hrest, bind, Except.bind,
                                  pure, Except.pure]
                              have hall :=
                                  (applyFnClosuresThreaded_forall_refLocs
                                    (fuel'' + 1 + 1) IH' st1 st2 p p1_val etyp2 p2 pred2
                                    ctx result1 (result1.nextTag', result1.nextLoc') result1.nextBind' fuel''
                                    (by omega) hwf1 (Nat.le_refl _) (firstClosure :: restClosures)
                                    (firstResult :: restResults) hcaptLocs hArgRefLocs
                                    hArgClosRefLocs hthread).1
                              -- Each member's refLocsResultOutputs gives bounds at its own nextLoc.
                              -- joinTypeResults nextLoc = max of member nextLocs → transport via mono.
                              -- Per-member at res.nextLoc' (join lemma inputs):
                              have hrl_at_res : ∀ r ∈ firstResult :: restResults,
                                  etypRefLocsBounded r.qualType.etyp res.nextLoc' := by
                                intro r hr
                                have hro := hall r hr
                                exact etypRefLocsBounded_mono hro.2.1
                                  (joinTypeResults_member_nextLoc_le ctx firstResult restResults res hjoin r hr)
                              have hcrl_at_res : ∀ r ∈ firstResult :: restResults,
                                  etypClosuresCapturedRefLocsBounded r.qualType.etyp res.nextLoc' := by
                                intro r hr
                                have hro := hall r hr
                                exact etypClosuresCapturedRefLocsBounded_mono hro.2.2
                                  (joinTypeResults_member_nextLoc_le ctx firstResult restResults res hjoin r hr)
                              exact ⟨joinTypeResults_wfTypeResult ctx firstResult restResults res hjoin
                                      ((hall firstResult (by simp)).1)
                                      (fun r hr => (hall r (by simp [hr])).1),
                                joinTypeResults_etypRefLocsBounded ctx firstResult restResults res hjoin
                                  (hrl_at_res _ (by simp))
                                  (fun r hr => hrl_at_res r (by simp [hr])),
                                joinTypeResults_etypClosuresCapturedRefLocsBounded ctx firstResult restResults res hjoin
                                  (hcrl_at_res _ (by simp))
                                  (fun r hr => hcrl_at_res r (by simp [hr]))⟩
                | parrow st1 st2 p tcls_p =>
                  simp at htc
                  by_cases hempty : tcls_p = []
                  · simp [hempty] at htc
                  · simp [hempty] at htc
                    by_cases hsub : isErasureOf st1 { etyp := etyp2, poison := p2, pred := pred2 } = false
                    · simp [hsub] at htc
                    · push Not at hsub; simp [hsub] at htc
                      cases tcls_p with
                      | nil =>
                          exact False.elim (hempty rfl)
                      | cons firstClosure restClosures =>
                        cases happly :
                            applyPFnTClosureAtCursor firstClosure st1 st2 p p1_val etyp2 p2
                              pred2 ctx result1 (result1.nextTag', result1.nextLoc') result1.nextBind' fuel'' with
                        | error _ =>
                            simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                        | ok firstResult =>
                          simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                          cases hrest :
                              applyClosuresThreaded
                                (fun tcl cursor bn =>
                                  applyPFnTClosureAtCursor tcl st1 st2 p p1_val etyp2 p2
                                    pred2 ctx result1 cursor bn fuel'')
                                restClosures (firstResult.nextTag', firstResult.nextLoc') firstResult.nextBind' with
                          | error _ =>
                              simp [hrest] at htc
                          | ok restResults =>
                            simp [hrest, pure, Except.pure] at htc
                            obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx firstResult restResults = .ok joined ∧
                                res = { joined with tagLog' := L } := by
                              cases hj : joinTypeResults ctx firstResult restResults with
                              | error e => simp [hj, Functor.map, Except.map] at htc
                              | ok joined =>
                                  simp [hj, Functor.map, Except.map] at htc
                                  exact ⟨joined, _, rfl, htc.symm⟩
                            have hClosRefLocsP := hIH_e1.2.2
                            simp [hqt1] at hClosRefLocsP
                            have hcaptLocsP :
                                ∀ tcl ∈ firstClosure :: restClosures, match tcl with
                                  | .regular _ _ env =>
                                      CapturedEnvRefLocsFullBounded env result1.nextLoc'
                                  | .extern _ _ _ env _ _ =>
                                      CapturedEnvRefLocsFullBounded env result1.nextLoc' :=
                              fun tcl htcl => hClosRefLocsP tcl htcl
                            have hArgClosRefLocsP :
                                etypClosuresCapturedRefLocsBounded etyp2 result1.nextLoc' := by
                              have := hIH_e2.2.2
                              simp [hqt2] at this
                              exact etypClosuresCapturedRefLocsBounded_mono this hmono_e1
                            have hthread :
                                applyClosuresThreaded
                                  (fun tcl cursor bn =>
                                    applyPFnTClosureAtCursor tcl st1 st2 p p1_val etyp2 p2
                                      pred2 ctx result1 cursor bn fuel'')
                                  (firstClosure :: restClosures)
                                  (result1.nextTag', result1.nextLoc') result1.nextBind' =
                                    .ok (firstResult :: restResults) := by
                              simp [applyClosuresThreaded, happly, hrest, bind, Except.bind,
                                pure, Except.pure]
                            have hall :=
                                (applyPFnClosuresThreaded_forall_refLocs
                                  (fuel'' + 1 + 1) IH' st1 st2 p p1_val etyp2 p2 pred2
                                  ctx result1 (result1.nextTag', result1.nextLoc') result1.nextBind' fuel''
                                  (by omega) hwf1 (Nat.le_refl _) (firstClosure :: restClosures)
                                  (firstResult :: restResults) hcaptLocsP hArgRefLocs
                                  hArgClosRefLocsP hthread).1
                            have hrl_at_res : ∀ r ∈ firstResult :: restResults,
                                etypRefLocsBounded r.qualType.etyp res.nextLoc' := by
                              intro r hr; exact etypRefLocsBounded_mono (hall r hr).2.1
                                (joinTypeResults_member_nextLoc_le ctx firstResult restResults res hjoin r hr)
                            have hcrl_at_res : ∀ r ∈ firstResult :: restResults,
                                etypClosuresCapturedRefLocsBounded r.qualType.etyp res.nextLoc' := by
                              intro r hr; exact etypClosuresCapturedRefLocsBounded_mono (hall r hr).2.2
                                (joinTypeResults_member_nextLoc_le ctx firstResult restResults res hjoin r hr)
                            exact ⟨joinTypeResults_wfTypeResult ctx firstResult restResults res hjoin
                                    ((hall firstResult (by simp)).1)
                                    (fun r hr => (hall r (by simp [hr])).1),
                              joinTypeResults_etypRefLocsBounded ctx firstResult restResults res hjoin
                                (hrl_at_res _ (by simp))
                                (fun r hr => hrl_at_res r (by simp [hr])),
                              joinTypeResults_etypClosuresCapturedRefLocsBounded ctx firstResult restResults res hjoin
                                (hcrl_at_res _ (by simp))
                                (fun r hr => hcrl_at_res r (by simp [hr]))⟩
                | _ => simp at htc

/-- Public API: successful typechecking preserves wfTypeResult. -/
lemma typecheckExpr_preserves_wfTypeResult (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (hwf : wfTypeContext ctx) (htc : typecheck ctx e fuel = .ok res) :
    wfTypeResult res :=
  (typecheckExpr_preserves_refLocs_main fuel ctx e res hwf htc).1

/-- Public API: successful typechecking preserves etypRefLocsBounded for result etyp. -/
lemma typecheckExpr_preserves_etypRefLocsBounded (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (hwf : wfTypeContext ctx) (htc : typecheck ctx e fuel = .ok res) :
    etypRefLocsBounded res.qualType.etyp res.nextLoc' :=
  (typecheckExpr_preserves_refLocs_main fuel ctx e res hwf htc).2.1

/-- Public API: successful typechecking preserves etypClosuresCapturedRefLocsBounded for result etyp. -/
lemma typecheckExpr_preserves_etypClosuresCapturedRefLocsBounded (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult)
    (hwf : wfTypeContext ctx) (htc : typecheck ctx e fuel = .ok res) :
    etypClosuresCapturedRefLocsBounded res.qualType.etyp res.nextLoc' :=
  (typecheckExpr_preserves_refLocs_main fuel ctx e res hwf htc).2.2

lemma joinTypeResults_mem_contains_of_member
    (ctx : TypeContext) (first src : TypeResult) (rest : List TypeResult) (res : TypeResult)
    (_h_join : joinTypeResults ctx first rest = .ok res)
    (_hmem_src : src ∈ first :: rest) :
    ∀ l, src.memEnv'.contains l → res.memEnv'.contains l := by
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_acc_contains :
      ∀ (rs' : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs' = .ok acc' →
        ∀ l, acc.2.1.contains l → acc'.2.1.contains l := by
    intro rs' acc acc' hfold
    induction rs' generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at hfold
        subst acc'
        intro l hcontains
        exact hcontains
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at hfold
            let acc1 :
                ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag :=
              (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
                joinMemEnvsStrong acc.2.1 x.memEnv',
                joinPoison acc.2.2.1 resPoison,
                joinPredicates acc.2.2.2.1 resPred,
                joinTagEnvs acc.2.2.2.2.1 x.tagEnv',
                joinRegimes acc.2.2.2.2.2.1 x.regime',
                max acc.2.2.2.2.2.2.1 x.nextLoc',
                max acc.2.2.2.2.2.2.2 x.nextTag')
            have hfold_tail : List.foldlM joinStep acc1 xs = .ok acc' := by
              simpa [acc1] using hfold
            intro l hcontains_acc
            rcases memEnv_lookup_some_of_contains acc.2.1 l hcontains_acc with ⟨qt_acc, hlookup_acc⟩
            rcases joinMemEnvsStrong_lookup_some_of_left_lookup
                (env1 := acc.2.1) (env2 := x.memEnv') (l := l) (qt1 := qt_acc) hlookup_acc with
              ⟨qt_acc1, hlookup_acc1⟩
            have hcontains_acc1 : acc1.2.1.contains l := by
              apply memEnv_contains_of_lookup_some (env := acc1.2.1) (l := l) (qt := qt_acc1)
              simpa [acc1] using hlookup_acc1
            exact ih (acc := acc1) hfold_tail l hcontains_acc1
  have h_fold_member_contains :
      ∀ (rs' : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs' = .ok acc' →
        ∀ r ∈ rs', ∀ l, r.memEnv'.contains l → acc'.2.1.contains l := by
    intro rs' acc acc' hfold
    induction rs' generalizing acc with
    | nil =>
        intro r hr
        cases hr
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at hfold
            let acc1 :
                ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag :=
              (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
                joinMemEnvsStrong acc.2.1 x.memEnv',
                joinPoison acc.2.2.1 resPoison,
                joinPredicates acc.2.2.2.1 resPred,
                joinTagEnvs acc.2.2.2.2.1 x.tagEnv',
                joinRegimes acc.2.2.2.2.2.1 x.regime',
                max acc.2.2.2.2.2.2.1 x.nextLoc',
                max acc.2.2.2.2.2.2.2 x.nextTag')
            have hfold_tail : List.foldlM joinStep acc1 xs = .ok acc' := by
              simpa [acc1] using hfold
            intro r hr l hcontains_r
            rcases List.mem_cons.mp hr with hrx | hrxs
            · subst r
              rcases memEnv_lookup_some_of_contains x.memEnv' l hcontains_r with ⟨qt_x, hlookup_x⟩
              rcases joinMemEnvsStrong_lookup_some_of_right_lookup
                  (env1 := acc.2.1) (env2 := x.memEnv') (l := l) (qt2 := qt_x) hlookup_x with
                ⟨qt_acc1, hlookup_acc1⟩
              have hcontains_acc1 : acc1.2.1.contains l := by
                apply memEnv_contains_of_lookup_some (env := acc1.2.1) (l := l) (qt := qt_acc1)
                simpa [acc1] using hlookup_acc1
              exact h_fold_acc_contains xs acc1 acc' hfold_tail l hcontains_acc1
            · exact ih (acc := acc1) hfold_tail r hrxs l hcontains_r
  have hsrc_sum : src = first ∨ src ∈ rest := List.mem_cons.mp _hmem_src
  cases hqt : first.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe,
        MonadExceptOf.throw, TypecheckM] at _h_join
      cases hcheck :
          (List.foldlM
            (fun x result =>
              match result.qualType with
              | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
                if beqETypSignature etyp resEtyp = false then
                  Except.error
                    (toString "Closure alternatives produced incompatible result types: " ++
                      toString (repr etyp) ++ toString " vs " ++ toString (repr resEtyp))
                else Except.ok ())
            () rest : Except String Unit) with
      | error err =>
          erw [hcheck] at _h_join
          simp at _h_join
      | ok _ =>
          erw [hcheck] at _h_join
          simp at _h_join
          cases hfold :
              List.foldlM joinStep
                (etyp, first.memEnv', poison, pred, first.tagEnv', first.regime', first.nextLoc',
                  first.nextTag') rest with
          | error err =>
              erw [hfold] at _h_join
              simp at _h_join
          | ok a =>
              erw [hfold] at _h_join
              simp at _h_join
              subst res
              intro l hcontains_src
              cases hsrc_sum with
              | inl hsrc_eq =>
                  subst src
                  exact h_fold_acc_contains
                    rest
                    (etyp, first.memEnv', poison, pred, first.tagEnv', first.regime', first.nextLoc',
                      first.nextTag')
                    a
                    hfold l hcontains_src
              | inr hsrc_rest =>
                  exact h_fold_member_contains
                    rest
                    (etyp, first.memEnv', poison, pred, first.tagEnv', first.regime', first.nextLoc',
                      first.nextTag')
                    a
                    hfold src hsrc_rest l hcontains_src

private lemma applyFnTClosure_mem_contains_preserved
    (fuel_top : Nat)
    (IH : ∀ m < fuel_top, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' →
        ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (ctx : TypeContext) (result_fn : TypeResult) (fuel_call : Nat)
    (h_call_lt : fuel_call < fuel_top)
    (tcl : FnTClosure) (res : TypeResult)
    (htc : applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx result_fn fuel_call = .ok res) :
    ∀ l, result_fn.memEnv'.contains l → res.memEnv'.contains l := by
  cases fuel_call with
  | zero =>
      unfold applyFnTClosure at htc
      simp at htc
  | succ fuelBody =>
      cases tcl with
      | regular x body tenv =>
          unfold applyFnTClosure at htc
          simp only [bind, Except.bind] at htc
          let ctx'' : TypeContext :=
            { ctx with
              pc := joinPoison p (joinPoison p1 ctx.pc),
              memEnv := result_fn.memEnv',
              varEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured tenv) x
                ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩,
              bindEnv := BindEnv.bindParam tenv x result_fn.nextBind', tagEnv := result_fn.tagEnv',
              nextTag := result_fn.nextTag', nextBind := result_fn.nextBind' + 1,
              nextLoc := result_fn.nextLoc',
              regime := result_fn.regime',
              externRefAllowed := false,
              declaredExternRefs := result_fn.declared' }
          cases htc_body : typecheckExpr ctx'' body fuelBody with
          | error _ =>
              dsimp only [ctx''] at htc_body
              simp [htc_body] at htc
          | ok result3 =>
              dsimp only [ctx''] at htc_body
              simp only [htc_body] at htc
              have h_body_lt : fuelBody < fuel_top := Nat.lt_trans (Nat.lt_succ_self fuelBody) h_call_lt
              have hpres3 :
                  ∀ l, ctx''.memEnv.contains l → result3.memEnv'.contains l :=
                IH fuelBody h_body_lt body ctx'' result3
                  (by simpa [typecheck, ctx''] using htc_body)
              cases h_qt3 : result3.qualType with
              | mk etyp3 p3 pred3 =>
                  simp [h_qt3] at htc
                  cases hsub : isErasureOf st2 { etyp := etyp3, poison := p3, pred := pred3 } with
                  | false =>
                      simp [hsub] at htc
                  | true =>
                      simp [hsub, pure, Except.pure] at htc
                      cases htc
                      intro l hcontains
                      exact hpres3 l (by simpa [ctx''] using hcontains)
      | extern id x retSpec effects capturedEnv declaredArgQt captures =>
          unfold applyFnTClosure at htc
          simp only [bind, Except.bind] at htc
          have happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
              argEtyp argPoison argPred ctx result_fn (fuelBody + 1) = .ok res := by
            unfold applyFnTClosure; simp only [bind, Except.bind]; exact htc
          exact applyFnTClosure_extern_mem_contains_preserved ctx st1 st2 p p1 argEtyp argPoison
            argPred result_fn (fuelBody + 1) id x retSpec effects capturedEnv res declaredArgQt happly

private lemma applyPFnTClosure_mem_contains_preserved
    (fuel_top : Nat)
    (IH : ∀ m < fuel_top, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' →
        ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (ctx : TypeContext) (result_fn : TypeResult) (fuel_call : Nat)
    (h_call_lt : fuel_call < fuel_top)
    (tcl : PFnTClosure) (res : TypeResult)
    (htc : applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx result_fn fuel_call = .ok res) :
    ∀ l, result_fn.memEnv'.contains l → res.memEnv'.contains l := by
  cases fuel_call with
  | zero =>
      unfold applyPFnTClosure at htc
      simp at htc
  | succ fuelBody =>
      cases tcl with
      | regular x body tenv =>
          unfold applyPFnTClosure at htc
          simp only [bind, Except.bind] at htc
          let ctx'' : TypeContext :=
            { ctx with
              pc := joinPoison p (joinPoison ctx.pc p1),
              memEnv := result_fn.memEnv',
              varEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured tenv) x
                ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩,
              bindEnv := BindEnv.bindParam tenv x result_fn.nextBind', tagEnv := result_fn.tagEnv',
              pureCtx := true,
              nextLoc := result_fn.nextLoc',
              nextTag := result_fn.nextTag', nextBind := result_fn.nextBind' + 1,
              regime := result_fn.regime',
              externRefAllowed := false,
              declaredExternRefs := result_fn.declared' }
          cases htc_body : typecheckExpr ctx'' (PExpr.toExpr body) fuelBody with
          | error _ =>
              dsimp only [ctx''] at htc_body
              simp [htc_body] at htc
          | ok result3 =>
              dsimp only [ctx''] at htc_body
              simp only [htc_body] at htc
              have h_body_lt : fuelBody < fuel_top := Nat.lt_trans (Nat.lt_succ_self fuelBody) h_call_lt
              have hpres3 :
                  ∀ l, ctx''.memEnv.contains l → result3.memEnv'.contains l :=
                IH fuelBody h_body_lt (PExpr.toExpr body) ctx'' result3
                  (by simpa [typecheck, ctx''] using htc_body)
              cases h_qt3 : result3.qualType with
              | mk etyp3 p3 pred3 =>
                  simp [h_qt3] at htc
                  cases hsub : isErasureOf st2 { etyp := etyp3, poison := p3, pred := pred3 } with
                  | false =>
                      simp [hsub] at htc
                  | true =>
                      simp [hsub, pure, Except.pure] at htc
                      cases htc
                      intro l hcontains
                      exact hpres3 l (by simpa [ctx''] using hcontains)
      | extern id x retSpec capturedEnv declaredArgQt captures =>
          unfold applyPFnTClosure at htc
          simp only [bind, Except.bind] at htc
          -- Leading argument-condition gate: throw branch is impossible on .ok.
          split at htc
          · simp at htc
          simp only [pure, Except.pure] at htc
          split at htc
          · split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            cases htc; intro l hl; exact hl
          · split at htc
            · simp at htc
            · simp only [Except.ok.injEq] at htc
              subst htc; intro l hl; exact hl
          · split at htc
            · simp at htc
            · simp only [Except.ok.injEq] at htc
              subst htc; intro l hl; exact hl

private lemma typecheckApp_mem_contains_preserved
    (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' →
        ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l) :
    typecheckApp ctx e1 e2 fuel = .ok res →
    ∀ l, ctx.memEnv.contains l → res.memEnv'.contains l := by
  intro htc l hcontains
  cases fuel with
  | zero =>
      simp [typecheckApp] at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      unfold typecheckApp at htc
      simp only [bind, Except.bind] at htc
      cases htc2 : typecheckExpr ctx e2 fuel' with
      | error _ =>
          simp [htc2] at htc
      | ok result2 =>
          simp [htc2] at htc
          have hcontains2 : result2.memEnv'.contains l :=
            IH fuel' h_fuel e2 ctx result2 (by simpa [typecheck] using htc2) l hcontains
          cases hqt2 : result2.qualType with
          | mk etyp2 p2 pred2 =>
              simp [hqt2] at htc
              let ctxFun : TypeContext :=
                { ctx with
                  memEnv := result2.memEnv'
                  tagEnv := result2.tagEnv'
                  nextLoc := result2.nextLoc'
                  nextTag := result2.nextTag'
                  nextBind := result2.nextBind'
                  regime := result2.regime'
                  declaredExternRefs := result2.declared' }
              have hctxFun : ctxFun.memEnv.contains l := by
                simpa [ctxFun] using hcontains2
              cases htc1 : typecheckExpr ctxFun e1 fuel' with
              | error _ =>
                  simp [ctxFun, htc1] at htc
              | ok result1 =>
                  simp [ctxFun, htc1] at htc
                  have hcontains1 : result1.memEnv'.contains l :=
                    IH fuel' h_fuel e1 ctxFun result1
                      (by simpa [typecheck, ctxFun] using htc1) l hctxFun
                  cases hqt1 : result1.qualType with
                  | mk etyp1 p1_val pred1 =>
                      simp [hqt1] at htc
                      cases etyp1 with
                      | arrow st1 st2 p tcls =>
                          simp at htc
                          by_cases hpure : ctx.pureCtx = true
                          · simp [hpure] at htc
                          · simp [hpure] at htc
                            by_cases hempty : tcls = []
                            · simp [hempty] at htc
                            · simp [hempty] at htc
                              by_cases hsub : isErasureOf st1 { etyp := etyp2, poison := p2, pred := pred2 } = false
                              · simp [hsub] at htc
                              · push Not at hsub
                                simp [hsub] at htc
                                cases tcls with
                                | nil =>
                                    exact False.elim (hempty rfl)
                                | cons firstClosure restClosures =>
                                  cases happly :
                                      applyFnTClosureAtCursor firstClosure st1 st2 p p1_val
                                        etyp2 p2 pred2 ctx result1
                                        (result1.nextTag', result1.nextLoc') result1.nextBind' fuel' with
                                  | error _ =>
                                      simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                                  | ok firstResult =>
                                    simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                                    cases hrest :
                                        applyClosuresThreaded
                                          (fun tcl cursor bn =>
                                            applyFnTClosureAtCursor tcl st1 st2 p p1_val
                                              etyp2 p2 pred2 ctx result1 cursor bn fuel')
                                          restClosures
                                          (firstResult.nextTag', firstResult.nextLoc') firstResult.nextBind' with
                                    | error _ =>
                                        simp [hrest] at htc
                                    | ok restResults =>
                                      simp [hrest, pure, Except.pure] at htc
                                      obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx firstResult restResults = .ok joined ∧
                                          res = { joined with tagLog' := L } := by
                                        cases hj : joinTypeResults ctx firstResult restResults with
                                        | error e => simp [hj] at htc
                                        | ok joined =>
                                            simp [hj] at htc
                                            exact ⟨joined, _, rfl, htc.symm⟩
                                      have happly_old :
                                          applyFnTClosure firstClosure st1 st2 p p1_val etyp2 p2 pred2
                                            ctx result1 fuel' = .ok firstResult := by
                                        unfold applyFnTClosure
                                        unfold applyFnTClosureAtCursor at happly
                                        simpa using happly
                                      have hcontains_first : firstResult.memEnv'.contains l :=
                                        applyFnTClosure_mem_contains_preserved
                                          fuel'.succ IH st1 st2 p p1_val etyp2 p2 pred2
                                          ctx result1 fuel' h_fuel firstClosure firstResult
                                          happly_old l hcontains1
                                      exact
                                        joinTypeResults_mem_contains_of_member
                                          ctx firstResult firstResult restResults res hjoin
                                          (by simp) l hcontains_first
                      | parrow st1 st2 p tcls_p =>
                          simp at htc
                          by_cases hempty : tcls_p = []
                          · simp [hempty] at htc
                          · simp [hempty] at htc
                            by_cases hsub : isErasureOf st1 { etyp := etyp2, poison := p2, pred := pred2 } = false
                            · simp [hsub] at htc
                            · push Not at hsub
                              simp [hsub] at htc
                              cases tcls_p with
                              | nil =>
                                  exact False.elim (hempty rfl)
                              | cons firstClosure restClosures =>
                                cases happly :
                                    applyPFnTClosureAtCursor firstClosure st1 st2 p p1_val
                                      etyp2 p2 pred2 ctx result1
                                      (result1.nextTag', result1.nextLoc') result1.nextBind' fuel' with
                                | error _ =>
                                    simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                                | ok firstResult =>
                                  simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
                                  cases hrest :
                                      applyClosuresThreaded
                                        (fun tcl cursor bn =>
                                          applyPFnTClosureAtCursor tcl st1 st2 p p1_val
                                            etyp2 p2 pred2 ctx result1 cursor bn fuel')
                                        restClosures
                                        (firstResult.nextTag', firstResult.nextLoc') firstResult.nextBind' with
                                  | error _ =>
                                      simp [hrest] at htc
                                  | ok restResults =>
                                    simp [hrest, pure, Except.pure] at htc
                                    obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx firstResult restResults = .ok joined ∧
                                        res = { joined with tagLog' := L } := by
                                      cases hj : joinTypeResults ctx firstResult restResults with
                                      | error e => simp [hj] at htc
                                      | ok joined =>
                                          simp [hj] at htc
                                          exact ⟨joined, _, rfl, htc.symm⟩
                                    have happly_old :
                                        applyPFnTClosure firstClosure st1 st2 p p1_val etyp2 p2 pred2
                                          ctx result1 fuel' = .ok firstResult := by
                                      unfold applyPFnTClosure
                                      unfold applyPFnTClosureAtCursor at happly
                                      simpa using happly
                                    have hcontains_first : firstResult.memEnv'.contains l :=
                                      applyPFnTClosure_mem_contains_preserved
                                        fuel'.succ IH st1 st2 p p1_val etyp2 p2 pred2
                                        ctx result1 fuel' h_fuel firstClosure firstResult
                                        happly_old l hcontains1
                                    exact
                                      joinTypeResults_mem_contains_of_member
                                        ctx firstResult firstResult restResults res hjoin
                                        (by simp) l hcontains_first
                      | _ =>
                          simp at htc

private lemma typecheckAssign_mem_contains_preserved
    (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' →
        ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l) :
    typecheckAssign ctx e1 e2 fuel = .ok res →
    ∀ l, ctx.memEnv.contains l → res.memEnv'.contains l := by
  intro htc l hcontains
  cases fuel with
  | zero =>
      unfold typecheckAssign at htc
      simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      unfold typecheckAssign at htc
      simp only [bind, Except.bind] at htc
      cases h_tc1 : typecheckExpr ctx e1 fuel' with
      | error _ =>
          simp [h_tc1] at htc
      | ok result1 =>
          simp only [h_tc1] at htc
          have hcontains1 : result1.memEnv'.contains l :=
            IH fuel' h_fuel e1 ctx result1 (by simpa [typecheck] using h_tc1) l hcontains
          cases h_qt1 : result1.qualType with
          | mk etyp1 p1 pred1 =>
              rw [h_qt1] at htc
              simp at htc
              cases etyp1 with
              | ref ls =>
                  simp at htc
                  let ctx2 : TypeContext :=
                    { ctx with
                      memEnv := result1.memEnv'
                      tagEnv := result1.tagEnv'
                      nextLoc := result1.nextLoc'
                      nextTag := result1.nextTag'
                      nextBind := result1.nextBind'
                      regime := result1.regime'
                      declaredExternRefs := result1.declared' }
                  have hctx2 : ctx2.memEnv.contains l := by
                    simpa [ctx2] using hcontains1
                  cases h_tc2 : typecheckExpr ctx2 e2 fuel' with
                  | error _ =>
                      simp [ctx2, h_tc2] at htc
                  | ok result2 =>
                      simp [ctx2, h_tc2] at htc
                      have hcontains2 : result2.memEnv'.contains l :=
                        IH fuel' h_fuel e2 ctx2 result2
                          (by simpa [typecheck, ctx2] using h_tc2) l hctx2
                      cases h_qt2 : result2.qualType with
                      | mk etyp2 p2 pred2 =>
                          rw [h_qt2] at htc
                          simp at htc
                          by_cases h_etyp2_int : etyp2 = ETyp.int
                          · subst h_etyp2_int
                            simp at htc
                            cases htc
                            exact
                              assign_memEnv_formula_contains_of_contains
                                result2.memEnv' ls
                                (joinPoison ctx.pc (joinPoison p1 p2))
                                (if p1 = true ∨ ctx.pc = true then Predicate.noPred else pred2)
                                l hcontains2
                          · simp [h_etyp2_int] at htc
              | _ =>
                  simp at htc

private lemma typecheckIf_mem_contains_preserved
    (ctx : TypeContext) (e1 e2 e3 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' →
        ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l) :
    typecheckIf ctx e1 e2 e3 fuel = .ok res →
    ∀ l, ctx.memEnv.contains l → res.memEnv'.contains l := by
  intro htc l hcontains
  cases fuel with
  | zero =>
      simp [typecheckIf] at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      rcases typecheckIf_structure ctx e1 e2 e3 (fuel' + 1) res htc with
        htrue | hfalse | hstd
      · rcases htrue with
          ⟨k, deps, _hmatch, _hreg, _res1, _htc1, _hbool, res2, _res3, htc2, _htc3, h_mem,
           _h_tag, _h_loc, _h_ntag, _h_regime, _h_decl, _h_poison, _h_etyp⟩
        let ctxTrue : TypeContext := { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩,
                                                nextTag := _res1.nextTag', nextBind := _res1.nextBind',
                                                declaredExternRefs := _res1.declared' }
        have hcontains2 : res2.memEnv'.contains l :=
          IH fuel' h_fuel e2 ctxTrue res2
            (by simpa [typecheck, ctxTrue] using htc2) l
            (by simpa [ctxTrue] using hcontains)
        simpa [h_mem] using hcontains2
      · rcases hfalse with
          ⟨k, deps, _hmatch, _hreg, _res1, _htc1, _hbool, _res2, res3, _htc2, htc3, h_mem,
           _h_tag, _h_loc, _h_ntag, _h_regime, _h_decl, _h_poison, _h_etyp⟩
        let ctxFalse : TypeContext := { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                                                 nextLoc := _res2.nextLoc', nextTag := _res2.nextTag', nextBind := _res2.nextBind',
                                                 declaredExternRefs := _res2.declared' }
        have hcontains3 : res3.memEnv'.contains l :=
          IH fuel' h_fuel e3 ctxFalse res3
            (by simpa [typecheck, ctxFalse] using htc3) l
            (by simpa [ctxFalse] using hcontains)
        simpa [h_mem] using hcontains3
      · rcases hstd with
          ⟨_h_std_case, res1, htc1, _hbool, res2, hstd_tail⟩
        simp at hstd_tail
        rcases hstd_tail with ⟨htc2, res3, hstd_tail'⟩
        rcases hstd_tail' with
          ⟨htc3, h_mem, _h_tag, _h_loc, _h_ntag, _h_regime, _h_decl, _h_poison, _h_etyp, _h_pred⟩
        let ctx2 : TypeContext :=
          { ctx with
            memEnv := res1.memEnv'
            tagEnv := res1.tagEnv'
            nextLoc := res1.nextLoc'
            nextTag := res1.nextTag'
            nextBind := res1.nextBind'
            regime := res1.regime'
            pc := joinPoison ctx.pc res1.qualType.poison
            declaredExternRefs := res1.declared' }
        let ctx3 : TypeContext :=
          { ctx with
            memEnv := res1.memEnv'
            tagEnv := res1.tagEnv'
            nextLoc := res2.nextLoc'
            nextTag := res2.nextTag'
            nextBind := res2.nextBind'
            regime := res1.regime'
            pc := joinPoison ctx.pc res1.qualType.poison
            declaredExternRefs := res2.declared' }
        have hcontains1 : res1.memEnv'.contains l :=
          IH fuel' h_fuel e1 ctx res1
            (by simpa [typecheck] using htc1) l hcontains
        have hcontains2 : res2.memEnv'.contains l :=
          IH fuel' h_fuel e2 ctx2 res2
            (by simpa [typecheck, ctx2] using htc2) l
            (by simpa [ctx2] using hcontains1)
        rcases memEnv_lookup_some_of_contains res2.memEnv' l hcontains2 with ⟨qt2, hlookup2⟩
        rcases joinMemEnvsStrong_lookup_some_of_left_lookup res2.memEnv' res3.memEnv' l qt2 hlookup2 with
          ⟨qt, hlookup_join⟩
        have hcontains_join : (joinMemEnvsStrong res2.memEnv' res3.memEnv').contains l := by
          exact memEnv_contains_of_lookup_some _ _ _ hlookup_join
        simpa [h_mem] using hcontains_join

private lemma typecheckExpr_mem_contains_preserved_main :
    ∀ (fuel : Nat) (ctx : TypeContext) (e : Expr) (res : TypeResult),
      typecheck ctx e fuel = .ok res →
      ∀ l, ctx.memEnv.contains l → res.memEnv'.contains l := by
  intro fuel
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
      intro ctx e res htc l hcontains
      have IH' : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheck ctx' e m = .ok res' →
          ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l := by
        intro m hm e' ctx' res' htc' l hcontains
        exact IH m hm ctx' e' res' htc' l hcontains
      unfold typecheck at htc
      cases fuel with
      | zero =>
          unfold typecheckExpr at htc
          simp at htc
      | succ fuel' =>
          unfold typecheckExpr at htc
          have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
          have hltSub : fuel' - 1 < fuel'.succ := by
            exact Nat.lt_succ_of_le (Nat.sub_le fuel' 1)
          have IH_fuel' : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
              typecheck ctx' e m = .ok res' →
              ∀ l, ctx'.memEnv.contains l → res'.memEnv'.contains l := by
            intro m hm
            exact IH' m (Nat.lt_trans hm h_fuel)
          unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
          cases e with
          | num _ | bool _ | unit | str _ =>
              simp [pure, Except.pure] at htc
              cases htc
              simpa using hcontains
          | var x =>
              have htcVar : typecheckVar ctx x = .ok res := by
                simpa [typecheckExpr] using htc
              have hmem : res.memEnv' = ctx.memEnv := typecheckVar_preserves_memEnv ctx x res htcVar
              simpa [hmem] using hcontains
          | fn x st1 body st2 =>
              have hfn := typecheckFn_ok_eq htc; subst hfn
              simpa using hcontains
          | pfn x st1 body st2 =>
              unfold typecheckPfn at htc
              simp [bind, Except.bind] at htc
              cases h_topexpr : body.toPExpr with
              | error _ =>
                  simp [h_topexpr] at htc
              | ok _ =>
                  simp [h_topexpr, pure, Except.pure] at htc
                  cases htc
                  simpa using hcontains
          | externVal typ poison pred =>
              have h0ok := typecheckExternVal_ok_declSite htc
              simp only [typecheckExternVal] at htc
              rw [h0ok] at htc
              simp [Bind.bind, Except.bind, pure, Except.pure] at htc
              split at htc <;> simp (config := { failIfUnchanged := false }) at htc
              split at htc <;> simp (config := { failIfUnchanged := false }) at htc
              split at htc <;> simp (config := { failIfUnchanged := false }) at htc
              split at htc <;> simp (config := { failIfUnchanged := false }) at htc
              split at htc <;> simp (config := { failIfUnchanged := false }) at htc
              cases htc
              rename_i _surf _heqSurf _ _ _
              unfold surfaceSpecToQTyp at _heqSurf
              split at _heqSurf <;> simp [bind, Except.bind, pure, Except.pure] at _heqSurf
              · cases _heqSurf; exact hcontains
              · cases _heqSurf; exact hcontains
              · cases _heqSurf; exact hcontains
              · cases _heqSurf; exact hcontains
          | externFn id arg argTyp argPoison argPred retSpec effects =>
              obtain ⟨argQt, _, hres⟩ :=
                typecheckExternFn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec effects res htc
              rw [hres]
              exact hcontains
          | externPfn id arg argTyp argPoison argPred retSpec =>
              obtain ⟨argQt, _, hres⟩ :=
                typecheckExternPfn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec res htc
              rw [hres]
              exact hcontains
          | externRef _id _rp _rpred _cp _cpred =>
              simp at htc
              have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
              subst hres
              exact updateMemEnv_contains_of_contains ctx.memEnv ctx.nextLoc l _ hcontains
          | op e1 bop e2 =>
              have htcOp : typecheckOp ctx e1 e2 fuel' bop = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckOp_structure ctx e1 e2 bop fuel' res htcOp with
                ⟨result1, result2, _result_etyp, htc1, htc2, _h_op, h_mem, _h_tag, _h_loc, _h_ntag,
                  _h_regime, _h_ret_etyp, _h_ret_poison, _h_ret_pred⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              have hctx2 : (updateCtxFromResult ctx result1).memEnv.contains l := by
                simpa [updateCtxFromResult] using hcontains1
              have hcontains2 : result2.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e2 (updateCtxFromResult ctx result1) result2
                  (by simpa [typecheck, updateCtxFromResult] using htc2) l hctx2
              simpa [h_mem] using hcontains2
          | unaryop uop e1 =>
              have htcUnary : typecheckUnaryOp ctx uop e1 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckUnaryOp_structure ctx uop e1 fuel' res htcUnary with
                ⟨result1, _result_etyp, htc1, _h_op, h_mem, _h_tag, _h_loc, _h_ntag, _h_regime,
                  _h_ret_etyp, _h_ret_poison, _h_ret_pred⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              simpa [h_mem] using hcontains1
          | ite e1 e2 e3 =>
              have htcIf : typecheckIf ctx e1 e2 e3 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              exact typecheckIf_mem_contains_preserved ctx e1 e2 e3 fuel' res IH_fuel' htcIf l hcontains
          | newRef e1 =>
              have htcNew : typecheckNewRef ctx e1 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckNewRef_structure ctx e1 fuel' res htcNew with
                ⟨result1, l0, htc1, _hl0, _hInt, _hRetEtyp, _hRetPoison, _hRetPred, h_mem,
                  _h_tag, _h_loc, _h_ntag, _h_regime⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              rw [h_mem]
              exact
                updateMemEnv_contains_of_contains result1.memEnv' l0 l
                  ⟨ETyp.int, joinPoison ctx.pc result1.qualType.poison,
                    if ctx.pc then Predicate.noPred else result1.qualType.pred⟩
                  hcontains1
          | assign e1 e2 =>
              have htcAssign : typecheckAssign ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              exact typecheckAssign_mem_contains_preserved ctx e1 e2 fuel' res IH_fuel' htcAssign l hcontains
          | deref e1 =>
              have htcDeref : typecheckDeref ctx e1 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckDeref_structure ctx e1 fuel' res htcDeref with
                ⟨result1, htc1, h_mem, _h_tag, _h_loc, _h_ntag, _h_regime⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              simpa [h_mem] using hcontains1
          | seq e1 e2 =>
              have htcSeq : typecheckSeq ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckSeq_structure ctx e1 e2 fuel' res htcSeq with
                ⟨result1, ctx', res, htc1, hctx', htc2, rfl⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              have hctx' : ctx'.memEnv.contains l := by
                simpa [hctx'] using! hcontains1
              exact
                IH' (fuel' - 1) hltSub e2 ctx' res
                  (by simpa [typecheck, hctx'] using htc2) l hctx'
          | vlet x e1 e2 =>
              have htcVlet : typecheckVlet ctx x e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              rcases typecheckVlet_structure ctx x e1 e2 fuel' res htcVlet with
                ⟨result1, result2, ctx', htc1, hctx', htc2, _h_ret_etyp, h_mem, _h_tag, _h_loc,
                  _h_ntag, _h_regime, _h_ret_poison, _h_ret_pred⟩
              have hcontains1 : result1.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e1 ctx result1
                  (by simpa [typecheck] using htc1) l hcontains
              have hctx' : ctx'.memEnv.contains l := by
                simpa [hctx'] using hcontains1
              have hcontains2 : result2.memEnv'.contains l :=
                IH' (fuel' - 1) hltSub e2 ctx' result2
                  (by simpa [typecheck, hctx'] using htc2) l hctx'
              simpa [h_mem] using hcontains2
          | app e1 e2 =>
              have htcApp : typecheckApp ctx e1 e2 fuel' = .ok res := by
                simpa [typecheckExpr] using htc
              exact typecheckApp_mem_contains_preserved ctx e1 e2 fuel' res IH_fuel' htcApp l hcontains

lemma joinTypeResults_transport_valueHasETyp_from_member
  (ctx : TypeContext) (first src : TypeResult) (rest : List TypeResult) (res : TypeResult)
  (θ : RealizationMap) (v : Value)
  (_h_join : joinTypeResults ctx first rest = .ok res)
  (_hmem_src : src ∈ first :: rest)
  (h_src : valueHasETyp θ v src.qualType.etyp) :
  valueHasETyp θ v res.qualType.etyp := by
  let joinStep : (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
      TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun acc result =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
            joinMemEnvsStrong acc.2.1 result.memEnv', joinPoison acc.2.2.1 resPoison,
            joinPredicates acc.2.2.2.1 resPred, joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
            joinRegimes acc.2.2.2.2.2.1 result.regime',
            max acc.2.2.2.2.2.2.1 result.nextLoc', max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_left_val :
      ∀ (rs' : List TypeResult) (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        (∀ r ∈ rs', beqETypSignature acc.1 r.qualType.etyp = true) →
        List.foldlM joinStep acc rs' = .ok acc' →
        valueHasETyp θ v acc.1 →
        valueHasETyp θ v acc'.1 := by
    intro rs' acc acc' hcompat hfold hval_acc
    induction rs' generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at hfold
        cases hfold
        simpa using hval_acc
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at hfold
            have hcompat_x : beqETypSignature acc.1 resEtyp = true := by
              have hx := hcompat x (by simp)
              simpa [hqx] using hx
            let acc1 :
                ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag :=
              (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
                joinMemEnvsStrong acc.2.1 x.memEnv', joinPoison acc.2.2.1 resPoison,
                joinPredicates acc.2.2.2.1 resPred, joinTagEnvs acc.2.2.2.2.1 x.tagEnv',
                joinRegimes acc.2.2.2.2.2.1 x.regime',
                max acc.2.2.2.2.2.2.1 x.nextLoc', max acc.2.2.2.2.2.2.2 x.nextTag')
            have hval_acc1 : valueHasETyp θ v acc1.1 := by
              have hjoin : valueHasETyp θ v (joinETyps acc.1 resEtyp acc.2.2.1 resPoison) :=
                valueHasETyp_joinETyps_left
                  (θ := θ) (v := v) (t1 := acc.1) (t2 := resEtyp)
                  (p1 := acc.2.2.1) (p2 := resPoison) hval_acc
              simpa [acc1] using hjoin
            have hcompat_tail : ∀ r ∈ xs, beqETypSignature acc1.1 r.qualType.etyp = true := by
              intro r hr
              have hcomp := hcompat r (List.Mem.tail _ hr)
              rw [show acc1.1 = joinETyps acc.1 resEtyp acc.2.2.1 resPoison by rfl]
              rw [← beqETypSignature_joinETyps_left hcompat_x]
              exact hcomp
            have hfold_tail : List.foldlM joinStep acc1 xs = .ok acc' := by
              simpa [acc1] using hfold
            exact ih (acc := acc1) hcompat_tail hfold_tail hval_acc1
  have h_fold_member_val :
      ∀ (rs' : List TypeResult) (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag)
        (src' : TypeResult),
        (∀ r ∈ rs', beqETypSignature acc.1 r.qualType.etyp = true) →
        List.foldlM joinStep acc rs' = .ok acc' →
        src' ∈ rs' →
        valueHasETyp θ v src'.qualType.etyp →
        valueHasETyp θ v acc'.1 := by
    intro rs' acc acc' src' hcompat hfold hmem_src' hval_src'
    induction rs' generalizing acc acc' src' with
    | nil =>
        cases hmem_src'
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at hfold
            have hcompat_x : beqETypSignature acc.1 resEtyp = true := by
              have hx := hcompat x (by simp)
              simpa [hqx] using hx
            let acc1 :
                ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag :=
              (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
                joinMemEnvsStrong acc.2.1 x.memEnv', joinPoison acc.2.2.1 resPoison,
                joinPredicates acc.2.2.2.1 resPred, joinTagEnvs acc.2.2.2.2.1 x.tagEnv',
                joinRegimes acc.2.2.2.2.2.1 x.regime',
                max acc.2.2.2.2.2.2.1 x.nextLoc', max acc.2.2.2.2.2.2.2 x.nextTag')
            have hcompat_tail : ∀ r ∈ xs, beqETypSignature acc1.1 r.qualType.etyp = true := by
              intro r hr
              have hcomp := hcompat r (List.Mem.tail _ hr)
              rw [show acc1.1 = joinETyps acc.1 resEtyp acc.2.2.1 resPoison by rfl]
              rw [← beqETypSignature_joinETyps_left hcompat_x]
              exact hcomp
            have hfold_tail : List.foldlM joinStep acc1 xs = .ok acc' := by
              simpa [acc1] using hfold
            rcases (List.mem_cons.mp hmem_src') with hsrc_eq | hsrc_tail
            · subst src'
              have hval_x : valueHasETyp θ v resEtyp := by
                simpa [hqx] using hval_src'
              have hval_acc1 : valueHasETyp θ v acc1.1 := by
                have hjoin :
                    valueHasETyp θ v (joinETyps acc.1 resEtyp acc.2.2.1 resPoison) :=
                  valueHasETyp_joinETyps_right
                    (θ := θ) (v := v) (t1 := acc.1) (t2 := resEtyp)
                    (p1 := acc.2.2.1) (p2 := resPoison) hcompat_x hval_x
                simpa [acc1] using hjoin
              exact h_fold_left_val xs acc1 acc' hcompat_tail hfold_tail hval_acc1
            · exact ih (acc := acc1) (acc' := acc') (src' := src') hcompat_tail hfold_tail hsrc_tail hval_src'
  cases hqt : first.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe,
        MonadExceptOf.throw, TypecheckM] at _h_join
      cases hcheck : (List.foldlM (fun _ result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _, pred := _ } =>
            if beqETypSignature etyp resEtyp = false then
              Except.error (toString "Closure alternatives produced incompatible result types: " ++
                toString (repr etyp) ++ toString " vs " ++ toString (repr resEtyp))
            else Except.ok ()) () rest : Except String Unit) with
      | error _ =>
          erw [hcheck] at _h_join
          contradiction
      | ok _ =>
          erw [hcheck] at _h_join
          cases hfold : List.foldlM joinStep (etyp, first.memEnv', poison, pred, first.tagEnv',
            first.regime', first.nextLoc', first.nextTag') rest with
          | error _ =>
              erw [hfold] at _h_join
              contradiction
          | ok a =>
              erw [hfold] at _h_join
              have heq := Except.ok.inj _h_join
              have hetyp_res : a.1 = res.qualType.etyp := by
                exact congrArg (fun tr => tr.qualType.etyp) heq
              have hcompat := joinTypeResults_compat_ok etyp rest hcheck
              rcases (List.mem_cons.mp _hmem_src) with hsrc_head | hsrc_tail
              · subst src
                have hval_a : valueHasETyp θ v a.1 :=
                  h_fold_left_val rest
                    (etyp, first.memEnv', poison, pred, first.tagEnv',
                      first.regime', first.nextLoc', first.nextTag')
                    a hcompat hfold (by simpa [hqt] using h_src)
                simpa [hetyp_res] using hval_a
              · have hval_a : valueHasETyp θ v a.1 :=
                  h_fold_member_val rest
                    (etyp, first.memEnv', poison, pred, first.tagEnv',
                      first.regime', first.nextLoc', first.nextTag')
                    a src hcompat hfold hsrc_tail h_src
                simpa [hetyp_res] using hval_a

private lemma joinTypeResults_mem_subset
    (ctx : TypeContext) (first : TypeResult) (rest : List TypeResult) (res : TypeResult)
    (hjoin : joinTypeResults ctx first rest = .ok res)
    (hfirst : ∀ l, first.memEnv'.contains l → ctx.memEnv.contains l)
    (hrest : ∀ r ∈ rest, ∀ l, r.memEnv'.contains l → ctx.memEnv.contains l) :
    ∀ l, res.memEnv'.contains l → ctx.memEnv.contains l := by
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
      TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_subset :
      ∀ (rs' : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs' = .ok acc' →
        (∀ l, acc.2.1.contains l → ctx.memEnv.contains l) →
        (∀ r ∈ rs', ∀ l, r.memEnv'.contains l → ctx.memEnv.contains l) →
        (∀ l, acc'.2.1.contains l → ctx.memEnv.contains l) := by
    intro rs' acc acc' hfold hacc hsubs
    induction rs' generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at hfold
        cases hfold
        exact hacc
    | cons r rs ih =>
        cases hqr : r.qualType with
        | mk etyp_r poison_r pred_r =>
            simp [List.foldlM_cons, joinStep, hqr, bind, Except.bind] at hfold
            let acc1 : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag :=
              (joinETyps acc.1 etyp_r acc.2.2.1 poison_r,
                joinMemEnvsStrong acc.2.1 r.memEnv',
                joinPoison acc.2.2.1 poison_r,
                joinPredicates acc.2.2.2.1 pred_r,
                joinTagEnvs acc.2.2.2.2.1 r.tagEnv',
                joinRegimes acc.2.2.2.2.2.1 r.regime',
                max acc.2.2.2.2.2.2.1 r.nextLoc',
                max acc.2.2.2.2.2.2.2 r.nextTag')
            have hacc1 : ∀ l, acc1.2.1.contains l → ctx.memEnv.contains l := by
              intro l hl
              have hor := joinMemEnvsStrong_contains_implies_or acc.2.1 r.memEnv' l hl
              cases hor with
              | inl hleft =>
                  exact hacc l hleft
              | inr hright =>
                  exact hsubs r (by simp) l hright
            have hsubs_tail : ∀ r' ∈ rs, ∀ l, r'.memEnv'.contains l → ctx.memEnv.contains l := by
              intro r' hr' l hl
              exact hsubs r' (by simp [hr']) l hl
            exact ih acc1 hfold hacc1 hsubs_tail
  cases hqf : first.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqf, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
            (fun x result =>
              match result.qualType with
              | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
                if beqETypSignature etyp resEtyp = false then
                  Except.error
                    (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                        toString " vs " ++
                      toString (repr resEtyp))
                else Except.ok ())
            () rest : Except String Unit) with
      | error _err =>
          erw [hcheck] at hjoin
          simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin
          simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, first.memEnv', poison, pred, first.tagEnv', first.regime', first.nextLoc', first.nextTag') rest with
          | error _err =>
              erw [hfold] at hjoin
              simp at hjoin
          | ok acc =>
              erw [hfold] at hjoin
              simp at hjoin
              subst res
              have hacc0 : ∀ l, first.memEnv'.contains l → ctx.memEnv.contains l := hfirst
              exact h_fold_subset rest
                (etyp, first.memEnv', poison, pred, first.tagEnv', first.regime', first.nextLoc', first.nextTag')
                acc hfold hacc0 hrest

private lemma joinMemEnvsStrong_lookup_of_some_some
    (env1 env2 : MemoryTypeEnv) (l : Loc) (qt : QTyp)
    (h1 : env1.lookup l = some qt)
    (h2 : env2.lookup l = some qt) :
    (joinMemEnvsStrong env1 env2).lookup l = some qt := by
  have h1_get : env1.get? l = some ⟨qt.poison, qt.pred⟩ := memEnv_get_eq_of_lookup env1 l qt h1
  have hcontains1 : env1.contains l := memEnv_contains_of_lookup_some env1 l qt h1
  have h_in_keys : l ∈ env1.keys := ExtTreeMap.mem_keys.2 hcontains1
  have h_mem : l ∈ (env1.keys ++ env2.keys).eraseDups := by
    exact List.mem_eraseDups_of_mem (List.mem_append_left _ h_in_keys)
  let f : Loc → Option MemEntry → Option MemEntry → Option MemEntry := fun _ oe1 oe2 =>
    match oe1, oe2 with
    | some e1, none => some ⟨e1.poison, Predicate.noPred⟩
    | none, some e2 => some ⟨e2.poison, Predicate.noPred⟩
    | some e1, some e2 =>
      some ⟨joinPoison e1.poison e2.poison, joinPredicates e1.pred e2.pred⟩
    | none, none => none
  have hgo :=
    combineExtTreeMaps_go_get_mem env1 env2 f
      (env1.keys ++ env2.keys).eraseDups ({} : MemoryTypeEnv) l h_mem
  have h2_get : env2.get? l = some ⟨qt.poison, qt.pred⟩ := memEnv_get_eq_of_lookup env2 l qt h2
  have hgo' :
      (combineExtTreeMaps.go env1 env2 f
        (env1.keys ++ env2.keys).eraseDups ({} : MemoryTypeEnv))[l]? = some ⟨qt.poison, qt.pred⟩ := by
    erw [h1_get, h2_get] at hgo
    simp [f, joinPoison_idempotent, joinPredicates_idempotent] at hgo
    simpa [f] using hgo
  have hcombine : (combineExtTreeMaps env1 env2 f).get? l = some ⟨qt.poison, qt.pred⟩ := by
    simpa [combineExtTreeMaps, Std.ExtTreeMap.get?_eq_getElem?] using hgo'
  have heq : combineExtTreeMaps env1 env2 f = joinMemEnvsStrong env1 env2 := by
    simp only [joinMemEnvsStrong]; congr 2
  rw [← heq, MemoryTypeEnv.lookup, hcombine, Option.map, memEnv_lookup_toQTyp env1 l qt h1]

