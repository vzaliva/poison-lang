    _ = (some entry).map (fun e => ⟨ETyp.int, e.poison, e.pred⟩) := by rw [ExtTreeMap.get?_eq_getElem?, hgo]
    _ = some ⟨ETyp.int, entry.poison, entry.pred⟩ := rfl
    _ = (env2.get? l).map (fun e => ⟨ETyp.int, e.poison, e.pred⟩) := by
