                    res1 result c b fuel' IH' hatc)
                  (fun k hk => Nat.le_trans hbase hk))
              tcls (res1.nextTag', res1.nextLoc') res1.nextBind' (first :: rest) (Nat.le_refl _) (by simpa using hmap)
          have hfirst := hmap_prop first (by simp)
