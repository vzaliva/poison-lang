private lemma typecheckDeref_nextTag_mono_normal (ctx : TypeContext) (e : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckDeref ctx e fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckDeref at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hte : typecheckExpr ctx e fuel' with
      | error err =>
          simp [hte] at htc
      | ok r1 =>
          simp [hte] at htc
          rcases hq1 : r1.qualType with ⟨etyp1, pRef, predRef⟩
          simp [hq1] at htc
          cases etyp1 with
          | int =>
              simp at htc
          | bool =>
              simp at htc
          | unit =>
              simp at htc
          | string =>
              simp at htc
          | arrow st1 st2 p tcls =>
              simp at htc
          | parrow st1 st2 p tcls =>
              simp at htc
          | ref ls =>
              simp at htc
              by_cases hls : ls = ∅
              · simp [hls] at htc
              · simp [hls] at htc
                let foldStep : (Poison × Option Predicate) → Loc → Except String (Poison × Option Predicate) :=
                  fun x l =>
                    match r1.memEnv'.lookup l with
                    | some qt =>
                        pure (joinPoison x.1 qt.poison,
                          match x.2 with
                          | none => some qt.pred
                          | some p => some (joinPredicates p qt.pred))
                    | none => throw s!"Location {l} not found in memory environment"
                let foldExpr : Except String (Poison × Option Predicate) := ls.foldM (false, (none : Option Predicate)) foldStep
                cases hfold : foldExpr with
                  | error err =>
                      have hfold' := hfold
                      simp [foldExpr, foldStep] at hfold'
                      erw [hfold'] at htc
                      simp at htc
                  | ok folded =>
                      rcases folded with ⟨joinedCellPoison, mergedPredOpt⟩
                      have hfold' := hfold
                      simp [foldExpr, foldStep] at hfold'
                      erw [hfold'] at htc
                      simp at htc
                      have hte' : typecheck ctx e fuel' = .ok r1 := by simpa [typecheck] using hte
                      have hmono := IH fuel' (Nat.lt_succ_self fuel') e ctx r1 hte'
                      cases hpRef : pRef with
                      | true =>
                          simp [hpRef, pure, Except.pure] at htc
                          cases htc
                          exact hmono
                      | false =>
                          simp [hpRef] at htc
                          cases hmerged : mergedPredOpt.getD Predicate.noPred with
                          | noPred =>
                              simp [hmerged, pure, Except.pure] at htc
                              cases htc
                              exact hmono
                          | guardOnly k =>
                              simp [hmerged] at htc
                              cases htag : r1.tagEnv'[k]? with
                              | none =>
                                  simp [htag, pure, Except.pure] at htc
                                  cases htc
                                  exact hmono
                              | some tv =>
                                  rcases tv with ⟨b, deps⟩
                                  cases b <;> simp [htag, pure, Except.pure] at htc <;> cases htc <;> exact hmono
                          | guardClosure k arg body env =>
                              simp [hmerged] at htc
                              cases htag : r1.tagEnv'[k]? with
                              | none =>
                                  simp [htag, pure, Except.pure] at htc
                                  cases htc
                                  exact hmono
                              | some tv =>
                                  rcases tv with ⟨b, deps⟩
                                  cases b <;> simp [htag, pure, Except.pure] at htc <;> cases htc <;> exact hmono

private lemma typecheckVlet_nextTag_mono_normal (ctx : TypeContext) (x : Name) (e1 e2 : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckVlet ctx x e1 e2 fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckVlet at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hlookup : ctx.varEnv.lookup x with
      | none =>
          simp [hlookup] at htc
          cases hte1 : typecheckExpr ctx e1 fuel' with
          | error err =>
              simp [hte1] at htc
          | ok r1 =>
              simp [hte1] at htc
              let varEnv' := ctx.varEnv.update x r1.qualType
              let ctxBase : TypeContext := updateCtxFromResult ctx r1
              let ctx' : TypeContext := { ctxBase with varEnv := varEnv', bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
              cases hte2 : typecheckExpr ctx' e2 fuel' with
              | error err =>
                  erw [hte2] at htc
                  simp at htc
              | ok r2 =>
                  erw [hte2] at htc
                  simp at htc
                  rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                  simp [hq2, pure, Except.pure] at htc
                  have hresnext : r2.nextTag' = res.nextTag' := by
                    simpa using congrArg TypeResult.nextTag' htc
                  have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                    simpa [typecheck] using hte1
                  have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                  have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                    simpa [typecheck, ctx', ctxBase, varEnv', updateCtxFromResult] using hte2
                  have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
                  have hctx : ctx.nextTag ≤ r2.nextTag' := Nat.le_trans h1 (by simpa [ctx', ctxBase, varEnv', updateCtxFromResult] using h2)
                  simpa [hresnext] using hctx
      | some qtOuter =>
          simp [hlookup] at htc
          cases hpred : qtOuter.pred with
          | guardClosure k arg body env =>
              simp [hpred] at htc
              by_cases hregSome : (ctx.regime.lookup? k).isSome = true
              · simp [hregSome] at htc
              · simp [hregSome] at htc
                cases hte1 : typecheckExpr ctx e1 fuel' with
                | error err =>
                    simp [hte1] at htc
                | ok r1 =>
                    simp [hte1] at htc
                    let varEnv' := ctx.varEnv.update x r1.qualType
                    let ctxBase : TypeContext := updateCtxFromResult ctx r1
                    let ctx' : TypeContext := { ctxBase with varEnv := varEnv', bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                    cases hte2 : typecheckExpr ctx' e2 fuel' with
                    | error err =>
                        erw [hte2] at htc
                        simp at htc
                    | ok r2 =>
                        erw [hte2] at htc
                        simp at htc
                        rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                        simp [hq2, pure, Except.pure] at htc
                        have hresnext : r2.nextTag' = res.nextTag' := by
                          simpa using congrArg TypeResult.nextTag' htc
                        have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                          simpa [typecheck] using hte1
                        have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                        have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                          simpa [typecheck, ctx', ctxBase, varEnv', updateCtxFromResult] using hte2
                        have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
                        have hctx : ctx.nextTag ≤ r2.nextTag' := Nat.le_trans h1 (by simpa [ctx', ctxBase, varEnv', updateCtxFromResult] using h2)
                        simpa [hresnext] using hctx
          | guardOnly k =>
              simp [hpred] at htc
              cases hte1 : typecheckExpr ctx e1 fuel' with
              | error err =>
                  simp [hte1] at htc
              | ok r1 =>
                  simp [hte1] at htc
                  let varEnv' := ctx.varEnv.update x r1.qualType
                  let ctxBase : TypeContext := updateCtxFromResult ctx r1
                  let ctx' : TypeContext := { ctxBase with varEnv := varEnv', bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                  cases hte2 : typecheckExpr ctx' e2 fuel' with
                  | error err =>
                      erw [hte2] at htc
                      simp at htc
                  | ok r2 =>
                      erw [hte2] at htc
                      simp at htc
                      rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                      simp [hq2, pure, Except.pure] at htc
                      have hresnext : r2.nextTag' = res.nextTag' := by
                        simpa using congrArg TypeResult.nextTag' htc
                      have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                        simpa [typecheck] using hte1
                      have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                      have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                        simpa [typecheck, ctx', ctxBase, varEnv', updateCtxFromResult] using hte2
                      have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
                      have hctx : ctx.nextTag ≤ r2.nextTag' := Nat.le_trans h1 (by simpa [ctx', ctxBase, varEnv', updateCtxFromResult] using h2)
                      simpa [hresnext] using hctx
          | noPred =>
              simp [hpred] at htc
              cases hte1 : typecheckExpr ctx e1 fuel' with
              | error err =>
                  simp [hte1] at htc
              | ok r1 =>
                  simp [hte1] at htc
                  let varEnv' := ctx.varEnv.update x r1.qualType
                  let ctxBase : TypeContext := updateCtxFromResult ctx r1
                  let ctx' : TypeContext := { ctxBase with varEnv := varEnv', bindEnv := ctx.bindEnv.insert x r1.nextBind', nextBind := r1.nextBind' + 1 }
                  cases hte2 : typecheckExpr ctx' e2 fuel' with
                  | error err =>
                      erw [hte2] at htc
                      simp at htc
                  | ok r2 =>
                      erw [hte2] at htc
                      simp at htc
                      rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                      simp [hq2, pure, Except.pure] at htc
                      have hresnext : r2.nextTag' = res.nextTag' := by
                        simpa using congrArg TypeResult.nextTag' htc
                      have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                        simpa [typecheck] using hte1
                      have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                      have hte2' : typecheck ctx' e2 fuel' = .ok r2 := by
                        simpa [typecheck, ctx', ctxBase, varEnv', updateCtxFromResult] using hte2
                      have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx' r2 hte2'
                      have hctx : ctx.nextTag ≤ r2.nextTag' := Nat.le_trans h1 (by simpa [ctx', ctxBase, varEnv', updateCtxFromResult] using h2)
                      simpa [hresnext] using hctx

private lemma typecheckIf_nextTag_mono_normal (ctx : TypeContext) (e1 e2 e3 : Expr)
    (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e' m = .ok res' →
      ctx'.nextTag ≤ res'.nextTag') :
  typecheckIf ctx e1 e2 e3 fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  unfold typecheckIf at htc
  cases fuel with
  | zero =>
      simp at htc
  | succ fuel' =>
      simp [bind, Except.bind] at htc
      cases hmatch : matchGuard e1 ctx.memEnv ctx.varEnv ctx.bindEnv fuel' with
      | error err =>
          simp [hmatch] at htc
          cases hte1 : typecheckExpr ctx e1 fuel' with
          | error err1 =>
              simp [hte1] at htc
          | ok r1 =>
              simp [hte1] at htc
              rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
              simp [hq1] at htc
              by_cases hbool : etyp1 = ETyp.bool
              · simp [hbool] at htc
                let ctx1 : TypeContext := updateCtxFromResult ctx r1
                let branchPc := joinPoison ctx.pc p1
                let ctx'' := { ctx1 with pc := branchPc }
                cases hte2 : typecheckExpr ctx'' e2 fuel' with
                | error err2 =>
                    erw [hte2] at htc
                    simp at htc
                | ok r2 =>
                    erw [hte2] at htc
                    simp at htc
                    rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                    simp [hq2] at htc
                    let ctxForE3 := { ctx'' with nextLoc := r2.nextLoc', nextTag := r2.nextTag', nextBind := r2.nextBind', declaredExternRefs := r2.declared' }
                    cases hte3 : typecheckExpr ctxForE3 e3 fuel' with
                    | error err3 =>
                        erw [hte3] at htc
                        simp at htc
                    | ok r3 =>
                        erw [hte3] at htc
                        simp at htc
                        rcases hq3 : r3.qualType with ⟨etyp3, p3, pred3⟩
                        simp [hq3] at htc
                        by_cases hcompat : beqETypSignature etyp2 etyp3
                        · simp [hcompat, pure, Except.pure] at htc
                          cases htc
                          have hte1' : typecheck ctx e1 fuel' = .ok r1 := by
                            simpa [typecheck] using hte1
                          have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1 hte1'
                          have hte2' : typecheck ctx'' e2 fuel' = .ok r2 := by
                            simpa [typecheck, ctx'', ctx1, branchPc] using hte2
                          have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx'' r2 hte2'
                          have hctx_to_ctx2 : ctx.nextTag ≤ r2.nextTag' := by
                            have hctx1 : ctx.nextTag ≤ r1.nextTag' := h1
                            have hctx2 : ctx''.nextTag ≤ r2.nextTag' := h2
                            have hctx1eq : ctx''.nextTag = r1.nextTag' := by
                              simp [ctx'', ctx1, updateCtxFromResult]
                            exact Nat.le_trans hctx1 (by simpa [hctx1eq] using hctx2)
                          exact Nat.le_trans hctx_to_ctx2 (Nat.le_max_left _ _)
                        · simp [hcompat] at htc
              · simp [hbool] at htc
      | ok kd =>
          rcases kd with ⟨k, deps⟩
          simp [hmatch] at htc
          cases hte1 : typecheckExpr { ctx with pureCtx := true } e1 fuel' with
          | error err1 =>
              simp [hte1] at htc
          | ok r1 =>
              simp [hte1] at htc
              rcases hq1 : r1.qualType with ⟨etyp1, p1, pred1⟩
              simp [hq1] at htc
              by_cases hbool : etyp1 = ETyp.bool
              · simp [hbool] at htc
                let ctxTrue := { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩,
                                          nextTag := r1.nextTag', nextBind := r1.nextBind',
                                          declaredExternRefs := r1.declared' }
                let ctxFalse := { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                                           nextTag := r1.nextTag', nextBind := r1.nextBind',
                                           declaredExternRefs := r1.declared' }
                cases hreg : ctx.regime.lookup? k with
                | some b =>
                    cases b with
                    | true =>
                        simp [hreg] at htc
                        cases hte2 : typecheckExpr ctxTrue e2 fuel' with
                        | error err2 =>
                            erw [hte2] at htc
                            simp at htc
                        | ok r2 =>
                            erw [hte2] at htc
                            simp at htc
                            rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                            simp [hq2] at htc
                            let ctxFalse' := { ctxFalse with nextLoc := r2.nextLoc', nextTag := r2.nextTag', nextBind := r2.nextBind', declaredExternRefs := r2.declared' }
                            cases hte3 : typecheckExpr ctxFalse' e3 fuel' with
                            | error err3 =>
                                erw [hte3] at htc
                                simp at htc
                            | ok r3 =>
                                erw [hte3] at htc
                                simp at htc
                                rcases hq3 : r3.qualType with ⟨etyp3, p3, pred3⟩
                                simp [hq3] at htc
                                by_cases hcompat : beqETypSignature etyp2 etyp3
                                · simp [hcompat, pure, Except.pure] at htc
                                  cases htc
                                  have hte2' : typecheck ctxTrue e2 fuel' = .ok r2 := by
                                    simpa [typecheck, ctxTrue] using hte2
                                  have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctxTrue r2 hte2'
                                  have h1 := IH fuel' (Nat.lt_succ_self fuel') e1
                                    { ctx with pureCtx := true } r1 (by simpa [typecheck] using hte1)
                                  have hctx : ctx.nextTag ≤ r2.nextTag' := by
                                    exact Nat.le_trans (by simpa using h1) (by simpa [ctxTrue] using h2)
                                  exact Nat.le_trans hctx (Nat.le_max_left _ _)
                                · simp [hcompat] at htc
                    | false =>
                        simp [hreg] at htc
                        cases hte2 : typecheckExpr ctxTrue e2 fuel' with
                        | error err2 =>
                            erw [hte2] at htc
                            simp at htc
                        | ok r2 =>
                            erw [hte2] at htc
                            simp at htc
                            rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                            simp [hq2] at htc
                            let ctxFalse' := { ctxFalse with nextLoc := r2.nextLoc', nextTag := r2.nextTag', nextBind := r2.nextBind', declaredExternRefs := r2.declared' }
                            cases hte3 : typecheckExpr ctxFalse' e3 fuel' with
                            | error err3 =>
                                erw [hte3] at htc
                                simp at htc
                            | ok r3 =>
                                erw [hte3] at htc
                                simp at htc
                                rcases hq3 : r3.qualType with ⟨etyp3, p3, pred3⟩
                                simp [hq3] at htc
                                by_cases hcompat : beqETypSignature etyp2 etyp3
                                · simp [hcompat, pure, Except.pure] at htc
                                  cases htc
                                  have hte2' : typecheck ctxTrue e2 fuel' = .ok r2 := by
                                    simpa [typecheck, ctxTrue] using hte2
                                  have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctxTrue r2 hte2'
                                  have h1 := IH fuel' (Nat.lt_succ_self fuel') e1
                                    { ctx with pureCtx := true } r1 (by simpa [typecheck] using hte1)
                                  have hctx : ctx.nextTag ≤ r2.nextTag' := by
                                    exact Nat.le_trans (by simpa using h1) (by simpa [ctxTrue] using h2)
                                  exact Nat.le_trans hctx (Nat.le_max_left _ _)
                                · simp [hcompat] at htc
                | none =>
                    simp [hreg] at htc
                    cases hte1std : typecheckExpr ctx e1 fuel' with
                    | error err1std =>
                        erw [hte1std] at htc
                        simp at htc
                    | ok r1std =>
                        erw [hte1std] at htc
                        simp at htc
                        rcases hq1std : r1std.qualType with ⟨etyp1std, p1std, pred1std⟩
                        simp [hq1std] at htc
                        by_cases hboolStd : etyp1std = ETyp.bool
                        · simp [hboolStd] at htc
                          let ctx1 : TypeContext := updateCtxFromResult ctx r1std
                          let branchPc := joinPoison ctx.pc p1std
                          let ctx'' := { ctx1 with pc := branchPc }
                          cases hte2 : typecheckExpr ctx'' e2 fuel' with
                          | error err2 =>
                              erw [hte2] at htc
                              simp at htc
                          | ok r2 =>
                              erw [hte2] at htc
                              simp at htc
                              rcases hq2 : r2.qualType with ⟨etyp2, p2, pred2⟩
                              simp [hq2] at htc
                              let ctxForE3 := { ctx'' with nextLoc := r2.nextLoc', nextTag := r2.nextTag', nextBind := r2.nextBind', declaredExternRefs := r2.declared' }
                              cases hte3 : typecheckExpr ctxForE3 e3 fuel' with
                              | error err3 =>
                                  erw [hte3] at htc
                                  simp at htc
                              | ok r3 =>
                                  erw [hte3] at htc
                                  simp at htc
                                  rcases hq3 : r3.qualType with ⟨etyp3, p3, pred3⟩
                                  simp [hq3] at htc
                                  by_cases hcompat : beqETypSignature etyp2 etyp3
                                  · simp [hcompat, pure, Except.pure] at htc
                                    cases htc
                                    have hte1std' : typecheck ctx e1 fuel' = .ok r1std := by
                                      simpa [typecheck] using hte1std
                                    have h1 := IH fuel' (Nat.lt_succ_self fuel') e1 ctx r1std hte1std'
                                    have hte2' : typecheck ctx'' e2 fuel' = .ok r2 := by
                                      simpa [typecheck, ctx'', ctx1, branchPc, updateCtxFromResult] using hte2
                                    have h2 := IH fuel' (Nat.lt_succ_self fuel') e2 ctx'' r2 hte2'
                                    have hctx_to_ctx2 : ctx.nextTag ≤ r2.nextTag' := by
                                      have hctx1 : ctx.nextTag ≤ r1std.nextTag' := h1
                                      have hctx2 : ctx''.nextTag ≤ r2.nextTag' := h2
                                      have hctx1eq : ctx''.nextTag = r1std.nextTag' := by
                                        simp [ctx'', ctx1, updateCtxFromResult]
                                      exact Nat.le_trans hctx1 (by simpa [hctx1eq] using hctx2)
                                    exact Nat.le_trans hctx_to_ctx2 (Nat.le_max_left _ _)
                                  · simp [hcompat] at htc
                        · simp [hboolStd] at htc
              · simp [hbool] at htc

private lemma typecheck_nextTag_mono_normal_main : ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
  typecheck ctx e fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro ctx e fuel res htc
  revert ctx e res htc
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
      intro ctx e res htc
      have IH_converted : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e' m = .ok res' →
        ctx'.nextTag ≤ res'.nextTag' := by
        intro m h_lt e' ctx' res' htc'
        exact IH m h_lt ctx' e' res' htc'
      unfold typecheck at htc
      cases fuel with
      | zero =>
          unfold typecheckExpr at htc
          simp at htc
      | succ fuel' =>
          unfold typecheckExpr at htc
          unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
          have IH_fuel' : ∀ m < fuel', ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
            typecheck ctx' e' m = .ok res' →
            ctx'.nextTag ≤ res'.nextTag' := by
            intro m h_lt e' ctx' res' htc'
            have h_lt' : m < fuel' + 1 := Nat.lt_of_lt_of_le h_lt (Nat.le_succ fuel')
            exact IH_converted m h_lt' e' ctx' res' htc'
          cases e with
          | num _n | bool _b | unit | str _s =>
              simp at htc
              injection htc with h_eq
              subst h_eq
              exact le_rfl
          | var x =>
              simp at htc
              have hpres := typecheckVar_preserves_nextTag ctx x res htc
              simp [hpres]
          | fn x st1 body st2 =>
              have hfn := typecheckFn_ok_eq htc; subst hfn
              exact le_rfl
          | pfn x st1 body st2 =>
              unfold typecheckPfn at htc
              simp [Bind.bind, Except.bind] at htc
              cases h_topexpr : body.toPExpr with
              | error _ =>
                  simp [h_topexpr] at htc
              | ok _ =>
                  simp [h_topexpr] at htc
                  injection htc with h_eq
                  subst h_eq
                  exact le_rfl
          | externVal _id typ poison pred =>
              simp at htc
              exact typecheckExternVal_nextTag_mono _ _ _ _ _ _ _ htc
          | externFn id arg argTyp argPoison argPred retSpec effects =>
              simp at htc
              have hpres := typecheckExternFn_preserves_nextTag ctx id arg argTyp argPoison argPred retSpec effects res htc
              simp [hpres]
          | externPfn id arg argTyp argPoison argPred retSpec =>
              simp at htc
              have hpres := typecheckExternPfn_preserves_nextTag ctx id arg argTyp argPoison argPred retSpec res htc
              simp [hpres]
          | externRef _id _rp _rpred _cp _cpred =>
              simp at htc
              have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
              simp [hres]
          | op e1 op e2 =>
              simp at htc
              exact typecheckOp_nextTag_mono_normal ctx e1 e2 fuel' op res IH_fuel' htc
          | unaryop op e1 =>
              simp at htc
              exact typecheckUnaryOp_nextTag_mono_normal ctx op e1 fuel' res IH_fuel' htc
          | ite e1 e2 e3 =>
              simp at htc
              exact typecheckIf_nextTag_mono_normal ctx e1 e2 e3 fuel' res IH_fuel' htc
          | newRef e1 =>
              simp at htc
              exact typecheckNewRef_nextTag_mono_normal ctx e1 fuel' res IH_fuel' htc
          | assign e1 e2 =>
              simp at htc
              exact typecheckAssign_nextTag_mono_normal ctx e1 e2 fuel' res IH_fuel' htc
          | deref e1 =>
              simp at htc
              exact typecheckDeref_nextTag_mono_normal ctx e1 fuel' res IH_fuel' htc
          | seq e1 e2 =>
              simp at htc
              exact typecheckSeq_nextTag_mono_normal ctx e1 e2 fuel' res IH_fuel' htc
          | vlet x e1 e2 =>
              simp at htc
              exact typecheckVlet_nextTag_mono_normal ctx x e1 e2 fuel' res IH_fuel' htc
          | app e1 e2 =>
              simp at htc
              exact typecheckApp_nextTag_mono_normal ctx e1 e2 fuel' res IH_fuel' htc

lemma typecheck_normal_nextTag_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  typecheck ctx e fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  exact typecheck_nextTag_mono_normal_main ctx e fuel res htc

lemma typecheck_nextTag_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  typecheck ctx e fuel = .ok res →
  ctx.nextTag ≤ res.nextTag' := by
  intro htc
  exact typecheck_normal_nextTag_mono ctx e fuel res htc

/-- Extended-regime monotonicity of the regime join: the conservative join keeps
    agreeing entries, so `monotoneStepExt` with a shared `newTags` set transports through it. -/
private lemma joinRegimes_monotoneExt_of_monotoneExt
    (R R1 R2 : Regime) (newTags : Tag → Prop)
    (h1 : Regime.monotoneStepExt R R1 newTags)
    (h2 : Regime.monotoneStepExt R R2 newTags) :
    Regime.monotoneStepExt R (joinRegimes R1 R2) newTags := by
  refine ⟨?_, ?_⟩
  · intro k b hknew hkR
    have hk1 := h1.1 k b hknew hkR
    have hk2 := h2.1 k b hknew hkR
    cases hk1 with
    | inl hk1some =>
        cases hk2 with
        | inl hk2some =>
            exact Or.inl (joinRegimes_lookup_of_some_some R1 R2 k b hk1some hk2some)
        | inr hk2none =>
            exact Or.inr (joinRegimes_lookup_of_right_none R1 R2 k hk2none)
    | inr hk1none =>
        exact Or.inr (joinRegimes_lookup_of_left_none R1 R2 k hk1none)
  · intro k hkjoin
    have hk1 : R1.lookup? k ≠ none := joinRegimes_no_new_left R1 R2 k hkjoin
    exact h1.2 k hk1

lemma joinTypeResults_regime_monotone
    {newTags : Tag → Prop}
    (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) (R : Regime)
    (h_r : Regime.monotoneStepExt R r.regime' newTags)
    (h_rs : ∀ x ∈ rs, Regime.monotoneStepExt R x.regime' newTags) :
    joinTypeResults ctx r rs = .ok res →
    Regime.monotoneStepExt R res.regime' newTags := by
  intro hjoin
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_regime :
      ∀ (rs' : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs' = .ok acc' →
        Regime.monotoneStepExt R acc.2.2.2.2.2.1 newTags →
        (∀ x ∈ rs', Regime.monotoneStepExt R x.regime' newTags) →
        Regime.monotoneStepExt R acc'.2.2.2.2.2.1 newTags := by
    intro rs' acc acc' hfold hacc hmono
    induction rs' generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at hfold
        cases hfold
        simpa using hacc
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at hfold
            have hxmono : Regime.monotoneStepExt R x.regime' newTags := hmono x (by simp)
            have hacc1 : Regime.monotoneStepExt R (joinRegimes acc.2.2.2.2.2.1 x.regime') newTags :=
              joinRegimes_monotoneExt_of_monotoneExt R acc.2.2.2.2.2.1 x.regime' newTags hacc hxmono
            have hmono_tail : ∀ y ∈ xs, Regime.monotoneStepExt R y.regime' newTags := by
              intro y hy
              exact hmono y (by simp [hy])
            exact ih _ hfold hacc1 hmono_tail
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err =>
          erw [hcheck] at hjoin
          simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin
          simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err =>
              erw [hfold] at hjoin
              simp at hjoin
          | ok a =>
              erw [hfold] at hjoin
              simp at hjoin
              subst res
              simpa using h_fold_regime rs
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') a
                hfold h_r h_rs

/-- The regime after `applyExternRegimePolicy` either agrees with the input regime at `k`, or
    `k` is one of the policy-allocated tags. -/
lemma applyExternRegimePolicy_lookup_spec
    (R : Regime) (id : ExternId) (policy : ExternId → Tag → Option Bool)
    (tagMapping : TagMapping) (k : Tag) :
    (applyExternRegimePolicy R id policy tagMapping).lookup? k = R.lookup? k
      ∨ ∃ idx, tagMapping.get? idx = some k := by
  unfold applyExternRegimePolicy
  have hgen : ∀ (l : List (TagIndex × Tag)) (R0 : Regime),
      (l.foldl (fun R p => match policy id p.2 with
                           | some b => match R.lookup? p.2 with | none => R.insert p.2 b | some _ => R
                           | none => R)
          R0).lookup? k = R0.lookup? k ∨ ∃ p ∈ l, p.2 = k := by
    intro l
    induction l with
    | nil => intro R0; left; rfl
    | cons p l' ih =>
        intro R0
        simp only [List.foldl_cons]
        rcases ih _ with hl | hr
        · by_cases hpk : p.2 = k
          · exact Or.inr ⟨p, List.Mem.head l', hpk⟩
          · refine Or.inl ?_
            rw [hl]
            cases hpol : policy id p.2 with
            | none => rfl
            | some b =>
                cases hlook : R0.lookup? p.2 with
                | some _ => rfl
                | none =>
                    have hcmp : compare p.2 k ≠ Ordering.eq := fun h =>
                      hpk ((Nat.compare_eq_eq).1 h)
                    show Regime.lookup? (R0.insert p.2 b) k = Regime.lookup? R0 k
                    unfold Regime.lookup?
                    simp [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_insert, hcmp]
        · obtain ⟨p', hp'mem, hp'k⟩ := hr
          exact Or.inr ⟨p', List.mem_cons_of_mem _ hp'mem, hp'k⟩
  rcases hgen tagMapping.toList R with h | ⟨p, hpmem, hpk⟩
  · exact Or.inl h
  · refine Or.inr ⟨p.1, ?_⟩
    have hp : tagMapping.get? p.1 = some p.2 := by
      simpa using (Std.ExtTreeMap.mem_toList_iff_getElem?_eq_some).1 hpmem
    rw [hp, hpk]

/-- Insert-if-absent: applying the extern-regime policy never overwrites an
    existing regime entry, so every `some` entry of `R` is preserved exactly.  This makes the
    exact-preservation consumers (pure-regime bridge, regime-consistency transport) hold with no tag
    bound. -/
lemma applyExternRegimePolicy_lookup_preserve_some
    (R : Regime) (id : ExternId) (policy : ExternId → Tag → Option Bool)
    (tagMapping : TagMapping) (k : Tag) (b : Bool)
    (h : R.lookup? k = some b) :
    (applyExternRegimePolicy R id policy tagMapping).lookup? k = some b := by
  unfold applyExternRegimePolicy
  have hgen : ∀ (l : List (TagIndex × Tag)) (R0 : Regime), R0.lookup? k = some b →
      (l.foldl (fun R p => match policy id p.2 with
                           | some b => match R.lookup? p.2 with | none => R.insert p.2 b | some _ => R
                           | none => R)
          R0).lookup? k = some b := by
    intro l
    induction l with
    | nil => intro R0 h0; simpa using h0
    | cons p l' ih =>
        intro R0 h0
        simp only [List.foldl_cons]
        apply ih
        cases hpol : policy id p.2 with
        | none => exact h0
        | some bb =>
            cases hlook : R0.lookup? p.2 with
            | some _ => exact h0
            | none =>
                have hne : p.2 ≠ k := by
                  intro heq; rw [heq, h0] at hlook; exact nomatch hlook
                have hcmp : compare p.2 k ≠ Ordering.eq := fun hc => hne ((Nat.compare_eq_eq).1 hc)
                show Regime.lookup? (R0.insert p.2 bb) k = some b
                unfold Regime.lookup?
                rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_insert]
                simp only [hcmp, ite_false]
                simpa [Std.ExtTreeMap.get?_eq_getElem?] using! h0
  exact hgen tagMapping.toList R h

/-- Insertion-step monotonicity: applying the extern-regime policy is
    a `monotoneStepExt` step whose fresh-tag set is exactly the policy-allocated tags.  With the
    restricted forward conjunct, a non-fresh `k` is untouched by the inserts, so no `hfresh`
    hypothesis is needed. -/
private theorem applyExternRegimePolicy_monotoneStepExt
    (R : Regime) (id : ExternId) (policy : ExternId → Tag → Option Bool)
    (tagMapping : TagMapping) :
    Regime.monotoneStepExt R (applyExternRegimePolicy R id policy tagMapping)
      (fun k => ∃ idx, tagMapping.get? idx = some k) := by
  refine ⟨?_, ?_⟩
  · intro k b hknew hRk
    rcases applyExternRegimePolicy_lookup_spec R id policy tagMapping k with heq | ⟨idx, hidx⟩
    · exact Or.inl (heq.trans hRk)
    · exact absurd ⟨idx, hidx⟩ hknew
  · intro k hk
    rcases applyExternRegimePolicy_lookup_spec R id policy tagMapping k with heq | hval
    · exact Or.inl (heq ▸ hk)
    · exact Or.inr hval

/-- Extern-regime shape: the applied PFn extern's `regime'` is either
    unchanged (nested returns) or the policy-extended `applyExternRegimePolicy` of `r1.regime'`
    over a tag mapping whose tags are all fresh (`≥ r1.nextTag'`).  This single lemma feeds both the
    regime-monotonicity chain (via `applyExternRegimePolicy_monotoneStepExt`) and the consistency
    consumers (via `applyPFnTClosure_extern_regime_preserve_some`). -/
private lemma applyPFnTClosure_extern_regime_eq_or_policy
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2) :
  r2.regime' = r1.regime' ∨
    ∃ tm : TagMapping, r2.regime' = applyExternRegimePolicy r1.regime' id ctx.externRegime tm ∧
      (∀ idx j, tm.get? idx = some j → r1.nextTag' ≤ j) := by
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ n =>
      simp only [bind, Except.bind] at happly
      -- Leading argument-condition gate: throw branch is impossible on .ok.
      split at happly
      · exact nomatch happly
      simp only [pure, Except.pure] at happly
      split at happly
      · -- ExternReturn.simple
        split at happly
        · exact nomatch happly
        · next tmRes hcollect =>
          obtain ⟨tm, nt'⟩ := tmRes
          split at happly
          · exact nomatch happly
          · split at happly
            · exact nomatch happly
            · split at happly
              · exact nomatch happly
              cases happly
              refine Or.inr ⟨tm, rfl, ?_⟩
              intro idx j hj
              exact collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx j hj
      · -- ExternReturn.nestedFn
        split at happly
        · exact nomatch happly
        · cases happly; exact Or.inl rfl
      · -- ExternReturn.nestedPfn
        split at happly
        · exact nomatch happly
        · cases happly; exact Or.inl rfl

/-- Exact regime preservation for an applied PFn extern (insert-if-absent policy): any tag already
    `some b` in `r1.regime'` stays `some b` in `r2.regime'`.  Unconditional — no tag bound needed. -/
lemma applyPFnTClosure_extern_regime_preserve_some
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (b : Bool) (hk : r1.regime'.lookup? k = some b) :
  r2.regime'.lookup? k = some b := by
  rcases applyPFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
      r1 r2 fuel id x retSpec capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, _hfresh⟩
  · rw [heq]; exact hk
  · rw [hr2]
    exact applyExternRegimePolicy_lookup_preserve_some r1.regime' id ctx.externRegime tm k b hk

-- ==========================================================================
-- FnTClosure.extern regime lemmas
-- The output regime is the effect-invalidated input regime extended by the
-- extern-regime policy (fresh tags only); entries that survive the effect
-- invalidation keep their values.
-- ==========================================================================

/-- Extern-regime shape:
    the applied Fn extern's `regime'` is the policy-extended `applyExternRegimePolicy` of the
    *effect-invalidated* input regime `invalidateRegimeDepsEffect r1.regime' r1.tagEnv'
    (effectTargetLocs effects …)` over a fresh tag mapping (tags `≥ r1.nextTag'`) — for both
    simple returns and nested returns.  The statement keeps the weaker `invalidated ∨
    policy-extended` disjunction so downstream consumers stay uniform with the PFn variant; for
    Fn externs the left disjunct is vacuous.  Feeds both the regime-monotonicity chain and the
    consistency consumers (the inner regime is a sub-map of `r1.regime'`). -/
private lemma applyFnTClosure_extern_regime_eq_or_policy
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (effects : List Effect) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2) :
  r2.regime' = invalidateRegimeDepsEffect r1.regime' r1.tagEnv'
      (effectTargetLocs effects
        (VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
          ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩)) ∨
    ∃ tm : TagMapping, r2.regime' = applyExternRegimePolicy
      (invalidateRegimeDepsEffect r1.regime' r1.tagEnv'
        (effectTargetLocs effects
          (VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
            ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩)))
      id ctx.externRegime tm ∧
      (∀ idx j, tm.get? idx = some j → r1.nextTag' ≤ j) := by
  unfold applyFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ n =>
      simp only [bind, Except.bind] at happly
      -- Leading argument-condition gate: throw branch is impossible on .ok.
      split at happly
      · exact nomatch happly
      simp only [pure, Except.pure] at happly
      -- collectAndAllocExternTags
      split at happly
      · exact nomatch happly
      · next tmRes hcollect =>
        obtain ⟨tm, nt'⟩ := tmRes
        -- effects loop result
        split at happly
        · exact nomatch happly
        · -- match retSpec
          split at happly
          · -- ExternReturn.simple
            split at happly
            · exact nomatch happly
            · split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                cases happly
                refine Or.inr ⟨tm, rfl, ?_⟩
                intro idx j hj
                exact collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx j hj
          · -- ExternReturn.nestedFn: outer effect tags are policy-extended
            split at happly
            · exact nomatch happly
            · split at happly
              · exact nomatch happly
              cases happly
              refine Or.inr ⟨tm, rfl, ?_⟩
              intro idx j hj
              exact collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx j hj
          · -- ExternReturn.nestedPfn: outer effect tags are policy-extended
            split at happly
            · exact nomatch happly
            · split at happly
              · exact nomatch happly
              cases happly
              refine Or.inr ⟨tm, rfl, ?_⟩
              intro idx j hj
              exact collectAndAllocExternTags_mapping_values_ge _ _ _ _ hcollect idx j hj

/-- Forward regime preservation for an applied Fn extern.  The effect
    invalidation can drop regime entries whose guard deps touch the written effect
    targets, so preservation requires that `k` *survives* the effect invalidation
    of the input tagEnv (⇒ its deps avoid the written locs).  A surviving tag's
    regime value passes through both the effect invalidation and the insert-if-absent
    policy unchanged.  (The survival hypothesis is stated against the
    invalidated input tagEnv rather than `r2.tagEnv'`, which additionally holds
    the freshly installed return guard.) -/
lemma applyFnTClosure_extern_regime_preserve_some
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (effects : List Effect) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (b : Bool)
  (hsurvive : (invalidateTagDeps r1.tagEnv'
    (effectTargetLocs effects
      (VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
        ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩))).get? k ≠ none)
  (hk : r1.regime'.lookup? k = some b) :
  r2.regime'.lookup? k = some b := by
  have hsurv := invalidateRegimeDepsEffect_lookup_preserve_of_survive _ _ _ k b hsurvive hk
  rcases applyFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
      r1 r2 fuel id x retSpec effects capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, _hfresh⟩
  · rw [heq]; exact hsurv
  · rw [hr2]
    exact applyExternRegimePolicy_lookup_preserve_some _ id ctx.externRegime tm k b hsurv

/-- Backward exact regime preservation for an applied Fn extern: a pre-existing tag
    (`< r1.nextTag'`) that is `some b` in `r2.regime'` was already `some b` in
    `r1.regime'` (the policy only inserts fresh tags). -/
lemma applyFnTClosure_extern_regime_preserve_some_back
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (effects : List Effect) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (b : Bool) (hk : k < r1.nextTag') (h : r2.regime'.lookup? k = some b) :
  r1.regime'.lookup? k = some b := by
  rcases applyFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
      r1 r2 fuel id x retSpec effects capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, hfresh⟩
  · -- vacuous branch: r2.regime' is the effect-invalidated (sub-map) regime
    rw [heq] at h
    exact invalidateRegimeDepsEffect_lookup_some_imp _ _ _ k b h
  · rw [hr2] at h
    rcases applyExternRegimePolicy_lookup_spec
        (invalidateRegimeDepsEffect r1.regime' r1.tagEnv'
          (effectTargetLocs effects (VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
            ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩)))
        id ctx.externRegime tm k with hsame | ⟨idx, hidx⟩
    · rw [hsame] at h
      exact invalidateRegimeDepsEffect_lookup_some_imp _ _ _ k b h
    · exact absurd (Nat.lt_of_lt_of_le hk (hfresh idx k hidx)) (Nat.lt_irrefl k)

/-- Backward exact regime preservation for an applied PFn extern. -/
lemma applyPFnTClosure_extern_regime_preserve_some_back
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
  (declaredArgQt : QTyp)
  (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
    argEtyp argPoison argPred ctx r1 fuel = .ok r2)
  (k : Tag) (b : Bool) (hk : k < r1.nextTag') (h : r2.regime'.lookup? k = some b) :
  r1.regime'.lookup? k = some b := by
  rcases applyPFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
      r1 r2 fuel id x retSpec capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, hfresh⟩
  · rw [heq] at h; exact h
  · rw [hr2] at h
    rcases applyExternRegimePolicy_lookup_spec r1.regime' id ctx.externRegime tm k with hsame | ⟨idx, hidx⟩
    · rw [hsame] at h; exact h
    · exact absurd (Nat.lt_of_lt_of_le hk (hfresh idx k hidx)) (Nat.lt_irrefl k)

private lemma applyFnTClosure_regime_mono
    (tcl : FnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheck ctx' e m = .ok res' →
          Regime.monotoneStepExt ctx'.regime res'.regime' (fun k => ctx'.nextTag ≤ k)) :
    applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
    Regime.monotoneStepExt r1.regime' r2.regime' (fun k => r1.nextTag' ≤ k) := by
  intro happly
  cases tcl with
  | regular x body env =>
    unfold applyFnTClosure at happly
    cases fuel <;> simp at happly
    simp [bind, Except.bind] at happly
    rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
      <;> rw [htc] at happly
      <;> simp at happly
    rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
    simp [hqt] at happly
    rcases hsub : isErasureOf st2 _
      <;> rw [hsub] at happly
      <;> simp at happly
    · simp [Functor.map, Except.map] at happly
    · simp [pure, Except.pure] at happly
      subst r2
      specialize IH _ (lt_add_one _) _ _ _ htc
      simpa using IH
  | extern id x retSpec effects capturedEnv declaredArgQt _captures =>
    -- Extern case: `regime'` is the fresh policy extension of the *effect-invalidated*
    -- input regime.  Both legs are monotone: the invalidation is a strong `monotoneStep`
    -- (sub-map), the policy a `monotoneStepExt` adding only fresh (`≥ r1.nextTag'`) tags; compose
    -- them by `monotoneStepExt_trans`.  (The disjunction's left branch is vacuous for Fn.)
    rcases applyFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
        r1 r2 fuel id x retSpec effects capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, hfresh⟩
    · rw [heq]
      exact Regime.monotoneStep_toExt (invalidateRegimeDepsEffect_monotone _ _ _) _
    · rw [hr2]
      refine Regime.monotoneStepExt_weaken
        (Regime.monotoneStepExt_trans
          (Regime.monotoneStep_toExt (invalidateRegimeDepsEffect_monotone r1.regime' r1.tagEnv' _)
            (fun k => r1.nextTag' ≤ k))
          (applyExternRegimePolicy_monotoneStepExt _ id ctx.externRegime tm))
        (fun k hk => ?_)
      rcases hk with hle | ⟨idx, hidx⟩
      · exact hle
      · exact hfresh idx k hidx

lemma applyPFnTClosure_regime_mono
    (tcl : PFnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheck ctx' e m = .ok res' →
          Regime.monotoneStepExt ctx'.regime res'.regime' (fun k => ctx'.nextTag ≤ k)) :
    applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
    Regime.monotoneStepExt r1.regime' r2.regime' (fun k => r1.nextTag' ≤ k) := by
  intro happly
  cases tcl with
  | regular x body env =>
      unfold applyPFnTClosure at happly
      cases fuel <;> simp at happly
      simp [bind, Except.bind] at happly
      rcases htc_body : typecheckExpr _ _ _ with _ | ⟨r3⟩
      · rw [htc_body] at happly
        simp at happly
      · rw [htc_body] at happly
        simp at happly
        rcases hq3 : r3.qualType with ⟨etyp3, poison3, pred3⟩
        simp [hq3] at happly
        rcases hsub : isErasureOf st2 { etyp := etyp3, poison := poison3, pred := pred3 }
        · rw [hsub] at happly
          simp [Functor.map, Except.map] at happly
        · rw [hsub] at happly
          simp [pure, Except.pure] at happly
          subst r2
          specialize IH _ (lt_add_one _) _ _ _ htc_body
          simpa using IH
  | extern id x retSpec capturedEnv declaredArgQt captures =>
      rcases applyPFnTClosure_extern_regime_eq_or_policy ctx st1 st2 p p1 argEtyp argPoison argPred
          r1 r2 fuel id x retSpec capturedEnv declaredArgQt happly with heq | ⟨tm, hr2, hfresh⟩
      · rw [heq]; exact Regime.monotoneStepExt_refl _ _
      · rw [hr2]
        exact Regime.monotoneStepExt_weaken
          (applyExternRegimePolicy_monotoneStepExt r1.regime' id ctx.externRegime tm)
          (fun k hk => match hk with | ⟨idx, hidx⟩ => hfresh idx k hidx)

