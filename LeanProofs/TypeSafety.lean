-- Regime monotonicity: typechecking can only drop pre-existing regime entries (never change their
-- values); the only new entries are fresh tags `≥ ctx.nextTag` (`Regime.monotoneStepExt`).

private lemma typecheck_regime_mono_main : ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
    typecheck ctx e fuel = .ok res →
    Regime.monotoneStepExt ctx.regime res.regime' (fun k => ctx.nextTag ≤ k) := by
  intro ctx e fuel res htc
  revert ctx e res htc
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
      intro ctx e res htc
      have IH_converted : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheck ctx' e m = .ok res' →
          Regime.monotoneStepExt ctx'.regime res'.regime' (fun k => ctx'.nextTag ≤ k) := by
        intro m h_lt e' ctx' res' htc'
        exact IH m h_lt ctx' e' res' htc'
      unfold typecheck at htc
      cases fuel with
      | zero =>
          unfold typecheckExpr at htc
          simp at htc
      | succ fuel' =>
          unfold typecheckExpr at htc
          have IH_fuel' : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
              typecheck ctx' e m = .ok res' →
              Regime.monotoneStepExt ctx'.regime res'.regime' (fun k => ctx'.nextTag ≤ k) := by
            intro m h_lt e' ctx' res' htc'
            have h_lt' : m < fuel' + 1 := Nat.lt_of_lt_of_le h_lt (Nat.le_succ fuel')
            exact IH_converted m h_lt' e' ctx' res' htc'
          unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
          cases e with
          | num _n | bool _b | unit | str _s =>
              simp at htc
              injection htc with h_eq
              subst h_eq
              exact Regime.monotoneStepExt_refl ctx.regime _
          | var x =>
              simp at htc
              exact typecheckVar_regime_mono ctx x res htc
          | fn x st1 body st2 =>
              have hfn := typecheckFn_ok_eq htc; subst hfn
              exact Regime.monotoneStepExt_refl ctx.regime _
          | pfn x st1 body st2 =>
              unfold typecheckPfn at htc
              simp [Bind.bind, Except.bind] at htc
              cases h_topexpr : body.toPExpr with
              | error _ =>
                  simp [h_topexpr] at htc
              | ok _ =>
                  simp [h_topexpr] at htc
                  injection htc with h_eq
                  subst h_eq
                  exact Regime.monotoneStepExt_refl ctx.regime _
          | externVal id _typ _poison pred =>
              obtain ⟨_, tagMapping, nextTag', _, _, halloc, _, _, rfl⟩ :=
                typecheckExternVal_ok_shape htc
              exact Regime.monotoneStepExt_weaken
                (applyExternRegimePolicy_monotoneStepExt ctx.regime id ctx.externRegime tagMapping)
                (fun k hk => match hk with
                  | ⟨idx, hidx⟩ =>
                    collectAndAllocExternTags_mapping_values_ge _ _ _ _ halloc idx k hidx)
          | externFn id arg argTyp argPoison argPred retSpec effects =>
              obtain ⟨argQt, _, hres⟩ :=
                typecheckExternFn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec effects res htc
              rw [hres]
              exact Regime.monotoneStepExt_refl ctx.regime _
          | externPfn id arg argTyp argPoison argPred retSpec =>
              obtain ⟨argQt, _, hres⟩ :=
                typecheckExternPfn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec res htc
              rw [hres]
              exact Regime.monotoneStepExt_refl ctx.regime _
          | externRef _id _rp _rpred _cp _cpred =>
              simp at htc
              have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
              subst hres
              exact Regime.monotoneStepExt_refl ctx.regime _
          | op e1 op e2 =>
              simp at htc
              exact typecheckOp_regime_mono ctx e1 e2 fuel' op res IH_fuel' htc
          | unaryop op e1 =>
              simp at htc
              exact typecheckUnaryOp_regime_mono ctx op e1 fuel' res IH_fuel' htc
          | ite e1 e2 e3 =>
              simp at htc
              exact typecheckIf_regime_mono ctx e1 e2 e3 fuel' res IH_fuel' htc
          | newRef e1 =>
              simp at htc
              exact typecheckNewRef_regime_mono ctx e1 fuel' res IH_fuel' htc
          | assign e1 e2 =>
              simp at htc
              exact typecheckAssign_regime_mono ctx e1 e2 fuel' res IH_fuel' htc
          | deref e1 =>
              simp at htc
              exact typecheckDeref_regime_mono ctx e1 fuel' res IH_fuel' htc
          | seq e1 e2 =>
              simp at htc
              exact typecheckSeq_regime_mono ctx e1 e2 fuel' res IH_fuel' htc
          | vlet x e1 e2 =>
              simp at htc
              exact typecheckVlet_regime_mono ctx x e1 e2 fuel' res IH_fuel' htc
          | app e1 e2 =>
              simp at htc
              exact typecheckApp_regime_mono ctx e1 e2 fuel' res IH_fuel' htc

/-- Regime evolution through a typing step: monotone for old tags,
    but selected extern calls may add fresh tags `≥ ctx.nextTag`.  The stronger
    `Regime.monotoneStep` does not hold for typing, because extern typing inserts regime
    entries.  Consumers use this `monotoneStepExt` form together with a tag bound to transport
    old-tag facts. -/
lemma regime_monotoneExt (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
    typecheck ctx e fuel = .ok res →
    Regime.monotoneStepExt ctx.regime (ctxAfter ctx res).regime (fun k => ctx.nextTag ≤ k) := by
  intro htc
  simpa [ctxAfter] using typecheck_regime_mono_main ctx e fuel res htc

-- Tag boundedness: predTagBounded helper lemmas and infrastructure

section PredTagBoundMono
variable {nt nt' : Tag}

private lemma predTagBounded_mono {p : Predicate}
    (hb : predTagBounded nt p) (hle : nt ≤ nt') : predTagBounded nt' p := by
  cases p with
  | guardClosure k _ _ _ => exact Nat.lt_of_lt_of_le hb hle
  | guardOnly k => exact Nat.lt_of_lt_of_le hb hle
  | noPred => trivial

lemma qtypPredTagBounded_mono {qt : QTyp}
    (hb : qtypPredTagBounded qt nt) (hle : nt ≤ nt') : qtypPredTagBounded qt nt' :=
  predTagBounded_mono hb hle

lemma predTagsBoundedInVarEnv_mono {S : VarTypeEnv}
    (hb : predTagsBoundedInVarEnv S nt) (hle : nt ≤ nt') : predTagsBoundedInVarEnv S nt' :=
  fun x qt hlookup => qtypPredTagBounded_mono (hb x qt hlookup) hle

lemma predTagsBoundedInMemEnv_mono {G : MemoryTypeEnv}
    (hb : predTagsBoundedInMemEnv G nt) (hle : nt ≤ nt') : predTagsBoundedInMemEnv G nt' :=
  fun l qt hlookup => qtypPredTagBounded_mono (hb l qt hlookup) hle

end PredTagBoundMono

lemma tagEnvBounded_insert_of_lt (te : TagEnv) (nt : Tag) (k : Tag) (tv : TagVal)
    (hb : tagEnvBounded te nt) (hk : k < nt) :
    tagEnvBounded (te.insert k tv) nt := by
  intro j hj
  by_cases heq : j = k
  · subst heq; exact hk
  · apply hb; intro hnone; apply hj
    have : (te.insert k tv).get? j = te.get? j := by
      simp only [Std.ExtTreeMap.get?_eq_getElem?]
      rw [Std.ExtTreeMap.getElem?_insert]
      simp [Ne.symm heq]
    rw [this]; exact hnone

private lemma predTagBounded_noPred (nt : Tag) : predTagBounded nt Predicate.noPred := trivial

private lemma predTagBounded_joinPredicates {nt : Tag} {p q : Predicate}
    (hp : predTagBounded nt p) (_hq : predTagBounded nt q) :
    predTagBounded nt (joinPredicates p q) := by
  unfold joinPredicates
  split
  · exact hp
  · -- Not exact match: all branches produce p's tag (guardOnly k1) or noPred
    split
    · split <;> first | exact hp | trivial  -- guardClosure/guardClosure
    · split <;> first | exact hp | trivial  -- guardOnly/guardOnly
    · split <;> first | exact hp | trivial  -- guardClosure/guardOnly
    · split <;> first | exact hp | trivial  -- guardOnly/guardClosure
    · trivial  -- noPred/_
    · trivial  -- _/noPred

section PredTagsBoundedUpdate
variable {nt : Tag} {qt : QTyp}

lemma predTagsBoundedInVarEnv_update {S : VarTypeEnv} {x : Name}
    (hb : predTagsBoundedInVarEnv S nt) (hqt : qtypPredTagBounded qt nt) :
    predTagsBoundedInVarEnv (S.update x qt) nt := by
  intro y qt' hlookup
  simp only [VarTypeEnv.update, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?] at hlookup
  rw [Std.ExtTreeMap.getElem?_insert] at hlookup
  split at hlookup
  · cases hlookup; exact hqt
  · exact hb y qt' (by simp only [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)

private lemma predTagsBoundedInMemEnv_update {G : MemoryTypeEnv} {l : Loc}
    (hb : predTagsBoundedInMemEnv G nt) (hqt : qtypPredTagBounded qt nt) :
    predTagsBoundedInMemEnv (G.update l qt) nt := by
  intro l' qt' hlookup
  simp only [MemoryTypeEnv.update, MemoryTypeEnv.lookup] at hlookup
  rw [Std.ExtTreeMap.get?_eq_getElem?, Std.ExtTreeMap.getElem?_insert] at hlookup
  split at hlookup
  · simp [Option.map] at hlookup; cases hlookup; exact hqt
  · simp at hlookup
    exact hb l' qt' (by simp [MemoryTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)

end PredTagsBoundedUpdate

/-- If joinMemEnvsStrong has an entry at l, then G1 or G2 has an entry at l,
    and the pred is either noPred (single-sided) or joinPredicates (both-sided). -/
private lemma joinMemEnvsStrong_pred_cases
    (G1 G2 : MemoryTypeEnv) (l : Loc) (qt : QTyp)
    (hlookup : (joinMemEnvsStrong G1 G2).lookup l = some qt) :
    (qt.pred = Predicate.noPred) ∨
    (∃ qt1 qt2, G1.lookup l = some qt1 ∧ G2.lookup l = some qt2 ∧
      qt.pred = joinPredicates qt1.pred qt2.pred) := by
  -- Work at the MemEntry level via get?
  simp only [joinMemEnvsStrong, MemoryTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?,
             combineExtTreeMaps] at hlookup
  classical
  let ks := (G1.keys ++ G2.keys).eraseDups
  let f : Loc → Option MemEntry → Option MemEntry → Option MemEntry := fun _ oe1 oe2 =>
    match oe1, oe2 with
    | some e1, none => some ⟨e1.poison, Predicate.noPred⟩
    | none, some e2 => some ⟨e2.poison, Predicate.noPred⟩
    | some e1, some e2 => some ⟨joinPoison e1.poison e2.poison, joinPredicates e1.pred e2.pred⟩
    | none, none => none
  -- The combined map at l is f l G1[l]? G2[l]?
  by_cases hmem : l ∈ ks
  · have hgo := combineExtTreeMaps_go_get_mem G1 G2 f ks ({} : MemoryTypeEnv) l hmem
    -- hgo : (combined)[l]? = match f l G1[l]? G2[l]? with some v => some v | none => none
    -- hlookup : Option.map wrap (combined)[l]? = some qt
    simp only [f] at hgo
    -- Case on G1[l]? and G2[l]?
    -- Substitute hgo into hlookup to get direct access to G1.get?/G2.get?
    simp only [Std.ExtTreeMap.get?_eq_getElem?] at hgo
    -- hgo and hlookup use the same combined[l]? but with different lambda shapes
    -- Use conv to target the rewrite precisely
    have hme := Option.map_eq_some_iff.mp hlookup
    obtain ⟨me, hme_eq, hqt_eq⟩ := hme
    -- Now case-split on G1.get? and G2.get? via hgo
    -- hgo : some me = match f l G1[l]? G2[l]? with some v => some v | none => none
    -- hqt_eq : {int, me.poison, me.pred} = qt
    -- Case on G1.get? l and G2.get? l (MemEntry level)
    match h1 : (G1.get? l : Option MemEntry), h2 : (G2.get? l : Option MemEntry) with
    | none, none =>
      simp only [Std.ExtTreeMap.get?_eq_getElem?] at h1 h2
      simp only [h1, h2] at hgo
      change (combineExtTreeMaps.go G1 G2 f ks ∅)[l]? = _ at hme_eq
      rw [hgo] at hme_eq; simp at hme_eq
    | none, some e2 =>
      simp only [Std.ExtTreeMap.get?_eq_getElem?] at h1 h2
      simp only [h1, h2] at hgo
      change (combineExtTreeMaps.go G1 G2 f ks ∅)[l]? = _ at hme_eq
      rw [hgo] at hme_eq; simp only [Option.some.injEq] at hme_eq
      left; rw [← hqt_eq, ← hme_eq]
    | some e1, none =>
      simp only [Std.ExtTreeMap.get?_eq_getElem?] at h1 h2
      simp only [h1, h2] at hgo
      change (combineExtTreeMaps.go G1 G2 f ks ∅)[l]? = _ at hme_eq
      rw [hgo] at hme_eq; simp only [Option.some.injEq] at hme_eq
      left; rw [← hqt_eq, ← hme_eq]
    | some e1, some e2 =>
      simp only [Std.ExtTreeMap.get?_eq_getElem?] at h1 h2
      simp only [h1, h2] at hgo
      change (combineExtTreeMaps.go G1 G2 f ks ∅)[l]? = _ at hme_eq
      rw [hgo] at hme_eq; simp only [Option.some.injEq] at hme_eq
      right
      exact ⟨⟨ETyp.int, e1.poison, e1.pred⟩, ⟨ETyp.int, e2.poison, e2.pred⟩,
        by simp [MemoryTypeEnv.lookup, h1],
        by simp [MemoryTypeEnv.lookup, h2],
        by rw [← hqt_eq, ← hme_eq]⟩
  · have hgo := combineExtTreeMaps_go_get_not_mem G1 G2 f ks ({} : MemoryTypeEnv) l hmem
    simp at hgo
    -- hgo : l ∉ combined OR combined[l]? = ∅[l]? = none
    -- Either way, hlookup contradicts this
    -- hgo : l ∉ combined. Use show to bring hlookup back to original form and derive contradiction
    have h_none := Std.ExtTreeMap.getElem?_eq_none hgo
    -- hlookup has Option.map _ combined[l]? = some qt but combined[l]? = none
    change Option.map _ (combineExtTreeMaps.go G1 G2 f ks ∅)[l]? = some qt at hlookup
    rw [h_none] at hlookup; simp at hlookup

/-- joinMemEnvsStrong preserves predTagsBoundedInMemEnv. -/
private lemma predTagsBoundedInMemEnv_joinMemEnvsStrong
    {G1 G2 : MemoryTypeEnv} {nt : Tag}
    (hb1 : predTagsBoundedInMemEnv G1 nt) (hb2 : predTagsBoundedInMemEnv G2 nt) :
    predTagsBoundedInMemEnv (joinMemEnvsStrong G1 G2) nt := by
  intro l qt hlookup
  rcases joinMemEnvsStrong_pred_cases G1 G2 l qt hlookup with hnoPred | ⟨qt1, qt2, h1, h2, hjoin⟩
  · -- pred = noPred → trivially bounded
    simp only [qtypPredTagBounded, hnoPred]; exact predTagBounded_noPred _
  · -- pred = joinPredicates qt1.pred qt2.pred → bounded by predTagBounded_joinPredicates
    simp only [qtypPredTagBounded, hjoin]
    exact predTagBounded_joinPredicates (hb1 l qt1 h1) (hb2 l qt2 h2)

-- ═══════════════════════════════════════════════════════════════════
-- Closure captured-env predicate tag boundedness
-- ═══════════════════════════════════════════════════════════════════

/-- All predicate guard tags in a captured variable environment are below the bound. -/
private def capturedPredTagsBounded (env : CapturedVarEnv) (nt : Tag) : Prop :=
  ∀ name qt bn, (name, qt, bn) ∈ env → qtypPredTagBounded qt nt

/-- From capturedPredTagsBounded, derive predTagsBoundedInVarEnv for ofCaptured. -/
lemma predTagsBoundedInVarEnv_ofCaptured {env : CapturedVarEnv} {nt : Tag}
    (hb : capturedPredTagsBounded env nt) :
    predTagsBoundedInVarEnv (VarTypeEnv.ofCaptured env) nt := by
  intro name qt hlookup
  -- VarTypeEnv.ofCaptured env = foldr insert {} env
  -- If lookup returns some qt, then (name, qt) was in env (or inserted)
  simp only [VarTypeEnv.ofCaptured, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?] at hlookup
  -- foldr insert {} env: the result is a map built from env entries.
  -- If result[name]? = some qt, then (name, qt) was inserted, so it's from env.
  -- Prove by: the result of foldr insert acc entries has entries from acc ∪ entries.
  -- If lookup gives some qt, then qt came from acc or from entries.
  -- Since acc = {} initially, qt must come from entries.
  -- Use induction on env (foldr processes right-to-left: insert hd into (foldr ... acc tl))
  suffices h : ∀ (entries : CapturedVarEnv) (acc : VarTypeEnv),
      (∀ n q, acc[n]? = some q → qtypPredTagBounded q nt) →
      (∀ n q b, (n, q, b) ∈ entries → qtypPredTagBounded q nt) →
      (List.foldr (fun (entry : Name × QTyp × Nat) (acc : VarTypeEnv) => acc.insert entry.1 entry.2.1)
        acc entries)[name]? = some qt →
      qtypPredTagBounded qt nt by
    exact h env {} (fun n q hq => by
      rw [Std.ExtTreeMap.getElem?_empty] at hq; exact absurd hq (by simp)) hb hlookup
  intro entries
  induction entries with
  | nil => intro acc hacc _ hlookup'; exact hacc _ _ hlookup'
  | cons hd tl ih =>
    intro acc hacc hentries hlookup'
    -- foldr (cons hd tl) acc = (foldr tl acc).insert hd.1 hd.2
    simp only [List.foldr] at hlookup'
    -- hlookup' : ((foldr tl acc).insert hd.1 hd.2)[name]? = some qt
    rw [Std.ExtTreeMap.getElem?_insert] at hlookup'
    split at hlookup'
    · -- name = hd.1: qt = hd.2
      simp at hlookup'; subst hlookup'
      exact hentries hd.1 hd.2.1 hd.2.2 (.head tl)
    · -- name ≠ hd.1: qt from foldr tl acc
      exact ih acc hacc (fun n q b hmem => hentries n q b (.tail hd hmem)) hlookup'

/-- updateLocsetWeak preserves predTagsBoundedInMemEnv. -/
private lemma predTagsBoundedInMemEnv_updateLocsetWeak
    {env : MemoryTypeEnv} {nt : Tag} {ls : LocSet} {storedPoison : Poison} {storedPred : Predicate}
    (hb : predTagsBoundedInMemEnv env nt) (hpred : predTagBounded nt storedPred) :
    predTagsBoundedInMemEnv (updateLocsetWeak env ls storedPoison storedPred) nt := by
  unfold updateLocsetWeak
  -- Helper: pure LocSet.fold preserves a property
  have fold_pres : ∀ {β : Type} (s : LocSet) (init : β) (f : β → Loc → β)
      (P : β → Prop), P init → (∀ acc l, P acc → P (f acc l)) → P (LocSet.fold s init f) := by
    intro β s init f P hinit hstep
    simp only [LocSet.fold]; rw [Std.ExtTreeSet.foldl_eq_foldl_toList]
    induction s.toList generalizing init with
    | nil => exact hinit
    | cons hd tl ih => simp only [List.foldl]; exact ih (f init hd) (hstep init hd hinit)
  -- Step 1: joinedPred is bounded
  -- The first fold returns (joinedPoison, joinedPred); we need joinedPred bounded
  set foldResult := LocSet.fold ls (storedPoison, storedPred) (fun (accP, accPred) l =>
    match env.get? l with
    | some e => (joinPoison accP e.poison, joinPredicates accPred e.pred)
    | none => (accP, Predicate.noPred))
  have hJoinedBounded : predTagBounded nt foldResult.2 := by
    simp only [foldResult]
    apply fold_pres (β := Poison × Predicate) ls _ _ (fun p => predTagBounded nt p.2) hpred
    intro ⟨accP, accPred⟩ l hPacc; simp only []
    cases hget : env.get? l with
    | none => exact trivial
    | some e =>
      have hlookup : env.lookup l = some ⟨ETyp.int, e.poison, e.pred⟩ := by
        simp only [MemoryTypeEnv.lookup]
        rw [Std.ExtTreeMap.get?_eq_getElem?] at hget
        simp [hget]
      exact predTagBounded_joinPredicates hPacc (hb l _ hlookup)
  -- Step 2: inserting the same bounded entry everywhere preserves the bound
  -- The entry is ⟨foldResult.1, foldResult.2⟩, pred = foldResult.2 (bounded by hJoinedBounded)
  -- After let-matching foldResult, the fold inserts this entry at all ls locations
  -- Use intro/cases to handle the let-match
  intro l qt hlookup
  -- hlookup is in the result of the second fold
  -- Use fold_pres to show all entries in the result are bounded
  have : predTagsBoundedInMemEnv
      (LocSet.fold ls env (fun acc l => acc.insert l ⟨foldResult.1, foldResult.2⟩)) nt := by
    apply fold_pres ls env _ (fun acc => predTagsBoundedInMemEnv acc nt) hb
    intro acc l' hacc
    -- acc.insert l' entry where entry = ⟨joinedPoison, joinedPred⟩
    -- This is the same as MemoryTypeEnv.update acc l' ⟨int, joinedPoison, joinedPred⟩
    show predTagsBoundedInMemEnv (acc.insert l' ⟨foldResult.1, foldResult.2⟩) nt
    rw [show acc.insert l' ⟨foldResult.1, foldResult.2⟩ = MemoryTypeEnv.update acc l' ⟨ETyp.int, foldResult.1, foldResult.2⟩ from rfl]
    exact predTagsBoundedInMemEnv_update hacc hJoinedBounded
  exact this l qt (by convert hlookup using 2)

/-- predTagsBoundedInMemEnv preserved by the assign-shaped memEnv update
    (singleton strong / non-singleton weak).  Mirrors `assign_memEnv_formula_*`;
    shared so the extern write-effect proof need not import `StepFRAssign`. -/
private lemma assign_memEnv_formula_predBounded
    (env : MemoryTypeEnv) (ls : LocSet) (storedPoison : Poison) (storedPred : Predicate) (nt : Tag)
    (hb : predTagsBoundedInMemEnv env nt) (hpred : predTagBounded nt storedPred) :
    predTagsBoundedInMemEnv
      (match Std.ExtTreeSet.toList ls with
        | [l0] => updateMemEnv env l0 { etyp := ETyp.int, poison := storedPoison, pred := storedPred }
        | _ => updateLocsetWeak env ls storedPoison storedPred) nt := by
  have hqt : qtypPredTagBounded ⟨ETyp.int, storedPoison, storedPred⟩ nt := hpred
  cases hls : Std.ExtTreeSet.toList ls with
  | nil => simpa using predTagsBoundedInMemEnv_updateLocsetWeak hb hpred
  | cons x xs =>
      cases xs with
      | nil => simpa using! predTagsBoundedInMemEnv_update hb hqt
      | cons y ys => simpa using predTagsBoundedInMemEnv_updateLocsetWeak hb hpred

-- ═══════════════════════════════════════════════════════════════════
-- CapturedEnvFullBounded: recursive closure-env boundedness
-- ═══════════════════════════════════════════════════════════════════

/-- Depth-indexed captured-env boundedness. At depth 0, trivially true.
    At depth n+1, each entry has bounded pred tags AND its closures' captured envs
    are bounded at depth n. -/
private def capturedEnvBoundedN : Nat → CapturedVarEnv → Tag → Prop
  | 0, _, _ => True
  | n + 1, env, nt =>
    ∀ name qt bn, (name, qt, bn) ∈ env →
      qtypPredTagBounded qt nt ∧
      match qt.etyp with
      | .arrow _ _ _ tcls => ∀ tcl ∈ tcls, match tcl with
          | .regular _ _ env' => capturedEnvBoundedN n env' nt
          | .extern _ _ _ _ env' _ _ => capturedEnvBoundedN n env' nt
      | .parrow _ _ _ tcls => ∀ tcl ∈ tcls, match tcl with
          | .regular _ _ env' => capturedEnvBoundedN n env' nt
          | .extern _ _ _ env' _ _ => capturedEnvBoundedN n env' nt
      | _ => True

/-- Recursive closure-env boundedness: the property holds at all depths. -/
def CapturedEnvFullBounded (env : CapturedVarEnv) (nt : Tag) : Prop :=
  ∀ n, capturedEnvBoundedN n env nt

/-- Combined closure boundedness for ETyp: each closure's captured env is fully bounded. -/
def etypClosuresFullBounded (etyp : ETyp) (nt : Tag) : Prop :=
  match etyp with
  | .arrow _ _ _ tcls => ∀ tcl ∈ tcls, match tcl with
      | .regular _ _ env => CapturedEnvFullBounded env nt
      | .extern _ _ _ _ env _ _ => CapturedEnvFullBounded env nt
  | .parrow _ _ _ tcls => ∀ tcl ∈ tcls, match tcl with
      | .regular _ _ env => CapturedEnvFullBounded env nt
      | .extern _ _ _ env _ _ => CapturedEnvFullBounded env nt
  | _ => True

/-- Monotonicity for capturedEnvBoundedN. -/
private lemma capturedEnvBoundedN_mono : ∀ (n : Nat) {env : CapturedVarEnv} {nt nt' : Tag},
    capturedEnvBoundedN n env nt → nt ≤ nt' → capturedEnvBoundedN n env nt'
  | 0, _, _, _, _, _ => trivial
  | n + 1, env, nt, nt', h, hle => by
    intro name qt bn hmem
    obtain ⟨hp, hc⟩ := h name qt bn hmem
    refine ⟨qtypPredTagBounded_mono hp hle, ?_⟩
    revert hc; cases qt.etyp with
    | arrow _ _ _ tcls =>
      intro hc tcl hmem_tcl; have := hc tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact capturedEnvBoundedN_mono n this hle
      | extern _ _ _ _ env' _ => exact capturedEnvBoundedN_mono n this hle
    | parrow _ _ _ tcls =>
      intro hc tcl hmem_tcl; have := hc tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact capturedEnvBoundedN_mono n this hle
      | extern _ _ _ env' _ => exact capturedEnvBoundedN_mono n this hle
    | _ => intro _; trivial

/-- Monotonicity for CapturedEnvFullBounded. -/
lemma CapturedEnvFullBounded_mono {env : CapturedVarEnv} {nt nt' : Tag}
    (h : CapturedEnvFullBounded env nt) (hle : nt ≤ nt') :
    CapturedEnvFullBounded env nt' :=
  fun n => capturedEnvBoundedN_mono n (h n) hle

/-- Monotonicity for etypClosuresFullBounded. -/
lemma etypClosuresFullBounded_mono {etyp : ETyp} {nt nt' : Tag}
    (h : etypClosuresFullBounded etyp nt) (hle : nt ≤ nt') :
    etypClosuresFullBounded etyp nt' := by
  cases etyp with
  | arrow _ _ _ tcls =>
    intro tcl hmem; have hfull := h tcl hmem
    cases tcl with
    | regular _ _ env => exact CapturedEnvFullBounded_mono hfull hle
    | extern _ _ _ _ env _ => exact CapturedEnvFullBounded_mono hfull hle
  | parrow _ _ _ tcls =>
    intro tcl hmem; have hfull := h tcl hmem
    cases tcl with
    | regular _ _ env => exact CapturedEnvFullBounded_mono hfull hle
    | extern _ _ _ env _ => exact CapturedEnvFullBounded_mono hfull hle
  | _ => trivial

/-- Construct CapturedEnvFullBounded from per-entry evidence at a single bound. -/
private lemma CapturedEnvFullBounded.mk'
    {env : CapturedVarEnv} {nt : Tag}
    (h : ∀ name qt bn, (name, qt, bn) ∈ env →
         qtypPredTagBounded qt nt ∧ etypClosuresFullBounded qt.etyp nt) :
    CapturedEnvFullBounded env nt := by
  intro n; induction n with
  | zero => trivial
  | succ n ih =>
    intro name qt bn hmem
    obtain ⟨hp, he⟩ := h name qt bn hmem
    refine ⟨hp, ?_⟩
    revert he; cases qt.etyp with
    | arrow _ _ _ tcls =>
      intro he tcl hmem_tcl; have hfull := he tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact hfull n
      | extern _ _ _ _ env' _ => exact hfull n
    | parrow _ _ _ tcls =>
      intro he tcl hmem_tcl; have hfull := he tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact hfull n
      | extern _ _ _ env' _ => exact hfull n
    | _ => intro _; trivial

/-- Extract per-entry evidence from CapturedEnvFullBounded at the current bound. -/
private lemma CapturedEnvFullBounded.get {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) {name : Name} {qt : QTyp} {bn : Nat}
    (hmem : (name, qt, bn) ∈ env) :
    qtypPredTagBounded qt nt ∧ etypClosuresFullBounded qt.etyp nt := by
  constructor
  · exact (h 1 name qt bn hmem).1
  · cases hqe : qt.etyp with
    | arrow _ _ _ tcls =>
      intro tcl hmem_tcl
      cases tcl with
      | regular _ _ env' =>
        show CapturedEnvFullBounded env' nt
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
      | extern _ _ _ _ env' _ =>
        show CapturedEnvFullBounded env' nt
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
    | parrow _ _ _ tcls =>
      intro tcl hmem_tcl
      cases tcl with
      | regular _ _ env' =>
        show CapturedEnvFullBounded env' nt
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
      | extern _ _ _ env' _ =>
        show CapturedEnvFullBounded env' nt
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
    | _ => trivial

/-- Extract capturedPredTagsBounded from CapturedEnvFullBounded. -/
lemma capturedPredTagsBounded_of_fullBounded
    {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) : capturedPredTagsBounded env nt :=
  fun name qt bn hmem => (h 1 name qt bn hmem).1

/-- Public: a captured member's guard tag is below the bound.  Used downstream by the
    extended-regime closure-transport to discharge freshness
    (`¬ newTags k = k < nextTag`) for captured-variable guard tags. -/
lemma CapturedEnvFullBounded_guardTag_lt {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) {name : Name} {qt : QTyp} {bn : Nat} {k : Tag}
    (hmem : (name, qt, bn) ∈ env) (hg : qtypGuardTag qt = some k) : k < nt := by
  have hb := (CapturedEnvFullBounded.get h hmem).1
  cases hp : qt.pred with
  | guardClosure k' a b c =>
      simp only [qtypGuardTag, hp, Option.some.injEq] at hg
      simp only [qtypPredTagBounded, predTagBounded, hp] at hb
      exact hg ▸ hb
  | guardOnly k' =>
      simp only [qtypGuardTag, hp, Option.some.injEq] at hg
      simp only [qtypPredTagBounded, predTagBounded, hp] at hb
      exact hg ▸ hb
  | noPred => simp [qtypGuardTag, hp] at hg

/-- Public: a captured member's type has fully-bounded nested closures. -/
lemma CapturedEnvFullBounded_member_etypClosures {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) {name : Name} {qt : QTyp} {bn : Nat}
    (hmem : (name, qt, bn) ∈ env) : etypClosuresFullBounded qt.etyp nt :=
  (CapturedEnvFullBounded.get h hmem).2

/-- Public: a captured member's predicate guard tag is bounded. -/
lemma CapturedEnvFullBounded_member_predTagBounded {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) {name : Name} {qt : QTyp} {bn : Nat}
    (hmem : (name, qt, bn) ∈ env) : qtypPredTagBounded qt nt :=
  (h 1 name qt bn hmem).1

/-- Public: dropping the head preserves CapturedEnvFullBounded. -/
lemma CapturedEnvFullBounded_tail {x : Name} {q : QTyp} {m : Nat} {σcap : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded ((x, q, m) :: σcap) nt) : CapturedEnvFullBounded σcap nt := by
  intro n
  cases n with
  | zero => exact trivial
  | succ n => intro name qt bn hmem; exact h (n + 1) name qt bn (List.mem_cons_of_mem _ hmem)

/-- Public: a QTyp whose predicate guard tag is bounded has that guard tag below the bound. -/
lemma qtypGuardTag_lt_of_predTagBounded {qt : QTyp} {B k : Tag}
    (hb : qtypPredTagBounded qt B) (hg : qtypGuardTag qt = some k) : k < B := by
  cases hp : qt.pred with
  | guardClosure k' a b c =>
      simp only [qtypGuardTag, hp, Option.some.injEq] at hg
      simp only [qtypPredTagBounded, predTagBounded, hp] at hb
      exact hg ▸ hb
  | guardOnly k' =>
      simp only [qtypGuardTag, hp, Option.some.injEq] at hg
      simp only [qtypPredTagBounded, predTagBounded, hp] at hb
      exact hg ▸ hb
  | noPred => simp [qtypGuardTag, hp] at hg

/-- Public: a guard tag looked up via `VarTypeEnv.ofCaptured` of a fully-bounded captured env is
    below the bound (for `MemberVarsRegimeEvidence`, which uses `ofCaptured`). -/
lemma ofCaptured_guardTag_lt_of_fullBounded {env : CapturedVarEnv} {B : Tag}
    (h : CapturedEnvFullBounded env B) {y : Name} {qt : QTyp} {k : Tag}
    (hlook : (VarTypeEnv.ofCaptured env).lookup y = some qt) (hg : qtypGuardTag qt = some k) :
    k < B :=
  qtypGuardTag_lt_of_predTagBounded
    (predTagsBoundedInVarEnv_ofCaptured (capturedPredTagsBounded_of_fullBounded h) y qt hlook) hg

section RefLocsBoundedMono
variable {nl nl' : Loc}

/-- Monotonicity for etypRefLocsBounded. -/
lemma etypRefLocsBounded_mono {etyp : ETyp}
    (h : etypRefLocsBounded etyp nl) (hle : nl ≤ nl') :
    etypRefLocsBounded etyp nl' := by
  cases etyp with
  | ref ls => intro l hmem; exact Nat.lt_of_lt_of_le (h l hmem) hle
  | _ => trivial

/-- Monotonicity for varEnvRefLocsBounded. -/
lemma varEnvRefLocsBounded_mono {S : VarTypeEnv}
    (h : varEnvRefLocsBounded S nl) (hle : nl ≤ nl') :
    varEnvRefLocsBounded S nl' :=
  fun x qt hlookup => etypRefLocsBounded_mono (h x qt hlookup) hle

/-- Monotonicity for CapturedEnvRefLocsBoundedN. -/
private lemma CapturedEnvRefLocsBoundedN_mono :
    ∀ (n : Nat) {env : CapturedVarEnv} {nl nl' : Loc},
    CapturedEnvRefLocsBoundedN n env nl → nl ≤ nl' → CapturedEnvRefLocsBoundedN n env nl'
  | 0, _, _, _, _, _ => trivial
  | n + 1, env, nl, nl', h, hle => by
    intro name qt bn hmem
    obtain ⟨hrl, hc⟩ := h name qt bn hmem
    refine ⟨etypRefLocsBounded_mono hrl hle, ?_⟩
    revert hc; cases qt.etyp with
    | arrow _ _ _ tcls =>
      intro hc tcl hmem_tcl; have := hc tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact CapturedEnvRefLocsBoundedN_mono n this hle
      | extern _ _ _ _ env' _ => exact CapturedEnvRefLocsBoundedN_mono n this hle
    | parrow _ _ _ tcls =>
      intro hc tcl hmem_tcl; have := hc tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact CapturedEnvRefLocsBoundedN_mono n this hle
      | extern _ _ _ env' _ => exact CapturedEnvRefLocsBoundedN_mono n this hle
    | _ => intro _; trivial

/-- Monotonicity for CapturedEnvRefLocsFullBounded. -/
lemma CapturedEnvRefLocsFullBounded_mono {env : CapturedVarEnv}
    (h : CapturedEnvRefLocsFullBounded env nl) (hle : nl ≤ nl') :
    CapturedEnvRefLocsFullBounded env nl' :=
  fun n => CapturedEnvRefLocsBoundedN_mono n (h n) hle

/-- Monotonicity for etypClosuresCapturedRefLocsBounded. -/
lemma etypClosuresCapturedRefLocsBounded_mono {etyp : ETyp}
    (h : etypClosuresCapturedRefLocsBounded etyp nl) (hle : nl ≤ nl') :
    etypClosuresCapturedRefLocsBounded etyp nl' := by
  cases etyp with
  | arrow _ _ _ tcls =>
    intro tcl hmem; have hfull := h tcl hmem
    cases tcl with
    | regular _ _ env => exact CapturedEnvRefLocsFullBounded_mono hfull hle
    | extern _ _ _ _ env _ => exact CapturedEnvRefLocsFullBounded_mono hfull hle
  | parrow _ _ _ tcls =>
    intro tcl hmem; have hfull := h tcl hmem
    cases tcl with
    | regular _ _ env => exact CapturedEnvRefLocsFullBounded_mono hfull hle
    | extern _ _ _ env _ => exact CapturedEnvRefLocsFullBounded_mono hfull hle
  | _ => trivial

/-- Monotonicity for varEnvClosuresCapturedRefLocsBounded. -/
lemma varEnvClosuresCapturedRefLocsBounded_mono {S : VarTypeEnv}
    (h : varEnvClosuresCapturedRefLocsBounded S nl) (hle : nl ≤ nl') :
    varEnvClosuresCapturedRefLocsBounded S nl' :=
  fun x qt hlookup => etypClosuresCapturedRefLocsBounded_mono (h x qt hlookup) hle

end RefLocsBoundedMono

/-- wfTypeResult implies wfTypeContext for the post-context (ctxAfter preserves varEnv from ctx). -/
lemma wfTypeContext_of_wfTypeResult (ctx : TypeContext) (res : TypeResult)
    (hwfRes : wfTypeResult res)
    (hwfCtx : wfTypeContext ctx)
    (hmono : ctx.nextLoc ≤ res.nextLoc') :
    wfTypeContext (ctxAfter ctx res) := by
  simp only [wfTypeContext, ctxAfter]
  exact ⟨hwfRes,
         varEnvRefLocsBounded_mono hwfCtx.2.1 hmono,
         varEnvClosuresCapturedRefLocsBounded_mono hwfCtx.2.2 hmono⟩

section RefLocsBoundedSingleBound
variable {nl : Loc}

/-- Construct CapturedEnvRefLocsFullBounded from per-entry evidence at a single bound. -/
private lemma CapturedEnvRefLocsFullBounded.mk'
    {env : CapturedVarEnv}
    (h : ∀ name qt bn, (name, qt, bn) ∈ env →
         etypRefLocsBounded qt.etyp nl ∧ etypClosuresCapturedRefLocsBounded qt.etyp nl) :
    CapturedEnvRefLocsFullBounded env nl := by
  intro n; induction n with
  | zero => trivial
  | succ n ih =>
    intro name qt bn hmem
    obtain ⟨hrl, he⟩ := h name qt bn hmem
    refine ⟨hrl, ?_⟩
    revert he; cases qt.etyp with
    | arrow _ _ _ tcls =>
      intro he tcl hmem_tcl; have hfull := he tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact hfull n
      | extern _ _ _ _ env' _ => exact hfull n
    | parrow _ _ _ tcls =>
      intro he tcl hmem_tcl; have hfull := he tcl hmem_tcl
      cases tcl with
      | regular _ _ env' => exact hfull n
      | extern _ _ _ env' _ => exact hfull n
    | _ => intro _; trivial

/-- Extract per-entry ref-loc evidence from CapturedEnvRefLocsFullBounded. -/
private lemma CapturedEnvRefLocsFullBounded.get {env : CapturedVarEnv}
    (h : CapturedEnvRefLocsFullBounded env nl) {name : Name} {qt : QTyp} {bn : Nat}
    (hmem : (name, qt, bn) ∈ env) :
    etypRefLocsBounded qt.etyp nl ∧ etypClosuresCapturedRefLocsBounded qt.etyp nl := by
  constructor
  · exact (h 1 name qt bn hmem).1
  · cases hqe : qt.etyp with
    | arrow _ _ _ tcls =>
      intro tcl hmem_tcl
      cases tcl with
      | regular _ _ env' =>
        show CapturedEnvRefLocsFullBounded env' nl
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
      | extern _ _ _ _ env' _ =>
        show CapturedEnvRefLocsFullBounded env' nl
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
    | parrow _ _ _ tcls =>
      intro tcl hmem_tcl
      cases tcl with
      | regular _ _ env' =>
        show CapturedEnvRefLocsFullBounded env' nl
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
      | extern _ _ _ env' _ =>
        show CapturedEnvRefLocsFullBounded env' nl
        intro n; have := h (n + 1) name qt bn hmem; simp [hqe] at this; exact this.2 _ hmem_tcl
    | _ => trivial

/-- Extract capturedEnvRefLocsBounded from CapturedEnvRefLocsFullBounded. -/
lemma capturedEnvRefLocsBounded_of_fullBounded_refLocs
    {env : CapturedVarEnv}
    (h : CapturedEnvRefLocsFullBounded env nl) : capturedEnvRefLocsBounded env nl :=
  fun name qt bn hmem => (h 1 name qt bn hmem).1

/-- varEnvRefLocsBounded for VarTypeEnv.update. -/
lemma varEnvRefLocsBounded_update {S : VarTypeEnv} {x : Name} {qt : QTyp}
    (hS : varEnvRefLocsBounded S nl) (hqt : etypRefLocsBounded qt.etyp nl) :
    varEnvRefLocsBounded (VarTypeEnv.update S x qt) nl := by
  intro y qt' hlookup
  simp only [VarTypeEnv.update, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?,
    Std.ExtTreeMap.getElem?_insert] at hlookup
  by_cases hEq : compare x y = Ordering.eq
  · simp [hEq] at hlookup; subst hlookup; exact hqt
  · simp [hEq] at hlookup
    exact hS y qt' (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?, hlookup])

/-- varEnvClosuresCapturedRefLocsBounded for VarTypeEnv.update. -/
lemma varEnvClosuresCapturedRefLocsBounded_update
    {S : VarTypeEnv} {x : Name} {qt : QTyp}
    (hS : varEnvClosuresCapturedRefLocsBounded S nl)
    (hqt : etypClosuresCapturedRefLocsBounded qt.etyp nl) :
    varEnvClosuresCapturedRefLocsBounded (VarTypeEnv.update S x qt) nl := by
  intro y qt' hlookup
  simp only [VarTypeEnv.update, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?,
    Std.ExtTreeMap.getElem?_insert] at hlookup
  by_cases hEq : compare x y = Ordering.eq
  · simp [hEq] at hlookup; subst hlookup; exact hqt
  · simp [hEq] at hlookup
    exact hS y qt' (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?, hlookup])

/-- Bridge: varEnvRefLocsBounded + varEnvClosuresCapturedRefLocsBounded →
    CapturedEnvRefLocsFullBounded for toCaptured. -/
private lemma CapturedEnvRefLocsFullBounded_of_toCaptured {S : VarTypeEnv} {B : BindEnv}
    (hrl : varEnvRefLocsBounded S nl)
    (hcl : varEnvClosuresCapturedRefLocsBounded S nl) :
    CapturedEnvRefLocsFullBounded (VarTypeEnv.toCaptured S B) nl :=
  CapturedEnvRefLocsFullBounded.mk' fun name qt bn hmem => by
    have hlookup : S[name]? = some qt := VarTypeEnv.toCaptured_mem_getElem? hmem
    have hlookup' : S.lookup name = some qt := by
      simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?, hlookup]
    exact ⟨hrl name qt hlookup', hcl name qt hlookup'⟩

/-- Bridge: capturedEnvRefLocsBounded → varEnvRefLocsBounded for ofCaptured. -/
lemma varEnvRefLocsBounded_ofCaptured {env : CapturedVarEnv}
    (h : capturedEnvRefLocsBounded env nl) :
    varEnvRefLocsBounded (VarTypeEnv.ofCaptured env) nl := by
  induction env with
  | nil =>
    intro x qt hlookup
    simp [VarTypeEnv.ofCaptured, VarTypeEnv.lookup] at hlookup
  | cons entry tl ih =>
    have hh : capturedEnvRefLocsBounded tl nl :=
      fun name qt' b hmem => h name qt' b (List.Mem.tail _ hmem)
    intro x qt hlookup
    simp only [VarTypeEnv.ofCaptured, List.foldr] at hlookup
    simp only [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?,
      Std.ExtTreeMap.getElem?_insert] at hlookup
    by_cases hEq : compare entry.1 x = Ordering.eq
    · simp [hEq] at hlookup
      subst hlookup
      exact h entry.1 entry.2.1 entry.2.2 (List.Mem.head _)
    · simp [hEq] at hlookup
      have hlookup' : (VarTypeEnv.ofCaptured tl).lookup x = some qt := by
        simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup
      exact ih hh x qt hlookup'

/-- CapturedEnvRefLocsFullBounded for a sublist (tail). -/
private lemma CapturedEnvRefLocsFullBounded_tail {entry : Name × QTyp × Nat}
    {tl : CapturedVarEnv}
    (h : CapturedEnvRefLocsFullBounded (entry :: tl) nl) :
    CapturedEnvRefLocsFullBounded tl nl := fun n => by
  cases n with
  | zero => trivial
  | succ n => intro name qt bn hmem; exact h (n + 1) name qt bn (List.Mem.tail _ hmem)

/-- Bridge: CapturedEnvRefLocsFullBounded → varEnvClosuresCapturedRefLocsBounded for ofCaptured. -/
lemma varEnvClosuresCapturedRefLocsBounded_ofCaptured {env : CapturedVarEnv}
    (h : CapturedEnvRefLocsFullBounded env nl) :
    varEnvClosuresCapturedRefLocsBounded (VarTypeEnv.ofCaptured env) nl := by
  induction env with
  | nil =>
    intro x qt hlookup
    simp [VarTypeEnv.ofCaptured, VarTypeEnv.lookup] at hlookup
  | cons entry tl ih =>
    have htl : CapturedEnvRefLocsFullBounded tl nl := CapturedEnvRefLocsFullBounded_tail h
    intro x qt hlookup
    simp only [VarTypeEnv.ofCaptured, List.foldr] at hlookup
    simp only [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?,
      Std.ExtTreeMap.getElem?_insert] at hlookup
    by_cases hEq : compare entry.1 x = Ordering.eq
    · simp [hEq] at hlookup; subst hlookup
      exact (CapturedEnvRefLocsFullBounded.get h (List.Mem.head _)).2
    · simp [hEq] at hlookup
      have hlookup' : (VarTypeEnv.ofCaptured tl).lookup x = some qt := by
        simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup
      exact ih htl x qt hlookup'

end RefLocsBoundedSingleBound

-- ═══════════════════════════════════════════════════════════════════
-- Closure captured-env preservation
-- ═══════════════════════════════════════════════════════════════════

/-- All ETyp closures in a VarTypeEnv have fully bounded captured envs. -/
private def varEnvClosuresCapturedBounded (S : VarTypeEnv) (nt : Tag) : Prop :=
  ∀ x qt, S.lookup x = some qt → etypClosuresFullBounded qt.etyp nt

/-- From predTagsBoundedInVarEnv + varEnvClosuresCapturedBounded, derive
    CapturedEnvFullBounded for toCaptured. -/
private lemma capturedEnvFullBounded_of_toCaptured {S : VarTypeEnv} {B : BindEnv} {nt : Tag}
    (hpred : predTagsBoundedInVarEnv S nt) (hclosure : varEnvClosuresCapturedBounded S nt) :
    CapturedEnvFullBounded (VarTypeEnv.toCaptured S B) nt :=
  CapturedEnvFullBounded.mk' fun name qt bn hmem => by
    have hlookup : S[name]? = some qt := VarTypeEnv.toCaptured_mem_getElem? hmem
    have hlookup' : S.lookup name = some qt := by
      simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?, hlookup]
    exact ⟨hpred name qt hlookup', hclosure name qt hlookup'⟩

/-- Combined input invariant for the closure-env preservation theorem. -/
def closureEnvBoundedInCtx (ctx : TypeContext) : Prop :=
  varEnvClosuresCapturedBounded ctx.varEnv ctx.nextTag

/-- Bundled tag-boundedness invariant for the typing context.
    Combines tag-env boundedness, predicate-tag boundedness, and closure-env boundedness.
    Used as an input hypothesis and output guarantee in StepFR. -/
def TagBoundedCtx (ctx : TypeContext) : Prop :=
  tagEnvBoundedInCtx ctx ∧ predTagsBoundedInCtx ctx ∧ closureEnvBoundedInCtx ctx

/-- Public extractors from `TagBoundedCtx`: discharge freshness
    `¬ newTags k = k < ctx.nextTag` for memEnv/varEnv guard tags and supply the deep closure
    bound for varEnv values.  Used pervasively by the extended-regime (`monotoneStepExt`) consumers. -/
lemma TagBoundedCtx_memEnv_guardTag_lt {ctx : TypeContext} {l : Loc} {qt : QTyp} {k : Tag}
    (h : TagBoundedCtx ctx) (hlook : ctx.memEnv.lookup l = some qt)
    (hg : qtypGuardTag qt = some k) : k < ctx.nextTag :=
  qtypGuardTag_lt_of_predTagBounded (h.2.1.2 l qt hlook) hg

lemma TagBoundedCtx_varEnv_guardTag_lt {ctx : TypeContext} {x : Name} {qt : QTyp} {k : Tag}
    (h : TagBoundedCtx ctx) (hlook : ctx.varEnv.lookup x = some qt)
    (hg : qtypGuardTag qt = some k) : k < ctx.nextTag :=
  qtypGuardTag_lt_of_predTagBounded (h.2.1.1 x qt hlook) hg

lemma TagBoundedCtx_memEnv_predTagBounded {ctx : TypeContext} {l : Loc} {qt : QTyp}
    (h : TagBoundedCtx ctx) (hlook : ctx.memEnv.lookup l = some qt) :
    qtypPredTagBounded qt ctx.nextTag :=
  h.2.1.2 l qt hlook

lemma TagBoundedCtx_varEnv_predTagBounded {ctx : TypeContext} {x : Name} {qt : QTyp}
    (h : TagBoundedCtx ctx) (hlook : ctx.varEnv.lookup x = some qt) :
    qtypPredTagBounded qt ctx.nextTag :=
  h.2.1.1 x qt hlook

lemma TagBoundedCtx_varEnv_etypClosures {ctx : TypeContext} {x : Name} {qt : QTyp}
    (h : TagBoundedCtx ctx) (hlook : ctx.varEnv.lookup x = some qt) :
    etypClosuresFullBounded qt.etyp ctx.nextTag :=
  h.2.2 x qt hlook

/-- Dedup fold: every element in the result was in init or xs. -/
private lemma foldl_dedup_mem {α : Type} [BEq α]
    (init : List α) (xs : List α) (a : α) :
    a ∈ List.foldl (fun acc x => if acc.contains x then acc else acc ++ [x]) init xs →
    a ∈ init ∨ a ∈ xs := by
  induction xs generalizing init with
  | nil => intro h; left; exact h
  | cons hd tl ih =>
    intro h; simp only [List.foldl] at h
    rcases ih _ h with hinit' | htl
    · split at hinit'
      · left; exact hinit'
      · rw [List.mem_append] at hinit'
        rcases hinit' with hinit | hhd
        · left; exact hinit
        · simp at hhd; right; rw [hhd]; exact List.Mem.head _
    · right; exact List.Mem.tail hd htl

/-- Every closure in mergeFnTClosures was in one of the inputs. -/
private lemma mergeFnTClosures_mem (tcls1 tcls2 : List FnTClosure) (tcl : FnTClosure) :
    tcl ∈ mergeFnTClosures tcls1 tcls2 → tcl ∈ tcls1 ∨ tcl ∈ tcls2 := by
  intro h; simp only [mergeFnTClosures] at h
  rcases foldl_dedup_mem _ _ _ h with h1 | h2
  · rcases foldl_dedup_mem _ _ _ h1 with h_e | h_t
    · simp at h_e
    · left; exact h_t
  · right; exact h2

/-- Every closure in mergePFnTClosures was in one of the inputs. -/
private lemma mergePFnTClosures_mem (tcls1 tcls2 : List PFnTClosure) (tcl : PFnTClosure) :
    tcl ∈ mergePFnTClosures tcls1 tcls2 → tcl ∈ tcls1 ∨ tcl ∈ tcls2 := by
  intro h; simp only [mergePFnTClosures] at h
  rcases foldl_dedup_mem _ _ _ h with h1 | h2
  · rcases foldl_dedup_mem _ _ _ h1 with h_e | h_t
    · simp at h_e
    · left; exact h_t
  · right; exact h2

/-- joinETyps preserves etypRefLocsBounded. -/
private lemma etypRefLocsBounded_joinETyps {e1 e2 : ETyp} {p1 p2 : Poison} {nl : Loc}
    (h1 : etypRefLocsBounded e1 nl) (h2 : etypRefLocsBounded e2 nl) :
    etypRefLocsBounded (joinETyps e1 e2 p1 p2) nl := by
  cases e1 with
  | ref ls1 =>
    cases e2 with
    | ref ls2 =>
      simp only [joinETyps, etypRefLocsBounded, LocSet.union]
      intro l hmem
      rcases Std.ExtTreeSet.mem_union_iff.mp hmem with h | h
      · exact h1 l h
      · exact h2 l h
    | _ => exact h1
  | int => cases e2 <;> simp [joinETyps, etypRefLocsBounded]
  | bool => cases e2 <;> simp [joinETyps, etypRefLocsBounded]
  | unit => cases e2 <;> simp [joinETyps, etypRefLocsBounded]
  | string => cases e2 <;> simp [joinETyps, etypRefLocsBounded]
  | arrow st1 st2 p tcls1 =>
    cases e2 with
    | arrow _ _ _ _ => simp only [joinETyps]; split <;> simp [etypRefLocsBounded]
    | _ => simp [joinETyps, etypRefLocsBounded]
  | parrow st1 st2 p tcls1 =>
    cases e2 with
    | parrow _ _ _ _ => simp only [joinETyps]; split <;> simp [etypRefLocsBounded]
    | _ => simp [joinETyps, etypRefLocsBounded]

/-- joinETyps preserves etypClosuresCapturedRefLocsBounded (merges closure lists). -/
private lemma etypClosuresCapturedRefLocsBounded_joinETyps {e1 e2 : ETyp} {p1 p2 : Poison} {nl : Loc}
    (h1 : etypClosuresCapturedRefLocsBounded e1 nl)
    (h2 : etypClosuresCapturedRefLocsBounded e2 nl) :
    etypClosuresCapturedRefLocsBounded (joinETyps e1 e2 p1 p2) nl := by
  cases e1 with
  | arrow st1 st2 p tcls1 =>
    cases e2 with
    | arrow st1' st2' p' tcls2 =>
      simp only [joinETyps]
      split
      · intro tcl hmem
        rcases mergeFnTClosures_mem _ _ _ hmem with hmem1 | hmem2
        · exact h1 tcl hmem1
        · exact h2 tcl hmem2
      · exact h1
    | _ => simp only [joinETyps]; exact h1
  | parrow st1 st2 p tcls1 =>
    cases e2 with
    | parrow st1' st2' p' tcls2 =>
      simp only [joinETyps]
      split
      · intro tcl hmem
        rcases mergePFnTClosures_mem _ _ _ hmem with hmem1 | hmem2
        · exact h1 tcl hmem1
        · exact h2 tcl hmem2
      · exact h1
    | _ => simp only [joinETyps]; exact h1
  | int => cases e2 <;> simp [joinETyps, etypClosuresCapturedRefLocsBounded]
  | bool => cases e2 <;> simp [joinETyps, etypClosuresCapturedRefLocsBounded]
  | unit => cases e2 <;> simp [joinETyps, etypClosuresCapturedRefLocsBounded]
  | string => cases e2 <;> simp [joinETyps, etypClosuresCapturedRefLocsBounded]
  | ref ls =>
    cases e2 <;> simp [joinETyps, etypClosuresCapturedRefLocsBounded]

/-- joinETyps preserves etypClosuresFullBounded (merges closure lists). -/
private lemma etypClosuresFullBounded_joinETyps {e1 e2 : ETyp} {p1 p2 : Poison} {nt : Tag}
    (h1 : etypClosuresFullBounded e1 nt) (h2 : etypClosuresFullBounded e2 nt) :
    etypClosuresFullBounded (joinETyps e1 e2 p1 p2) nt := by
  cases e1 with
  | arrow st1 st2 p tcls1 =>
    cases e2 with
    | arrow st1' st2' p' tcls2 =>
      simp only [joinETyps]
      split
      · intro tcl hmem
        rcases mergeFnTClosures_mem _ _ _ hmem with hmem1 | hmem2
        · exact h1 tcl hmem1
        · exact h2 tcl hmem2
      · exact h1
    | _ => simp only [joinETyps]; exact h1
  | parrow st1 st2 p tcls1 =>
    cases e2 with
    | parrow st1' st2' p' tcls2 =>
      simp only [joinETyps]
      split
      · intro tcl hmem
        rcases mergePFnTClosures_mem _ _ _ hmem with hmem1 | hmem2
        · exact h1 tcl hmem1
        · exact h2 tcl hmem2
      · exact h1
    | _ => simp only [joinETyps]; exact h1
  | _ => simp only [joinETyps]; cases e2 <;> exact h1

section ClosureCapturedBoundedness
variable {S : VarTypeEnv} {nt : Tag}

/-- varEnvClosuresCapturedBounded is monotone in the bound. -/
lemma varEnvClosuresCapturedBounded_mono {nt' : Tag}
    (hb : varEnvClosuresCapturedBounded S nt) (hle : nt ≤ nt') :
    varEnvClosuresCapturedBounded S nt' :=
  fun x qt hlookup => etypClosuresFullBounded_mono (hb x qt hlookup) hle

/-- varEnvClosuresCapturedBounded is preserved by VarTypeEnv.update. -/
lemma varEnvClosuresCapturedBounded_update {x : Name} {qt : QTyp}
    (hb : varEnvClosuresCapturedBounded S nt) (hqt : etypClosuresFullBounded qt.etyp nt) :
    varEnvClosuresCapturedBounded (S.update x qt) nt := by
  intro y qt' hlookup
  simp only [VarTypeEnv.update, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?] at hlookup
  rw [Std.ExtTreeMap.getElem?_insert] at hlookup
  split at hlookup
  · cases hlookup; exact hqt
  · exact hb y qt' (by simp only [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)

end ClosureCapturedBoundedness

/-- Generic: List.foldl preserves tag boundedness given a step invariant. -/
private theorem foldl_tags_bounded {bound : Tag}
    {f : List (Tag × Deps) → (Name × QTyp) → List (Tag × Deps)}
    {init : List (Tag × Deps)} {xs : List (Name × QTyp)}
    (hinit : ∀ kd ∈ init, kd.1 < bound)
    (hstep : ∀ acc x, x ∈ xs → (∀ kd ∈ acc, kd.1 < bound) → ∀ kd ∈ f acc x, kd.1 < bound) :
    ∀ kd ∈ List.foldl f init xs, kd.1 < bound := by
  induction xs generalizing init with
  | nil => exact hinit
  | cons hd tl ih =>
    intro kd hkd; simp only [List.foldl] at hkd
    exact ih (hstep init hd (.head tl) hinit)
      (fun acc x hx hacc => hstep acc x (.tail hd hx) hacc) kd hkd

/-- Generic: List.foldlM (Except) preserves tag boundedness given a step invariant. -/
private theorem foldlM_tags_bounded {bound : Tag}
    {f : List (Tag × Deps) → (Name × QTyp) → Except String (List (Tag × Deps))}
    {init : List (Tag × Deps)} {xs : List (Name × QTyp)} {result : List (Tag × Deps)}
    (hfold : List.foldlM f init xs = .ok result)
    (hinit : ∀ kd ∈ init, kd.1 < bound)
    (hstep : ∀ acc x, x ∈ xs → (∀ kd ∈ acc, kd.1 < bound) →
             ∀ res, f acc x = .ok res → ∀ kd ∈ res, kd.1 < bound) :
    ∀ kd ∈ result, kd.1 < bound := by
  induction xs generalizing init with
  | nil => simp [List.foldlM, pure, Except.pure] at hfold; subst hfold; exact hinit
  | cons hd tl ih =>
    simp [List.foldlM, bind, Except.bind] at hfold
    cases hsr : f init hd with
    | error err => simp [hsr] at hfold
    | ok mid =>
      simp [hsr] at hfold
      exact ih hfold (hstep init hd (.head tl) hinit mid hsr)
        (fun acc x hx hacc => hstep acc x (.tail hd hx) hacc)

/-- From CapturedEnvFullBounded, derive varEnvClosuresCapturedBounded for ofCaptured. -/
lemma varEnvClosuresCapturedBounded_ofCaptured {env : CapturedVarEnv} {nt : Tag}
    (hb : CapturedEnvFullBounded env nt) :
    varEnvClosuresCapturedBounded (VarTypeEnv.ofCaptured env) nt := by
  intro name qt hlookup
  simp only [VarTypeEnv.ofCaptured, VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?] at hlookup
  suffices h : ∀ (entries : CapturedVarEnv) (acc : VarTypeEnv),
      (∀ n q b, (n, q, b) ∈ entries → etypClosuresFullBounded q.etyp nt) →
      (∀ n (q : QTyp), acc[n]? = some q → etypClosuresFullBounded q.etyp nt) →
      (List.foldr (fun (entry : Name × QTyp × Nat) (acc : VarTypeEnv) => acc.insert entry.1 entry.2.1) acc entries)[name]? = some qt →
      etypClosuresFullBounded qt.etyp nt by
    exact h env {} (fun n q b hmem => (hb.get hmem).2) (fun n q hq => by
      rw [Std.ExtTreeMap.getElem?_empty] at hq; exact absurd hq (by simp)) hlookup
  intro entries
  induction entries with
  | nil => intro acc _ hacc hlookup'; exact hacc _ _ hlookup'
  | cons hd tl ih =>
    intro acc hentries hacc hlookup'
    simp only [List.foldr] at hlookup'
    rw [Std.ExtTreeMap.getElem?_insert] at hlookup'
    split at hlookup'
    · simp at hlookup'; subst hlookup'; exact hentries hd.1 hd.2.1 hd.2.2 (.head tl)
    · exact ih acc (fun n q b hmem => hentries n q b (.tail hd hmem)) hacc hlookup'

/-- Public applied form: a member looked up via `ofCaptured` of a fully-bounded captured env
    has fully-bounded nested closures. -/
lemma etypClosuresFullBounded_of_ofCaptured_lookup {env : CapturedVarEnv} {nt : Tag}
    (h : CapturedEnvFullBounded env nt) {y : Name} {qt : QTyp}
    (hlook : (VarTypeEnv.ofCaptured env).lookup y = some qt) :
    etypClosuresFullBounded qt.etyp nt :=
  varEnvClosuresCapturedBounded_ofCaptured h y qt hlook

lemma matchGuard_tag_bounded
    (e : Expr) (G : MemoryTypeEnv) (S : VarTypeEnv) (B : BindEnv) (fuel : Nat)
    (k : Tag) (deps : Deps) (nextTag : Tag)
    (hmatch : matchGuard e G S B fuel = .ok (k, deps))
    (hvar : predTagsBoundedInVarEnv S nextTag)
    (hmemG : predTagsBoundedInMemEnv G nextTag) :
    k < nextTag := by
  simp only [matchGuard, Bind.bind, Except.bind] at hmatch
  cases htoPE : e.toPExpr with
  | error err => simp [htoPE] at hmatch
  | ok condPE =>
    simp only [htoPE] at hmatch
    -- hmatch : (match foldlM ... with error => error | ok refMs => match (foldl ... ++ refMs) with ...) = ok (k, deps)
    -- Split on foldlM result for refMatches
    split at hmatch
    · exact absurd hmatch (by intro h; exact nomatch h)
    · rename_i refMatches _heqRefM
      -- Split on the match over allMatches = varMatches ++ refMatches
      split at hmatch
      · -- Singleton [hd] where hd = (k, deps) after the pure
        rename_i hd heqAll
        -- hmatch : pure hd = .ok (k, deps), i.e., hd = (k, deps)
        simp only [pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at hmatch
        obtain ⟨hk_eq, hd_eq⟩ := hmatch
        -- hk_eq : tag✝ = k, hd_eq : hd = deps
        -- Suffices to show tag✝ < nextTag
        rw [← hk_eq]
        -- heqAll : varMatches ++ refMatches = [(tag✝, hd)]
        -- Show: all tags in varMatches ++ refMatches are < nextTag
        -- Then the singleton element's tag is < nextTag
        -- First, generalize the varMatches expression
        generalize hVM : VarTypeEnv.foldl _ _ S = varMatches at heqAll
        -- Now heqAll : varMatches ++ refMatches = [(_, hd)]
        -- Show all elements have bounded tags
        suffices hall : ∀ kd ∈ varMatches ++ refMatches, kd.1 < nextTag by
          exact hall _ (by rw [heqAll]; exact List.Mem.head _)
        rw [List.forall_mem_append]
        constructor
        · -- All tags in varMatches are bounded
          rw [← hVM, VarTypeEnv.foldl, Std.ExtTreeMap.foldl_eq_foldl_toList]
          exact foldl_tags_bounded (fun _ h => nomatch h) (fun acc entry hmem hacc kd hkd => by
            have hlookup : S[entry.1]? = some entry.2 :=
              (Std.ExtTreeMap.mem_toList_iff_getElem?_eq_some).mp hmem
            have hqt := hvar entry.1 entry.2
              (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?, hlookup])
            -- The fold body: match checkPredicate with ok (some kd) => kd::acc | _ => acc
            split at hkd
            · -- ok (some kd_new): kd ∈ kd_new :: acc
              rename_i kd_new heq_check
              simp only [List.mem_cons] at hkd
              rcases hkd with rfl | hkd
              · -- kd = kd_new: extract tag from entry.2.pred = guardClosure tag ...
                revert heq_check
                simp only [pure, Except.pure]
                rcases entry with ⟨name, etyp, poison, pred⟩
                simp only [] at hqt ⊢
                cases pred with
                | noPred => intro h; cases etyp <;> simp at h
                | guardOnly _ => intro h; cases etyp <;> simp at h
                | guardClosure tag _ _ _ =>
                  change tag < nextTag at hqt
                  intro heq_check
                  cases etyp <;> simp only [] at heq_check
                  all_goals first
                    | contradiction
                    | (split at heq_check
                       · split at heq_check
                         · split at heq_check
                           · simp at heq_check
                           · simp only [Except.ok.injEq, Option.some.injEq, Prod.mk.injEq] at heq_check
                             rw [← heq_check.1]; exact hqt
                         · simp at heq_check
                       · simp at heq_check)
              · exact hacc kd hkd
            · exact hacc kd hkd  -- ok none
            · exact hacc kd hkd  -- error
          )
        · -- All tags in refMatches are bounded
          -- Convert VarTypeEnv.foldlM to List.foldlM on S.toList
          rw [VarTypeEnv.foldlM, Std.ExtTreeMap.foldlM_eq_foldlM_toList] at _heqRefM
          exact foldlM_tags_bounded _heqRefM (fun _ h => nomatch h)
            (fun acc entry hmem hacc res hres kd hkd => by
              -- entry ∈ S.toList. The fold step processes entry.2.etyp:
              -- Non-ref etyp → pure acc (no change)
              -- Ref with poison → pure acc
              -- Ref with empty locset → error
              -- Ref → merge preds from G, match merged pred, possibly add (tag, deps)
              -- Case on entry.2.etyp
              split at hres
              · -- ETyp.ref ls
                rename_i ls
                split at hres
                · -- poison = true → pure acc
                  simp only [pure, Except.pure, Except.ok.injEq] at hres
                  subst hres; exact hacc kd hkd
                · -- poison ≠ true
                  split at hres
                  · simp at hres  -- empty locset → error
                  · -- Non-empty locset: merge preds, match merged
                    -- After the two LocSet.foldM calls, match on merged predicate
                    split at hres
                    · exact absurd hres (by intro h; exact nomatch h)  -- foldM error
                    · rename_i merged_opt _
                      split at hres
                      · exact absurd hres (by intro h; exact nomatch h)  -- foldM error
                      · rename_i depsMerged _
                        -- Match on the merged predicate
                        split at hres
                        · -- guardClosure tag: possibly adds (tag, depsMerged)
                          rename_i tag _ _ _
                          split at hres
                          · split at hres
                            · -- Match success: res = (tag, depsMerged) :: acc
                              simp only [pure, Except.pure, Except.ok.injEq] at hres
                              subst hres
                              simp only [List.mem_cons] at hkd
                              rcases hkd with rfl | hkd
                              · -- kd = (tag, depsMerged): need tag < nextTag
                                -- tag came from the merged predicate which was guardClosure tag ...
                                -- The merge (LocSet.foldM using joinPredicates) preserves the tag
                                -- from individual G.lookup entries. By predTagBounded_joinPredicates
                                -- and hmemG, the tag is bounded.
                                -- Key: merged_opt.getD noPred = guardClosure tag ...
                                -- merged_opt came from foldM over ls using G.lookup
                                -- The first G.lookup l that has a predicate determines the initial tag
                                -- By hmemG, that tag < nextTag
                                -- merged_opt.getD noPred = guardClosure _tag✝ ...
                                -- merged_opt ≠ none (since getD returns guardClosure)
                                -- So merged_opt = some (guardClosure _tag✝ ...)
                                -- This came from folding joinPredicates over G.lookup entries
                                -- The fold preserves the tag from the first entry
                                -- Use hmemG to get the bound
                                -- merged_opt.getD noPred = guardClosure _tag✝ ...
                                -- merged_opt must be some (not none, since getD noPred ≠ guardClosure)
                                rename_i heqMergedPred _ _
                                -- Name the pred-merge fold hypothesis BEFORE cases on merged_opt
                                -- heq✝¹ is the pred-merge foldM hypothesis
                                -- Apply LocSet.foldM_Except_preserves_property NOW while the fold hyp is accessible
                                have hP : ∀ p, merged_opt = some p → predTagBounded nextTag p := by
                                  apply LocSet.foldM_Except_preserves_property (init := none)
                                    (P := fun opt => ∀ p, opt = some p → predTagBounded nextTag p)
                                  -- Resolve the fold hypothesis FIRST to unify f
                                  on_goal 3 => assumption
                                  · -- h_init: P none
                                    intro _ h; exact absurd h (by simp)
                                  · -- h_preserve: step preserves P
                                    intro acc_opt l hPacc acc_opt' hstep p hp
                                    split at hstep
                                    · rename_i memQt hlookup_l
                                      have hqt_l := hmemG l memQt hlookup_l
                                      split at hstep
                                      · exact absurd hstep (by intro h; exact nomatch h)
                                      · have h_eq := (@Except.ok.inj _ _ _ _ hstep).symm
                                        rw [h_eq] at hp
                                        have h_p := @Option.some.inj _ _ _ hp; subst h_p
                                        cases acc_opt with
                                        | none => exact hqt_l
                                        | some q => exact predTagBounded_joinPredicates (hPacc q rfl) hqt_l
                                    · exact absurd hstep (by intro h; exact nomatch h)
                                cases hmo : merged_opt with
                                | none => simp [Option.getD, hmo] at heqMergedPred
                                | some mergedPred =>
                                  simp [Option.getD] at heqMergedPred
                                  have hbound := hP mergedPred hmo
                                  -- heqMergedPred has `match merged_opt` form; simplify with hmo
                                  simp [hmo] at heqMergedPred
                                  -- heqMergedPred : mergedPred = guardClosure _tag✝ ...
                                  rw [heqMergedPred] at hbound
                                  exact hbound
                              · exact hacc kd hkd
                            · simp only [pure, Except.pure, Except.ok.injEq] at hres
                              subst hres; exact hacc kd hkd
                          · simp only [pure, Except.pure, Except.ok.injEq] at hres
                            subst hres; exact hacc kd hkd
                        · -- guardOnly: pure acc
                          simp only [pure, Except.pure, Except.ok.injEq] at hres
                          subst hres; exact hacc kd hkd
                        · -- noPred: pure acc
                          simp only [pure, Except.pure, Except.ok.injEq] at hres
                          subst hres; exact hacc kd hkd
              · -- Non-ref etyp → pure acc
                simp only [pure, Except.pure, Except.ok.injEq] at hres
                subst hres; exact hacc kd hkd)
      · exact absurd hmatch (by intro h; exact nomatch h)
      · exact absurd hmatch (by intro h; exact nomatch h)

private lemma typecheckIf_pred_noPred (ctx : TypeContext) (e1 e2 e3 : Expr)
    (fuel : Nat) (res : TypeResult)
    (htc : typecheckIf ctx e1 e2 e3 fuel = .ok res) :
    res.qualType.pred = Predicate.noPred := by
  unfold typecheckIf at htc
  simp only [bind, Except.bind, pure, Except.pure] at htc
  cases fuel with
  | zero => simp at htc
  | succ fuel' =>
    repeat (first | split at htc | simp at htc | (cases htc; rfl))

/-- normalizeAppResultByProvenance preserves predTagBounded: it either keeps the pred or sets noPred. -/
private lemma normalizeAppResultByProvenance_predTagBounded {p1p : Poison} {qt : QTyp} {nt : Tag}
    (hb : predTagBounded nt qt.pred) : predTagBounded nt (normalizeAppResultByProvenance p1p qt).pred := by
  simp [normalizeAppResultByProvenance]
  split
  · exact trivial -- noPred case
  · exact hb

/-- Generalized: resolveSyntaxPred produces a bounded pred when all mapping values are < t'. -/
private lemma resolveSyntaxPred_predTagBounded_of_mapping
    (pred : SyntaxPredicate) (varEnv : VarTypeEnv) (binds : BindEnv)
    (mapping : ExtTreeMap TagIndex Tag) (t' : Tag)
    (resolvedPred : Predicate)
    (hmapping : ∀ idx tag, mapping.get? idx = some tag → tag < t')
    (htc_resolve : resolveSyntaxPred pred varEnv binds mapping = .ok resolvedPred) :
    predTagBounded t' resolvedPred := by
  unfold resolveSyntaxPred at htc_resolve
  cases pred with
  | guardClosure idx arg body =>
    simp [bind, Except.bind, pure, Except.pure] at htc_resolve
    split at htc_resolve
    · rename_i tag hget
      cases hbody : body.toPExpr with
      | error => simp [hbody] at htc_resolve
      | ok pbody =>
        simp [hbody] at htc_resolve; rw [← htc_resolve]; simp [predTagBounded]
        exact hmapping idx tag (by rwa [ExtTreeMap.get?_eq_getElem?])
    · simp at htc_resolve
  | guardOnly idx =>
    simp [pure, Except.pure] at htc_resolve
    split at htc_resolve
    · rename_i tag hget; simp at htc_resolve
      rw [← htc_resolve]; simp [predTagBounded]
      exact hmapping idx tag (by rwa [ExtTreeMap.get?_eq_getElem?])
    · simp at htc_resolve
  | noPred =>
    simp [pure, Except.pure] at htc_resolve
    rw [← htc_resolve]; trivial

/-- returnSpecToQTyp produces non-function ETyps — trivially closure-bounded. -/
private lemma returnSpecToQTyp_etyp_simple
    (typ : Typ) (poison : Poison) (resolvedPred : Predicate) (nextLoc : Loc)
    (retQt : QTyp) (nextLoc' : Loc) (nt : Tag)
    (h : returnSpecToQTyp typ poison resolvedPred nextLoc = .ok (retQt, nextLoc')) :
    etypClosuresFullBounded retQt.etyp nt := by
  unfold returnSpecToQTyp at h
  simp [bind, Except.bind, pure, Except.pure] at h
  cases typ <;> simp at h <;> (try (rcases h with ⟨rfl, _⟩; trivial))

/-- returnSpecToQTyp produces bounded preds when the resolvedPred is bounded. -/
private lemma returnSpecToQTyp_predBounded
    (typ : Typ) (poison : Poison) (resolvedPred : Predicate) (nextLoc : Loc)
    (retQt : QTyp) (nextLoc' : Loc) (nt : Tag)
    (hpred : predTagBounded nt resolvedPred)
    (h : returnSpecToQTyp typ poison resolvedPred nextLoc = .ok (retQt, nextLoc')) :
    predTagBounded nt retQt.pred := by
  unfold returnSpecToQTyp at h
  simp [bind, Except.bind, pure, Except.pure] at h
  cases typ <;> simp at h <;> (try (rcases h with ⟨rfl, _⟩; exact hpred))

/-- The effects forIn loop preserves predTagsBoundedInMemEnv.
    Abstract: given that each step of the loop body preserves the invariant
    (for both yield and done results), the full loop preserves boundedness. -/
private lemma effects_forIn_predTagsBounded
    {α : Type} [Membership α (List α)]
    {effects : List α}
    {nt : Tag}
    {memEnvInit memEnvResult : MemoryTypeEnv}
    (hInit : predTagsBoundedInMemEnv memEnvInit nt)
    {body : α → MemoryTypeEnv → Except String (ForInStep MemoryTypeEnv)}
    (hbody_pres : ∀ (eff : α) (r : MemoryTypeEnv),
      predTagsBoundedInMemEnv r nt →
      ∀ (fs : ForInStep MemoryTypeEnv), body eff r = .ok fs →
        match fs with
        | .yield r' => predTagsBoundedInMemEnv r' nt
        | .done r' => predTagsBoundedInMemEnv r' nt)
    (hloop : forIn effects memEnvInit body = Except.ok memEnvResult) :
    predTagsBoundedInMemEnv memEnvResult nt := by
  induction effects generalizing memEnvInit with
  | nil =>
    simp only [forIn, List.forIn'_nil, pure, Except.pure, Except.ok.injEq] at hloop
    subst hloop; exact hInit
  | cons hd tl ih =>
    simp only [forIn, List.forIn'_cons, bind, Except.bind] at hloop
    split at hloop
    · simp at hloop  -- error case
    · rename_i stepResult hstep
      split at hloop
      · -- ForInStep.done: loop terminates early
        rename_i memDone
        simp [pure, Except.pure] at hloop; subst hloop
        have := hbody_pres hd memEnvInit hInit (.done memDone) hstep
        simp at this; exact this
      · -- ForInStep.yield: continue with tail
        rename_i memStep
        have hBounded := hbody_pres hd memEnvInit hInit (.yield memStep) hstep
        simp at hBounded
        exact ih hBounded hloop

/-- Extern FnTClosure preserves the combined boundedness triple. -/
private lemma applyFnTClosure_extern_predTagsBounded
    (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat)
    (id : ExternId) (x : Name) (retSpec : ExternReturn) (effects : List Effect) (capturedEnv : CapturedVarEnv)
    (hpred_r1_mem : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
    (henv_captured : CapturedEnvFullBounded capturedEnv r1.nextTag')
    (hpred_argPred : predTagBounded r1.nextTag' argPred)
    (hclosure_arg : etypClosuresFullBounded argEtyp r1.nextTag')
    (declaredArgQt : QTyp)
    (happly : applyFnTClosure (FnTClosure.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
      argEtyp argPoison argPred ctx r1 fuel = .ok r2) :
    predTagsBoundedInMemEnv r2.memEnv' r2.nextTag' ∧
    qtypPredTagBounded r2.qualType r2.nextTag' ∧
    etypClosuresFullBounded r2.qualType.etyp r2.nextTag' := by
  unfold applyFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ fuel' =>
    -- The unfolded happly is a big do-block. Use split to case on each bind.
    simp only [bind, Except.bind] at happly
    -- Leading argument-condition gate: throw branch is impossible on .ok.
    split at happly
    · simp at happly
    simp only [pure, Except.pure] at happly
    -- collectAndAllocExternTags
    split at happly
    · simp at happly
    · rename_i allocResult halloc
      -- Tag monotonicity and mapping boundedness
      obtain ⟨tagMapping, nextTag'⟩ := allocResult
      have hmono : r1.nextTag' ≤ nextTag' :=
        collectAndAllocExternTags_nextTag_ge _ _ _ _ halloc
      have hmapping : ∀ idx tag, tagMapping.get? idx = some tag → tag < nextTag' :=
        collectAndAllocExternTags_mapping_values_lt _ _ _ _ halloc
      -- predTagsBoundedInMemEnv mono'd
      have hMemMono : predTagsBoundedInMemEnv r1.memEnv' nextTag' :=
        predTagsBoundedInMemEnv_mono hpred_r1_mem hmono
      -- CapturedEnvFullBounded mono'd
      have hCaptMono : CapturedEnvFullBounded capturedEnv nextTag' :=
        CapturedEnvFullBounded_mono henv_captured hmono
      -- Effects loop (forIn)
      let unifiedEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
        ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩
      let unifiedBinds := BindEnv.bindParam capturedEnv x r1.nextBind'
      let effectPc := joinPoison p (joinPoison p1 ctx.pc)
      split at happly
      · simp at happly
      · rename_i loopResult hloop
        have hMemAfterLoop : predTagsBoundedInMemEnv loopResult nextTag' := by
          apply effects_forIn_predTagsBounded hMemMono _ hloop
          intro eff r hr fs hfs
          -- Decompose the bind layer from `memEnv ← applyExternEffect ...`
          simp only [] at hfs
          split at hfs
          · simp at hfs  -- applyExternEffect error → contradiction
          · -- applyExternEffect succeeded with some result
            rename_i effectResult happlyEffect
            simp only [Except.ok.injEq] at hfs; cases hfs; simp
            -- Unfold applyExternEffect to expose the match chain
            simp only [applyExternEffect, bind, Except.bind] at happlyEffect
            split at happlyEffect
            · -- some case: split on qt.etyp
              split at happlyEffect
              · -- ETyp.ref
                split at happlyEffect
                · simp at happlyEffect -- resolveSyntaxPred error
                · rename_i resolvedPred_eff hresolve_eff
                  simp [pure, Except.pure] at happlyEffect; subst happlyEffect
                  have hResBounded := resolveSyntaxPred_predTagBounded_of_mapping
                    eff.pred unifiedEnv unifiedBinds tagMapping nextTag' resolvedPred_eff hmapping hresolve_eff
                  -- The effect update mirrors assignment (singleton strong /
                  -- non-singleton weak); the stored predicate is `noPred` under a
                  -- poisoned target/pc, otherwise the resolved effect predicate.
                  apply assign_memEnv_formula_predBounded r _ _ _ nextTag' hr
                  split
                  · simp [predTagBounded]
                  · simpa [effectSpecToQTyp] using hResBounded
              · simp at happlyEffect -- non-ref: error
            · simp at happlyEffect -- none: error
        -- Case on retSpec
        cases retSpec with
        | simple typ poison pred =>
          simp at happly
          -- resolveSyntaxPred
          split at happly
          · simp at happly
          · rename_i resolvedPred hresolve
            have hResolvedBounded : predTagBounded nextTag' resolvedPred :=
              resolveSyntaxPred_predTagBounded_of_mapping pred unifiedEnv unifiedBinds tagMapping nextTag'
                resolvedPred hmapping hresolve
            -- returnSpecToQTyp
            split at happly
            · simp at happly
            · rename_i retResult hret
              split at happly
              · exact nomatch happly
              simp only [Except.ok.injEq] at happly; subst r2
              obtain ⟨retQt, nextLoc'⟩ := retResult
              have hRetPredBounded : predTagBounded nextTag' retQt.pred :=
                returnSpecToQTyp_predBounded typ poison resolvedPred r1.nextLoc'
                  retQt nextLoc' nextTag' hResolvedBounded hret
              have hRetEtypBounded : etypClosuresFullBounded retQt.etyp nextTag' :=
                returnSpecToQTyp_etyp_simple typ poison resolvedPred r1.nextLoc'
                  retQt nextLoc' nextTag' hret
              refine ⟨hMemAfterLoop, ?_, ?_⟩
              · exact normalizeAppResultByProvenance_predTagBounded hRetPredBounded
              · simp [normalizeAppResultByProvenance]
                split <;> exact hRetEtypBounded
        | nestedFn innerId innerArg innerArgTyp innerArgPoison innerArgPred innerRet innerEffects =>
          simp only [] at happly
          split at happly
          · simp at happly
          · next v hresolve =>
            have hresolve_tag : v.2 = nextTag' := resolveArgCondQTyp_snd hresolve
            rw [hresolve_tag] at happly
            split at happly
            · exact nomatch happly
            simp only [Except.ok.injEq] at happly; subst r2
            have hPredUnified : predTagsBoundedInVarEnv unifiedEnv nextTag' :=
              predTagsBoundedInVarEnv_update
                (predTagsBoundedInVarEnv_ofCaptured (capturedPredTagsBounded_of_fullBounded hCaptMono))
                (predTagBounded_mono hpred_argPred hmono)
            have hClosUnified : varEnvClosuresCapturedBounded unifiedEnv nextTag' :=
              varEnvClosuresCapturedBounded_update
                (varEnvClosuresCapturedBounded_ofCaptured hCaptMono)
                (etypClosuresFullBounded_mono hclosure_arg hmono)
            have hCaptToCaptured : CapturedEnvFullBounded (VarTypeEnv.toCaptured unifiedEnv unifiedBinds) nextTag' :=
              capturedEnvFullBounded_of_toCaptured hPredUnified hClosUnified
            refine ⟨hMemAfterLoop, ?_, ?_⟩
            · simp [normalizeAppResultByProvenance]; split <;> trivial
            · simp [normalizeAppResultByProvenance]; split
              · intro tcl hmem
                simp at hmem; subst tcl
                exact hCaptToCaptured
              · intro tcl hmem
                simp at hmem; subst tcl
                exact hCaptToCaptured
        | nestedPfn innerId innerArg innerArgTyp innerArgPoison innerArgPred innerRet =>
          simp only [] at happly
          split at happly
          · simp at happly
          · next v hresolve =>
            have hresolve_tag : v.2 = nextTag' := resolveArgCondQTyp_snd hresolve
            rw [hresolve_tag] at happly
            split at happly
            · exact nomatch happly
            simp only [Except.ok.injEq] at happly; subst r2
            have hPredUnified : predTagsBoundedInVarEnv unifiedEnv nextTag' :=
              predTagsBoundedInVarEnv_update
                (predTagsBoundedInVarEnv_ofCaptured (capturedPredTagsBounded_of_fullBounded hCaptMono))
                (predTagBounded_mono hpred_argPred hmono)
            have hClosUnified : varEnvClosuresCapturedBounded unifiedEnv nextTag' :=
              varEnvClosuresCapturedBounded_update
                (varEnvClosuresCapturedBounded_ofCaptured hCaptMono)
                (etypClosuresFullBounded_mono hclosure_arg hmono)
            have hCaptToCaptured : CapturedEnvFullBounded (VarTypeEnv.toCaptured unifiedEnv unifiedBinds) nextTag' :=
              capturedEnvFullBounded_of_toCaptured hPredUnified hClosUnified
            refine ⟨hMemAfterLoop, ?_, ?_⟩
            · simp [normalizeAppResultByProvenance]; split <;> trivial
            · simp [normalizeAppResultByProvenance]; split
              · intro tcl hmem
                simp at hmem; subst tcl
                exact hCaptToCaptured
              · intro tcl hmem
                simp at hmem; subst tcl
                exact hCaptToCaptured

/-- Extern PFnTClosure preserves the combined boundedness triple. -/
private lemma applyPFnTClosure_extern_predTagsBounded
    (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat)
    (id : ExternId) (x : Name) (retSpec : ExternReturn) (capturedEnv : CapturedVarEnv)
    (hpred_r1_mem : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
    (henv_captured : CapturedEnvFullBounded capturedEnv r1.nextTag')
    (hpred_argPred : predTagBounded r1.nextTag' argPred)
    (hclosure_arg : etypClosuresFullBounded argEtyp r1.nextTag')
    (declaredArgQt : QTyp)
    (happly : applyPFnTClosure (PFnTClosure.extern id x retSpec capturedEnv declaredArgQt captures) st1 st2 p p1
      argEtyp argPoison argPred ctx r1 fuel = .ok r2) :
    predTagsBoundedInMemEnv r2.memEnv' r2.nextTag' ∧
    qtypPredTagBounded r2.qualType r2.nextTag' ∧
    etypClosuresFullBounded r2.qualType.etyp r2.nextTag' := by
  unfold applyPFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ fuel' =>
    simp [bind, Except.bind] at happly
    -- Leading argument-condition gate: throw branch is impossible on .ok.
    split at happly
    · simp at happly
    simp only [pure, Except.pure] at happly
    -- unifiedEnv
    let unifiedEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured capturedEnv) x
      ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩
    let unifiedBinds := BindEnv.bindParam capturedEnv x r1.nextBind'
    -- Case on retSpec
    cases retSpec with
    | simple typ poison pred =>
      -- collectAndAllocExternTags [pred]
      simp at happly
      cases halloc : collectAndAllocExternTags [pred] r1.nextTag' with
      | error err => simp [halloc] at happly
      | ok allocResult =>
        simp [halloc] at happly
        obtain ⟨tagMapping, nextTag'⟩ := allocResult
        have hmono : r1.nextTag' ≤ nextTag' :=
          collectAndAllocExternTags_nextTag_ge _ _ _ _ halloc
        have hmapping : ∀ idx tag, tagMapping.get? idx = some tag → tag < nextTag' :=
          collectAndAllocExternTags_mapping_values_lt _ _ _ _ halloc
        -- resolveSyntaxPred
        split at happly
        · simp at happly -- error case
        · rename_i resolvedPred hresolve
          have hResolvedBounded : predTagBounded nextTag' resolvedPred :=
            resolveSyntaxPred_predTagBounded_of_mapping pred unifiedEnv unifiedBinds tagMapping nextTag'
              resolvedPred hmapping hresolve
          -- returnSpecToQTyp
          split at happly
          · simp at happly -- error case
          · rename_i retResult hret
            split at happly
            · exact nomatch happly
            simp only [Except.ok.injEq] at happly; subst r2
            obtain ⟨retQt, nextLoc'⟩ := retResult
            have hRetPredBounded : predTagBounded nextTag' retQt.pred :=
              returnSpecToQTyp_predBounded typ poison resolvedPred r1.nextLoc'
                retQt nextLoc' nextTag' hResolvedBounded hret
            have hRetEtypBounded : etypClosuresFullBounded retQt.etyp nextTag' :=
              returnSpecToQTyp_etyp_simple typ poison resolvedPred r1.nextLoc'
                retQt nextLoc' nextTag' hret
            -- Memory unchanged: r2.memEnv' = r1.memEnv'
            have hMemMono : predTagsBoundedInMemEnv r1.memEnv' nextTag' :=
              predTagsBoundedInMemEnv_mono hpred_r1_mem hmono
            refine ⟨hMemMono, ?_, ?_⟩
            · exact normalizeAppResultByProvenance_predTagBounded hRetPredBounded
            · simp [normalizeAppResultByProvenance]
              split <;> exact hRetEtypBounded
    | nestedFn innerId innerArg innerArgTyp innerArgPoison innerArgPred innerRet innerEffects =>
      simp only [] at happly
      split at happly
      · simp at happly
      · next v hresolve =>
        have hresolve_tag : v.2 = r1.nextTag' := resolveArgCondQTyp_snd hresolve
        rw [hresolve_tag] at happly
        simp only [Except.ok.injEq] at happly; subst r2
        -- nextTag' = r1.nextTag' (no tag allocation for nested)
        have hPredUnified : predTagsBoundedInVarEnv unifiedEnv r1.nextTag' :=
          predTagsBoundedInVarEnv_update
            (predTagsBoundedInVarEnv_ofCaptured (capturedPredTagsBounded_of_fullBounded henv_captured))
            hpred_argPred
        have hClosUnified : varEnvClosuresCapturedBounded unifiedEnv r1.nextTag' :=
          varEnvClosuresCapturedBounded_update
            (varEnvClosuresCapturedBounded_ofCaptured henv_captured) hclosure_arg
        have hCaptToCaptured : CapturedEnvFullBounded (VarTypeEnv.toCaptured unifiedEnv unifiedBinds) r1.nextTag' :=
          capturedEnvFullBounded_of_toCaptured hPredUnified hClosUnified
        refine ⟨hpred_r1_mem, ?_, ?_⟩
        · simp [normalizeAppResultByProvenance]; split <;> trivial
        · simp [normalizeAppResultByProvenance]; split
          · intro tcl hmem
            simp at hmem; subst tcl
            exact hCaptToCaptured
          · intro tcl hmem
            simp at hmem; subst tcl
            exact hCaptToCaptured
    | nestedPfn innerId innerArg innerArgTyp innerArgPoison innerArgPred innerRet =>
      simp only [] at happly
      split at happly
      · simp at happly
      · next v hresolve =>
        have hresolve_tag : v.2 = r1.nextTag' := resolveArgCondQTyp_snd hresolve
        rw [hresolve_tag] at happly
        simp only [Except.ok.injEq] at happly; subst r2
        have hPredUnified : predTagsBoundedInVarEnv unifiedEnv r1.nextTag' :=
          predTagsBoundedInVarEnv_update
            (predTagsBoundedInVarEnv_ofCaptured (capturedPredTagsBounded_of_fullBounded henv_captured))
            hpred_argPred
        have hClosUnified : varEnvClosuresCapturedBounded unifiedEnv r1.nextTag' :=
          varEnvClosuresCapturedBounded_update
            (varEnvClosuresCapturedBounded_ofCaptured henv_captured) hclosure_arg
        have hCaptToCaptured : CapturedEnvFullBounded (VarTypeEnv.toCaptured unifiedEnv unifiedBinds) r1.nextTag' :=
          capturedEnvFullBounded_of_toCaptured hPredUnified hClosUnified
        refine ⟨hpred_r1_mem, ?_, ?_⟩
        · simp [normalizeAppResultByProvenance]; split <;> trivial
        · simp [normalizeAppResultByProvenance]; split
          · intro tcl hmem
            simp at hmem; subst tcl
            exact hCaptToCaptured
          · intro tcl hmem
            simp at hmem; subst tcl
            exact hCaptToCaptured

/-- applyFnTClosure preserves the combined boundedness triple. -/
private lemma applyFnTClosure_predTagsBounded
    (tcl : FnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat)
    (IH : ∀ m < fuel, ∀ (e' : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheckExpr ctx' e' m = .ok res' → predTagsBoundedInCtx ctx' →
          closureEnvBoundedInCtx ctx' →
          predTagsBoundedInMemEnv res'.memEnv' res'.nextTag' ∧
          qtypPredTagBounded res'.qualType res'.nextTag' ∧
          etypClosuresFullBounded res'.qualType.etyp res'.nextTag')
    (hpred_r1_mem : predTagsBoundedInMemEnv r1.memEnv' r1.nextTag')
    (henv_captured : match tcl with
      | .regular _ _ env => CapturedEnvFullBounded env r1.nextTag'
      | .extern _ _ _ _ env _ _ => CapturedEnvFullBounded env r1.nextTag')
    (hpred_argPred : predTagBounded r1.nextTag' argPred)
    (hclosure_arg : etypClosuresFullBounded argEtyp r1.nextTag') :
    applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
    predTagsBoundedInMemEnv r2.memEnv' r2.nextTag' ∧
    qtypPredTagBounded r2.qualType r2.nextTag' ∧
    etypClosuresFullBounded r2.qualType.etyp r2.nextTag' := by
  intro happly
  unfold applyFnTClosure at happly
  cases fuel with
  | zero => simp at happly
  | succ fuel' =>
    cases tcl with
    | regular x body env =>
      simp [bind, Except.bind] at happly
      rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
        <;> rw [htc] at happly <;> simp at happly
      rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
      simp [hqt] at happly
      cases hsub : isErasureOf st2 _ with
      | false => rw [hsub] at happly; simp at happly
      | true =>
        rw [hsub] at happly; simp [pure, Except.pure] at happly; subst r2
        -- IH on the body gives full 3-tuple for r
        have h_lt : fuel' < fuel' + 1 := Nat.lt_succ_self _
        have hpredCtx' : predTagsBoundedInCtx
            { ctx with pc := joinPoison p (joinPoison p1 ctx.pc),
                       memEnv := r1.memEnv', varEnv := (VarTypeEnv.ofCaptured env).update x
                         { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred },
                       bindEnv := BindEnv.bindParam env x r1.nextBind', tagEnv := r1.tagEnv', nextTag := r1.nextTag', nextBind := r1.nextBind' + 1,
                       nextLoc := r1.nextLoc', regime := r1.regime' } := by
          constructor
          · intro v qt' hlookup
            simp [VarTypeEnv.update, VarTypeEnv.lookup] at hlookup
            rw [Std.ExtTreeMap.getElem?_insert] at hlookup
            split at hlookup
            · simp at hlookup; subst qt'; exact hpred_argPred
            · exact predTagsBoundedInVarEnv_ofCaptured
                (capturedPredTagsBounded_of_fullBounded henv_captured) v qt'
                (by simp [VarTypeEnv.lookup, Std.ExtTreeMap.get?_eq_getElem?]; exact hlookup)
          · exact hpred_r1_mem
        have hclosureCtx' : varEnvClosuresCapturedBounded
            ((VarTypeEnv.ofCaptured env).update x
              { etyp := argEtyp, poison := joinPoison ctx.pc argPoison, pred := argPred })
            r1.nextTag' :=
          varEnvClosuresCapturedBounded_update
            (varEnvClosuresCapturedBounded_ofCaptured henv_captured) hclosure_arg
        have hIH_body := IH fuel' h_lt body _ r htc hpredCtx' hclosureCtx'
        have hpredBody : predTagBounded r.nextTag' pred := by
          have := hIH_body.2.1; simp [qtypPredTagBounded, hqt] at this; exact this
        -- normalizeAppResultByProvenance doesn't change etyp, so closures carry over
        have hClosBody : etypClosuresFullBounded etyp r.nextTag' := by
          have := hIH_body.2.2; simp [hqt] at this; exact this
        simp [normalizeAppResultByProvenance]
        split
        · exact ⟨hIH_body.1, trivial, hClosBody⟩
        · exact ⟨hIH_body.1, hpredBody, hClosBody⟩
    | extern id x retSpec effects capturedEnv declaredArgQt captures =>
      -- Reconstruct the applyFnTClosure equation from the unfolded happly
      have happly' : applyFnTClosure (.extern id x retSpec effects capturedEnv declaredArgQt captures) st1 st2 p p1
          argEtyp argPoison argPred ctx r1 (fuel' + 1) = .ok r2 := by
        unfold applyFnTClosure; exact happly
      exact applyFnTClosure_extern_predTagsBounded ctx st1 st2 p p1
        argEtyp argPoison argPred r1 r2 (fuel' + 1) id x retSpec effects capturedEnv
        hpred_r1_mem henv_captured hpred_argPred hclosure_arg declaredArgQt happly'

/-- applyPFnTClosure preserves the combined boundedness triple. -/
