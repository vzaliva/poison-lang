private lemma typecheckVlet_nextLoc_mono (ctx : TypeContext) (x : Name) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckVlet ctx x e1 e2 fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckVlet_structure ctx x e1 e2 fuel res htc
  rcases hstruct with ⟨result1, result2, ctx', htc1, hctx', htc2, _hetyp, _hmem, _htag, hnextloc, _hnexttag, _⟩
  cases fuel with
  | zero => unfold typecheckVlet at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e1 fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e1 ctx result1 htc1_simp
      have htc2_simp : typecheckExpr ctx' e2 fuel' = .ok result2 := by simpa using htc2
      have IH2 := IH fuel' h_fuel e2 ctx' result2 htc2_simp
      have h_ctx'_nextLoc : ctx'.nextLoc = result1.nextLoc' := by simp [hctx']
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ = ctx'.nextLoc := h_ctx'_nextLoc.symm
        _ ≤ result2.nextLoc' := IH2
        _ = res.nextLoc' := hnextloc.symm

private lemma typecheckIf_nextLoc_mono (ctx : TypeContext) (e1 e2 e3 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckIf ctx e1 e2 e3 fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  cases fuel with
  | zero => unfold typecheckIf at htc; simp at htc
  | succ fuel' =>
      have hstruct := typecheckIf_structure ctx e1 e2 e3 (fuel' + 1) res htc
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      -- Extract nextLoc equality from all four cases and prove monotonicity
      cases hstruct with
      | inl h1 =>
        -- R(k) = some true
        rcases h1 with ⟨k, deps, _, _, res1, htc1, _, res2, res3, htc2, _htc3, _, _, hnextloc, _hnexttag, _, _⟩
        have IH2 := IH fuel' h_fuel e2 { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := res1.nextTag', nextBind := res1.nextBind', declaredExternRefs := res1.declared' } res2 htc2
        simp at IH2
        calc ctx.nextLoc
          _ ≤ res2.nextLoc' := IH2
          _ ≤ max res2.nextLoc' res3.nextLoc' := le_max_left _ _
          _ = res.nextLoc' := hnextloc.symm
      | inr h_rest =>
        cases h_rest with
        | inl h2 =>
          -- R(k) = some false
          rcases h2 with ⟨k, deps, _, _, res1, htc1, _, res2, res3, htc2, htc3, _, _, hnextloc, _hnexttag, _, _⟩
          let ctxTrue := { ctx with tagEnv := ctx.tagEnv.insert k ⟨true, deps⟩, nextTag := res1.nextTag', nextBind := res1.nextBind', declaredExternRefs := res1.declared' }
          let ctxFalse := { ctx with tagEnv := ctx.tagEnv.insert k ⟨false, deps⟩,
                                     nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind', declaredExternRefs := res2.declared' }
          have IH2 := IH fuel' h_fuel e2 ctxTrue res2 (by simpa [ctxTrue] using! htc2)
          simp [ctxTrue] at IH2
          have IH3 := IH fuel' h_fuel e3 ctxFalse res3 (by simpa [ctxFalse] using! htc3)
          simp [ctxFalse] at IH3
          calc ctx.nextLoc
            _ ≤ res2.nextLoc' := IH2
            _ ≤ res3.nextLoc' := IH3
            _ ≤ max res2.nextLoc' res3.nextLoc' := le_max_right _ _
            _ = res.nextLoc' := hnextloc.symm
        | inr hstd =>
            have ⟨_h_std_case, h_res⟩ := hstd
            have ⟨res1, htc1, _hbool, h_res2⟩ := h_res
            have ⟨res2, h_body⟩ := h_res2
            have ⟨htc2, h_res3⟩ := h_body
            have ⟨res3, h_body3⟩ := h_res3
            have ⟨htc3, _hmem, _htag, _hloc, hnextloc, _hregime, _hpoison, _hetyp, _hpred⟩ := h_body3
            let ctx1 : TypeContext := { ctx with memEnv := res1.memEnv', tagEnv := res1.tagEnv', nextLoc := res1.nextLoc', nextTag := res1.nextTag', nextBind := res1.nextBind', regime := res1.regime', declaredExternRefs := res1.declared' }
            let pc' := joinPoison ctx.pc res1.qualType.poison
            let ctx'' := { ctx1 with pc := pc' }
            let ctxForE3 := { ctx'' with nextLoc := res2.nextLoc', nextTag := res2.nextTag', nextBind := res2.nextBind', declaredExternRefs := res2.declared' }
            have htc1' : typecheck ctx e1 fuel' = .ok res1 := by simpa [typecheck] using htc1
            have htc2' : typecheck ctx'' e2 fuel' = .ok res2 := by simpa [typecheck, ctx'', ctx1, pc'] using htc2
            have htc3' : typecheck ctxForE3 e3 fuel' = .ok res3 := by simpa [typecheck, ctxForE3, ctx'', ctx1, pc'] using htc3
            have IH1 := IH fuel' h_fuel e1 ctx res1 htc1'
            have IH2 := IH fuel' h_fuel e2 ctx'' res2 htc2'
            have h_loc1 : ctx.nextLoc ≤ res1.nextLoc' := IH1
            have h_loc2 : res1.nextLoc' ≤ res2.nextLoc' := by
              have := IH2
              simpa [ctx'', ctx1] using this
            calc ctx.nextLoc
              _ ≤ res1.nextLoc' := h_loc1
              _ ≤ res2.nextLoc' := h_loc2
              _ ≤ max res2.nextLoc' res3.nextLoc' := Nat.le_max_left _ _
              _ = res.nextLoc' := _hloc.symm

lemma joinTypeResults_nextLoc_eq_max
  (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) :
    joinTypeResults ctx r rs = .ok res →
    res.nextLoc' = List.max (r.nextLoc' :: rs.map TypeResult.nextLoc') (by intro h; cases h) := by
  intro hjoin
  -- Helper: the join fold computes the max of nextLoc' across the list.
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  have h_fold_nextLoc :
      ∀ (rs : List TypeResult)
        (acc acc' : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag),
        List.foldlM joinStep acc rs = Except.ok acc' →
        acc'.2.2.2.2.2.2.1 = List.foldl max acc.2.2.2.2.2.2.1 (rs.map TypeResult.nextLoc') := by
    intro rs acc acc' h
    induction rs generalizing acc with
    | nil =>
        simp [List.foldlM_nil, pure, Except.pure] at h
        cases h
        simp
    | cons x xs ih =>
        cases hqx : x.qualType with
        | mk resEtyp resPoison resPred =>
            simp [List.foldlM_cons, joinStep, hqx, bind, Except.bind] at h
            -- h is now about the tail fold; apply the IH.
            have h' := ih _ h
            -- foldl on a cons updates the max with the head.
            simpa [List.foldl_cons] using h'
  -- Unfold joinTypeResults and split on the fold checks.
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err =>
          erw [hcheck] at hjoin
          simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin
          simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err =>
              erw [hfold] at hjoin
              simp at hjoin
          | ok a =>
              erw [hfold] at hjoin
              simp at hjoin
              subst res
              simp
              have h_fold := h_fold_nextLoc rs _ _ hfold
              -- List.max on a non-empty list is foldl max.
              simpa [List.max] using h_fold

/-- Every member's nextLoc' ≤ the joined result's nextLoc' (consequence of max fold). -/
lemma joinTypeResults_member_nextLoc_le
    (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult)
    (hjoin : joinTypeResults ctx r rs = .ok res)
    (member : TypeResult) (hmem : member ∈ r :: rs) :
    member.nextLoc' ≤ res.nextLoc' := by
  have hmax := joinTypeResults_nextLoc_eq_max ctx r rs res hjoin
  rw [hmax]
  apply List.le_max_of_mem
  simp at hmem ⊢
  rcases hmem with rfl | hmem
  · exact .inl rfl
  · exact .inr ⟨member, hmem, rfl⟩

private lemma returnSpecToQTyp_preserves_nextLoc
  (typ : Typ) (poison : Bool) (pred : Predicate)
  (nextLoc : Loc) (ret : QTyp × Loc) :
  returnSpecToQTyp typ poison pred nextLoc = .ok ret →
  ret.2 = nextLoc := by
  intro h
  unfold returnSpecToQTyp at h
  cases typ with
  | int | bool | unit | string =>
      simp [bind, Except.bind, pure, Except.pure] at h
      exact (congrArg Prod.snd h).symm
  | ref _ =>
      simp [bind, Except.bind] at h
  | arrow _ _ =>
      simp [bind, Except.bind] at h

private lemma applyFnTClosure_nextLoc_mono
  (tcl : FnTClosure) (ctx : TypeContext)
  (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (r1 r2 : TypeResult) (fuel : Nat)
  (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
        typecheck ctx' e m = .ok res' → ctx'.nextLoc ≤ res'.nextLoc') :
  applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
  r1.nextLoc' ≤ r2.nextLoc' := by
  intro happly
  unfold applyFnTClosure at happly
  cases fuel <;> simp at happly
  cases tcl <;> simp at happly
  · simp [bind, Except.bind] at happly
    rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
      <;> rw [htc] at happly
      <;> simp at happly
    rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
    simp [hqt] at happly
    rcases hsub : isErasureOf st2 _
      <;> rw [hsub] at happly
      <;> simp at happly
    · simp [Functor.map, Except.map] at happly
    · simp [pure, Except.pure] at happly
      subst r2
      specialize IH _ (lt_add_one _) _ _ _ htc
      simp at IH
      exact IH
  · simp [bind, Except.bind] at happly
    -- Leading argument-condition gate: throw branch is impossible on .ok.
    split at happly
    · simp at happly
    -- Extern case: nestedFn/nestedPfn set nextLoc' := r1.nextLoc' (Nat.le_refl);
    -- simple uses returnSpecToQTyp which preserves nextLoc (equality → Nat.le_refl)
    split at happly
    · simp at happly
    · split at happly
      · simp at happly
      · split at happly
        · -- simple case: nextLoc' from returnSpecToQTyp which preserves nextLoc
          split at happly
          · simp at happly
          · -- happly now: (fun a => {nextLoc' := a.2, ...}) <$> returnSpecToQTyp ... = ok r2
            simp only [Functor.map, Except.map] at happly
            split at happly
            · simp at happly
            · -- ok case: r2 = {nextLoc' := v.2, ...}, and v.2 = r1.nextLoc' by preservation
              rename_i v hret
              split at happly
              · exact nomatch happly
              simp only [Except.ok.injEq] at happly
              rw [← happly]
              have := returnSpecToQTyp_preserves_nextLoc _ _ _ r1.nextLoc' v hret
              simp [this]
        · -- nestedFn: nextLoc' := r1.nextLoc' (resolveArgCondQTyp does not allocate)
          simp only [Functor.map, Except.map] at happly
          split at happly
          · simp at happly
          · split at happly
            · exact nomatch happly
            simp only [Except.ok.injEq] at happly; rw [← happly]
        · -- nestedPfn: nextLoc' := r1.nextLoc' (resolveArgCondQTyp does not allocate)
          simp only [Functor.map, Except.map] at happly
          split at happly
          · simp at happly
          · split at happly
            · exact nomatch happly
            simp only [Except.ok.injEq] at happly; rw [← happly]

private lemma typecheckApp_nextLoc_mono (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckApp ctx e1 e2 fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  unfold typecheckApp at htc
  cases fuel <;> simp at htc
  rename_i fuel'
  simp [bind, Except.bind] at htc
  rcases hcte2 : typecheckExpr ctx e2 _ with _ | ⟨res2⟩
    <;> rw [hcte2] at htc
    <;> simp at htc
  rcases hq2 : res2.qualType with ⟨etyp2, poison2, pred2⟩
  simp [hq2] at htc
  set ctx' : TypeContext := {
    pc := ctx.pc,
    regime := res2.regime',
    memEnv := res2.memEnv',
    varEnv := ctx.varEnv,
    bindEnv := ctx.bindEnv, tagEnv := res2.tagEnv',
    nextLoc := res2.nextLoc',
    nextTag := res2.nextTag', nextBind := res2.nextBind',
    pureCtx := ctx.pureCtx,
    externRegime := ctx.externRegime,
    externRefAllowed := ctx.externRefAllowed,
    declaredExternRefs := res2.declared' } with hctx'
  rcases htce1 : typecheckExpr ctx' e1 _ with _ | ⟨res1⟩
    <;> rw [htce1] at htc
    <;> simp at htc
  rcases hq1 : res1.qualType with ⟨etyp1, poison1, pred1⟩
  simp [hq1] at htc
  rcases etyp1 with _ | _ | _ | _ | _ | ⟨t1, t2, p, fs⟩ | _
    <;> simp at htc
  · rcases hctx : ctx.pureCtx <;> simp [hctx] at htc
    rcases fs with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf t1 _
      <;> rw [hsub1] at htc
      <;> simp at htc
    rcases happly :
        applyFnTClosureAtCursor f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyFnTClosureAtCursor tcl t1 t2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
        res = { joined with tagLog' := L } := by
      cases hj : joinTypeResults ctx r rs' with
      | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, _, rfl, htc.symm⟩
    -- ctx.nextLoc <= res1.nextLoc (by IH on htce1)
    -- res1.nextLoc = ctx'.nextLoc
    -- ctx'.nextLoc <= res2.nextLoc (by IH on hcte2)
    -- res2.nextLoc <= r.nextLoc (by applyFnTClosure_nextLoc_mono)
    -- forall r in rs', res2.nextLoc <= r.nextLoc (by applyFnTClosure_nextLoc_mono)
    -- res2.nextLoc <= max (r.nextLoc, map rs' .nextLoc) (follows from above)
    -- max (res2.nextLoc, map rs' .nextLoc) = res.nextLoc (by joinTypeResults_nextLoc_eq_max)
    have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
    have hcte2' : typecheck ctx e2 fuel' = .ok res2 := by
      simpa [typecheck] using hcte2
    have IH2 := IH fuel' h_fuel e2 ctx res2 hcte2'
    have htce1' : typecheck ctx' e1 fuel' = .ok res1 := by
      simpa [typecheck] using htce1
    have IH1 := IH fuel' h_fuel e1 ctx' res1 htce1'
    have IH' :
        ∀ m < fuel', ∀ (e : Expr) (ctx'' : TypeContext) (res' : TypeResult),
          typecheck ctx'' e m = .ok res' → ctx''.nextLoc ≤ res'.nextLoc' := by
      intro m hm e ctx'' res' htc'
      exact IH m (Nat.lt_trans hm h_fuel) e ctx'' res' htc'
    have happly_old :
        applyFnTClosure f t1 t2 p poison1 etyp2 poison2 pred2 ctx res1 fuel' = .ok r := by
      unfold applyFnTClosure
      unfold applyFnTClosureAtCursor at happly
      simpa using happly
    have h_r : res1.nextLoc' ≤ r.nextLoc' := by
      exact applyFnTClosure_nextLoc_mono f ctx t1 t2 p poison1 etyp2 poison2 pred2 res1 r fuel' IH' happly_old
    have h_join :
        res.nextLoc' =
          List.max (r.nextLoc' :: rs'.map TypeResult.nextLoc') (by intro h; cases h) :=
      joinTypeResults_nextLoc_eq_max ctx r rs' res hjoin
    have h_r_le_res : r.nextLoc' ≤ res.nextLoc' := by
      have h_r_le_max :
          r.nextLoc' ≤
            List.max (r.nextLoc' :: rs'.map TypeResult.nextLoc') (by intro h; cases h) := by
        apply List.le_max_of_mem
        simp
      simpa [h_join] using h_r_le_max
    calc
      ctx.nextLoc ≤ res2.nextLoc' := IH2
      _ = ctx'.nextLoc := by simp [hctx']
      _ ≤ res1.nextLoc' := IH1
      _ ≤ r.nextLoc' := h_r
      _ ≤ res.nextLoc' := h_r_le_res
  · rename_i st1 st2 p tcls
    rcases tcls with _ | ⟨f, fs'⟩ <;> simp at htc
    rcases hsub1 : isErasureOf st1 _
      <;> rw [hsub1] at htc
      <;> simp at htc
    rcases happly :
        applyPFnTClosureAtCursor f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1
          (res1.nextTag', res1.nextLoc') res1.nextBind' fuel' with _ | ⟨r⟩
      <;> simp [applyClosuresThreaded, happly, bind, Except.bind] at htc
    rcases hrest :
        applyClosuresThreaded
          (fun tcl cursor bn =>
            applyPFnTClosureAtCursor tcl st1 st2 p poison1 etyp2 poison2 pred2
              ctx res1 cursor bn fuel')
          fs' (r.nextTag', r.nextLoc') r.nextBind' with _ | ⟨rs'⟩
      <;> simp [hrest] at htc
    obtain ⟨res, _L, hjoin, rfl⟩ : ∃ joined L, joinTypeResults ctx r rs' = .ok joined ∧
        res = { joined with tagLog' := L } := by
      cases hj : joinTypeResults ctx r rs' with
      | error e => simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
      | ok joined =>
          simp [pure, Except.pure, hj, Functor.map, Except.map] at htc
          exact ⟨joined, _, rfl, htc.symm⟩
    have h_fuel : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
    have hcte2' : typecheck ctx e2 fuel' = .ok res2 := by
      simpa [typecheck] using hcte2
    have IH2 := IH fuel' h_fuel e2 ctx res2 hcte2'
    have htce1' : typecheck ctx' e1 fuel' = .ok res1 := by
      simpa [typecheck] using htce1
    have IH1 := IH fuel' h_fuel e1 ctx' res1 htce1'
    have IH' :
        ∀ m < fuel', ∀ (e : Expr) (ctx'' : TypeContext) (res' : TypeResult),
          typecheck ctx'' e m = .ok res' → ctx''.nextLoc ≤ res'.nextLoc' := by
      intro m hm e ctx'' res' htc'
      exact IH m (Nat.lt_trans hm h_fuel) e ctx'' res' htc'
    have happly_old :
        applyPFnTClosure f st1 st2 p poison1 etyp2 poison2 pred2 ctx res1 fuel' = .ok r := by
      unfold applyPFnTClosure
      unfold applyPFnTClosureAtCursor at happly
      simpa using happly
    have h_r : res1.nextLoc' ≤ r.nextLoc' := by
      unfold applyPFnTClosure at happly_old
      cases fuel' with
      | zero =>
          simp at happly_old
      | succ fuel'' =>
          cases f with
          | regular x body env =>
              simp [bind, Except.bind] at happly_old
              cases htc_body : typecheckExpr _ _ _ with
              | error _ =>
                  rw [htc_body] at happly_old
                  simp at happly_old
              | ok r3 =>
                  rw [htc_body] at happly_old
                  simp at happly_old
                  rcases hq3 : r3.qualType with ⟨etyp3, poison3, pred3⟩
                  simp [hq3] at happly_old
                  cases hsub : isErasureOf st2 { etyp := etyp3, poison := poison3, pred := pred3 } with
                  | false =>
                      rw [hsub] at happly_old
                      simp at happly_old
                  | true =>
                      rw [hsub] at happly_old
                      simp [pure, Except.pure] at happly_old
                      set ctx'' : TypeContext :=
                        { pc := joinPoison p (joinPoison ctx.pc poison1),
                          regime := res1.regime',
                          memEnv := res1.memEnv',
                          varEnv :=
                            (VarTypeEnv.ofCaptured env).update x
                              { etyp := etyp2, poison := joinPoison ctx.pc poison2, pred := pred2 },
                          bindEnv := BindEnv.bindParam env x res1.nextBind', tagEnv := res1.tagEnv',
                          nextLoc := res1.nextLoc',
                          nextTag := res1.nextTag', nextBind := res1.nextBind' + 1,
                          pureCtx := true,
                          externRegime := ctx.externRegime,
                          externRefAllowed := false,
                          declaredExternRefs := res1.declared' } with hctx''
                      have htc_body' : typecheck ctx'' body.toExpr fuel'' = .ok r3 := by
                        simpa [typecheck, hctx''] using htc_body
                      have IH_body := IH' fuel'' (Nat.lt_succ_self fuel'') body.toExpr ctx'' r3 htc_body'
                      cases happly_old
                      simpa using IH_body
          | extern id x retSpec capturedEnv declaredArgQt captures =>
              simp [bind, Except.bind] at happly_old
              -- Leading argument-condition gate: throw branch is impossible on .ok.
              split at happly_old
              · simp at happly_old
              simp only [pure, Except.pure] at happly_old
              split at happly_old
              · split at happly_old
                · simp at happly_old
                · split at happly_old
                  · simp at happly_old
                  · unfold returnSpecToQTyp at happly_old
                    split at happly_old
                    · simp at happly_old
                    · rename_i v hret
                      split at happly_old
                      · exact nomatch happly_old
                      injection happly_old with happly_old
                      cases happly_old
                      have hnl : v.2 = res1.nextLoc' := by
                        have h : returnSpecToQTyp _ _ _ res1.nextLoc' = Except.ok v := hret
                        exact returnSpecToQTyp_preserves_nextLoc _ _ _ _ _ h
                      exact _root_.le_of_eq hnl.symm
              · split at happly_old
                · simp at happly_old
                · injection happly_old with happly_old
                  cases happly_old
                  simp
              · split at happly_old
                · simp at happly_old
                · injection happly_old with happly_old
                  cases happly_old
                  simp
    have h_join :
        res.nextLoc' =
          List.max (r.nextLoc' :: rs'.map TypeResult.nextLoc') (by intro h; cases h) :=
      joinTypeResults_nextLoc_eq_max ctx r rs' res hjoin
    have h_r_le_res : r.nextLoc' ≤ res.nextLoc' := by
      have h_r_le_max :
          r.nextLoc' ≤
            List.max (r.nextLoc' :: rs'.map TypeResult.nextLoc') (by intro h; cases h) := by
        apply List.le_max_of_mem
        simp
      simpa [h_join] using h_r_le_max
    calc
      ctx.nextLoc ≤ res2.nextLoc' := IH2
      _ = ctx'.nextLoc := by simp [hctx']
      _ ≤ res1.nextLoc' := IH1
      _ ≤ r.nextLoc' := h_r
      _ ≤ res.nextLoc' := h_r_le_res

private lemma typecheckUnaryOp_nextLoc_mono (ctx : TypeContext) (op : UnaryOp) (e : Expr) (fuel : Nat) (res : TypeResult)
    (IH : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc') :
  typecheckUnaryOp ctx op e fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  have hstruct := typecheckUnaryOp_structure ctx op e fuel res htc
  rcases hstruct with ⟨result1, _result_etyp, htc1, _hop, _hmem, _htag, hnextloc, _hnexttag, _⟩
  cases fuel with
  | zero => unfold typecheckUnaryOp at htc; simp at htc
  | succ fuel' =>
      have h_fuel : fuel' < fuel'.succ := Nat.lt_succ_self fuel'
      have htc1_simp : typecheckExpr ctx e fuel' = .ok result1 := by simpa using htc1
      have IH1 := IH fuel' h_fuel e ctx result1 htc1_simp
      calc ctx.nextLoc
        _ ≤ result1.nextLoc' := IH1
        _ = res.nextLoc' := hnextloc.symm

private lemma surfaceSpecToQTyp_nextLoc_mono
  (typ : Typ) (poison : Bool) (pred : Predicate)
  (ctx : TypeContext) (result : QTyp × TypeContext) :
  surfaceSpecToQTyp typ poison pred ctx = .ok result →
  ctx.nextLoc ≤ result.2.nextLoc := by
  intro h
  unfold surfaceSpecToQTyp at h
  cases typ with
  | int | bool | unit | string =>
      simp [bind, Except.bind, pure, Except.pure] at h
      have hs : result.2 = ctx := (congrArg Prod.snd h).symm
      simp [hs]
  | ref t =>
      cases t with
      | int =>
          simp [bind, Except.bind] at h
      | bool | unit | string | ref _ | arrow _ _ =>
          simp [bind, Except.bind] at h
  | arrow _ _ =>
      simp [bind, Except.bind] at h

-- Main induction for `typecheck_nextLoc_mono`: nextLoc is monotone.
private lemma typecheck_nextLoc_mono_main : ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
  typecheck ctx e fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro ctx e fuel res htc
  revert ctx e res htc
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
    intro ctx e res htc
    have IH_converted : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      ctx'.nextLoc ≤ res'.nextLoc' := by
      intro m h_lt e' ctx' res' htc'
      exact IH m h_lt ctx' e' res' htc'
    unfold typecheck at htc
    cases fuel with
    | zero =>
        unfold typecheckExpr at htc
        simp at htc
    | succ fuel' =>
        unfold typecheckExpr at htc
        have IH_fuel' : ∀ m < fuel', ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
          typecheck ctx' e m = .ok res' →
          ctx'.nextLoc ≤ res'.nextLoc' := by
          intro m h_lt e' ctx' res' htc'
          have h_lt' : m < fuel' + 1 := Nat.lt_of_lt_of_le h_lt (Nat.le_succ fuel')
          exact IH_converted m h_lt' e' ctx' res' htc'
        unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
        cases e with
        | num _n | bool _b | unit | str _s =>
            simp at htc
            injection htc with h_eq
            subst h_eq
            exact le_rfl
        | var x =>
            simp at htc
            exact typecheckVar_nextLoc_mono ctx x res htc
        | fn x st1 body st2 =>
            have hfn := typecheckFn_ok_eq htc; subst hfn
            exact le_rfl
        | pfn x st1 body st2 =>
            unfold typecheckPfn at htc
            simp [Bind.bind, Except.bind] at htc
            cases h_topexpr : body.toPExpr with
            | error _ =>
                simp [h_topexpr] at htc
            | ok _ =>
                simp [h_topexpr] at htc
                injection htc with h_eq
                subst h_eq
                exact le_rfl
        | externVal typ poison pred =>
            have h0ok := typecheckExternVal_ok_declSite htc
            simp only [typecheckExternVal] at htc
            rw [h0ok] at htc
            simp [Bind.bind, Except.bind, pure, Except.pure] at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            cases htc
            rename_i _surf _heqSurf _ _ _
            exact surfaceSpecToQTyp_nextLoc_mono _ _ _ _ _ _heqSurf
        | externFn id arg argTyp argPoison argPred retSpec effects =>
            obtain ⟨argQt, _, hres⟩ :=
              typecheckExternFn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec effects res htc
            rw [hres]
        | externPfn id arg argTyp argPoison argPred retSpec =>
            obtain ⟨argQt, _, hres⟩ :=
              typecheckExternPfn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec res htc
            rw [hres]
        | externRef _id _rp _rpred _cp _cpred =>
            simp at htc
            have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
            subst hres
            exact Nat.le_succ ctx.nextLoc
        | op e1 op e2 =>
            simp at htc
            exact typecheckOp_nextLoc_mono ctx e1 e2 fuel' op res IH_fuel' htc
        | unaryop op e1 =>
            simp at htc
            exact typecheckUnaryOp_nextLoc_mono ctx op e1 fuel' res IH_fuel' htc
        | ite e1 e2 e3 =>
            simp at htc
            exact typecheckIf_nextLoc_mono ctx e1 e2 e3 fuel' res IH_fuel' htc
        | newRef e1 =>
            simp at htc
            exact typecheckNewRef_nextLoc_mono ctx e1 fuel' res IH_fuel' htc
        | assign e1 e2 =>
            simp at htc
            exact typecheckAssign_nextLoc_mono ctx e1 e2 fuel' res IH_fuel' htc
        | deref e1 =>
            simp at htc
            exact typecheckDeref_nextLoc_mono ctx e1 fuel' res IH_fuel' htc
        | seq e1 e2 =>
            simp at htc
            exact typecheckSeq_nextLoc_mono ctx e1 e2 fuel' res IH_fuel' htc
        | vlet x e1 e2 =>
            simp at htc
            exact typecheckVlet_nextLoc_mono ctx x e1 e2 fuel' res IH_fuel' htc
        | app e1 e2 =>
            simp at htc
            exact typecheckApp_nextLoc_mono ctx e1 e2 fuel' res IH_fuel' htc

-- `nextLoc` is monotone for successful typechecking: typing never decreases the fresh-location supply.
-- This is analogous to typecheck_nextTag_mono but for memory locations.
lemma typecheck_nextLoc_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  typecheck ctx e fuel = .ok res →
  ctx.nextLoc ≤ res.nextLoc' := by
  intro htc
  exact typecheck_nextLoc_mono_main ctx e fuel res htc

-- ================================================================
-- Declared extern-ref set: monotonicity and no-declare equality
-- (serial threading; see `doc/externs.md`, `@21`)
-- ================================================================

/-- Both `declared'` facts carried through the fuel induction: ids declared on
    entry survive typechecking (membership monotonicity), and in contexts where
    `extern ref` is disallowed the declared set is unchanged. -/
private def DeclaredFacts (ctx : TypeContext) (res : TypeResult) : Prop :=
  (∀ id, id ∈ ctx.declaredExternRefs → id ∈ res.declared') ∧
  (ctx.externRefAllowed = false → res.declared' = ctx.declaredExternRefs)

/-- `typecheckVar` returns the entry declared set unchanged. -/
private lemma typecheckVar_declared'_eq (ctx : TypeContext) (x : Name) (res : TypeResult) :
  typecheckVar ctx x = .ok res →
  res.declared' = ctx.declaredExternRefs := by
  intro htc
  unfold typecheckVar at htc
  cases h_lookup : ctx.varEnv.lookup x with
  | none =>
      simp [h_lookup] at htc
  | some qt =>
      simp [h_lookup] at htc
      cases qt with
      | mk etyp poison pred =>
          cases pred with
          | noPred =>
              simp at htc
              injection htc with h_eq
              subst h_eq
              rfl
          | guardOnly k =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
          | guardClosure k _ _ _ =>
              simp at htc
              cases hft : etyp.isFunctionType with
              | true =>
                  simp [hft, throw] at htc
                  cases htc
              | false =>
                  simp [hft] at htc
                  cases htagopt : ctx.tagEnv.get? k with
                  | none =>
                      have htagopt' : ctx.tagEnv[k]? = none := by
                        simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                      simp [htagopt', pure, Except.pure] at htc
                      cases htc
                      rfl
                  | some tv =>
                      cases tv with
                      | mk b deps =>
                          have htagopt' : ctx.tagEnv[k]? = some ⟨b, deps⟩ := by
                            simpa [Std.ExtTreeMap.get?_eq_getElem?] using htagopt
                          simp [htagopt'] at htc
                          cases b with
                          | true =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl
                          | false =>
                              simp [pure, Except.pure] at htc
                              cases htc
                              rfl

/-- `typecheckOp` threads the declared set serially and returns the second
    operand's set. -/
private lemma typecheckOp_declared'_eq (ctx : TypeContext) (e1 e2 : Expr) (op : Op) (fuel : Nat)
    (res : TypeResult) :
  typecheckOp ctx e1 e2 fuel op = .ok res →
  ∃ (result1 result2 : TypeResult),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    typecheckExpr (updateCtxFromResult ctx result1) e2 (fuel - 1) = .ok result2 ∧
    res.declared' = result2.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
      simp [typecheckOp] at h_typecheck
  | succ fuel' =>
      unfold typecheckOp at h_typecheck
      simp at h_typecheck
      cases h_tc1_result : typecheckExpr ctx e1 fuel' with
      | ok result1 =>
          simp [h_tc1_result, bind, Except.bind] at h_typecheck
          match h_qt1 : result1.qualType with
          | QTyp.mk etyp1 p1 pred1 =>
              rw [h_qt1] at h_typecheck
              cases h_tc2_result : typecheckExpr (updateCtxFromResult ctx result1) e2 fuel' with
              | ok result2 =>
                  have h_tc2_orig := h_tc2_result
                  simp only [updateCtxFromResult] at h_tc2_result
                  rw [h_tc2_result] at h_typecheck
                  simp only [pure, Except.pure] at h_typecheck
                  match h_qt2 : result2.qualType with
                  | QTyp.mk etyp2 p2 pred2 =>
                      rw [h_qt2] at h_typecheck
                      simp at h_typecheck
                      cases h_opEType_result : opEType? op etyp1 etyp2 with
                      | some result_etyp =>
                          simp [h_opEType_result] at h_typecheck
                          simp only [Nat.add_sub_cancel]
                          rw [← h_typecheck]
                          exact ⟨result1, result2, h_tc1_result, h_tc2_orig, rfl⟩
                      | none =>
                          simp [h_opEType_result] at h_typecheck
              | error _msg2 =>
                  have hctx : updateCtxFromResult ctx result1 = { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' } := by simp only [updateCtxFromResult]
                  rw [hctx] at h_tc2_result
                  simp only [h_tc2_result] at h_typecheck
                  exact absurd h_typecheck (fun h => by injection h)
      | error _msg =>
          simp [h_tc1_result, bind, Except.bind] at h_typecheck

/-- `typecheckUnaryOp` keeps the operand's declared set. -/
private lemma typecheckUnaryOp_declared'_eq (ctx : TypeContext) (op : UnaryOp) (e1 : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckUnaryOp ctx op e1 fuel = .ok res →
  ∃ (result1 : TypeResult),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    res.declared' = result1.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
      simp [typecheckUnaryOp] at h_typecheck
  | succ fuel' =>
      unfold typecheckUnaryOp at h_typecheck
      simp at h_typecheck
      cases h_tc1_result : typecheckExpr ctx e1 fuel' with
      | ok result1 =>
          simp [h_tc1_result, bind, Except.bind] at h_typecheck
          match h_qt1 : result1.qualType with
          | QTyp.mk etyp1 p1 pred1 =>
              rw [h_qt1] at h_typecheck
              cases h_opEType_result : opUnaryEType? op etyp1 with
              | some result_etyp =>
                  simp [h_opEType_result] at h_typecheck
                  injection h_typecheck with h_res_eq
                  subst h_res_eq
                  simp only [Nat.add_sub_cancel]
                  exact ⟨result1, h_tc1_result, rfl⟩
              | none =>
                  simp [h_opEType_result] at h_typecheck
      | error _msg =>
          simp [h_tc1_result, bind, Except.bind] at h_typecheck

/-- `typecheckNewRef` keeps the operand's declared set (fresh-location
    allocation does not touch it). -/
private lemma typecheckNewRef_declared'_eq (ctx : TypeContext) (e1 : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckNewRef ctx e1 fuel = .ok res →
  ∃ (result1 : TypeResult),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    res.declared' = result1.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
    unfold typecheckNewRef at h_typecheck
    simp at h_typecheck
  | succ fuel' =>
    unfold typecheckNewRef at h_typecheck
    simp at h_typecheck
    simp [bind, Except.bind] at h_typecheck
    cases h_tc1 : typecheckExpr ctx e1 fuel' with
    | ok result1 =>
      simp [h_tc1] at h_typecheck
      cases h_qt1 : result1.qualType with
      | mk etyp poison pred =>
        rw [h_qt1] at h_typecheck
        simp at h_typecheck
        split at h_typecheck
        · simp [pure, Except.pure, freshTLocRes] at h_typecheck
          simp only [Nat.add_sub_cancel]
          refine ⟨result1, h_tc1, ?_⟩
          have hd := congrArg TypeResult.declared' h_typecheck
          simpa using hd.symm
        · simp [Functor.map, Except.map] at h_typecheck
    | error _err =>
      simp [h_tc1] at h_typecheck

/-- `typecheckAssign` threads the declared set serially and returns the
    right-hand side's set. -/
private lemma typecheckAssign_declared'_eq (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckAssign ctx e1 e2 fuel = .ok res →
  ∃ (result1 result2 : TypeResult),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    typecheckExpr { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' } e2 (fuel - 1) = .ok result2 ∧
    res.declared' = result2.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
      unfold typecheckAssign at h_typecheck
      simp at h_typecheck
  | succ fuel' =>
      unfold typecheckAssign at h_typecheck
      simp at h_typecheck
      simp [bind, Except.bind] at h_typecheck
      cases h_tc1 : typecheckExpr ctx e1 fuel' with
      | ok result1 =>
          simp [h_tc1] at h_typecheck
          cases h_qt1 : result1.qualType with
          | mk etyp1 p1 pred1 =>
              rw [h_qt1] at h_typecheck
              simp at h_typecheck
              cases etyp1 <;> simp at h_typecheck
              rename_i ls
              cases h_tc2 : typecheckExpr { ctx with memEnv := result1.memEnv', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind', regime := result1.regime', declaredExternRefs := result1.declared' } e2 fuel' with
              | ok result2 =>
                  rw [h_tc2] at h_typecheck
                  simp at h_typecheck
                  cases h_qt2 : result2.qualType with
                  | mk etyp2 p2 pred2 =>
                      rw [h_qt2] at h_typecheck
                      simp at h_typecheck
                      split at h_typecheck
                      · simp [pure, Except.pure] at h_typecheck
                        simp only [Nat.add_sub_cancel]
                        refine ⟨result1, result2, h_tc1, h_tc2, ?_⟩
                        have hd := congrArg TypeResult.declared' h_typecheck
                        simpa using hd.symm
                      · simp [Functor.map, Except.map] at h_typecheck
              | error _err =>
                  rw [h_tc2] at h_typecheck
                  simp at h_typecheck
      | error _err =>
          simp [h_tc1] at h_typecheck

/-- `typecheckDeref` keeps the operand's declared set in every branch. -/
private lemma typecheckDeref_declared'_eq (ctx : TypeContext) (e : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckDeref ctx e fuel = .ok res →
  ∃ (result1 : TypeResult),
    typecheckExpr ctx e (fuel - 1) = .ok result1 ∧
    res.declared' = result1.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
      unfold typecheckDeref at h_typecheck
      simp at h_typecheck
  | succ fuel' =>
      unfold typecheckDeref at h_typecheck
      simp at h_typecheck
      simp [bind, Except.bind] at h_typecheck
      cases h_tc1 : typecheckExpr ctx e fuel' with
      | ok result1 =>
          simp [h_tc1] at h_typecheck
          simp only [Nat.add_sub_cancel]
          refine ⟨result1, h_tc1, ?_⟩
          cases h_qt : result1.qualType with
          | mk etyp poisonRef predRef =>
              rw [h_qt] at h_typecheck
              simp at h_typecheck
              cases etyp <;> simp at h_typecheck
              split at h_typecheck
              · contradiction
              · split at h_typecheck
                · contradiction
                · split at h_typecheck
                  · simp [pure, Except.pure] at h_typecheck
                    cases h_typecheck; rfl
                  · split at h_typecheck
                    · simp [pure, Except.pure] at h_typecheck
                      cases h_typecheck; rfl
                    · split at h_typecheck <;> simp [pure, Except.pure] at h_typecheck <;> cases h_typecheck <;> rfl
                    · split at h_typecheck <;> simp [pure, Except.pure] at h_typecheck <;> cases h_typecheck <;> rfl
      | error _err =>
          simp [h_tc1] at h_typecheck

/-- `typecheckVlet` threads the declared set serially and returns the body's
    set. -/
private lemma typecheckVlet_declared'_eq (ctx : TypeContext) (x : Name) (e1 e2 : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckVlet ctx x e1 e2 fuel = .ok res →
  ∃ (result1 result2 : TypeResult),
    typecheckExpr ctx e1 (fuel - 1) = .ok result1 ∧
    typecheckExpr { ctx with memEnv := result1.memEnv', varEnv := ctx.varEnv.update x result1.qualType, bindEnv := ctx.bindEnv.insert x result1.nextBind', tagEnv := result1.tagEnv', nextLoc := result1.nextLoc', nextTag := result1.nextTag', nextBind := result1.nextBind' + 1, regime := result1.regime', declaredExternRefs := result1.declared' } e2 (fuel - 1) = .ok result2 ∧
    res.declared' = result2.declared' := by
  intro h_typecheck
  cases fuel with
  | zero =>
      unfold typecheckVlet at h_typecheck
      simp at h_typecheck
  | succ fuel' =>
      unfold typecheckVlet at h_typecheck
      simp only [Nat.add_sub_cancel]
      cases h_shadow : ctx.varEnv.lookup x with
      | none =>
          simp [h_shadow] at h_typecheck
          simp [bind, Except.bind] at h_typecheck
          cases h_tc1 : typecheckExpr ctx e1 fuel' with
          | ok result1 =>
              simp [h_tc1] at h_typecheck
              cases h_tc2 :
                typecheckExpr
                    { ctx with memEnv := result1.memEnv', varEnv := ctx.varEnv.update x result1.qualType, bindEnv := ctx.bindEnv.insert x result1.nextBind',
                               tagEnv := result1.tagEnv', nextLoc := result1.nextLoc',
                               nextTag := result1.nextTag', nextBind := result1.nextBind' + 1, regime := result1.regime',
                               declaredExternRefs := result1.declared' }
                    e2 fuel' with
              | ok result2 =>
                  simp [h_tc2] at h_typecheck
                  cases h_qt2 : result2.qualType with
                  | mk _etyp2 p2 pred2 =>
                      rw [h_qt2] at h_typecheck
                      simp at h_typecheck
                      simp [pure, Except.pure] at h_typecheck
                      refine ⟨result1, result2, rfl, h_tc2, ?_⟩
                      have hd := congrArg TypeResult.declared' h_typecheck
                      simpa using hd.symm
              | error _err =>
                  simp [h_tc2] at h_typecheck
          | error _err =>
              simp [h_tc1] at h_typecheck
      | some qt_outer =>
          simp [h_shadow] at h_typecheck
          cases h_pred : qt_outer.pred with
          | guardClosure k _ _ _ =>
              simp [h_pred] at h_typecheck
              cases h_regime : (ctx.regime.lookup? k).isSome with
              | true =>
                  simp [h_regime] at h_typecheck
                  contradiction
              | false =>
                  simp [h_regime] at h_typecheck
                  simp [bind, Except.bind] at h_typecheck
                  cases h_tc1 : typecheckExpr ctx e1 fuel' with
                  | ok result1 =>
                      simp [h_tc1] at h_typecheck
                      cases h_tc2 :
                        typecheckExpr
                            { ctx with memEnv := result1.memEnv', varEnv := ctx.varEnv.update x result1.qualType, bindEnv := ctx.bindEnv.insert x result1.nextBind',
                                       tagEnv := result1.tagEnv', nextLoc := result1.nextLoc',
                                       nextTag := result1.nextTag', nextBind := result1.nextBind' + 1, regime := result1.regime',
                                       declaredExternRefs := result1.declared' }
                            e2 fuel' with
                      | ok result2 =>
                          simp [h_tc2] at h_typecheck
                          cases h_qt2 : result2.qualType with
                          | mk _etyp2 p2 pred2 =>
                              rw [h_qt2] at h_typecheck
                              simp at h_typecheck
                              simp [pure, Except.pure] at h_typecheck
                              refine ⟨result1, result2, rfl, h_tc2, ?_⟩
                              have hd := congrArg TypeResult.declared' h_typecheck
                              simpa using hd.symm
                      | error _err =>
                          simp [h_tc2] at h_typecheck
                  | error _err =>
                      simp [h_tc1] at h_typecheck
          | guardOnly _ =>
              simp [h_pred] at h_typecheck
              simp [bind, Except.bind] at h_typecheck
              cases h_tc1 : typecheckExpr ctx e1 fuel' with
              | ok result1 =>
                  simp [h_tc1] at h_typecheck
                  cases h_tc2 :
                    typecheckExpr
                        { ctx with memEnv := result1.memEnv', varEnv := ctx.varEnv.update x result1.qualType, bindEnv := ctx.bindEnv.insert x result1.nextBind',
                                   tagEnv := result1.tagEnv', nextLoc := result1.nextLoc',
                                   nextTag := result1.nextTag', nextBind := result1.nextBind' + 1, regime := result1.regime',
                                   declaredExternRefs := result1.declared' }
                        e2 fuel' with
                  | ok result2 =>
                      simp [h_tc2] at h_typecheck
                      cases h_qt2 : result2.qualType with
                      | mk _etyp2 p2 pred2 =>
                          rw [h_qt2] at h_typecheck
                          simp at h_typecheck
                          simp [pure, Except.pure] at h_typecheck
                          refine ⟨result1, result2, rfl, h_tc2, ?_⟩
                          have hd := congrArg TypeResult.declared' h_typecheck
                          simpa using hd.symm
                  | error _err =>
                      simp [h_tc2] at h_typecheck
              | error _err =>
                  simp [h_tc1] at h_typecheck
          | noPred =>
              simp [h_pred] at h_typecheck
              simp [bind, Except.bind] at h_typecheck
              cases h_tc1 : typecheckExpr ctx e1 fuel' with
              | ok result1 =>
                  simp [h_tc1] at h_typecheck
                  cases h_tc2 :
                    typecheckExpr
                        { ctx with memEnv := result1.memEnv', varEnv := ctx.varEnv.update x result1.qualType, bindEnv := ctx.bindEnv.insert x result1.nextBind',
                                   tagEnv := result1.tagEnv', nextLoc := result1.nextLoc',
                                   nextTag := result1.nextTag', nextBind := result1.nextBind' + 1, regime := result1.regime',
                                   declaredExternRefs := result1.declared' }
                        e2 fuel' with
                  | ok result2 =>
                      simp [h_tc2] at h_typecheck
                      cases h_qt2 : result2.qualType with
                      | mk _etyp2 p2 pred2 =>
                          rw [h_qt2] at h_typecheck
                          simp at h_typecheck
                          simp [pure, Except.pure] at h_typecheck
                          refine ⟨result1, result2, rfl, h_tc2, ?_⟩
                          have hd := congrArg TypeResult.declared' h_typecheck
                          simpa using hd.symm
                  | error _err =>
                      simp [h_tc2] at h_typecheck
              | error _err =>
                  simp [h_tc1] at h_typecheck

/-- `joinTypeResults` pins the joined declared set to the first member's. -/
private lemma joinTypeResults_declared'_eq
  (ctx : TypeContext) (r : TypeResult) (rs : List TypeResult) (res : TypeResult) :
    joinTypeResults ctx r rs = .ok res →
    res.declared' = r.declared' := by
  intro hjoin
  let joinStep :
      (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) →
        TypeResult → Except String (ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) :=
    fun (acc : ETyp × MemoryTypeEnv × Poison × Predicate × TagEnv × Regime × Loc × Tag) (result : TypeResult) =>
      match result.qualType with
      | ⟨resEtyp, resPoison, resPred⟩ =>
          Except.ok
            (joinETyps acc.1 resEtyp acc.2.2.1 resPoison,
              joinMemEnvsStrong acc.2.1 result.memEnv',
              joinPoison acc.2.2.1 resPoison,
              joinPredicates acc.2.2.2.1 resPred,
              joinTagEnvs acc.2.2.2.2.1 result.tagEnv',
              joinRegimes acc.2.2.2.2.2.1 result.regime',
              max acc.2.2.2.2.2.2.1 result.nextLoc',
              max acc.2.2.2.2.2.2.2 result.nextTag')
  cases hqt : r.qualType with
  | mk etyp poison pred =>
      simp [joinTypeResults, hqt, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw, TypecheckM] at hjoin
      cases hcheck :
          (List.foldlM
      (fun x result =>
        match result.qualType with
        | { etyp := resEtyp, poison := _resP, pred := _resPred } =>
          if beqETypSignature etyp resEtyp = false then
            Except.error
              (toString "Closure alternatives produced incompatible result types: " ++ toString (repr etyp) ++
                  toString " vs " ++
                toString (repr resEtyp))
          else Except.ok ())
      () rs : Except String Unit) with
      | error err =>
          erw [hcheck] at hjoin
          simp at hjoin
      | ok _ =>
          erw [hcheck] at hjoin
          simp at hjoin
          cases hfold :
              List.foldlM joinStep
                (etyp, r.memEnv', poison, pred, r.tagEnv', r.regime', r.nextLoc', r.nextTag') rs with
          | error err =>
              erw [hfold] at hjoin
              simp at hjoin
          | ok a =>
              erw [hfold] at hjoin
              simp at hjoin
              subst res
              simp

/-- Every successful `applyFnTClosure` pins the result's declared set to the
    pre-application one (bodies run with `externRefAllowed := false`). -/
private lemma applyFnTClosure_declared'_eq
    (tcl : FnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat) :
    applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
    r2.declared' = r1.declared' := by
  intro happly
  cases tcl with
  | regular x body env =>
    unfold applyFnTClosure at happly
    cases fuel <;> simp at happly
    simp [bind, Except.bind] at happly
    rcases htc : typecheckExpr _ _ _ with _ | ⟨r⟩
      <;> rw [htc] at happly
      <;> simp at happly
    rcases hqt : r.qualType with ⟨etyp, poison, pred⟩
    simp [hqt] at happly
    rcases hsub : isErasureOf st2 _
      <;> rw [hsub] at happly
      <;> simp at happly
    · simp [Functor.map, Except.map] at happly
    · simp [pure, Except.pure] at happly
      subst r2
      rfl
  | extern id x retSpec effects capturedEnv declaredArgQt captures =>
    unfold applyFnTClosure at happly
    cases fuel with
    | zero => simp at happly
    | succ n =>
        simp only [bind, Except.bind] at happly
        split at happly
        · exact nomatch happly
        simp only [pure, Except.pure] at happly
        split at happly
        · exact nomatch happly
        · next tmRes hcollect =>
          obtain ⟨tm, nt'⟩ := tmRes
          split at happly
          · exact nomatch happly
          · split at happly
            · -- ExternReturn.simple
              split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                · split at happly
                  · exact nomatch happly
                  cases happly
                  rfl
            · -- ExternReturn.nestedFn
              split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                cases happly
                rfl
            · -- ExternReturn.nestedPfn
              split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                cases happly
                rfl

/-- Cursor variant of `applyFnTClosure_declared'_eq`. -/
private lemma applyFnTClosureAtCursor_declared'_eq
    (tcl : FnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (cursor : Tag × Loc) (bn : Nat) (fuel : Nat) :
    applyFnTClosureAtCursor tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1
        cursor bn fuel = .ok r2 →
    r2.declared' = r1.declared' := by
  intro happly
  let rCursor : TypeResult := { r1 with nextTag' := cursor.1, nextLoc' := cursor.2, nextBind' := bn }
  have hOld :
      applyFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx rCursor fuel =
        .ok r2 := by
    unfold applyFnTClosure
    unfold applyFnTClosureAtCursor at happly
    simpa [rCursor] using happly
  simpa [rCursor] using
    applyFnTClosure_declared'_eq tcl ctx st1 st2 p p1 argEtyp argPoison argPred
      rCursor r2 fuel hOld

/-- Every successful `applyPFnTClosure` pins the result's declared set to the
    pre-application one. -/
private lemma applyPFnTClosure_declared'_eq
    (tcl : PFnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (fuel : Nat) :
    applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1 fuel = .ok r2 →
    r2.declared' = r1.declared' := by
  intro happly
  cases tcl with
  | regular x body env =>
      unfold applyPFnTClosure at happly
      cases fuel <;> simp at happly
      simp [bind, Except.bind] at happly
      rcases htc_body : typecheckExpr _ _ _ with _ | ⟨r3⟩
      · rw [htc_body] at happly
        simp at happly
      · rw [htc_body] at happly
        simp at happly
        rcases hq3 : r3.qualType with ⟨etyp3, poison3, pred3⟩
        simp [hq3] at happly
        rcases hsub : isErasureOf st2 { etyp := etyp3, poison := poison3, pred := pred3 }
        · rw [hsub] at happly
          simp [Functor.map, Except.map] at happly
        · rw [hsub] at happly
          simp [pure, Except.pure] at happly
          subst r2
          rfl
  | extern id x retSpec capturedEnv declaredArgQt captures =>
      unfold applyPFnTClosure at happly
      cases fuel with
      | zero => simp at happly
      | succ n =>
          simp only [bind, Except.bind] at happly
          split at happly
          · exact nomatch happly
          simp only [pure, Except.pure] at happly
          split at happly
          · -- ExternReturn.simple
            split at happly
            · exact nomatch happly
            · next tmRes hcollect =>
              obtain ⟨tm, nt'⟩ := tmRes
              split at happly
              · exact nomatch happly
              · split at happly
                · exact nomatch happly
                · split at happly
                  · exact nomatch happly
                  cases happly
                  rfl
          · -- ExternReturn.nestedFn
            split at happly
            · exact nomatch happly
            · cases happly
              rfl
          · -- ExternReturn.nestedPfn
            split at happly
            · exact nomatch happly
            · cases happly
              rfl

/-- Cursor variant of `applyPFnTClosure_declared'_eq`. -/
private lemma applyPFnTClosureAtCursor_declared'_eq
    (tcl : PFnTClosure) (ctx : TypeContext)
    (st1 st2 : Typ) (p p1 : Poison)
    (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
    (r1 r2 : TypeResult) (cursor : Tag × Loc) (bn : Nat) (fuel : Nat) :
    applyPFnTClosureAtCursor tcl st1 st2 p p1 argEtyp argPoison argPred ctx r1
        cursor bn fuel = .ok r2 →
    r2.declared' = r1.declared' := by
  intro happly
  let rCursor : TypeResult := { r1 with nextTag' := cursor.1, nextLoc' := cursor.2, nextBind' := bn }
  have hOld :
      applyPFnTClosure tcl st1 st2 p p1 argEtyp argPoison argPred ctx rCursor fuel =
        .ok r2 := by
    unfold applyPFnTClosure
    unfold applyPFnTClosureAtCursor at happly
    simpa [rCursor] using happly
  simpa [rCursor] using
    applyPFnTClosure_declared'_eq tcl ctx st1 st2 p p1 argEtyp argPoison argPred
      rCursor r2 fuel hOld

/-- `typecheckApp` returns the function-position result's declared set: every
    closure member pins it and the join keeps the first member's. -/
private lemma typecheckApp_declared'_eq (ctx : TypeContext) (e1 e2 : Expr) (fuel : Nat)
    (res : TypeResult) :
  typecheckApp ctx e1 e2 fuel = .ok res →
  ∃ (result2 result1 : TypeResult),
    typecheckExpr ctx e2 (fuel - 1) = .ok result2 ∧
    typecheckExpr
        { ctx with memEnv := result2.memEnv', tagEnv := result2.tagEnv', nextLoc := result2.nextLoc',
                   nextTag := result2.nextTag', nextBind := result2.nextBind', regime := result2.regime',
                   declaredExternRefs := result2.declared' }
        e1 (fuel - 1) = .ok result1 ∧
    res.declared' = result1.declared' := by
  intro htc
  cases fuel with
  | zero =>
      unfold typecheckApp at htc
      simp at htc
  | succ fuel' =>
      rcases typecheckApp_arrow_structure_full ctx e1 e2 fuel' res htc with
        ⟨result2, result1, etyp2, p2, pred2, _hq2, htc2, htc1, hbranch⟩
      simp only [Nat.add_sub_cancel]
      refine ⟨result2, result1, htc2, htc1, ?_⟩
      rcases hbranch with
        ⟨st1, st2, p, p1, tcls, results, first, rest, res, _h1, _h2, _h3, _h4, _h5, hthread, hresults, hjoin, rfl⟩ |
        ⟨st1, st2, p, p1, tcls, results, first, rest, res, _h1, _h2, _h3, _h4, hthread, hresults, hjoin, rfl⟩
      · have hfirst : first.declared' = result1.declared' := by
          have hall := applyClosuresThreaded_forall
            (P := fun r => r.declared' = result1.declared')
            (fun tcl cursor bn => applyFnTClosureAtCursor tcl st1 st2 p p1 etyp2 p2 pred2 ctx result1 cursor bn fuel')
            tcls (result1.nextTag', result1.nextLoc') result1.nextBind' results
            (fun item cursor bn r h =>
              applyFnTClosureAtCursor_declared'_eq item ctx st1 st2 p p1 etyp2 p2 pred2 result1 r cursor bn fuel' h)
            hthread
          exact hall first (by rw [hresults]; exact List.Mem.head _)
        exact (joinTypeResults_declared'_eq ctx first rest res hjoin).trans hfirst
      · have hfirst : first.declared' = result1.declared' := by
          have hall := applyClosuresThreaded_forall
            (P := fun r => r.declared' = result1.declared')
            (fun tcl cursor bn => applyPFnTClosureAtCursor tcl st1 st2 p p1 etyp2 p2 pred2 ctx result1 cursor bn fuel')
            tcls (result1.nextTag', result1.nextLoc') result1.nextBind' results
            (fun item cursor bn r h =>
              applyPFnTClosureAtCursor_declared'_eq item ctx st1 st2 p p1 etyp2 p2 pred2 result1 r cursor bn fuel' h)
            hthread
          exact hall first (by rw [hresults]; exact List.Mem.head _)
        exact (joinTypeResults_declared'_eq ctx first rest res hjoin).trans hfirst

private lemma typecheck_declared'_main : ∀ (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult),
  typecheck ctx e fuel = .ok res →
  DeclaredFacts ctx res := by
  intro ctx e fuel res htc
  revert ctx e res htc
  induction fuel using Nat.strong_induction_on with
  | _ fuel IH =>
    intro ctx e res htc
    have IH_converted : ∀ m < fuel, ∀ (e : Expr) (ctx' : TypeContext) (res' : TypeResult),
      typecheck ctx' e m = .ok res' →
      DeclaredFacts ctx' res' := by
      intro m h_lt e' ctx' res' htc'
      exact IH m h_lt ctx' e' res' htc'
    unfold typecheck at htc
    cases fuel with
    | zero =>
        unfold typecheckExpr at htc
        simp at htc
    | succ fuel' =>
        unfold typecheckExpr at htc
        have hlt : fuel' - 1 < fuel' + 1 := by omega
        have hlt' : fuel' < fuel' + 1 := Nat.lt_succ_self fuel'
        unfold typecheckInt typecheckBool typecheckUnit typecheckString at htc
        cases e with
        | num _n | bool _b | unit | str _s =>
            simp at htc
            injection htc with h_eq
            subst h_eq
            exact ⟨fun id hid => hid, fun _ => rfl⟩
        | var x =>
            simp at htc
            have hd := typecheckVar_declared'_eq ctx x res htc
            exact ⟨fun id hid => hd ▸ hid, fun _ => hd⟩
        | fn x st1 body st2 =>
            have hfn := typecheckFn_ok_eq htc; subst hfn
            exact ⟨fun id hid => hid, fun _ => rfl⟩
        | pfn x st1 body st2 =>
            unfold typecheckPfn at htc
            simp [Bind.bind, Except.bind] at htc
            cases h_topexpr : body.toPExpr with
            | error _ =>
                simp [h_topexpr] at htc
            | ok _ =>
                simp [h_topexpr] at htc
                injection htc with h_eq
                subst h_eq
                exact ⟨fun id hid => hid, fun _ => rfl⟩
        | externVal typ poison pred =>
            have h0ok := typecheckExternVal_ok_declSite htc
            simp only [typecheckExternVal] at htc
            rw [h0ok] at htc
            simp [Bind.bind, Except.bind, pure, Except.pure] at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            split at htc <;> simp (config := { failIfUnchanged := false }) at htc
            cases htc
            refine ⟨fun id hid => List.mem_cons_of_mem _ hid, fun hallow => ?_⟩
            have hok := (checkExternDeclSite_ok_allowed h0ok).2
            simp [hallow] at hok
        | externFn id arg argTyp argPoison argPred retSpec effects =>
            have hok := (checkExternDeclSite_ok_allowed (typecheckExternFn_ok_declSite htc)).2
            obtain ⟨argQt, _, hres⟩ :=
              typecheckExternFn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec effects res htc
            rw [hres]
            refine ⟨fun id' hid => List.mem_cons_of_mem _ (List.mem_append_right _ hid),
              fun hallow => ?_⟩
            simp [hallow] at hok
        | externPfn id arg argTyp argPoison argPred retSpec =>
            have hok := (checkExternDeclSite_ok_allowed (typecheckExternPfn_ok_declSite htc)).2
            obtain ⟨argQt, _, hres⟩ :=
              typecheckExternPfn_ok_res_eq ctx id arg argTyp argPoison argPred retSpec res htc
            rw [hres]
            refine ⟨fun id' hid => List.mem_cons_of_mem _ (List.mem_append_right _ hid),
              fun hallow => ?_⟩
            simp [hallow] at hok
        | externRef _id _rp _rpred _cp _cpred =>
            simp at htc
            have hres := typecheckExternRef_ok_res_eq ctx _id _rp _rpred _cp _cpred res htc
            subst hres
            refine ⟨fun id' hid => List.mem_cons_of_mem _ hid, fun hallow => ?_⟩
            exfalso
            unfold typecheckExternRef at htc
            simp [hallow, bind, Except.bind] at htc
        | op e1 op e2 =>
            simp at htc
            obtain ⟨r1, r2, htc1, htc2, hdecl⟩ := typecheckOp_declared'_eq ctx e1 e2 op fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            have h2 := IH_converted (fuel' - 1) hlt e2 _ r2 (by simpa [typecheck] using htc2)
            exact ⟨fun id hid => hdecl ▸ h2.1 id (h1.1 id hid),
                   fun hallow => hdecl.trans ((h2.2 hallow).trans (h1.2 hallow))⟩
        | unaryop op e1 =>
            simp at htc
            obtain ⟨r1, htc1, hdecl⟩ := typecheckUnaryOp_declared'_eq ctx op e1 fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            exact ⟨fun id hid => hdecl ▸ h1.1 id hid,
                   fun hallow => hdecl.trans (h1.2 hallow)⟩
        | ite e1 e2 e3 =>
            simp at htc
            have hstruct := typecheckIf_structure ctx e1 e2 e3 fuel' res htc
            rcases hstruct with h1 | h2 | hstd
            · rcases h1 with ⟨k, deps, _, _, res1, htc1, _, res2, res3, htc2, htc3,
                _, _, _, _, _, hdecl, _, _⟩
              have hP := IH_converted (fuel' - 1) hlt e1 { ctx with pureCtx := true } res1
                (by simpa [typecheck] using htc1)
              have hT := IH_converted (fuel' - 1) hlt e2 _ res2 (by simpa [typecheck] using htc2)
              have hF := IH_converted (fuel' - 1) hlt e3 _ res3 (by simpa [typecheck] using htc3)
              refine ⟨fun id hid => ?_, fun hallow => ?_⟩
              · rw [hdecl]
                exact hF.1 id (hT.1 id (hP.1 id hid))
              · rw [hdecl]
                exact (hF.2 hallow).trans ((hT.2 hallow).trans (hP.2 hallow))
            · rcases h2 with ⟨k, deps, _, _, res1, htc1, _, res2, res3, htc2, htc3,
                _, _, _, _, _, hdecl, _, _⟩
              have hP := IH_converted (fuel' - 1) hlt e1 { ctx with pureCtx := true } res1
                (by simpa [typecheck] using htc1)
              have hT := IH_converted (fuel' - 1) hlt e2 _ res2 (by simpa [typecheck] using htc2)
              have hF := IH_converted (fuel' - 1) hlt e3 _ res3 (by simpa [typecheck] using htc3)
              refine ⟨fun id hid => ?_, fun hallow => ?_⟩
              · rw [hdecl]
                exact hF.1 id (hT.1 id (hP.1 id hid))
              · rw [hdecl]
                exact (hF.2 hallow).trans ((hT.2 hallow).trans (hP.2 hallow))
            · rcases hstd with ⟨_h_std_case, res1, htc1, _hbool, res2, htc2, res3, htc3,
                _, _, _, _, _, hdecl, _, _, _⟩
              have h1 := IH_converted (fuel' - 1) hlt e1 ctx res1 (by simpa [typecheck] using htc1)
              have h2 := IH_converted (fuel' - 1) hlt e2 _ res2 (by simpa [typecheck] using htc2)
              have h3 := IH_converted (fuel' - 1) hlt e3 _ res3 (by simpa [typecheck] using htc3)
              refine ⟨fun id hid => ?_, fun hallow => ?_⟩
              · rw [hdecl]
                exact h3.1 id (h2.1 id (h1.1 id hid))
              · rw [hdecl]
                exact (h3.2 hallow).trans ((h2.2 hallow).trans (h1.2 hallow))
        | newRef e1 =>
            simp at htc
            obtain ⟨r1, htc1, hdecl⟩ := typecheckNewRef_declared'_eq ctx e1 fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            exact ⟨fun id hid => hdecl ▸ h1.1 id hid,
                   fun hallow => hdecl.trans (h1.2 hallow)⟩
        | assign e1 e2 =>
            simp at htc
            obtain ⟨r1, r2, htc1, htc2, hdecl⟩ := typecheckAssign_declared'_eq ctx e1 e2 fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            have h2 := IH_converted (fuel' - 1) hlt e2 _ r2 (by simpa [typecheck] using htc2)
            exact ⟨fun id hid => hdecl ▸ h2.1 id (h1.1 id hid),
                   fun hallow => hdecl.trans ((h2.2 hallow).trans (h1.2 hallow))⟩
        | deref e1 =>
            simp at htc
            obtain ⟨r1, htc1, hdecl⟩ := typecheckDeref_declared'_eq ctx e1 fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            exact ⟨fun id hid => hdecl ▸ h1.1 id hid,
                   fun hallow => hdecl.trans (h1.2 hallow)⟩
        | seq e1 e2 =>
            simp at htc
            obtain ⟨r1, ctx', res, htc1, hctx', htc2, rfl⟩ := typecheckSeq_structure ctx e1 e2 fuel' res htc
            subst hctx'
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            have h2 := IH_converted (fuel' - 1) hlt e2 _ res (by simpa [typecheck] using htc2)
            exact ⟨fun id hid => h2.1 id (h1.1 id hid),
                   fun hallow => (h2.2 hallow).trans (h1.2 hallow)⟩
        | vlet x e1 e2 =>
            simp at htc
            obtain ⟨r1, r2, htc1, htc2, hdecl⟩ := typecheckVlet_declared'_eq ctx x e1 e2 fuel' res htc
            have h1 := IH_converted (fuel' - 1) hlt e1 ctx r1 (by simpa [typecheck] using htc1)
            have h2 := IH_converted (fuel' - 1) hlt e2 _ r2 (by simpa [typecheck] using htc2)
            exact ⟨fun id hid => hdecl ▸ h2.1 id (h1.1 id hid),
                   fun hallow => hdecl.trans ((h2.2 hallow).trans (h1.2 hallow))⟩
        | app e1 e2 =>
            simp at htc
            obtain ⟨r2, r1, htc2, htc1, hdecl⟩ := typecheckApp_declared'_eq ctx e1 e2 fuel' res htc
            have h2 := IH_converted (fuel' - 1) hlt e2 ctx r2 (by simpa [typecheck] using htc2)
            have h1 := IH_converted (fuel' - 1) hlt e1 _ r1 (by simpa [typecheck] using htc1)
            exact ⟨fun id hid => hdecl ▸ h1.1 id (h2.1 id hid),
                   fun hallow => hdecl.trans ((h1.2 hallow).trans (h2.2 hallow))⟩

/-- The declared extern-ref set is monotone under typechecking: every id
    declared on entry is still declared in the result. -/
lemma typecheck_declared'_mono (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  typecheck ctx e fuel = .ok res →
  ∀ id, id ∈ ctx.declaredExternRefs → id ∈ res.declared' := by
  intro htc
  exact (typecheck_declared'_main ctx e fuel res htc).1

/-- Where `extern ref` declarations are disallowed (in particular inside
    fn/pfn bodies), typechecking cannot change the declared set. -/
lemma typecheck_declared'_eq_of_not_allowed (ctx : TypeContext) (e : Expr) (fuel : Nat) (res : TypeResult) :
  ctx.externRefAllowed = false →
  typecheck ctx e fuel = .ok res →
  res.declared' = ctx.declaredExternRefs := by
  intro hallow htc
  exact (typecheck_declared'_main ctx e fuel res htc).2 hallow

