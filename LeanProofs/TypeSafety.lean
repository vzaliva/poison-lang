    cases qt1 with
    | mk t1 p1 pred1 =>
        cases qt2 with
        | mk t2 p2 pred2 =>
            have ht12 : t1 = t2 := by simpa using hetyp_eq
            have hfun : f l (env1.get? l) (env2.get? l) =
