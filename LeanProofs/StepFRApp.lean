      (Value.closure x₁ (Expr.externFn id₁ y₁ argTyp₁ retSpec₁ effects₁) env₁)) :
  ∃ σcap,
    ExternCallBoundaryFnStaticSource tcls st1 id₀ x₀ y₀ argTyp₀ retSpec₀ effects₀ σcap ∧
