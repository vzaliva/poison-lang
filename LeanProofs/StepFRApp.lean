private lemma updateMemEnv_contains_of_contains_local
    (env : MemoryTypeEnv) (l l' : Loc) (qt : QTyp)
    (h : env.contains l' = true) :
    (updateMemEnv env l qt).contains l' = true := by
  by_cases hEq : l' = l
  · subst hEq
    simp [updateMemEnv, Std.ExtTreeMap.contains_insert]
  · have hCmp : compare l l' ≠ Ordering.eq := by
      intro hce
      have : l = l' := (Nat.compare_eq_eq).1 hce
      exact hEq this.symm
    simp [updateMemEnv, Std.ExtTreeMap.contains_insert, h]

private lemma list_fold_updateMemEnv_contains_of_contains_local
    (xs : List Loc) (env : MemoryTypeEnv) (l' : Loc) (qt : QTyp)
    (h : env.contains l' = true) :
    (xs.foldl (fun acc l => updateMemEnv acc l qt) env).contains l' = true := by
  induction xs generalizing env with
  | nil => simpa using h
  | cons x xs ih =>
      have h1 : (updateMemEnv env x qt).contains l' = true :=
        updateMemEnv_contains_of_contains_local env x l' qt h
      exact ih (env := updateMemEnv env x qt) h1

private lemma applyFnTClosureAtCursor_extern_mem_contains_preserved
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (result2 : TypeResult) (cursor : Tag × Loc) (fuel : Nat)
  (id : ExternId) (x : Name) (retSpec : ExternReturn)
  (effects : List Effect) (capturedEnv : CapturedVarEnv)
  (r : TypeResult)
  (happly :
    applyFnTClosureAtCursor (FnTClosure.extern id x retSpec effects capturedEnv)
      st1 st2 p p1 argEtyp argPoison argPred ctx result2 cursor fuel = .ok r) :
  ∀ l, result2.memEnv'.contains l → r.memEnv'.contains l := by
  cases fuel with
  | zero =>
      unfold applyFnTClosureAtCursor at happly
      simp at happly
  | succ fuel =>
      intro l hl
      unfold applyFnTClosureAtCursor at happly
      simp only [applyExternEffect, bind, Except.bind, pure, Except.pure] at happly
      split at happly
      · simp at happly
      · rename_i tagInfo _
        rw [List.forIn_eq_foldlM] at happly
        simp only [Functor.map, Except.map] at happly
        split at happly
        · simp at happly
        · rename_i foldResult hfoldOuter
          split at hfoldOuter
          · simp at hfoldOuter
          · rename_i foldStep hfoldStep
            simp only [Except.ok.injEq] at hfoldOuter
            have hContains : foldResult.contains l = true := by
              rw [← hfoldOuter]
              apply List.foldlM_Except_preserves_property effects (ForInStep.yield result2.memEnv') _
                (fun s => (ForInStep.value s).contains l = true) hl ?_ foldStep hfoldStep
              intro acc effect hP
              cases acc with
              | done b =>
                  intro acc' hg
                  simp only [pure, Except.pure, Except.ok.injEq] at hg
                  exact hg ▸ hP
              | yield b =>
                  intro acc' hg
                  simp only [] at hg
                  split at hg
                  · simp at hg
                  · rename_i v happlyEffect
                    simp only [Except.ok.injEq] at hg
                    subst hg
                    simp only [ForInStep.value]
                    split at happlyEffect
                    · rename_i qt _hlookup
                      split at happlyEffect
                      · rename_i ls _hls
                        split at happlyEffect
                        · exact absurd happlyEffect (by simp)
                        · rename_i v' _hresolve
                          simp only [Except.ok.injEq] at happlyEffect
                          subst happlyEffect
                          unfold LocSet.fold
                          rw [Std.ExtTreeSet.foldl_eq_foldl_toList]
                          exact list_fold_updateMemEnv_contains_of_contains_local _ b l _ hP
                      · exact absurd happlyEffect (by simp)
                    · exact absurd happlyEffect (by simp)
            split at happly
            · split at happly
              · simp at happly
              · split at happly
                · simp at happly
                · simp only [Except.ok.injEq] at happly
                  cases happly
                  exact hContains
            · simp only [Except.ok.injEq] at happly
              cases happly
              exact hContains
            · simp only [Except.ok.injEq] at happly
              cases happly
              exact hContains

private lemma applyFnTClosure_staticSource_of_threaded_mem
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (bodyState : TypeResult) (fuel : Nat)
  (tcls : List FnTClosure) (results : List TypeResult)
  (id : ExternId) (x y : Name) (argTyp : Typ)
  (retSpec : ExternReturn) (effects : List Effect) (tenv : CapturedVarEnv)
  (hthread :
    applyClosuresThreaded
      (fun tcl' cursor =>
        applyFnTClosureAtCursor tcl' st1 st2 p p1 argEtyp argPoison argPred
          ctx bodyState cursor fuel)
      tcls (bodyState.nextTag', bodyState.nextLoc') = .ok results)
  (hsource :
    ExternCallBoundaryFnStaticSource tcls st1 id x y argTyp retSpec effects tenv) :
  ∃ (cursor : Tag × Loc) (first : TypeResult),
    bodyState.nextTag' ≤ cursor.1 ∧
    bodyState.nextLoc' ≤ cursor.2 ∧
    first ∈ results ∧
    (∀ k b, first.regime'.lookup? k = some b → bodyState.regime'.lookup? k = some b) ∧
    (∀ l, bodyState.memEnv'.contains l → first.memEnv'.contains l) ∧
    (applyFnTClosureAtCursor (FnTClosure.extern id x retSpec effects tenv)
        st1 st2 p p1 argEtyp argPoison argPred ctx bodyState cursor fuel = .ok first ∨
      ∃ fuelBody result3,
        fuel = Nat.succ fuelBody ∧
        typecheckExpr
          { ctx with
            pc := joinPoison p (joinPoison p1 ctx.pc)
            memEnv := bodyState.memEnv'
            varEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured tenv) x
              ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩
            tagEnv := bodyState.tagEnv'
            nextTag := cursor.1
            nextLoc := cursor.2
            regime := bodyState.regime' }
          (Expr.externFn id y argTyp retSpec effects) fuelBody = .ok result3 ∧
        first =
          { result3 with
            qualType :=
              normalizeAppResultByProvenance (joinPoison p1 p)
                { result3.qualType with
                  poison := joinPoison p1 (joinPoison p result3.qualType.poison) } }) := by
  cases hsource with
  | externMember _harg hmem =>
      rcases applyFnTClosure_extern_of_threaded_mem
          ctx st1 st2 p p1 argEtyp argPoison argPred bodyState fuel
          tcls results id x retSpec effects tenv hthread hmem with
        ⟨cursor, first, htag, hloc, hfirst, happly⟩
      have hmono : Regime.monotoneStep bodyState.regime' first.regime' :=
        applyFnTClosureAtCursor_regime_mono
          (FnTClosure.extern id x retSpec effects tenv) ctx st1 st2 p p1
          argEtyp argPoison argPred bodyState first cursor fuel
          (fun m _hlt e ctx' res' htc =>
            by simpa [ctxAfter] using regime_monotone ctx' e m res' htc)
          happly
      exact
        ⟨cursor, first, htag, hloc, hfirst, regime_lookup_back_of_monotone hmono,
          applyFnTClosureAtCursor_extern_mem_contains_preserved
            ctx st1 st2 p p1 argEtyp argPoison argPred bodyState cursor fuel
            id x retSpec effects tenv first happly,
          Or.inl happly⟩
  | regularExternBody hmem =>
      rcases applyFnTClosure_regular_inv_of_threaded_mem
          ctx st1 st2 p p1 argEtyp argPoison argPred bodyState fuel
          tcls results x (Expr.externFn id y argTyp retSpec effects) tenv
          hthread hmem with
        ⟨cursor, fuelBody, first, result3, htag, hloc, hfirst, happly,
          _hfuel, htcBody, _hsub, hfirstEq⟩
      have hmono : Regime.monotoneStep bodyState.regime' first.regime' :=
        applyFnTClosureAtCursor_regime_mono
          (FnTClosure.regular x (Expr.externFn id y argTyp retSpec effects) tenv)
          ctx st1 st2 p p1 argEtyp argPoison argPred bodyState first cursor fuel
          (fun m _hlt e ctx' res' htc =>
            by simpa [ctxAfter] using regime_monotone ctx' e m res' htc)
          happly
      have hmem_preserve : ∀ l, bodyState.memEnv'.contains l → first.memEnv'.contains l := by
        intro l hcontains
        have hcontains3 : result3.memEnv'.contains l :=
          typecheckExpr_mem_contains_preserved
            (ctx :=
              { ctx with
                pc := joinPoison p (joinPoison p1 ctx.pc)
                memEnv := bodyState.memEnv'
                varEnv := VarTypeEnv.update (VarTypeEnv.ofCaptured tenv) x
                  ⟨argEtyp, joinPoison ctx.pc argPoison, argPred⟩
                tagEnv := bodyState.tagEnv'
                nextTag := cursor.1
                nextLoc := cursor.2
                regime := bodyState.regime' })
            (e := Expr.externFn id y argTyp retSpec effects) (fuel := fuelBody)
            (res := result3) htcBody l (by simpa using hcontains)
        simpa [hfirstEq] using hcontains3
      exact
        ⟨cursor, first, htag, hloc, hfirst, regime_lookup_back_of_monotone hmono,
          hmem_preserve, Or.inr ⟨fuelBody, result3, _hfuel, htcBody, hfirstEq⟩⟩

private lemma applyFnTClosure_staticSource_clean_back_of_p1p_true
  (hExtTyping : ExternTypingAssumptions)
  (ctx : TypeContext) (st1 st2 : Typ) (p p1 : Poison)
  (argEtyp : ETyp) (argPoison : Poison) (argPred : Predicate)
  (bodyState : TypeResult) (fuel : Nat)
  (id : ExternId) (x y : Name) (argTyp : Typ)
  (retSpec : ExternReturn) (effects : List Effect) (tenv : CapturedVarEnv)
  (cursor : Tag × Loc) (first : TypeResult) (bodyCtx : TypeContext)
  (hselected :
    applyFnTClosureAtCursor (FnTClosure.extern id x retSpec effects tenv)
        st1 st2 p p1 argEtyp argPoison argPred ctx bodyState cursor fuel = .ok first ∨
      ∃ fuelBody result3,
        fuel = Nat.succ fuelBody ∧
        typecheckExpr bodyCtx (Expr.externFn id y argTyp retSpec effects) fuelBody = .ok result3 ∧
        first =
          { result3 with
            qualType :=
              normalizeAppResultByProvenance (joinPoison p1 p)
                { result3.qualType with
                  poison := joinPoison p1 (joinPoison p result3.qualType.poison) } })
  (hp1p : joinPoison p1 p = true)
  (hlookupBack :
    ∀ k b, first.regime'.lookup? k = some b → bodyState.regime'.lookup? k = some b)
  (hbodyCtx_mem : bodyCtx.memEnv = bodyState.memEnv')
  (hbodyCtx_regime : bodyCtx.regime = bodyState.regime')
  (hbodyCtx_pc : bodyCtx.pc = true)
  (hwfBody : wfTypeContext bodyCtx) :
  ∀ l qtPre qtFirst,
    bodyState.memEnv'.lookup l = some qtPre →
    first.memEnv'.lookup l = some qtFirst →
    qtypCleanUnder first.regime' qtFirst →
    qtypCleanUnder bodyState.regime' qtPre := by
  intro l qtPre qtFirst hlookupPre hlookupFirst hcleanFirst
  cases hselected with
  | inl happlyExtern =>
      let rCursor : TypeResult :=
        { bodyState with nextTag' := cursor.1, nextLoc' := cursor.2 }
      have happlyOld :
          applyFnTClosure (FnTClosure.extern id x retSpec effects tenv)
            st1 st2 p p1 argEtyp argPoison argPred ctx rCursor fuel = .ok first := by
        unfold applyFnTClosure
        unfold applyFnTClosureAtCursor at happlyExtern
        simpa [rCursor] using happlyExtern
      have heffectPc : joinPoison p (joinPoison p1 ctx.pc) = true := by
        cases p <;> cases p1 <;> cases ctx.pc <;> simp [joinPoison] at hp1p ⊢
      cases hcleanFirst with
      | clean hpoisonFirst =>
          rcases
            applyFnTClosure_extern_ok_memEnv_poison_origin_of_effect_pc_true
              ctx st1 st2 p p1 argEtyp argPoison argPred rCursor fuel
              id x retSpec effects tenv first happlyOld heffectPc
              l qtFirst hlookupFirst hpoisonFirst with
            ⟨qtMid, hlookupMid, hpoisonMid⟩
          have hlookupMid' : bodyState.memEnv'.lookup l = some qtMid := by
            simpa [rCursor] using hlookupMid
          have hqt : qtMid = qtPre :=
            Option.some.inj (hlookupMid'.symm.trans hlookupPre)
          subst hqt
          exact qtypCleanUnder.clean hpoisonMid
      | guard k htag hkFirst hnotfun =>
          have hlookupMid :
              rCursor.memEnv'.lookup l = some qtFirst :=
            applyFnTClosure_extern_ok_memEnv_guard_origin_of_effect_pc_true
              ctx st1 st2 p p1 argEtyp argPoison argPred rCursor fuel
              id x retSpec effects tenv first happlyOld heffectPc
              l qtFirst k hlookupFirst htag
          have hlookupMid' : bodyState.memEnv'.lookup l = some qtFirst := by
            simpa [rCursor] using hlookupMid
          have hqt : qtFirst = qtPre :=
            Option.some.inj (hlookupMid'.symm.trans hlookupPre)
          subst hqt
          exact qtypCleanUnder.guard k htag (hlookupBack k true hkFirst) hnotfun
  | inr hregular =>
      rcases hregular with ⟨fuelBody, result3, _hfuel, htcBody, hfirstEq⟩
      have hlookup3 : result3.memEnv'.lookup l = some qtFirst := by
        simpa [hfirstEq] using hlookupFirst
      have hclean3 : qtypCleanUnder result3.regime' qtFirst := by
        simpa [hfirstEq] using hcleanFirst
      have hcleanBody : qtypCleanUnder bodyCtx.regime qtPre :=
        typecheckExpr_lookup_clean_back_of_pc_true hExtTyping
          (ctx := bodyCtx) (e := Expr.externFn id y argTyp retSpec effects)
          (fuel := fuelBody) (res := result3) htcBody hwfBody hbodyCtx_pc
          l qtPre qtFirst (by simpa [hbodyCtx_mem] using hlookupPre) hlookup3 hclean3
      simpa [hbodyCtx_regime] using hcleanBody

