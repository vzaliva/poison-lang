        simpa [rCursor] using happly
      have hmemEq : first.memEnv' = bodyState.memEnv' := by
        have h :=
          applyPFnTClosure_extern_memEnv_eq
            ctx st1 st2 p p1 argEtyp argPoison argPred rCursor first fuel
