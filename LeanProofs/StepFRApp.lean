    (hcwr_pre₁ : consistentWithRegime predSat preCtx.regime preCtx
      preCfg₁.memory preCfg₁.varEnv θpre₁)
    (hagree_out :
      ∀ θbody₀ θbody₁,
        wfExtendsMap θpre₀ θbody₀ →
        wfExtendsMap θpre₁ θbody₁ →
        runtimeInstantiatesCtx (ctxAfter entry₀.bodyCtx src)
