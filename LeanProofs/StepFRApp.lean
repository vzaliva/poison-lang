      ∃ σcap,
      ExternCallBoundaryFnStaticSource tcls st1 id x y argTyp retSpec effects σcap ∧
      capturedVarsTypingProperty θ σcap ρcap ∧
        ∀ cursor : Tag × Loc,
        let bodyCtx : TypeContext :=
