--! poison-interpreter --extern-regime "240=true"
-- A guard that the regime sets must have a dependency set that the typechecker
-- can compute.
--
-- The effect of `f` guards the cell of `r` with `w > zz`, and `zz` is not
-- bound, so the locations that the guard reads cannot be determined.  The
-- regime sets the guard (`--extern-regime "240=true"`), so the call `f r` is a
-- type error.  Without that regime entry the guard is not set, the call is
-- accepted and `!r` is poisoned.
let r = ref 0 in
let f = extern fn @240 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> poisoned { 1, w => (w > zz) }) } in
let u = f r in
!r
