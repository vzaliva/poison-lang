-- Rejection counterpart to extern_captures_join_memread.poison, showing that
-- the joined `!r` capture is a CONJUNCT and is not dropped by the branch join.
-- The then-branch (`@23`) declares `captures: { !r :> (int :> clean {}) }`;
-- the else-branch is a native `pfn` with no contract; the join keeps both
-- members.  Here `rr` points to a POISONED cell, so `@23`'s `!r` read
-- dependency is NOT satisfied at the `f rr` call boundary, and type checking
-- FAILS, although the native member alone would type the call (with a
-- poisoned result).
let bad = extern val @244 : (int :> poisoned {})
in
let rr = ref bad
in
let f =
  if true then
    extern pfn @23 r : (ref int :> clean {}) -> ((int :> clean {})),
      captures: { !r :> (int :> clean {}) }
  else
    pfn r : (ref int) => !r : int
in f rr
