--! poison-interpreter --extern-regime "240=true"
-- A cell that holds the bare tag of a guard recorded through an effect with a
-- poisoned target reads clean while the guard stands.
--
-- As in `examples/effect-guard-poisoned-target-write.poison`, the call `fB r`
-- records tag 1 with the locations of `s` and `b`, though the cell of the
-- poisoned `s` stores no predicate.  Nothing writes `s` or `b`, so `!r`, which
-- holds the bare tag 1, reads clean and `getv (!r)` is accepted.
-- This is a typecheck-level demonstration: `@251` has no registered runtime
-- implementation, so evaluation stops at the declaration of `y` with the
-- expected "extern id 251 not registered" error.
let r = ref 0 in
let b = ref 0 in
let y = extern val @251 : (int :> poisoned {}) in
let s = if y > 0 then ref 1 else ref 2 in
let getv = extern pfn @242 v : (int :> clean {}) -> ((int :> clean {})) in
let fB = extern fn @240 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> poisoned { 1 }), !s :> (int :> poisoned { 1, w => (w > !b) }) } in
let u = fB r in
getv (!r)
