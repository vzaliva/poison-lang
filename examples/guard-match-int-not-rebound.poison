--! poison-interpreter --extern-regime "12=false"
-- The guard of x reads the integer lo, and the test x >= lo reads the same lo:
-- lo is bound once, before the guard is made, and is not bound again before
-- the test. A variable of a base type that the guard reads must have the same
-- binding at the guard and at the test, so the guard is selected. The regime
-- gives it the value false (5 >= 10 is false): the then branch is dead and the
-- result is the clean else branch. The else branch runs.
let bad = extern pfn @19 n : (int :> clean {}) -> ((int :> poisoned {})) in
let y = bad 3 in
let lo = 10 in
let g = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned { 1, v => (v >= lo) })) in
let x = g 5 in
if x >= lo then y else 1
