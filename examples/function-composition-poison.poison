-- Function composition poison example
let sensor_value = extern val @215 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let get_sensor = fn x : unit => sensor_value : int in
let f = fn x : int => x + 1 : int in
let g = fn x : int => x + x : int in
let poisoned_input = get_sensor unit in
let i = f poisoned_input in 
let result = g i in
result 