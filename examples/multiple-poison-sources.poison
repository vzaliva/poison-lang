let sensor_value = extern val @239 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let get_sensor = fn x : unit => sensor_value : int in
let corrupted_value = extern val @240 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let get_corrupted_ptr = fn x_unit : unit => ref corrupted_value : (ref int) in

-- Demonstrates poison propagation from multiple unreliable inputs

-- Multiple poisoned sources
let sensor1  = get_sensor unit in
let sensor2_ptr = get_corrupted_ptr unit in
let result = sensor1 + 10 + !sensor2_ptr in
result 