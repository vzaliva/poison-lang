-- A guard body that applies an impure function is a type error, also on an
-- effect whose target is poisoned, which stores no predicate in the cell.
--
-- `s` is poisoned (it is chosen by the poisoned `y`), and the effect of `f`
-- guards the cell of `s` with `chk w`, where `chk` is an impure function that
-- reads `a`.  The declaration of `f` is a type error, without any regime.
let r = ref 0 in
let y = extern val @251 : (int :> poisoned {}) in
let s = if y > 0 then ref 1 else ref 2 in
let a = ref 0 in
let chk = fn u : int => u > !a : bool in
let f = extern fn @240 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !s :> (int :> poisoned { 1, w => (chk w) }) } in
f r
