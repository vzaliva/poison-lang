-- Test: Two separate externs with same literal tag index get different
-- concrete tags. Even though both use tag index 3, they are independent
-- extern specs with independent fresh tag allocation. We store both into
-- refs so both tags appear in the final MemoryTypeEnv.
let a = ref (extern val @119 : (int :> poisoned { 3, x => x >= 0 })) in
let b = ref (extern val @120 : (int :> poisoned { 3, x => x >= 0 })) in
!a + !b
