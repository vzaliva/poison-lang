--! poison-interpreter --extern-regime "240=true"
-- A guard that an extern's effect puts on a cell is recorded at the call, with
-- a dependency set that holds the written cell and the locations the guard
-- reads.
--
-- `f` writes the cell of `r` and guards its content with `w > !b`; the regime
-- asserts the guard (`--extern-regime "240=true"`), so the call records the
-- guard with the locations of `r` and `b`.  `g` then writes the cell of `b`
-- through its effect: the guard is removed from the tag environment and from
-- the regime.  The `if` is typed with both branches, and the result, which
-- joins the poisoned `y`, is poisoned.
-- This is a typecheck-level demonstration: `@240` has no registered runtime
-- implementation, so evaluation stops at the call `f r` with the expected
-- "extern id 240 not registered" error.
let r = ref 0 in
let b = ref 0 in
let bad = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned {})) in
let y = bad 3 in
let f = extern fn @240 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> poisoned { 1, w => (w > !b) }) } in
let g = extern fn @241 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> clean {}) } in
let u = f r in
let w = g b in
if !r > !b then !r else y
