-- Test: Non-singleton locset assignment uses weak update
--
-- This test verifies that when assigning to a reference with a non-singleton locset,
-- the type system uses weak update (join with existing types) rather than strong update.
--
-- Expected behaviour:
--   1. r1 and r2 start clean with value 0
--   2. r1 is poisoned by writing a faulty random value
--   3. choice has locset {l1, l2} (non-singleton)
--   4. We assign a clean value (42) to choice
--   5. After weak update, both l1 and l2 are poisoned via join
--   6. Dereferencing choice yields a poisoned int

let r1 = ref 0 in              -- r1 : ref int @ {l1}, clean
let r2 = ref 0 in              -- r2 : ref int @ {l2}, clean
(r1 := frand 0;                -- Poison r1
 let choice = if (rand 0) >= 0 then r1 else r2 in  -- choice : ref int @ {l1, l2}
 (choice := 42;                -- Weak update: join clean write with poisoned l1
  !choice))                    -- Result is poisoned (runtime updates one location)
