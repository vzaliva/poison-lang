-- Branch-join capture conjunction, memory-read (`!r`) dimension, running
-- end-to-end.
--
-- The two branches of the `if` produce pure functions of the same signature
-- `ref int -> int`.  The then-branch is the built-in memory read `@23`, which
-- declares the bang read dependency `captures: { !r :> (int :> clean {}) }`;
-- the else-branch is a native `pfn` that reads the same cell and has no
-- `captures:` contract.  The join keeps both members, so applying `f` checks
-- `@23`'s capture gate as well as typing the native body: the extern's read
-- dependency is not dropped by a join with a function that has none.
--
-- Here `rr` points to a clean cell (`ref 3`), so the `!r` dependency is
-- satisfied, type checking succeeds, and the taken branch's `@23` runs and
-- returns the dereferenced value `3`.
let rr = ref 3
in
let f =
  if true then
    extern pfn @23 r : (ref int :> clean {}) -> ((int :> clean {})),
      captures: { !r :> (int :> clean {}) }
  else
    pfn r : (ref int) => !r : int
in f rr
