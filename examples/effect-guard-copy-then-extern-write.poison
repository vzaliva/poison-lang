--! poison-interpreter --extern-regime "240=true"
-- A value copied out of a cell guarded by an effect, while the guard stands,
-- reads clean and carries no guard.
--
-- `z` is read from the cell of `r` right after the call, while the regime
-- asserts the guard: it is a clean int with no predicate.  `g b` then writes
-- `b`, which the guard `w > !b` reads: the guard leaves the tag environment
-- and the regime.  The test `z > !b` selects no guard (`z` carries none), so
-- the `if` is typed with both branches, and the result, which joins the
-- poisoned `y`, is poisoned.
-- This is a typecheck-level demonstration: `@240` has no registered runtime
-- implementation, so evaluation stops at the call `f r` with the expected
-- "extern id 240 not registered" error.
let r = ref 0 in
let b = ref 0 in
let bad = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned {})) in
let y = bad 3 in
let f = extern fn @240 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> poisoned { 1, w => (w > !b) }) } in
let g = extern fn @241 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> clean {}) } in
let u = f r in
let z = !r in
let w = g b in
if z > !b then z else y
