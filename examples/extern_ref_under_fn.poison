-- An extern declaration may not appear in a fn or pfn body (evaluate-at-most-
-- once positions only): for `extern ref`, a body re-evaluated at each
-- application would re-realize the same reserved address.  The definition of
-- `f` is rejected.
let f = fn x : int => (let r = extern ref @21 : (ref int :> clean {}), points_to: (int :> poisoned {}) in !r) : int in
f 1
