-- A fn whose body declares an extern is rejected even when it is never
-- applied: the rule is checked at the definition of the function, not only
-- when its body is typed at an application.  Compare extern_ref_under_fn.poison,
-- where the fn is applied.
let f = fn x : int => (let r = extern ref @21 : (ref int :> clean {}), points_to: (int :> poisoned {}) in !r) : int in
42
