--! poison-interpreter --regime "1=true"
-- Test: Conditional branch skipping with known regime (acceptance criterion 3).
-- In .ioFree with known regime, conditionals skip typechecking the untaken branch.
-- The untaken else has printInt (IO) which would fail in ioFree if typechecked.
-- Limitation: matchGuard requires a guard from extern or frand; both forbidden in
-- ioFree. This test exercises the regime path in normal mode. Expect: runtime
-- fails (extern has no implementation).
-- NOTE: guardClosure required (not bare guardOnly) because fresh tag allocation
-- needs a closure definition. Tag index 3 → fresh tag 1 (nextTag starts at 1).
let ret = extern val @223 : (int :> poisoned { 3, ret => ret >= 0 }) in
if ret >= 0 then 42 else (printInt 99; 42)
