--! poison-interpreter --regime "1=true"
-- The control for regime-tag-before-extern-write: the extern called before the
-- guard of tag 1 exists declares no effect, so the call writes no location and
-- tag 1 stays in the regime. The guard of `x` is interpreted and the result is
-- typed clean. `@241` has no registered implementation, so evaluation stops at
-- the call.
let h = extern fn @241 m : (int :> clean {}) -> ((int :> clean {})) in
let u = h 0 in
let g = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned { 1, v => (v >= 0) })) in
let x = g 5 in
if x >= 0 then x else 0
