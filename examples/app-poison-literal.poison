-- Issue #111: poisoned function selection with literal bodies
-- Result must be poisoned even though individual closure bodies are clean literals
let c = extern val : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let f1 = fn u : unit => 3 : int in
let f2 = fn u : unit => 4 : int in
let g = if c > 0 then f1 else f2 in
g unit
