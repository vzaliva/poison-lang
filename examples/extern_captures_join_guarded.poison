--! poison-interpreter --extern-regime "238=true"
-- Branch-join capture conjunction, GUARDED (non-`noPred`) predicate dimension.
-- The two branches of the `if` produce extern closures (`@239` and `@240`:
-- each extern id is declared at most once in a program) of the same signature
-- that capture the environment entry `a`, each under a guard-CLOSURE clean
-- dependency, but with distinct guard tags (`{ 5, ... }` vs `{ 6, ... }`).  The
-- two members stay separate in the joined `parrow` (they are not deduplicated
-- and not collapsed to `noPred`), so the `f 2` call gates on BOTH captures: the
-- contracts combine by conjunction.
--
-- `@238` (open-style) returns a poisoned int carrying a guard; `--extern-regime
-- "238=true"` activates that return tag, so the captured `a` is clean under the
-- call-site regime and carries a guard-closure predicate shape.  Both guarded
-- capture requirements are then satisfied (a declared guard-closure shape is
-- matched modulo tag identity), so type checking PASSES.  As with the other
-- guarded examples, none of these externs has a registered runtime
-- implementation, so evaluation then stops at the producer `@238`.
let openf = extern fn @238 p : (int :> clean {}) -> ((int :> poisoned { 5, v => (v >= 0) }))
in
let a = openf 0
in
let f =
  if true then
    extern pfn @239 b : (int :> clean {}) -> ((int :> clean {})),
      captures: { a :> (int :> clean { 5, v => (v >= 0) }) }
  else
    extern pfn @240 b : (int :> clean {}) -> ((int :> clean {})),
      captures: { a :> (int :> clean { 6, v => (v >= 0) }) }
in f 2
