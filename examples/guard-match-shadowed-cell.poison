--! poison-interpreter --extern-regime "12=true"
-- The guard of x reads the cell of the first a (0). A second a (10) shadows
-- it, and the test x > !a reads the second one. A variable the guard reads
-- must have the same type where the guard was made and at the test: the two
-- a are references to different cells, so the guard is not selected, the
-- branches are joined, and the result is poisoned. abs(5) = 5: the guard
-- holds (5 > 0), the test does not (5 > 10), so the else branch runs.
let a = ref 0 in
let bad = extern pfn @19 n : (int :> clean {}) -> ((int :> poisoned {})) in
let y = bad 3 in
let g = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned { 1, v => (v > !a) })) in
let x = g 5 in
let a = ref 10 in
if x > !a then 1 else y
