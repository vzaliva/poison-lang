-- Sensor processing example

let sensor1 = frand 0 in -- Type: int :> poisoned {guard 1 (y, y >=0 && y <= 0, _)} 
let sensor2 = frand 0 in  -- Type: int :> poisoned {guard 2 (z, z >=0 && z <= 0, _)} 

let f = fn x : int =>            -- Captures sensor1 with its predicate 
    if ( (sensor1 >= 0) && (sensor1 <= 0 )) then         -- Matches guard "temp" test expression 
    -- With empty R: R(1) = none, so pc = join pc p1 (conservative)
        if ( (x >=0) && (x <= 0 )) then   -- Matches guard "pressure" test expression 
        -- With empty R: R(2) = none, so pc = join pc p2 (conservative)
            sensor1 + x          -- Result poisoned due to conservative pc
        else
            -1                   -- Result poisoned due to conservative pc
    else
        -2                       -- Result poisoned due to conservative pc
    : int
in
let result = f sensor2 in        -- Application types body with predicates
result                           -- Result: int :> poisoned (due to empty regime R)




