let get_sensor = fn x : unit => frand 0 : int in

-- Sensor processing example

let sensor1 = get_sensor unit in -- Type: int :> poisoned {guard 1 (y, y >=0 && y <= 0, _)} 
let sensor2 = get_sensor unit in  -- Type: int :> poisoned {guard 2 (z, z >=0 && z <= 0, _)} 

let f = fn x : int =>            -- Captures sensor1 with its predicate 
    if sensor1 >= 0 && sensor1 <= 0 then         -- Matches guard "temp" test expression 
    -- L[1] = true, pc=false
        if x >=0 && x <= 0 then   -- Matches guard "pressure" test expression 
        -- L[1] = true, L[2] = true, pc=false
            sensor1 + x          -- Both de-poisoned: clean result
        else
        -- L[1] = true, L[2] = false, pc=false 
            -1                   -- x still poisoned
    else
    -- L[1] = false, pc=false
        -2                       -- value is clean
    : int
in
let result = f sensor2 in        -- Application types body with predicates
result                           -- Result: int :> clean




