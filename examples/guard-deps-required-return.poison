--! poison-interpreter --extern-regime "244=true"
-- The guard of an extern's return, like the guard of an effect, must have a
-- dependency set that the typechecker can compute when the regime sets it.
--
-- `h` returns a value guarded by `w > !b + zz`; `zz` is not bound, so the
-- locations that the guard reads cannot be determined.  The regime sets the
-- guard (`--extern-regime "244=true"`), so the call `h 5` is a type error.
-- With the guard `w > !b` the call is accepted and records the guard with the
-- location of `b`; the write `g b` then removes it, `t` is poisoned, and the
-- error is at `getv t`, whose argument must be clean.
let b = ref 0 in
let h = extern pfn @244 v : (int :> clean {}) -> ((int :> poisoned { 1, w => (w > !b + zz) })) in
let g = extern fn @241 q : (ref int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !q :> (int :> clean {}) } in
let getv = extern pfn @242 v : (int :> clean {}) -> ((int :> clean {})) in
let t = h 5 in
let w = g b in
getv t
