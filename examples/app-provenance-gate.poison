-- Issue #113: provenance-poisoned function clears predicate in result.
-- The function body returns a guarded value (`a` or `b`, each declared by
-- extern val : (int :> poisoned { 1, v => (v >= 0 && v <= 0) })), but since the
-- function itself is poisoned (via if-on-poisoned-condition), the guard
-- predicate must be stripped from the application result.
let sensor = extern val @203 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let a = extern val @204 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let b = extern val @205 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
let f = if sensor > 0 then
  fn x : int => a : int
else
  fn x : int => b : int
in
f 42
