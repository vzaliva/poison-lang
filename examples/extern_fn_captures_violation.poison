-- Negative call-gate case for fn-side `captures:`.
-- The impure built-in `@22` (`set_err`) declares a `captures:` read dependency
-- requiring a *clean* integer `bad`, but `bad` is bound to a poisoned value.
-- The capture contract is checked at the call boundary (`capturesSatisfied`,
-- inside `applyFnTClosureAtCursor`): the poisoned `bad` does not satisfy the
-- declared `(int :> clean {})` read dependency, so type checking REJECTS the
-- application `set_err 42` before the extern runs.  The argument `42` itself is
-- clean and would pass the argument precondition; it is the *capture* gate that
-- fails — the fn-side mirror of the pfn capture-gate rejection.
let errno   = extern ref @21 : (ref int :> clean {}), points_to: (int :> poisoned {}) in
let bad     = extern val @5  : (int :> poisoned {}) in
let set_err = extern fn @22 n : (int :> clean {}) -> ((unit :> clean {})) ,
                effects:  { !errno :> (int :> clean {}) } ,
                captures: { bad :> (int :> clean {}) } in
let u = set_err 42 in
!errno
