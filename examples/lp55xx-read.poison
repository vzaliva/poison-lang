--! poison-interpreter --extern-regime "238=true"
-- lp55xx_read example (fixed variant), with a shared guard tag between the
-- return code and the status cell. The return guard is asserted by extern id
-- (`--extern-regime "238=true"`), so the typechecker interprets whatever output
-- tag it freshly allocates for @238. The equivalent low-level form
-- `--regime "1=true"` names that tag concretely, but is allocation-order
-- dependent (see doc/poison-interpreter.md).
--
-- `status` is a local stack cell that the read writes into; `eng` is the engine
-- register (extern). The outer `if ret >= 0` checks the return code: on success
-- it de-poisons `ret` and `status`; on a failed read the else branch stops the
-- engine (`eng := NOT_READY`) and returns `ERROR`, mirroring the driver's
-- cleanup path. Both observable outputs (the engine cell and the return code)
-- are clean under either regime.
let status = ref 0 in
let eng = extern ref @234 : (ref int :> clean {}), points_to: (int :> poisoned {}) in
let ENG_STATUS_MASK = extern val @235 : (int :> clean {}) in
let NOT_READY = extern val @236 : (int :> clean {}) in
let READY = extern val @237 : (int :> clean {}) in
let ERROR = extern val @239 : (int :> clean {}) in
let OK = extern val @240 : (int :> clean {}) in

let lp55xx_read =
  extern fn @238 r : (ref int :> clean {}) -> ( (int :> poisoned { 100, ret => (ret >= 0) }) ) ,
    effects: { !r :> (int :> poisoned { 100 }) }
in

let ret = lp55xx_read status in
if ret >= 0 then
  (status := !status & ENG_STATUS_MASK;
   if !status != ENG_STATUS_MASK then
     (eng := NOT_READY; ERROR)
   else
     (eng := READY; OK))
else
  (eng := NOT_READY; ERROR)
