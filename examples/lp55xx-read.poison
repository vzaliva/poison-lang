--! poison-interpreter --extern-regime "238=true"
-- lp55xx_read example with shared guard tag between return value and status.
-- The return guard is asserted by extern id (`--extern-regime "238=true"`), so
-- the typechecker inserts whatever output tag it freshly allocates for @238.
-- The equivalent low-level form `--regime "1=true"` names that tag concretely,
-- but is allocation-order dependent (see doc/poison-interpreter.md).
let status = extern ref @233 : (ref int :> clean {}), points_to: (int :> poisoned {}) in
let eng = extern ref @234 : (ref int :> clean {}), points_to: (int :> poisoned {}) in
let ENG_STATUS_MASK = extern val @235 : (int :> clean {}) in
let NOT_READY = extern val @236 : (int :> clean {}) in
let READY = extern val @237 : (int :> clean {}) in

let lp55xx_read =
  extern fn @238 r : (ref int :> clean {}) -> ( (int :> poisoned { 100, ret => (ret >= 0) }) ) ,
    effects: { !r :> (int :> poisoned { 100 }) }
in

let ret = lp55xx_read status in
if ret >= 0 then
  (status := !status & ENG_STATUS_MASK;
   if !status != ENG_STATUS_MASK then
     eng := NOT_READY
   else
     eng := READY;
   ret)
else
  ret
