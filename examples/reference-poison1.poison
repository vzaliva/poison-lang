-- ADD Number to identifier name
-- Let / Apply 
-- Reference poison example 1: reference operations with poisoned data
let get_sensor = fn x : unit => extern val : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) : int in
let r = ref 0 in       -- Clean reference, clean data
(r := get_sensor unit;   -- Data becomes poisoned, reference stays clean
!r)                     -- Result: poisoned (from data)

