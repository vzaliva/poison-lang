-- Test: standard if path from matched guard with unknown regime.
-- frand creates a guard tag; empty regime => R(k) = none => conservative std path.
-- Then-branch allocates a ref; else-branch does not.
-- After join, the single-sided location should have noPred.
let sensor = frand 0 in
if (sensor >= 0) && (sensor <= 0) then
  let r = ref 42 in
  !r
else
  0
