--! poison-interpreter --regime "1=true"
-- `--regime "1=true"` names tag 1, the tag of the guard that `g 5` returns
-- below. The call `set_err 7` comes first and writes the cell of `errno`. Tag 1
-- has no entry in the tag environment yet, so it has no dependency set, and a
-- call that writes a location removes it from the regime, as an assignment
-- does. The guard of `x` is then not interpreted, the `if` is typed by the
-- standard rule, and the result is poisoned. With `--extern-regime "12=true"`
-- the tag gets its value where `g 5` allocates it, and the result is clean.
let errno = extern ref @21 : (ref int :> clean {}), points_to: (int :> poisoned {}) in
let set_err = extern fn @22 n : (int :> clean {}) -> ((unit :> clean {})) ,
  effects: { !errno :> (int :> clean {}) } in
let u = set_err 7 in
let g = extern pfn @12 n : (int :> clean {}) -> ((int :> poisoned { 1, v => (v >= 0) })) in
let x = g 5 in
if x >= 0 then x else 0
