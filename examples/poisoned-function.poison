-- Function defined in poisoned environment is poisoned even if applied in clean add_one

let sensor1 = extern val @241 : (int :> poisoned { 1, v => (v >= 0 && v <= 0) }) in
-- add_some is poisoned as both `if` branches depend on poisoned condition
let add_some = 
    (if sensor1 > 0 then
        fn x : int => x + 1 : int 
    else
        fn x : int => x + 2 : int)
in
-- here `pc` is not poisoned, but calling poisoned function should return poisoned result
add_some 0
