-- Test: outer and inner externs both called, each gets independent fresh
-- tags. Outer uses tag index 7 (with guardClosure), inner uses tag index 7
-- (with its own guardClosure). Despite sharing the literal index, the two
-- specs are resolved independently. We store both results into refs so
-- all tags are observable in the final MemoryTypeEnv.
let s = ref 0 in
let outer =
  extern fn @113 x : (int :> clean {}) -> (
    extern pfn @114 y : (int :> clean {}) -> ( (int :> poisoned { 7, w => w >= 0 }) )
  ) ,
    effects: { !s :> (int :> poisoned { 7, v => v >= 0 }) }
in
let inner = outer 1 in
let a = ref (inner 10) in
let b = ref (inner 20) in
!a + !b
