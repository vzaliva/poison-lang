-- Drone dual control system in poison language
-- The position control is independent from the altitude control.
-- And we can show that faulty barometer does not affect the position control.

-- Altitude threshold in millimetres (50 metres = 50000 mm)
let land_thresh = 50000 in

-- Barometer reading function (may return poisoned value)
-- Returns altitude in millimetres (0-100000 mm = 0-100 metres)
let read_barometer = fn x : unit => frand 100000 : int

-- User landing command (external input)
-- For this demo random 50/50 input is used
let read_user_land = fn x : unit => 
  if (rand 1) = 0 then true else false 
  : bool in

-- User control input for lateral position
-- Simulate user providing new lateral position
-- pos: distance in millimetres from central divider (negative = left, positive = right) 
let read_user_control = fn pos : int => 
  -- Sumulated user adjustement reading could be faulty.
  -- we using `frand` here which will return poisoned value with
  -- de-poisoning predicate
  let raw_adjustment = frand 2000 in
  if raw_adjustement >= 0 & raw_adjustement <= 2000 then
    -- since `if` condition matches de-poisoning predicate for `raw_adjustement`
    -- in this brach it will be de-poisoned
    let adjustment = raw_adjustment - 1000 in  -- -1000 to 1000 mm
    pos + adjustment 
  else
    pos -- skip faulty input
  : int in

-- Maintain altitude action
let maintain_altitude = fn x : unit => 
  printStr "[ALT] maintaining altitude"
  : unit in

-- Initiate landing action (informative only)
-- Note: This is purely for demonstration - actual descent control logic is not implemented
-- In a real system, this would trigger proper descent control with velocity management
let initiate_landing = fn alt : int => 
  printStr "[ALT] LAND from ";
  printInt (alt / 1000);  -- Convert mm to metres for display
  printStr " m (descent control not implemented)"
  : unit in

-- Hold position action
let hold_position = fn pos : int => 
  printStr "[LAT] holding position ";
  printInt pos;
  printStr " mm from center"
  : unit in

-- Altitude control logic
let altitude_control = fn user_land : bool => fn alt : int => 
  if user_land & (alt < land_thresh) then
    initiate_landing alt  -- may consume poisoned value
  else
    maintain_altitude unit  -- independent of alt when user_land = false
  : unit in

-- Main control loop using while
let n = ref 0 in
let target_pos = ref 0 in
while (!n) < 10 do
  let altitude = read_barometer unit in  -- error unchecked → poison
  let user_land = read_user_land unit in  -- external command
  altitude_control user_land altitude;  -- affected iff user_land=true
  hold_position (!target_pos);  -- position control (independent)
  let new_target = read_user_control (!target_pos) in  -- Get new target position from user
  target_pos := new_target;
  n := (!n) + 1 