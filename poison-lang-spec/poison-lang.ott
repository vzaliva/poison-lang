R(k) = none
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; join pc p1 ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; join pc p1 ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
p = join p' p''
ptcls = ptcls2 U ptcls3
