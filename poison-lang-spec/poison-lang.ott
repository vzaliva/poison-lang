pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_R_false
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc p3 { no_pred } -| G3 ; L3 ; R3

% Standard conditional typing rule - impure function result
% (used when no matching predicate found)
% When both branches return impure function types with matching surface types (ST1, ST2):
%   - Branch types T2 and T3 are both impure arrow types with the same surface types
%   - Arrow-internal poisons p' and p'' are joined
%   - Outer qualified-type poisons p2 ⊔ p3 are joined
%   - Closure sets tcls2 and tcls3 are merged via union (deduplicating closures)
%   - Guard poison p1 is also included in result poison
%   - Result: (ST1 -> ST2 # (p' ⊔ p'') tclosures (tcls2 ∪ tcls3)) :> (pc ⊔ p1 ⊔ p2 ⊔ p3)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tclosures tcls2
T3 = ST1 -> ST2 # p'' tclosures tcls3
p = join p' p''
tcls = tcls2 U tcls3
----------------------------------  :: if_std_fn
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tclosures tcls :> join pc join p1 join p2 p3 { no_pred } -| JoinG G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - pure function result
% (used when no matching predicate found)
% When both branches return pure function types with matching surface types (ST1, ST2):
%   - Branch types T2 and T3 are both pure arrow types with the same surface types
%   - Arrow-internal poisons p' and p'' are joined
%   - Outer qualified-type poisons p2 ⊔ p3 are joined
%   - Closure sets ptcls2 and ptcls3 are merged via union (deduplicating closures)
%   - Guard poison p1 is also included in result poison
%   - Result: (ST1 -> ST2 # (p' ⊔ p'') tpclosures (ptcls2 ∪ ptcls3)) :> (pc ⊔ p1 ⊔ p2 ⊔ p3)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
p = join p' p''
ptcls = ptcls2 U ptcls3
----------------------------------  :: if_std_pfn
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tpclosures ptcls :> join pc join p1 join p2 p3 { no_pred } -| JoinG G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - reference result (no predicate match)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : ref T @ LS1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : ref T @ LS2 :> p3 { P3 } -| G3 ; L3 ; R3
LS = LS1 U LS2
----------------------------------  :: if_std_ref
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ref T @ LS :> join pc join p1 join p2 p3 { no_pred } -| JoinG G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - general non-reference case (no predicate match)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_std
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p1 join p2 p3 { no_pred } -| JoinG G2 G3 ; JoinL L2 L3 ; JoinR R2 R3


%  Flow‑sensitive WHILE à la Hunt & Sands 2006 https://doi.org/10.1145/1111037.1111045

% JoinL (logical environment join) — agreement-only meet used in the while fixpoint:
%   For each tag k:
%     - if both operands map k to the same boolean b with dependency locsets LS1, LS2,
%       keep k with deps = LS1 ∪ LS2;
%     - otherwise (k absent on some side, or booleans disagree), drop k (unknown).
%   Rationale: prevents branch-/iteration-local facts from leaking across iterations,
%   composes with invalidate_deps, and ensures the sequence Li+1 = JoinL(Li, L2,i)
%   is descending and stabilises. A union that preserves single-sided or
%   contradictory facts would be unsound for de-poisoning.

% Predicate-based while typing rule (when matching predicate found)
match_guard e1 G S = k with LS
pure ; R ; indexP p i ; indexG G i ; S ; indexL L i |- e1 : bool :> indexedP p 1 i { P1 }  -| indexedG G 1 i ; indexL L i ; indexR R i
pm ; indexR R i ; join indexP p i indexedP p 1 i ; indexedG G 1 i ; S ; indexL L i[k |-> true using LS] |- e2 : unit :> indexedP p 2 i { P2 }  -| indexedG G 2 i ; indexedL L 2 i ; indexedR R 2 i
indexP p 0 = pc AND indexP p i+1 = join indexP p i indexedP p 2 i
indexG G 0 = G AND indexG G i+1 = JoinRestrict indexG G i indexedG G 2 i
indexL L 0 = L AND indexL L i+1 = JoinL indexL L i indexedL L 2 i
indexR R 0 = R AND indexR R i+1 = JoinR indexR R i indexedR R 2 i
%  "where n is the smallest natural number satisfying the two equalities above."
indexP p n+1 = indexP p n
indexG G n+1 = indexG G n
indexL L n+1 = indexL L n
indexR R n+1 = indexR R n
---------------------------------------------------------------------------  :: while_depoison
pm ; R ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexP p n { no_pred }  -| indexG G n ; indexL L n[k |-> false using LS] ; indexR R n

% Standard while typing rule (when no matching predicate found) (used as a
% fallback when match_guard fails) 
% Unlike while_depoison, `e1` is not pure and can modify G and L
pm ; indexR R i ; indexP p i ; indexG G i ; S ; indexL L i |- e1 : bool :> indexedP p 1 i { P1 }  -| indexedG G 1 i ; indexedL L 1 i ; indexedR R 1 i
pm ; indexedR R 1 i ; join indexP p i indexedP p 1 i ; indexedG G 1 i ; S ; indexedL L 1 i |- e2 : unit :> indexedP p 2 i { P2 }  -| indexedG G 2 i ; indexedL L 2 i ; indexedR R 2 i
indexP p 0 = pc AND indexP p i+1 = join indexP p i indexedP p 2 i
indexG G 0 = G AND indexG G i+1 = JoinRestrict indexG G i indexedG G 2 i
indexL L 0 = L AND indexL L i+1 = JoinL indexL L i indexedL L 2 i
indexR R 0 = R AND indexR R i+1 = JoinR indexR R i indexedR R 2 i
%  "where n is the smallest natural number satisfying the two equalities above."
indexP p n+1 = indexP p n 
indexG G n+1 = indexG G n
indexL L n+1 = indexL L n
indexR R n+1 = indexR R n
---------------------------------------------------------------------------  :: while_std
pm ; R ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexP p n { no_pred }  -| indexG G n ; indexL L n ; indexR R n

