% Derived from `examples/1Bsemantics/l1.ott` in Ott distribution

embed
 {{ tex-preamble
\input{poison-lang-custom}
 }}

metavar n, i ::=
  {{ com Numeric literals }}
  {{ phantom }}


metavar address, a ::=
  {{ com Concrete heap addresses }}

metavar location, l ::= 
  {{ com Logical memory locations }}

metavar var, x ::=
  {{ com Variables }}
  {{ phantom }}
  {{ coq string }}

metavar tag, k ::=
  {{ com Tags for predicates }}
  {{ phantom }}
  {{ coq string }}

metavar tag_index, ki ::=
  {{ com Symbolic tag indices (local to extern specs) }}
  {{ phantom }}

metavar extern_id, eid ::=
  {{ com Extern identifiers (author-chosen natural numbers) }}
  {{ phantom }}

grammar

locset, LS :: 'LS_' ::= {{ com location sets }}
  | { }                      ::   :: empty
  | { l }                    ::   :: singleton
  | LS1 U LS2                ::   :: union {{ com union (dedup) }} {{ tex [[LS1]] \cup [[LS2]] }}

b :: 'B_' ::=              {{ com booleans }}  {{ phantom }} {{ coq bool }}
  | true                    ::   :: true      {{ coq true }}
  | false                   ::   :: false     {{ coq false }}

operations, op :: 'Op_' ::=            {{ com operations }}
  | +                       ::   :: plus
  | -                       ::   :: minus
  | *                       ::   :: mult
  | /                       ::   :: div
  | >=                      ::   :: gteq
  | <=                      ::   :: lteq
  | >                       ::   :: gt
  | <                       ::   :: lt
  | =                       ::   :: eq
  | !=                      ::   :: neq
  | &&                      ::   :: and 
  | &                       ::   :: bitwise_and
  | ||                      ::   :: or

unary_op :: 'UnaryOp_' ::=      {{ com operations }}
  | not                     ::   :: not 

% Surface types for annotations (no runtime info)
styp, ST :: 'ST_' ::=      {{ com surface types }}
  | int                    ::   :: int
  | bool                   ::   :: bool
  | unit                   ::   :: unit
  | string                 ::   :: string 
  | ref ST                 ::   :: ref
  | ST1 -> ST2             ::   :: arrow



e :: 'E_'  ::=	           {{ com expressions }}
  | unit                    ::   :: unit
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | x                       ::   :: var
  | e1 op e2                ::   :: op
  | unary_op e              ::   :: unary_op
  | if e1 then e2 else e3   ::   :: if
  | ref e                   ::   :: new_ref
  | e1 := e2                ::   :: assign
  | ! e                     ::   :: deref
  | e1 ; e2                 ::   :: sequence
  | let x = e1 in e2        ::   :: let
  | fn x : ST1 => e : ST2        ::   :: fn   {{ com fn with return type }}
  | pfn x : ST1 => pe : ST2      ::   :: pfn  {{ com pure fn with return type }}
  | e1 e2                   ::   :: app
  | ( e )                   :: M :: paren  {{ ichlo ([[e]]) }}
  | extern_val @ eid ST p SP      ::   :: extern_val {{ com extern value with mandatory identifier }} {{ tex \mathsf{extern}\,\mathsf{val}\,@[[eid]]\,[[ST]]\,[[p]]\,[[SP]] }}
  | extern_fn @ eid x Q ER ESL CSL   ::   :: extern_fn {{ com extern impure function with mandatory identifier; the argument qualified type Q is the caller precondition; CSL lists declared environment/memory read dependencies }} {{ tex \mathsf{extern}\,\mathsf{fn}\,@[[eid]]\,[[x]]:[[Q]] \to [[ER]]\,;\,[[ESL]]\,,\,\mathsf{captures}:[[CSL]] }}
  | extern_pfn @ eid x Q ER CSL      ::   :: extern_pfn {{ com extern pure function with mandatory identifier; the argument qualified type Q is the caller precondition; CSL lists declared environment/memory read dependencies }} {{ tex \mathsf{extern}\,\mathsf{pfn}\,@[[eid]]\,[[x]]:[[Q]] \Rightarrow [[ER]]\,,\,\mathsf{captures}:[[CSL]] }}


pe :: 'PE_' ::=            {{ com pure expressions }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | x                       ::   :: var
  | s                       ::   :: string
  | pe1 op pe2              ::   :: op
  | if pe1 then pe2 else pe3 ::   :: if
  | ! pe                    ::   :: deref
  | unit                    ::   :: unit
  | let x = pe1 in pe2      ::   :: let
  | ( pe )                  :: M :: paren  {{ ichlo ([[pe]]) }}
  | pe1 pe2                 ::   :: app

v :: 'V_' ::=              {{ com values }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | unit                    ::   :: unit    
  | a                       ::   :: address
  | closure ( x , e , r )   ::   :: closure   {{ com closure value }}
  | pe_closure ( x , pe , r )  ::   :: pe_closure   {{ com pure closure value }}

expr_or_value, ev :: 'EV_' ::=  {{ com expression or value }}
  | expr e                  ::   :: expr  {{ com expression }}
  | value v                 ::   :: value {{ com value }}

memory , m {{ tex \mu }} :: 'Memory_' ::=  {{ com memory }} {{ phantom }} {{ coq list (address * integer) }}
   | empty                  ::   :: empty {{ coq [] }}
   | m [ a |-> n ]          ::   :: extend  {{ coq (([[a]],[[n]])::[[m]]) }}

typ, T :: 'T_' ::=         {{ com enriched types }}
  | int                     ::   :: int
  | bool                    ::   :: bool
  | unit                    ::   :: unit
  | string                  ::   :: string
  | ref @ LS                 ::   :: ref {{ tex \mathsf{ref}\,@\,[[LS]] }}
  | ST1 -> ST2 # p tclosures tcls ::   :: arrow {{ tex [[ST1]] \rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{tclosures}\, [[tcls]] }}
  | ST1 -> ST2 # p tpclosures ptcls ::   :: parrow {{ tex [[ST1]] \Rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{tpclosures}\, [[ptcls]] }}

% Predicate closure contents (for cleaner syntax)
pcl :: 'PCL_' ::= {{ com predicate closure }}
  | ( x , pe , S )          ::   :: pred_closure

% Typing closures (separate for impure fn and pure pfn)
tcl :: 'TCL_' ::= {{ com impure fn closure }}
  | ( x , e , S )           ::   :: fn_closure
  | extern_tcl @ eid ( x , Q , ER , ESL , S ) ::   :: extern_closure {{ com extern impure closure (carries the extern id eid for the extern-regime policy and the declared argument precondition Q consulted at the call site) }} {{ tex \mathsf{extern}@[[eid]]([[x]], [[Q]], [[ER]], [[ESL]], [[S]]) }}

ptcl :: 'PTCL_' ::= {{ com pure fn closure }}
  | ( x , pe , S )          ::   :: pfn_closure
  | extern_ptcl @ eid ( x , Q , ER , S ) ::   :: extern_closure {{ com extern pure closure (carries the extern id eid for the extern-regime policy and the declared argument precondition Q consulted at the call site) }} {{ tex \mathsf{extern}@[[eid]]([[x]], [[Q]], [[ER]], [[S]]) }}

% Merged typing closures (non-empty lists treated as sets)
tcls :: 'TCLS_' ::= {{ com impure closure set }}
  | tcl                     ::   :: singleton {{ tex \{ [[tcl]] \} }}
  | tcl , tcls              ::   :: cons {{ tex \{ [[tcl]] \} \cup [[tcls]] }}
  | tcls1 U tcls2           ::   :: union {{ com closure set union }} {{ tex [[tcls1]] \cup [[tcls2]] }}

ptcls :: 'PTCLS_' ::= {{ com pure closure set }}
  | ptcl                    ::   :: singleton {{ tex \{ [[ptcl]] \} }}
  | ptcl , ptcls            ::   :: cons {{ tex \{ [[ptcl]] \} \cup [[ptcls]] }}
  | ptcls1 U ptcls2         ::   :: union {{ com closure set union }} {{ tex [[ptcls1]] \cup [[ptcls2]] }}

predicate, P :: 'P_' ::= {{ com predicate }}
  | guard k pred_closure pcl ::   :: pred_closure {{ com predicate as pure closure }} {{tex \mathsf{guard}\,[[k]]\,\mathsf{pred\_closure}\,[[pcl]] }}
  | guard k                   ::   :: guard_only {{ com guard tag only }} {{tex \mathsf{guard}\,[[k]] }}
  | no_pred                   ::   :: no_pred {{ com no predicate }} {{tex \bot }}
  | AppPred p P              ::   :: app_pred {{ com provenance gate }} {{ tex \mathrm{AppPred}([[p]], [[P]]) }}

qualified_type, Q :: 'Q_' ::= {{ com qualified type }}
  | T :> p                  ::   :: qualified {{ tex [[T]] \triangleright [[p]] }}
  | T :> p { P }            ::   :: qualified_pred {{ tex [[T]] \triangleright [[p]]\, \{ [[P]] \} }}

mem_entry, me :: 'ME_' ::= {{ com mem entry (poison+pred) }}
  | p { P }                 ::   :: entry {{ tex [[p]]\, \{ [[P]] \} }}

mem_type_assumption, ta :: 'TA_' ::= {{ com memory type assumption }}
  | l : me                  ::   :: loc

G {{ tex \Gamma }} :: G_ ::=     {{ com memory typing environments }} {{ phantom }} {{ coq list mem_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | G , ta                  ::   :: extend {{ coq ([[ta]]::[[G]]) }}
  | JoinG G1 G2             ::   :: JoinG {{ com flow-insensitive env join }} {{ tex [[G1]] \sqcup [[G2]] }}
  | JoinGStrong G1 G2       ::   :: JoinGStrong {{ com JoinG for unknown-branch }} {{ tex [[G1]] \sqcup^{\!*} [[G2]] }}
  | JoinRestrict G1 G2      ::   :: JoinRestrict {{ com JoinG with 2nd restricted to dom(G1) }} {{ tex [[G1]] \sqcup \bigl([[G2]] \mathbin{\restriction} \mathrm{dom}([[G1]])\bigr) }}
  | G [ l |-> me ]          ::   :: UpdateG {{ tex [[G]] [ l \mapsto [[me]] ] }}
  | G [ LS |-> me ]         ::   :: UpdateGSet {{ com update LS with me }} {{ tex [[G]] [ [[LS]] \mapsto [[me]] ] }}

% Variable environment for let bindings
var_type_assumption, va :: 'VA_' ::= {{ com variable type assumption }}
  | x : Q                ::   :: var

S {{ tex \sigma }} :: S_ ::=     {{ com variable typing environments }} {{ phantom }} {{ coq list var_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | S [ x |-> Q ]       ::   :: update {{ coq (([[x]],[[Q]])::[[S]]) }}

% Tag valuation environment
tag_valuation, tv :: 'TV_' ::= {{ com tag valuation }}
  | k : b using LS     ::   :: tag_deps {{ com tag with deps }}

L {{ tex \mathcal{L} }} :: L_ ::=     {{ com logical environment (tag valuation) }} {{ phantom }} {{ coq list tag_valuation }}
  | empty                   ::   :: empty {{ coq [] }}
  | L [ k |-> b using LS ] ::   :: UpdateL {{ tex [[L]] [ k \mapsto [[b]] \text{ using } [[LS]] ] }}
  | JoinL L1 L2             ::   :: JoinL {{ com agreement-only tag join }} {{ tex [[L1]] \sqcup [[L2]] }}

% Regime (partial map from tags to booleans)
% R is both input and output of typing; propagates like L (thread through sequencing, join at branches, invalidate on write)
% At selected extern call sites the active regime is extended with the freshly generated
% output tags (the extern-regime policy, keyed by extern id); unselected sites leave R unchanged.
R {{ tex \mathcal{R} }} :: R_ ::= {{ com regime (partial map from tags to booleans) }}
  | empty                   ::   :: empty {{ coq [] }}
  | R [ k |-> b ]           ::   :: extend {{ tex [[R]] [ k \rightharpoonup [[b]] ] }}
  | JoinR R1 R2             ::   :: JoinR {{ com agreement-only regime join }} {{ tex [[R1]] \sqcup [[R2]] }}

poison, p, pc :: 'p_' ::= {{ com poison status }}
  | clean                    ::   :: clean
  | poisoned                 ::   :: poisoned
  | join p1 p2               ::   :: join {{ com poison join }} {{ tex [[p1]] \sqcup [[p2]] }}

% Variable substitution environment for operational semantics
var_binding, vb :: 'VB_' ::= {{ com variable binding }}
  | x |-> v                  ::   :: binding

var_env, r {{ tex \rho }} :: 'VE_' ::=     {{ com variable substitution environment }} {{ phantom }} {{ coq list var_binding }}
  | empty                   ::   :: empty {{ coq [] }}
  | r [ x |-> v ]          ::   :: update {{ coq (([[x]],[[v]])::[[r]]) }}                  

pure_mode, pm :: 'PM_' ::= {{ com pure mode }} {{ tex \pi }}
  | pure                     ::   :: pure
  | impure                   ::   :: impure

% Syntax-level predicate (symbolic tags, before resolution)
syntax_predicate, SP :: 'SP_' ::= {{ com syntax predicate (symbolic) }}
  | guard_closure ki x pe    ::   :: guard_closure {{ com symbolic guard closure }} {{ tex \mathsf{guard}\,[[ki]]\,\mathsf{closure}\,([[x]],[[pe]]) }}
  | guard_only ki            ::   :: guard_only {{ com symbolic guard only }} {{ tex \mathsf{guard}\,[[ki]] }}
  | no_pred                  ::   :: no_pred {{ com no predicate }} {{ tex \bot }}

% Effect specification (target is always a named variable reference)
effect_spec, ES :: 'ES_' ::= {{ com effect specification }}
  | ! x :> p { SP }          ::   :: effect {{ tex ![[x]] \triangleright [[p]]\, \{ [[SP]] \} }}

% Effect list
effect_list, ESL :: 'ESL_' ::= {{ com effect list }}
  | empty                    ::   :: empty
  | ES , ESL                 ::   :: cons

% Capture (read-dependency) specification: a declared environment variable `x`
% or bang memory target `! x` reached through a captured reference, together with
% the qualified type the callable expects to read there.  Parallel to the effect
% list ESL, but read-only (doc/extern-env-deps.md).
capture_spec, CS :: 'CS_' ::= {{ com capture (read-dependency) specification }}
  | x :> Q                   ::   :: bareVar {{ tex [[x]] \triangleright [[Q]] }}
  | ! x :> Q                 ::   :: memVar  {{ tex ![[x]] \triangleright [[Q]] }}

% Capture list
capture_list, CSL :: 'CSL_' ::= {{ com capture (read-dependency) list }}
  | empty                    ::   :: empty
  | CS , CSL                 ::   :: cons

% Extern return specification.  Nested callable return forms carry their own
% extern identifier (@eid); `simple` returns do not (the id lives on the
% enclosing top-level extern).
extern_return, ER :: 'ER_' ::= {{ com extern return spec }}
  | simple ST p SP                ::   :: simple {{ com simple return }} {{ tex ([[ST]] \triangleright [[p]]\, \{ [[SP]] \}) }}
  | nested_fn @ eid x Q ER ESL CSL   ::   :: nested_fn {{ com nested impure fn return with identifier; the argument qualified type Q is the caller precondition for the next application; CSL lists declared read dependencies }} {{ tex \mathsf{fn}\,@[[eid]]\,[[x]]:[[Q]] \to [[ER]]\,;\,[[ESL]]\,,\,\mathsf{captures}:[[CSL]] }}
  | nested_pfn @ eid x Q ER CSL      ::   :: nested_pfn {{ com nested pure fn return with identifier; the argument qualified type Q is the caller precondition for the next application; CSL lists declared read dependencies }} {{ tex \mathsf{pfn}\,@[[eid]]\,[[x]]:[[Q]] \Rightarrow [[ER]]\,,\,\mathsf{captures}:[[CSL]] }}

% Tag resolution map (symbolic index -> concrete tag)
tag_map, TM :: 'TM_' ::= {{ com tag resolution map }}
  | empty                    ::   :: empty
  | TM [ ki |-> k ]          ::   :: extend {{ tex [[TM]] [ [[ki]] \mapsto [[k]] ] }}

terminals :: terminals_ ::=
  | +    :: :: plus
  | -    :: :: minus
  | *    :: :: mult
  | /    :: :: div
  | >=   :: :: gteq      {{ tex \geq }}
  | <=   :: :: lteq      {{ tex \leq }}
  | >    :: :: gt        {{ tex > }}
  | <    :: :: lt        {{ tex < }}
  | |-   :: :: turnstile {{ tex \vdash }}
  | -|   :: :: left_turnstile {{ tex \dashv }}
  | |->  :: :: mapsto    {{ tex \mapsto }}
  | ;    :: :: seq
  | ->   :: :: red       {{ tex \longrightarrow }}
  | <    :: :: la        {{ tex \langle }}
  | >    :: :: ra        {{ tex \rangle }}
  | :>   :: :: ty_poison {{ tex \triangleright }}
  | ;    :: :: sep       {{ tex ; }}
  | AND  :: :: and       {{ tex \land }}
  | range :: :: range   {{ tex range }}
  | =    :: :: eq
  | !=   :: :: neq 
  | in   :: :: in
  | [    :: :: lsquare   {{ tex [ }}
  | ]    :: :: rsquare   {{ tex ] }}
  | @    :: :: at        {{ tex @ }}
  | =>   :: :: lmbd   {{ tex \Rightarrow }}
  | ==>   :: :: beval   {{ tex \Downarrow }}
  | <:   :: :: subtype   {{ tex <: }}

subrules
  pe <:: e

grammar 
formula :: formula_ ::=
  | judgement              :: :: judgement
  | n1 + n2 = n3           :: :: sum         {{ coq ([[n1]]+[[n2]]=[[n3]]) }}
  | n1 - n2 = n3           :: :: diff        {{ coq ([[n1]]-[[n2]]=[[n3]]) }}
  | n1 * n2 = n3           :: :: mult        {{ coq ([[n1]]*[[n2]]=[[n3]]) }}
  | n1 / n2 = n3           :: :: div         {{ coq ([[n1]]/[[n2]]=[[n3]]) }}
  | n1 >= n2 = b           :: :: geq         {{ coq ([[n1]]>=[[n2]]=[[b]]) }}
  | n1 <= n2 = b           :: :: leq         {{ coq ([[n1]]<=[[n2]]=[[b]]) }}
  | n1 > n2 = b            :: :: gt          {{ coq ([[n1]]>[[n2]]=[[b]]) }}
  | n1 < n2 = b            :: :: lt          {{ coq ([[n1]]<[[n2]]=[[b]]) }}
  | n1 = n2 = b            :: :: eq          {{ coq ([[n1]]=[[n2]]=[[b]]) }}
  | n1 != n2 = b           :: :: neq         {{ coq ([[n1]]!=[[n2]]=[[b]]) }}
  | n1 & n2 = n3           :: :: bitwise_and {{ coq ([[n1]]&[[n2]]=[[n3]]) }}
  | b1 && b2 = b3          :: :: band        {{ coq ([[b1]]&&[[b2]]=[[b3]]) }}
  | b1 || b2 = b3          :: :: bor         {{ coq ([[b1]]||[[b2]]=[[b3]]) }}
  | not b = b1             :: :: not_bool   {{ coq ([[b1]] = not [[b]]) }}
  | m ( a ) = n            :: :: lookup      {{ coq (List.find [[a]] [[m]] = Some ([[n]])) }}   
  | G ( l ) = me       :: :: mem_lookup {{ coq (lookup_location_mem [[l]] [[G]] = Some ([[me]])) }}   
  | S ( x ) = Q        :: :: var_type_lookup {{ coq (lookup_var_type [[x]] [[S]] = Some ([[Q]])) }}   
  | r ( x ) = v           :: :: var_lookup {{ coq (lookup_var [[x]] [[r]] = Some ([[v]])) }}   
  | L ( k ) = b using LS :: :: tag_lookup {{ coq (lookup_tag [[k]] [[L]] = Some ([[b]], [[LS]])) }}   
  | R ( k ) = b           :: :: regime_lookup {{ coq (lookup_regime [[k]] [[R]] = Some ([[b]])) }}
  | R ( k ) = none        :: :: regime_none {{ coq (lookup_regime [[k]] [[R]] = None) }}
  | p1 = p2                :: :: poison_eq   {{ coq ([[p1]] = [[p2]]) }}   
  | G1 = G2                :: :: type_env_eq {{ coq ([[G1]] = [[G2]]) }}   
  | L1 = L2                :: :: tag_env_eq {{ coq ([[L1]] = [[L2]]) }}   
  | R1 = R2                :: :: regime_eq {{ coq ([[R1]] = [[R2]]) }}   
  | formula1 AND formula2  :: :: and         {{ tex [[formula1]] \quad [[formula2]] }} {{ coq ([[formula1]] /\ [[formula2]]) }}
  | fresh a                :: :: fresh_addr       {{ com a is fresh concrete address }}
  | fresh l                :: :: fresh_loc       {{ com l is fresh }}
  | fresh k                :: :: fresh_tag       {{ com k is fresh }}
  | fresh x S              :: :: fresh_var       {{ com x is fresh in S }}
  | n0 = random n1         :: :: random_gen     {{ com n0 is a random number in [0, n1] range }}
  | match_guard e G S = k with LS  :: :: match_guard  {{ com find guard k with deps LS for condition e }}  {{ tex match\_guard([[e]], [[G]], [[S]]) = [[k]] \text{ with } [[LS]] }}
  | invalidate_deps L LS = L1 :: :: invalidate_deps {{ com remove from L entries whose deps intersect LS }}  {{ tex [[L1]] = [[L]] \mathbin{\restriction} \bigl(\mathrm{dom}([[L]]) \setminus [[LS]]\bigr) }}
  | invalidate_regime_deps R L LS = R1 :: :: invalidate_regime_deps {{ com remove from R tags whose deps in L intersect LS }}  {{ tex [[R1]] = \mathrm{invalidate\_regime}([[R]], [[L]], [[LS]]) }}
  | ST <: T                :: :: subtype      {{ com ST is a subtype of T (surface type erasure) }} {{ tex [[ST]] <: [[T]] }}
  | base_of Q = ST         :: :: base_of      {{ com ST is the surface base type underlying the qualified type Q (drops the poison flag and predicate); rendered with the subtype glyph since it is the surface-erasure relation lifted to qualified types }} {{ tex [[ST]] <: [[Q]] }}
  | satisfiesArgCond R Q1 Q2 :: :: arg_cond_sat {{ com actual argument qualified type Q1 satisfies the declared extern argument precondition Q2 under regime R: base types match; a declared-clean Q2 forces Q1 clean under R (literally clean, or its guard tag is active in R); a declared no-predicate Q2 imposes no match; a declared predicate forces Q1 to carry the same guard shape modulo tag, binder, and captured environment (no logical implication) }} {{ tex [[Q1]] \vDash_{[[R]]} [[Q2]] }}
  | capturesSatisfied R CSL S G :: :: captures_sat {{ com the call-site read-dependency gate: every declared capture target in CSL resolves in the callable environment S (bare-variable targets) or memory typing G (bang targets) to a qualified type that satisfies the declared one under regime R, exactly as satisfiesArgCond gates the argument precondition.  A trusted clean result is available only when both the argument condition and all captures hold; the two are fused into a single gate at the call site (doc/extern-env-deps.md) }} {{ tex \mathrm{capturesSat}([[R]], [[CSL]], [[S]], [[G]]) }}
  | T1 ≈ T2                :: :: sig_comp     {{ com T1 and T2 signature-compatible }} {{ tex [[T1]] \approx [[T2]] }}
  | pcl = range pe1 pe2 S      :: :: range {{ tex [[pcl]] = ( 0 \leq [[pe1]] \leq [[pe2]] , [[S]]) }}
  | tcl in tcls            :: :: tcl_member  {{ com tcl member of tcls }} {{ tex [[tcl]] \in [[tcls]] }}
  | ptcl in ptcls          :: :: ptcl_member {{ com ptcl member of ptcls }} {{ tex [[ptcl]] \in [[ptcls]] }}
  | l in LS                 :: :: loc_member {{ com logical location membership }} {{ tex [[l]] \in [[LS]] }}
  | LS = LS1 U LS2          :: :: ls_union {{ com locset union binding }} {{ tex [[LS]] = [[LS1]] \cup [[LS2]] }}
  | T = ST1 -> ST2 # p tclosures tcls   :: :: type_eq_arrow  {{ com impure arrow type }} {{ tex [[T]] = [[ST1]] \rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{tclosures}\, [[tcls]] }}
  | T = ST1 -> ST2 # p tpclosures ptcls :: :: type_eq_parrow {{ com T is a pure arrow type with the given components }} {{ tex [[T]] = [[ST1]] \Rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{tpclosures}\, [[ptcls]] }}
  | T = ref @ LS                   :: :: type_eq_ref {{ com ref type with locset LS }} {{ tex [[T]] = \mathsf{ref}\,@\,[[LS]] }}
  | tcls = tcls1 U tcls2  :: :: tcls_union  {{ com closure set union binding }} {{ tex [[tcls]] = [[tcls1]] \cup [[tcls2]] }}
  | ptcls = ptcls1 U ptcls2 :: :: ptcls_union {{ com closure set union binding }} {{ tex [[ptcls]] = [[ptcls1]] \cup [[ptcls2]] }}
  | JoinP P1 P2 = P3       :: :: join_pred {{ com tag-aware, conservative pred join }} {{ tex [[P1]] \sqcup [[P2]] = [[P3]] }}
  | MergePreds G LS = P     :: :: merge_preds {{ com merge predicates for LS in G }} {{ tex \bigsqcup_{\,l \in [[LS]]} \mathrm{pred}([[G]](l)) = [[P]] }}
  | JoinPoisons G LS = p    :: :: join_poisons {{ com join poisons for LS in G }} {{ tex [[p]] = \bigsqcup_{\,l \in [[LS]]} \mathrm{poison}([[G]](l)) }}
  | not_harmful_shadow x S R :: :: not_harmful_shadow {{ com no harmful shadow of x in S,R }} {{ tex \neg\mathrm{harmful\_shadow}([[x]], [[S]], [[R]]) }}
  | not_fun T :: :: not_fun {{ com T is not function type }} {{ tex [[T]] \neq \_ \rightarrow \_}}
  | freshTags SP k = k' TM  :: :: fresh_tags {{ com allocate fresh tags for symbolic indices in SP }} {{ tex \mathrm{freshTags}([[SP]], [[k]]) = ([[k']], [[TM]]) }}
  | resolve TM SP S = P     :: :: resolve_pred {{ com resolve symbolic predicate via tag map }} {{ tex \mathrm{resolve}([[TM]], [[SP]], [[S]]) = [[P]] }}
  | TM ( ki ) = k           :: :: tag_map_lookup {{ com tag map lookup }} {{ tex [[TM]]([[ki]]) = [[k]] }}
  | returnType ER = ST      :: :: return_type {{ com extract surface return type from extern spec }} {{ tex \mathrm{returnType}([[ER]]) = [[ST]] }}
  | extern_wf p SP :: :: extern_pred_wf {{ com clean types cannot carry predicates }} {{ tex [[p]] = \mathsf{poisoned} \lor [[SP]] = \bot }}
  | extern_spec_wf ER ESL :: :: extern_spec_wf {{ com all (p, SP) pairs satisfy extern\_wf; simple return types are base types }} {{ tex \mathrm{specWf}([[ER]], [[ESL]]) }}
  | base_extern_type ST :: :: base_extern_type {{ com ST is a base type (int, bool, unit, string) }} {{ tex [[ST]] \in \{ \mathsf{int}, \mathsf{bool}, \mathsf{unit}, \mathsf{string} \} }}
  | externValConvert ST G = T G' :: :: extern_val_convert {{ com convert surface type to enriched type, possibly allocating fresh loc }} {{ tex \mathrm{externValConvert}([[ST]], [[G]]) = ([[T]], [[G']]) }}
  | allocReturnEffectTags SP ESL k = k' TM :: :: alloc_return_effect_tags {{ com allocate fresh tags for return pred SP and all effect preds in ESL }} {{ tex \mathrm{allocTags}([[SP]], [[ESL]], [[k]]) = ([[k']], [[TM]]) }}
  | allocEffectTags ESL k = k' TM :: :: alloc_effect_tags {{ com allocate fresh tags for effect preds only }} {{ tex \mathrm{allocEffectTags}([[ESL]], [[k]]) = ([[k']], [[TM]]) }}
  | resolveEffects ESL TM S G = G' :: :: resolve_effects {{ com resolve effect preds via TM and apply memory updates; predicates are stored as resolved (used by clean effect-pc extern application rules, where the gate join pc (join p1 p) is clean) }} {{ tex \mathrm{resolveEffects}([[ESL]], [[TM]], [[S]], [[G]]) = [[G']] }}
  | resolveEffectsPoisoned ESL TM S G = G' :: :: resolve_effects_poisoned {{ com resolve effect preds via TM and apply memory updates with predicate erasure (stored predicate forced to noPred); used by poisoned effect-pc extern application rules, where the gate join pc (join p1 p) is poisoned, mirroring assignment under poisoned pc }} {{ tex \mathrm{resolveEffectsPoisoned}([[ESL]], [[TM]], [[S]], [[G]]) = [[G']] }}
  | extendExternRegime eid TM R = R' :: :: extend_extern_regime {{ com call-site regime extension: insert into R the freshly generated output tags in the codomain of TM that the ambient extern-regime policy (the Ott analogue of the typechecker's ctx.externRegime, not shown in the judgment) selects for extern id eid; unselected extern ids leave R unchanged (see doc/extern-regime.md, sections 4.1 and 4.3) }} {{ tex [[R']] = \mathrm{extendExternRegime}([[eid]], [[TM]], [[R]]) }}


defns


Jop :: '' ::=

% --- Big-step (natural) semantics below ---

defn
< pm , e , m , r > ==> < v , m1 , r1 > :: :: beval :: ''  {{ com Big-step evaluation }} by

% Literals
----------------------   :: b_lit_num
< pm, n, m, r > ==> < n, m, r >

----------------------   :: b_lit_bool
< pm, b, m, r > ==> < b, m, r >

----------------------   :: b_lit_unit
< pm, unit, m, r > ==> < unit, m, r >

----------------------   :: b_lit_string
< pm, s, m, r > ==> < s, m, r >

% Variables
r(x) = v
--------------------------- :: b_var
< pm, x, m, r > ==> < v, m, r >

% Binary operations (evaluate both operands to values, then compute)
<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 + n2 = n
----------------------   :: b_op_plus
<pm, e1 + e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 - n2 = n
----------------------   :: b_op_minus
<pm, e1 - e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 * n2 = n
----------------------   :: b_op_mult
<pm, e1 * e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 / n2 = n
----------------------   :: b_op_div
<pm, e1 / e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 >= n2 = b
----------------------   :: b_op_gteq
<pm, e1 >= e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 <= n2 = b
----------------------   :: b_op_lteq
<pm, e1 <= e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 > n2 = b
----------------------   :: b_op_gt
<pm, e1 > e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 < n2 = b
----------------------   :: b_op_lt
<pm, e1 < e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 = n2 = b
----------------------   :: b_op_eq
<pm, e1 = e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 != n2 = b
----------------------   :: b_op_neq
<pm, e1 != e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < b1, m1, r1>
<pm, e2, m1, r1> ==> < b2, m2, r2>
b1 && b2 = b3
----------------------   :: b_op_and
<pm, e1 && e2, m, r> ==> < b3, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 & n2 = n3
----------------------   :: b_op_bitwise_and
<pm, e1 & e2, m, r> ==> < n3, m2, r2>

<pm, e1, m, r> ==> < b1, m1, r1>
<pm, e2, m1, r1> ==> < b2, m2, r2>
b1 || b2 = b3
----------------------   :: b_op_or
<pm, e1 || e2, m, r> ==> < b3, m2, r2>

<pm, e, m, r> ==> < b, m1, r1>
not b = b1
--------------------------------------------------------------- :: b_unary_op_not 
<pm, not e, m, r> ==> < b1, m1, r1>

% References (allocation is impure)
<impure, e, m, r> ==> < n, m1, r1>
fresh a
------------------------------ :: b_ref
<impure, ref e, m, r> ==> < a, m1 [ a |-> n ], r1>

% Dereference
<pm, e, m, r> ==> < a, m1, r1>
m1(a) = n
------------------------------ :: b_deref
<pm, !e, m, r> ==> < n, m1, r1>

% Assignment (mutation is impure)
<impure, e1, m, r> ==> < a, m1, r1>
<impure, e2, m1, r1> ==> < n, m2, r2>
-------------------------------------- :: b_assign
< impure, e1 := e2, m, r > ==> < unit, m2 [ a |-> n ], r2 >

% Sequencing
<pm, e1, m, r> ==> < v1, m1, r1>
<pm, e2, m1, r1> ==> < v2, m2, r2>
-------------------------------------- :: b_seq
< pm, e1 ; e2, m, r > ==> < v2, m2, r2 >

% Conditionals
<pm, e, m, r> ==> < true, m1, r1>
<pm, e1, m1, r1> ==> < v, m2, r2>
---------------------------------------------- :: b_if_true
< pm, if e then e1 else e2, m, r > ==> < v, m2, r2 >

<pm, e, m, r> ==> < false, m1, r1>
<pm, e2, m1, r1> ==> < v, m2, r2>
---------------------------------------------- :: b_if_false
< pm, if e then e1 else e2, m, r > ==> < v, m2, r2 >

% Let binding
% Note: the body sees the incoming environment extended with x, and the whole
% expression restores the incoming environment (heap effects remain).
<pm, e1, m, r> ==> < v, m1, r1>
<pm, e2, m1, r[x |-> v]> ==> < v2, m2, r2>
-------------------------------------------------------- :: b_let
< pm, let x = e1 in e2, m, r > ==> < v2, m2, r >

% Function abstraction
--------------------------------------------------------------- :: b_fn_abs
< pm, fn x : ST1 => e : ST2, m, r > ==> < closure(x, e, r), m, r >

% Pure function abstraction
--------------------------------------------------------------- :: b_pfn_abs
< pm, pfn x : ST1 => pe : ST2, m, r > ==> < pe_closure(x, pe, r), m, r >

% Impure function application (call-by-value)
% The function expression is evaluated under the caller environment r, and the
% whole application restores r: argument evaluation carries heap/address effects
% forward but cannot dynamically extend the variable environment.
< impure , e2 , m , r > ==> < v , m1 , r1 >
< impure , e1 , m1 , r > ==> < closure ( x , e , r3 ) , m2 , r2 >
< impure , e , m2 , r3 [ x |-> v ] > ==> < v0 , m3 , r4 >
--------------------------------------------------------------- :: b_app_closure
< impure , e1 e2 , m , r > ==> < v0 , m3 , r >

% Pure function application (no effects)
< pm , pe2 , m , r > ==> < v , m , r >
< pm , pe1 , m , r > ==> < pe_closure ( x , pe , r1 ) , m , r >
< pure , pe , m , r1 [ x |-> v ] > ==> < v0 , m , r2 >
--------------------------------------------------------------- :: b_app_pure_closure
< pm , pe1 pe2 , m , r > ==> < v0 , m , r >

%% --- Typing rules below ---

defn
pm ; R ; pc ; G ; S ; L |- e : Q -| G1 ; L1 ; R1 :: :: typing :: Ty_ by

------------------  :: int
pm ; R ; pc ; G ; S ; L |- n : int :> clean { no_pred } -| G ; L ; R

------------------  :: bool
pm ; R ; pc ; G ; S ; L |- b : bool :> clean { no_pred } -| G ; L ; R

------------------  :: string 
pm ; R ; pc ; G ; S ; L |- s : string :> clean { no_pred } -| G ; L ; R

% Variable typing - with guarded predicate that evaluates to true triggering de-poisoning.
S(x) = T :> p { guard k pred_closure pcl }
not_fun T
L(k) = true using LS
------------------  :: var_guard_true
pm ; R ; pc ; G ; S ; L |- x : T :> pc { no_pred } -| G ; L ; R

% Variable typing - with guard only that evaluates to true triggering de-poisoning.
S(x) = T :> p { guard k }
not_fun T
L(k) = true using LS
------------------  :: var_guard_only_true
pm ; R ; pc ; G ; S ; L |- x : T :> pc { no_pred } -| G ; L ; R

% Variable typing - with guarded predicate that evaluates to false, triggering poisoning.
S(x) = T :> p { guard k pred_closure pcl }
not_fun T
L(k) = false using LS
------------------  :: var_guard_false
pm ; R ; pc ; G ; S ; L |- x : T :> poisoned { no_pred } -| G ; L ; R

% Variable typing - with guard only that evaluates to false, triggering poisoning.
S(x) = T :> p { guard k }
not_fun T
L(k) = false using LS
------------------  :: var_guard_only_false
pm ; R ; pc ; G ; S ; L |- x : T :> poisoned { no_pred } -| G ; L ; R

% Variable typing - with guarded predicate but tag not in L
S(x) = T :> p { guard k pred_closure pcl }
not_fun T
------------------  :: var_guard_unknown
pm ; R ; pc ; G ; S ; L |- x : T :> join pc p { guard k pred_closure pcl } -| G ; L ; R

% Variable typing - with guard only but tag not in L
S(x) = T :> p { guard k }
not_fun T
------------------  :: var_guard_only_unknown
pm ; R ; pc ; G ; S ; L |- x : T :> join pc p { guard k } -| G ; L ; R

% Variable typing - no guard case
S(x) = T :> p { no_pred }
------------------  :: var_no_pred
pm ; R ; pc ; G ; S ; L |- x : T :> join pc p { no_pred } -| G ; L ; R

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_plus
pm ; R ; pc ; G ; S ; L |- e1 + e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_gteq
pm ; R ; pc ; G ; S ; L |- e1 >= e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_minus
pm ; R ; pc ; G ; S ; L |- e1 - e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_mult
pm ; R ; pc ; G ; S ; L |- e1 * e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_div
pm ; R ; pc ; G ; S ; L |- e1 / e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_lteq
pm ; R ; pc ; G ; S ; L |- e1 <= e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_gt
pm ; R ; pc ; G ; S ; L |- e1 > e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_lt
pm ; R ; pc ; G ; S ; L |- e1 < e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_eq
pm ; R ; pc ; G ; S ; L |- e1 = e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_neq
pm ; R ; pc ; G ; S ; L |- e1 != e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : bool :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_and
pm ; R ; pc ; G ; S ; L |- e1 && e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_bitwise_and
pm ; R ; pc ; G ; S ; L |- e1 & e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1  
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : bool :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: op_or
pm ; R ; pc ; G ; S ; L |- e1 || e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2 ; R2

% Typing for unary operators
pm ; R ; pc ; G ; S ; L |- e : bool :> p { P } -| G1 ; L1 ; R1
----------------------------------------------------------------------  :: unary_op_not_typing
pm ; R ; pc ; G ; S ; L |- not e : bool :> join pc p { no_pred } -| G1 ; L1 ; R1

% New ref creation with region types
% ref creates a reference with pc poison status and allocates fresh logical location l
% The region type ref @ { l } precisely tracks which logical location is allocated
% Predicate P is preserved only when the write is not control-poisoned;
% poisoned control stores AppPred pc P = no_pred.
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e : int :> p { P } -| G1 ; L1 ; R1
  fresh l
----------------------- :: ref
pm ; R ; pc ; G ; S ; L |- ref e : ref @ { l } :> pc { no_pred } -| G1[l |-> join pc p { AppPred pc P }] ; L1 ; R1

% Assignment (singleton locset): strong update through clean reference
% The result (unit) is poisoned if the pc is poisoned. The stored value
% is poisoned if the assignment is poisoned, or the value is poisoned.
% Predicate from e2 is preserved only when the write is not control-poisoned.
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e1 : ref @ { l } :> clean { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
invalidate_deps L2 { l } = L3
invalidate_regime_deps R2 L2 { l } = R3
----------------------- :: assign_singleton
pm ; R ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc clean { no_pred } -| G2[l |-> join pc p2 { AppPred pc P2 }] ; L3 ; R3

% Assignment (non-singleton locset): weak update through clean reference
% Joins stored poison/predicate with existing memory entries via JoinPoisons and MergePreds.
% This ensures soundness when the typechecker cannot determine which location
% in the locset will be updated at runtime. The write-side predicate is first
% gated by AppPred pc _ so control-poisoned writes do not preserve guards.
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e1 : ref @ LS0 :> clean { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
invalidate_deps L2 LS0 = L3
invalidate_regime_deps R2 L2 LS0 = R3
JoinPoisons G2 LS0 = p3
MergePreds G2 LS0 = P3
JoinP AppPred pc P2 P3 = P4
----------------------- :: assign_locset
pm ; R ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc clean { no_pred } -| G2[LS0 |-> join p3 join pc p2 { P4 }] ; L3 ; R3

% Assignment (singleton locset): strong update through poisoned reference
% Writing through a poisoned reference erases predicates (stores no_pred),
% mirroring deref_poisoned behaviour. This prevents untrusted writes from
% introducing guard tags that could spuriously make locations clean-under-R.
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e1 : ref @ { l } :> poisoned { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
invalidate_deps L2 { l } = L3
invalidate_regime_deps R2 L2 { l } = R3
----------------------- :: assign_singleton_poisoned_ref
pm ; R ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc poisoned { no_pred } -| G2[l |-> poisoned { no_pred }] ; L3 ; R3

% Assignment (non-singleton locset): weak update through poisoned reference
% Writing through a poisoned reference erases predicates (stores no_pred).
% Poison is still joined with existing cells, but predicates are not merged.
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e1 : ref @ LS0 :> poisoned { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2 ; R2
invalidate_deps L2 LS0 = L3
invalidate_regime_deps R2 L2 LS0 = R3
JoinPoisons G2 LS0 = p3
----------------------- :: assign_locset_poisoned_ref
pm ; R ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc poisoned { no_pred } -| G2[LS0 |-> poisoned { no_pred }] ; L3 ; R3

% Dereference with logical location sets.
% A poisoned reference yields a poisoned result (predicate erased).
% NOTE: Memory can only store integers (matching runtime semantics)
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> poisoned { P } -| G1 ; L1 ; R1
----------------------- :: deref_poisoned
pm ; R ; pc ; G ; S ; L |- !e : int :> poisoned { no_pred } -| G1 ; L1 ; R1

% No-predicate case: merge predicates across LS0 yields no_pred; poison joins all cells.
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = no_pred
  JoinPoisons G1 LS0 = p
----------------------- :: deref_no_pred
pm ; R ; pc ; G ; S ; L |- !e : int :> join pc p { no_pred } -| G1 ; L1 ; R1

% Guarded predicate evaluates to true after merging across LS0 (de-poison).
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k pred_closure pcl
  L1(k) = true using LS
----------------------- :: deref_guard_true
pm ; R ; pc ; G ; S ; L |- !e : int :> pc { no_pred } -| G1 ; L1 ; R1

% Guard-only predicate evaluates to true after merging.
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k
  L1(k) = true using LS
----------------------- :: deref_guard_only_true
pm ; R ; pc ; G ; S ; L |- !e : int :> pc { no_pred } -| G1 ; L1 ; R1

% Guarded predicate evaluates to false after merging (forces poisoning).
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k pred_closure pcl
  L1(k) = false using LS
----------------------- :: deref_guard_false
pm ; R ; pc ; G ; S ; L |- !e : int :> poisoned { no_pred } -| G1 ; L1 ; R1

% Guard-only predicate evaluates to false after merging.
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k
  L1(k) = false using LS
----------------------- :: deref_guard_only_false
pm ; R ; pc ; G ; S ; L |- !e : int :> poisoned { no_pred } -| G1 ; L1 ; R1

% Guarded predicate present but tag not known in L: poison joins all cells; predicate retained.
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k pred_closure pcl
  JoinPoisons G1 LS0 = p
----------------------- :: deref_guard_unknown
pm ; R ; pc ; G ; S ; L |- !e : int :> join pc p { guard k pred_closure pcl } -| G1 ; L1 ; R1

% Guard-only predicate present but tag not known in L.
pm ; R ; pc ; G ; S ; L |- e : ref @ LS0 :> clean { P } -| G1 ; L1 ; R1
  MergePreds G1 LS0 = guard k
  JoinPoisons G1 LS0 = p
----------------------- :: deref_guard_only_unknown
pm ; R ; pc ; G ; S ; L |- !e : int :> join pc p { guard k } -| G1 ; L1 ; R1

-------------------------------  :: unit
pm ; R ; pc ; G ; S ; L |- unit : unit :> clean { no_pred } -| G ; L ; R

% The result type is the type of the second expression T2. This is  a conservative
% approach. Alternatively, we could ignore e1's poison in result, as the e1's
% value is propagated to e2.
pm ; R ; pc ; G ; S ; L |- e1 : T1 :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
-------------------------------  :: seq
pm ; R ; pc ; G ; S ; L |- e1 ; e2  : T2 :> p2 { P2 } -| G2 ; L2 ; R2

% Function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
% The closure is stored as a singleton (just the closure, not a list).
----------------------------------------------------------------------  :: fn_abs
pm ; R ; pc ; G ; S ; L |- fn x : ST1 => e : ST2 : ST1 -> ST2 # pc tclosures ( x , e , S ) :> pc { no_pred } -| G ; L ; R

% Pure function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
% The closure is stored as a singleton (just the closure, not a list).
----------------------------------------------------------------------  :: pfn_abs
pm ; R ; pc ; G ; S ; L |- pfn x : ST1 => pe : ST2 : ST1 -> ST2 # pc tpclosures ( x , pe , S ) :> pc { no_pred } -| G ; L ; R

% Function application typing - singleton closure case - result is arrow type
% Premises follow argument-first call-by-value order: type e2, then type e1.
% When the closure list contains a single closure (x, e, S1) and the result is an arrow type:
% Type-check the body e in the captured context S1 extended with the actual argument.
% The predicate is no_pred (predicates are only meaningful for basic types.
% Please note that impure function application is disallowed in pure context.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
T2 = ST3 -> ST4 # p4 tclosures tcls2
----------------------------------------------------------------------  :: app_fn_singleton_arrow
impure ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { no_pred } -| G3 ; L3 ; R3

% Function application typing - singleton closure case - result is parrow type
% When the closure list contains a single closure (x, e, S1) and the result is a parrow type:
% Type-check the body e in the captured context S1 extended with the actual argument.
% The predicate is no_pred (predicates are only meaningful for basic types.
% Please note that impure function application is disallowed in pure context.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
T2 = ST3 -> ST4 # p4 tpclosures ptcls2
----------------------------------------------------------------------  :: app_fn_singleton_parrow
impure ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { no_pred } -| G3 ; L3 ; R3

% Function application typing - singleton closure case - result is non-function type
% When the closure list contains a single closure (x, e, S1) and the result is not a function type:
% Type-check the body e in the captured context S1 extended with the actual argument.
% Please note that impure function application is disallowed in pure context.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
p6 = join p1 p
----------------------------------------------------------------------  :: app_fn_singleton
impure ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { AppPred p6 P3 } -| G3 ; L3 ; R3

% Function application typing - multiple closures case - result is arrow type
% When both the head and tail applications return arrow types:
% 1. Apply the head closure (x, e, S1) to get arrow result T' with poison p' and environments (G', L')
% 2. Recursively apply the tail closures tcls' to get arrow result T'' with poison p'' and environments (G'', L'')
%    NOTE: e0 is a fresh metavariable representing "a function with type having only the tail closures tcls'".
%    This premise expresses structural recursion over the closure set: the rule applies to e0 e2,
%    which will bottom out at app_fn_singleton when tcls' is a singleton.
% 3. Both results must be impure arrow types with the same surface types
% 4. Merge the closure sets from both results via union
% 5. Join all outputs: poisons, memory environments, tag environments, regimes
%    For closure-alternative joins, memory uses JoinGStrong so single-sided
%    entries do not carry branch/alternative-local predicates into the merged
%    post-context.
% Please note that impure function application is disallowed in pure context.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) , tcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T' :> p' { P' } -| G' ; L' ; R'
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tclosures tcls' :> p1 { P1 } -| G1 ; L1 ; R1
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' = ST3 -> ST4 # p3 tclosures tcls3
T'' = ST3 -> ST4 # p4 tclosures tcls4
p5 = join p3 p4
tcls5 = tcls3 U tcls4
----------------------------------------------------------------------  :: app_fn_cons_arrow
impure ; R ; pc ; G ; S ; L |- e1 e2 : ST3 -> ST4 # p5 tclosures tcls5 :> join pc join p1 join p join p' p'' { no_pred } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''

% Function application typing - multiple closures case - result is non-arrow type (reference result)
% When both head and tail applications return references with the same inner type, join locsets.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) , tcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T' :> p' { P' } -| G' ; L' ; R'
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tclosures tcls' :> p1 { P1 } -| G1 ; L1 ; R1
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' = ref @ LS1
T'' = ref @ LS2
LS = LS1 U LS2
JoinP P' P'' = P3
p6 = join p1 p
----------------------------------------------------------------------  :: app_fn_cons_ref
impure ; R ; pc ; G ; S ; L |- e1 e2 : ref @ LS :> join pc join p1 join p join p' p'' { AppPred p6 P3 } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''

% Function application typing - multiple closures case - result is non-arrow type (base result)
% When results are non-reference, non-arrow types, signature compatibility forces equality; the result type is that base type.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures ( x , e , S1 ) , tcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
impure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- e : T' :> p' { P' } -| G' ; L' ; R'
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tclosures tcls' :> p1 { P1 } -| G1 ; L1 ; R1
impure ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' ≈ T''
JoinP P' P'' = P3
p6 = join p1 p
----------------------------------------------------------------------  :: app_fn_cons
impure ; R ; pc ; G ; S ; L |- e1 e2 : T' :> join pc join p1 join p join p' p'' { AppPred p6 P3 } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''

% Pure function application typing - singleton closure case - result is arrow type
% Premises follow argument-first call-by-value order: type e2, then type e1.
% When the closure list contains a single closure (x, pe, S1) and the result is an arrow type:
% Type-check the body pe in the captured context S1 extended with the actual argument.
% The predicate is no_pred (predicates are only meaningful for basic types.
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms).
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
T2 = ST3 -> ST4 # p4 tclosures tcls2
----------------------------------------------------------------------  :: app_pfn_singleton_arrow
pm ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { no_pred } -| G3 ; L3 ; R3

% Pure function application typing - singleton closure case - result is parrow type
% When the closure list contains a single closure (x, pe, S1) and the result is a parrow type:
% Type-check the body pe in the captured context S1 extended with the actual argument.
% The predicate is no_pred (predicates are only meaningful for basic types.
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms).
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
T2 = ST3 -> ST4 # p4 tpclosures ptcls2
----------------------------------------------------------------------  :: app_pfn_singleton_parrow
pm ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { no_pred } -| G3 ; L3 ; R3

% Pure function application typing - singleton closure case - result is non-function type
% When the closure list contains a single closure (x, pe, S1) and the result is not a function type:
% Type-check the body pe in the captured context S1 extended with the actual argument.
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms).
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T2 :> p3 { P3 } -| G3 ; L3 ; R3
ST2 <: T2
p6 = join p1 p
----------------------------------------------------------------------  :: app_pfn_singleton
pm ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p p3 { AppPred p6 P3 } -| G3 ; L3 ; R3

% Pure function application typing - multiple closures case - result is pure arrow type
% When both the head and tail applications return pure arrow types:
% 1. Apply the head closure (x, pe, S1) to get pure arrow result T' with poison p' and environments (G', L')
% 2. Recursively apply the tail closures ptcls' to get pure arrow result T'' with poison p'' and environments (G'', L'')
%    NOTE: e0 is a fresh metavariable representing "a pure function with type having only the tail closures ptcls'".
%    This premise expresses structural recursion over the closure set: the rule applies to e0 e2,
%    which will bottom out at app_pfn_singleton when ptcls' is a singleton.
% 3. Both results must be pure arrow types with the same surface types
% 4. Merge the closure sets from both results via union
% 5. Join all outputs: poisons, memory environments, tag environments, regimes
%    For closure-alternative joins, memory uses JoinGStrong so single-sided
%    entries do not carry branch/alternative-local predicates into the merged
%    post-context.
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms).
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) , ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T' :> p' { P' } -| G' ; L' ; R'
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tpclosures ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' = ST3 -> ST4 # p3 tpclosures ptcls3
T'' = ST3 -> ST4 # p4 tpclosures ptcls4
p5 = join p3 p4
ptcls5 = ptcls3 U ptcls4
----------------------------------------------------------------------  :: app_pfn_cons_arrow
pm ; R ; pc ; G ; S ; L |- e1 e2 : ST3 -> ST4 # p5 tpclosures ptcls5 :> join pc join p1 join p join p' p'' { no_pred } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''

% Pure function application typing - multiple closures case - result is non-arrow type (reference result)
% When both head and tail applications return references with the same inner type, join locsets.
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) , ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T' :> p' { P' } -| G' ; L' ; R'
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tpclosures ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' = ref @ LS1
T'' = ref @ LS2
LS = LS1 U LS2
JoinP P' P'' = P3
p6 = join p1 p
----------------------------------------------------------------------  :: app_pfn_cons_ref
pm ; R ; pc ; G ; S ; L |- e1 e2 : ref @ LS :> join pc join p1 join p join p' p'' { AppPred p6 P3 } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''

% Pure function application typing - multiple closures case - result is non-arrow type (base result)
% When results are non-reference, non-arrow types, signature compatibility forces equality; the result type is that base type.
pm ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tpclosures ( x , pe , S1 ) , ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
ST1 <: T1
pure ; R1 ; join p join p1 pc ; G1 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L1 |- pe : T' :> p' { P' } -| G' ; L' ; R'
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 : ST1 -> ST2 # p tpclosures ptcls' :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R2 ; pc ; G2 ; S ; L2 |- e0 e2 : T'' :> p'' { P'' } -| G'' ; L'' ; R''
ST2 <: T'
T' ≈ T''
JoinP P' P'' = P3
p6 = join p1 p
----------------------------------------------------------------------  :: app_pfn_cons
pm ; R ; pc ; G ; S ; L |- e1 e2 : T' :> join pc join p1 join p join p' p'' { AppPred p6 P3 } -| JoinGStrong G' G'' ; JoinL L' L'' ; JoinR R' R''


% Typing for Let Bindings

%
% A critical consideration is whether the context poison should be combined with
% the variable poison in the result. The current approach integrates the context
% poison with the variable poison. Consider the following illustrative example:
%
% if poisoned_sensor > 0 then      // pc = poisoned
%    let y = 42 in 17       // e2 does not use y
% else
%    0
% In this scenario, the let binding is deemed poisoned because the context
% poison is indeed poisoned.
%
% Predicates are propagated from e1 to x, and the result gets predicate from e2
% Note: Lexical scoping - the final variable environment S excludes the let-bound variable x
% The logical environment L1' from evaluating e2 is preserved (knowledge about predicates persists)
not_harmful_shadow x S R
pm ; R ; pc ; G ; S ; L |- e1 : T :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; pc ; G1 ; S[x |-> T :> p1  { P1 }] ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
----------------------------------------------------------------------  :: let
pm ; R ; pc ; G ; S ; L |- let x = e1 in e2 : T2 :> join pc p2 { P2 } -| G2 ; L2 ; R2


% Conditional typing with predicate-based de-poisoning - impure function result - R(k) unknown
% When R does not fix the guard outcome, use conservative fallback (poison branch pc, join results)
match_guard e1 G S = k with LS
R(k) = none
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R[k |-> true] ; join pc p1 ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R[k |-> false] ; join pc p1 ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tclosures tcls2
T3 = ST1 -> ST2 # p'' tclosures tcls3
p = join p' p''
tcls = tcls2 U tcls3
----------------------------------  :: if_depoison_fn_R_unknown
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tclosures tcls :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Conditional typing with predicate-based de-poisoning - impure function result - R(k) = true
% When R fixes the guard outcome to true, only the then-branch is effective
match_guard e1 G S = k with LS
R(k) = true
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tclosures tcls2
T3 = ST1 -> ST2 # p'' tclosures tcls3
----------------------------------  :: if_depoison_fn_R_true
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p' tclosures tcls2 :> join pc p2 { no_pred } -| G2 ; L2 ; R2

% Conditional typing with predicate-based de-poisoning - impure function result - R(k) = false
% When R fixes the guard outcome to false, only the else-branch is effective
match_guard e1 G S = k with LS
R(k) = false
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tclosures tcls2
T3 = ST1 -> ST2 # p'' tclosures tcls3
----------------------------------  :: if_depoison_fn_R_false
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p'' tclosures tcls3 :> join pc p3 { no_pred } -| G3 ; L3 ; R3

% Conditional typing with predicate-based de-poisoning - pure function result - R(k) unknown
% When R does not fix the guard outcome, use conservative fallback (poison branch pc, join results)
match_guard e1 G S = k with LS
R(k) = none
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R[k |-> true] ; join pc p1 ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R[k |-> false] ; join pc p1 ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
p = join p' p''
ptcls = ptcls2 U ptcls3
----------------------------------  :: if_depoison_pfn_R_unknown
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tpclosures ptcls :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Conditional typing with predicate-based de-poisoning - pure function result - R(k) = true
% When R fixes the guard outcome to true, only the then-branch is effective
match_guard e1 G S = k with LS
R(k) = true
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
----------------------------------  :: if_depoison_pfn_R_true
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p' tpclosures ptcls2 :> join pc p2 { no_pred } -| G2 ; L2 ; R2

% Conditional typing with predicate-based de-poisoning - pure function result - R(k) = false
% When R fixes the guard outcome to false, only the else-branch is effective
match_guard e1 G S = k with LS
R(k) = false
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
----------------------------------  :: if_depoison_pfn_R_false
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p'' tpclosures ptcls3 :> join pc p3 { no_pred } -| G3 ; L3 ; R3

% Conditional typing with predicate-based de-poisoning - reference result - R(k) unknown
% When R does not fix the guard outcome, use conservative fallback (poison branch pc, join results)
match_guard e1 G S = k with LS
R(k) = none
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R[k |-> true] ; join pc p1 ; G ; S ; L[k |-> true using LS] |- e2 : ref @ LS1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R[k |-> false] ; join pc p1 ; G ; S ; L[k |-> false using LS] |- e3 : ref @ LS2 :> p3 { P3 } -| G3 ; L3 ; R3
LS = LS1 U LS2
----------------------------------  :: if_depoison_ref_R_unknown
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ref @ LS :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Conditional typing with predicate-based de-poisoning - reference result - R(k) = true
% When R fixes the guard outcome to true, only the then-branch is effective
match_guard e1 G S = k with LS
R(k) = true
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : ref @ LS1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : ref @ LS2 :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_ref_R_true
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ref @ LS1 :> join pc p2 { no_pred } -| G2 ; L2 ; R2

% Conditional typing with predicate-based de-poisoning - reference result - R(k) = false
% When R fixes the guard outcome to false, only the else-branch is effective
match_guard e1 G S = k with LS
R(k) = false
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : ref @ LS1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : ref @ LS2 :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_ref_R_false
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ref @ LS2 :> join pc p3 { no_pred } -| G3 ; L3 ; R3

% Conditional typing with predicate-based de-poisoning - general non-reference case - R(k) unknown
% When R does not fix the guard outcome, use conservative fallback (poison branch pc, join results)
match_guard e1 G S = k with LS
R(k) = none
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R[k |-> true] ; join pc p1 ; G ; S ; L[k |-> true using LS] |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R[k |-> false] ; join pc p1 ; G ; S ; L[k |-> false using LS] |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_R_unknown
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Conditional typing with predicate-based de-poisoning - general non-reference case - R(k) = true
% When R fixes the guard outcome to true, only the then-branch is effective
match_guard e1 G S = k with LS
R(k) = true
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_R_true
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc p2 { no_pred } -| G2 ; L2 ; R2

% Conditional typing with predicate-based de-poisoning - general non-reference case - R(k) = false
% When R fixes the guard outcome to false, only the else-branch is effective
match_guard e1 G S = k with LS
R(k) = false
pure ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L ; R
pm ; R ; pc ; G ; S ; L[k |-> true using LS] |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R ; pc ; G ; S ; L[k |-> false using LS] |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_depoison_R_false
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc p3 { no_pred } -| G3 ; L3 ; R3

% Standard conditional typing rule - impure function result
% (used when no matching predicate found)
% When both branches return impure function types with matching surface types (ST1, ST2):
%   - Branch types T2 and T3 are both impure arrow types with the same surface types
%   - Arrow-internal poisons p' and p'' are joined
%   - Outer qualified-type poisons p2 ⊔ p3 are joined
%   - Closure sets tcls2 and tcls3 are merged via union (deduplicating closures)
%   - Guard poison p1 is also included in result poison
%   - Result: (ST1 -> ST2 # (p' ⊔ p'') tclosures (tcls2 ∪ tcls3)) :> (pc ⊔ p1 ⊔ p2 ⊔ p3)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tclosures tcls2
T3 = ST1 -> ST2 # p'' tclosures tcls3
p = join p' p''
tcls = tcls2 U tcls3
----------------------------------  :: if_std_fn
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tclosures tcls :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - pure function result
% (used when no matching predicate found)
% When both branches return pure function types with matching surface types (ST1, ST2):
%   - Branch types T2 and T3 are both pure arrow types with the same surface types
%   - Arrow-internal poisons p' and p'' are joined
%   - Outer qualified-type poisons p2 ⊔ p3 are joined
%   - Closure sets ptcls2 and ptcls3 are merged via union (deduplicating closures)
%   - Guard poison p1 is also included in result poison
%   - Result: (ST1 -> ST2 # (p' ⊔ p'') tpclosures (ptcls2 ∪ ptcls3)) :> (pc ⊔ p1 ⊔ p2 ⊔ p3)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T3 :> p3 { P3 } -| G3 ; L3 ; R3
T2 = ST1 -> ST2 # p' tpclosures ptcls2
T3 = ST1 -> ST2 # p'' tpclosures ptcls3
p = join p' p''
ptcls = ptcls2 U ptcls3
----------------------------------  :: if_std_pfn
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ST1 -> ST2 # p tpclosures ptcls :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - reference result (no predicate match)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : ref @ LS1 :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : ref @ LS2 :> p3 { P3 } -| G3 ; L3 ; R3
LS = LS1 U LS2
----------------------------------  :: if_std_ref
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : ref @ LS :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% Standard conditional typing rule - general non-reference case (no predicate match)
pm ; R ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1 ; R1
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e2 : T :> p2 { P2 } -| G2 ; L2 ; R2
pm ; R1 ; join pc p1 ; G1 ; S ; L1 |- e3 : T :> p3 { P3 } -| G3 ; L3 ; R3
----------------------------------  :: if_std
pm ; R ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p1 join p2 p3 { no_pred } -| JoinGStrong G2 G3 ; JoinL L2 L3 ; JoinR R2 R3

% --- Extern typing rules ---
% Extern expressions use symbolic tag indices (ki) in their SyntaxPredicates.
% At each use site, freshTags collects distinct ki values and allocates fresh
% concrete tags k starting from the current next-tag counter. The resolve
% operation then maps each symbolic predicate to a concrete Predicate using
% the tag map TM and the current variable typing environment S.
%
% This ensures that two calls to the same extern function get independent
% tags, preventing one validation from incorrectly de-poisoning the other.

% Extern value (base type): let x = extern val : (ST :> p { SP })
% ST must be a base type (int, bool, unit, string). Arrow types and non-int refs are rejected.
% Allocate fresh tags for SP, resolve to concrete predicate P.
% externValConvert maps the surface type ST to the enriched type T and possibly
% updated memory environment G'. For base types (int, bool, unit, string), T = ST
% and G' = G. For ref int, T = ref @ {l} with a fresh l, and G' = G[l |-> clean {no_pred}].
% Arrow types and ref T where T != int have no derivation (rejected).
extern_wf p SP
externValConvert ST G = T G'
freshTags SP k = k' TM
resolve TM SP S = P
----------------------------------------------------------------------  :: extern_val
pm ; R ; pc ; G ; S ; L |- extern_val @ eid ST p SP : T :> p { P } -| G' ; L ; R

% Extern impure function: extern fn @ eid x : Q1 -> ER , effects: ESL
% The argument qualified type Q1 is the caller-side precondition: it states what
% the actual argument must satisfy (cleanness under the regime and/or a predicate
% shape) for the trusted boundary result to apply. Q1 is recorded on the closure
% and consulted at each call site (satisfiesArgCond); it carries weaker
% well-formedness than return/effect specs and may be clean-with-predicate.
% The function is wrapped in an extern typing closure containing the precondition
% Q1, the unresolved return spec ER, effect list ESL, and captured environment S.
% Tag resolution for the return is deferred to application time (each call gets
% fresh tags); the argument precondition Q1 is resolved once here, at declaration.
% The optional captures: clause CSL lists declared read dependencies on the caller
% environment (bare-variable targets x :> Q) and memory (bang targets ! x :> Q).
% Like Q1, CSL is a call-site gate: a trusted clean result is available only when
% capturesSatisfied R CSL S G holds, fused with satisfiesArgCond into one guard at
% application. The declared CSL is the trusted CONTRACT: it is recorded on the
% produced closure member (one captures value per extern id, equal to the source
% contract, consistent across the typed closure, the reachable declaration, and
% the runtime declaration), and capturesSatisfied enforces it at the call boundary.
% The closure's runtime body-AST captures is a SEPARATE (two-track) field that the
% runtime return-shape check validateExternReturn compares MODULO captures (the
% body shape, not the contract). For presentation the extern_tcl form below elides
% CSL on the closure; the implementation carries it on the closure member.
% returnType extracts the surface return type from ER (recursively for nested specs).
% base_of Q1 = ST1 extracts the surface base type of the precondition; the arrow
% domain stays the bare surface type ST1 (shared with native fn), so the runtime
% ST1 <: T1 match at the call site is unchanged. The return qualified type is
% unchanged (output de-poisoning contract).
% extern_spec_wf ensures all (poison, SP) pairs in ER and ESL satisfy extern_wf
% (clean types cannot carry predicates); it is NOT applied to the argument Q1.
% This is enforced at parse time.
extern_spec_wf ER ESL
base_of Q1 = ST1
returnType ER = ST2
----------------------------------------------------------------------  :: extern_fn
pm ; R ; pc ; G ; S ; L |- extern_fn @ eid x Q1 ER ESL CSL : ST1 -> ST2 # pc tclosures extern_tcl @ eid ( x , Q1 , ER , ESL , S ) :> pc { no_pred } -| G ; L ; R

% Extern pure function: extern pfn @ eid x : Q1 -> ER
% The argument qualified type Q1 is the caller-side precondition (as for extern_fn).
% The function is wrapped in an extern pure typing closure carrying Q1.
% Tag resolution for the return is deferred to application time (each call gets
% fresh tags); the argument precondition Q1 is resolved once here, at declaration.
% The optional captures: clause CSL has the same call-site meaning as in
% extern_fn: it is recorded as the trusted read-dependency contract on the pure
% closure member and enforced by capturesSatisfied at application.
% base_of Q1 = ST1 extracts the surface base type; the arrow domain stays the bare
% surface type ST1 so the runtime ST1 <: T1 match is unchanged. The return
% qualified type is unchanged.
% extern_spec_wf ensures all predicates in ER satisfy extern_wf; it is NOT applied
% to the argument Q1.
extern_spec_wf ER empty
base_of Q1 = ST1
returnType ER = ST2
----------------------------------------------------------------------  :: extern_pfn
pm ; R ; pc ; G ; S ; L |- extern_pfn @ eid x Q1 ER CSL : ST1 -> ST2 # pc tpclosures extern_ptcl @ eid ( x , Q1 , ER , S ) :> pc { no_pred } -| G ; L ; R

% Side condition (not a typing rule): within a program, the set of extern
% identifiers @eid appearing in extern_val / extern_fn / extern_pfn forms
% (including those inside nested_fn / nested_pfn return descriptors) must be
% globally unique.  Duplicates are rejected during typechecking.

% --- Extern closure application rules ---
% When an extern typing closure is applied, tags are resolved fresh at each call site.
%
% For simple returns: allocReturnEffectTags collects the return pred SP together
% with all effect preds from ESL, allocates fresh tags from k in a single pass,
% producing one shared tag map TM. Both resolve and resolveEffects use this TM.
%
% For nested returns: only the outer effect preds are allocated via allocEffectTags.
% The inner return spec ER' is NOT touched — it is wrapped unchanged into a new
% extern closure, ensuring deferred resolution at the next application.
%
% resolveEffects resolves each effect's predicate via TM and applies the resulting
% memory updates to G.
%
% Call-site regime extension (doc/extern-regime.md, sections 4.1 and 4.3): each
% extern typing closure carries the extern id eid that produced it. At application,
% extendExternRegime eid TM R1 = R' inserts into the active regime R1 the freshly
% generated output tags in the codomain of TM that the extern-regime policy selects
% for eid; unselected extern ids leave R1 unchanged. The TM fed to extendExternRegime
% is exactly the one already used to resolve this call's predicates, so the three
% allocation forms feed the same metafunction: allocReturnEffectTags (simple impure
% returns: return pred + effects), allocEffectTags (nested impure returns: outer
% effects only — inner ER' tags stay deferred until the nested extern is applied),
% and freshTags (simple pure returns: return pred only). An effect tag whose
% predicate is erased under a poisoned effect-pc (resolveEffectsPoisoned) may still
% receive a regime entry, but it is inert: no live value or memory predicate mentions
% it, so it cannot drive de-poisoning.
%
% The per-id selection is governed by an *ambient* extern-regime policy — the Ott
% analogue of the typechecker's `ctx.externRegime` field, keyed by eid. Like that
% field, the policy is configuration of the typing run, not a component of the
% judgment form `pm ; R ; pc ; G ; S ; L |- e : Q -| G1 ; L1 ; R1`; extendExternRegime
% reads it implicitly, just as R itself is the only regime threaded syntactically.
%
% Two forms leave the regime unchanged, faithfully matching the Lean typechecker.
% (1) The standalone extern_val rule does not invoke the policy: it still allocates a
% TM for its own predicate (premise freshTags SP k = k' TM), but has no
% extendExternRegime premise and concludes with the incoming R, mirroring
% typecheckExternVal, which threads ctx.regime through unchanged and does not call
% applyExternRegimePolicy. The user-facing design (sections 4.1, 4.3, 4.6) is framed
% around extern *application* sites; immediate extern *values* are not covered by the
% current implementation, and this spec encodes that implementation behavior rather
% than asserting it as settled design. (2) The pure nested-return rules
% (app_extern_pfn_nested_*) allocate no outer output tags at their own call site (no
% freshTags / allocEffectTags premise), so there is nothing to insert and they too
% conclude with the incoming R.

% --- Extern argument-condition gate (caller precondition) ---
% Every extern application carries a satisfiesArgCond premise: the actual argument
% qualified type (the substituted T1 :> join pc p2 { P2 } recorded in the body
% environment) must satisfy the closure's declared argument precondition Q1 under the
% regime R1 in force after the function expression is typed. If it does not, the
% premise fails and the application is ill-typed (enforcement is by rejection; there
% is no conservative fallback rule). The gate fires at every curried level, against
% the applied closure's Q1, because each application consumes one argument. The
% existing ST1 <: T1 runtime-type match is kept as well: it checks surface-type
% erasure on the arrow domain, while satisfiesArgCond is the full precondition
% (poison-under-regime and predicate shape). The result-poison computations and the
% return qualified type are unchanged: the return contract still governs cleanness;
% the precondition is the gate under which the trusted result is honest.

% Extern impure function application - simple return, clean effect pc
% allocReturnEffectTags produces one shared TM for both the return pred SP and effects.
% base_extern_type: extern functions cannot return ref or arrow types.
% ST2 <: T2 converts the surface return type to enriched type (identity for base types).
% The effect-pc gate is `join pc (join p1 p)`: predicates are stored as
% resolved only when the caller's pc, the function expression's outer poison
% p1, and the arrow-internal poison p are all clean.
% satisfiesArgCond gates the application on the declared precondition Q1 (see above).
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , simple ST2 p3 SP , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = clean
ST1 <: T1
base_extern_type ST2
ST2 <: T2
allocReturnEffectTags SP ESL k = k' TM
resolve TM SP S1 [ x |-> T1 :> join pc p2 { P2 } ] = P
resolveEffects ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
p6 = join p1 p
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_simple_clean
impure ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p join pc p3 { AppPred p6 P } -| G1' ; L1 ; R'

% Extern impure function application - simple return, poisoned effect pc
% When the gate `join pc (join p1 p)` is poisoned, effect-installed predicates
% are erased to noPred (resolveEffectsPoisoned), mirroring assignment under
% poisoned pc and the application-result provenance gate.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , simple ST2 p3 SP , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = poisoned
ST1 <: T1
base_extern_type ST2
ST2 <: T2
allocReturnEffectTags SP ESL k = k' TM
resolve TM SP S1 [ x |-> T1 :> join pc p2 { P2 } ] = P
resolveEffectsPoisoned ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
p6 = join p1 p
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_simple_poisoned
impure ; R ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc join p1 join p join pc p3 { AppPred p6 P } -| G1' ; L1 ; R'

% Extern impure function application - nested impure fn return, clean effect pc
% Only outer effect preds in ESL are allocated via allocEffectTags.
% The inner return spec ER' is NOT resolved; it is wrapped in a new extern_tcl
% with the updated captured environment (deferred inner resolution).
% Predicates are stored as resolved only when `join pc (join p1 p)` is clean.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , nested_fn @ eid1 x1 Q3 ER' ESL' CSL' , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = clean
ST1 <: T1
base_of Q3 = ST3
allocEffectTags ESL k = k' TM
resolveEffects ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
returnType ER' = ST4
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_nested_fn_clean
impure ; R ; pc ; G ; S ; L |- e1 e2 : ST3 -> ST4 # pc tclosures extern_tcl @ eid1 ( x1 , Q3 , ER' , ESL' , S1 [ x |-> T1 :> join pc p2 { P2 } ] ) :> join pc join p1 p { no_pred } -| G1' ; L1 ; R'

% Extern impure function application - nested impure fn return, poisoned effect pc
% Effect-installed predicates erased; inner return spec deferred as before.
% This rule fires when any of pc, p1, or p is poisoned.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , nested_fn @ eid1 x1 Q3 ER' ESL' CSL' , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = poisoned
ST1 <: T1
base_of Q3 = ST3
allocEffectTags ESL k = k' TM
resolveEffectsPoisoned ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
returnType ER' = ST4
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_nested_fn_poisoned
impure ; R ; pc ; G ; S ; L |- e1 e2 : ST3 -> ST4 # pc tclosures extern_tcl @ eid1 ( x1 , Q3 , ER' , ESL' , S1 [ x |-> T1 :> join pc p2 { P2 } ] ) :> join pc join p1 p { no_pred } -| G1' ; L1 ; R'

% Extern impure function application - nested pure fn return, clean effect pc
% Same pattern: only outer ESL preds allocated; inner ER' deferred in extern_ptcl.
% Predicates are stored as resolved only when `join pc (join p1 p)` is clean.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , nested_pfn @ eid1 x1 Q3 ER' CSL' , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = clean
ST1 <: T1
base_of Q3 = ST3
allocEffectTags ESL k = k' TM
resolveEffects ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
returnType ER' = ST4
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_nested_pfn_clean
impure ; R ; pc ; G ; S ; L |- e1 e2 : ST3 -> ST4 # pc tpclosures extern_ptcl @ eid1 ( x1 , Q3 , ER' , S1 [ x |-> T1 :> join pc p2 { P2 } ] ) :> join pc join p1 p { no_pred } -| G1' ; L1 ; R'

% Extern impure function application - nested pure fn return, poisoned effect pc
% Effect-installed predicates erased; inner pure return spec deferred as before.
% This rule fires when any of pc, p1, or p is poisoned.
impure ; R ; pc ; G ; S ; L |- e2 : T1 :> p2 { P2 } -| G2 ; L2 ; R2
impure ; R2 ; pc ; G2 ; S ; L2 |- e1 : ST1 -> ST2 # p tclosures extern_tcl @ eid ( x , Q1 , nested_pfn @ eid1 x1 Q3 ER' CSL' , ESL , S1 ) :> p1 { P1 } -| G1 ; L1 ; R1
join pc join p1 p = poisoned
ST1 <: T1
base_of Q3 = ST3
allocEffectTags ESL k = k' TM
resolveEffectsPoisoned ESL TM S1 [ x |-> T1 :> join pc p2 { P2 } ] G1 = G1'
returnType ER' = ST4
satisfiesArgCond R1 T1 :> join pc p2 { P2 } Q1
extendExternRegime eid TM R1 = R'
----------------------------------------------------------------------  :: app_extern_fn_nested_pfn_poisoned
