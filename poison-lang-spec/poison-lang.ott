% Derived from `examples/1Bsemantics/l1.ott` in Ott distribution


metavar n, i ::=
  {{ com Numeric literals }}
  {{ phantom }}


metavar location, l ::= 
  {{ com Memory locations }}

metavar var, x ::=
  {{ com Variables }}
  {{ phantom }}
  {{ coq string }}

metavar tag, k ::=
  {{ com Tags for predicates }}
  {{ phantom }}
  {{ coq string }}

metavar deps ::=
  {{ com Dependency sets for tracking heap locations read by predicates }}
  {{ phantom }}
  {{ coq list location }}

grammar 

% Index expressions for use in formulas
idx :: 'IDX_' ::=              {{ com index expressions }}
  | 0                          ::   :: zero
  | 1                          ::   :: one  
  | 2                          ::   :: two
  | i                          ::   :: var
  | n                          ::   :: nat
  | idx1 + idx2                ::   :: plus
  | idx1 - idx2                ::   :: minus
  | idx1 * idx2                ::   :: mult
  | ( idx )                    :: M :: paren  {{ ichlo ([[idx]]) }}

b :: 'B_' ::=              {{ com booleans }}  {{ phantom }} {{ coq bool }}
  | true                    ::   :: true      {{ coq true }}
  | false                   ::   :: false     {{ coq false }}

operations, op :: 'Op_' ::=            {{ com operations }}
  | +                       ::   :: plus
  | -                       ::   :: minus
  | *                       ::   :: mult
  | /                       ::   :: div
  | >=                      ::   :: gteq
  | <=                      ::   :: lteq
  | >                       ::   :: gt
  | <                       ::   :: lt
  | =                       ::   :: eq
  | !=                      ::   :: neq
  | &&                      ::   :: and 
  | &                       ::   :: bitwise_and
  | ||                      ::   :: or

unary_op :: 'UnaryOp_' ::=      {{ com operations }}
  | not                     ::   :: not 

% Surface types for annotations (no runtime info)
styp, ST :: 'ST_' ::=      {{ com surface types (for annotations) }}
  | int                    ::   :: int
  | bool                   ::   :: bool
  | unit                   ::   :: unit
  | string                 ::   :: string 
  | ref ST                 ::   :: ref
  | ST1 -> ST2             ::   :: arrow



e :: 'E_'  ::=	           {{ com expressions }}
  | unit                    ::   :: unit
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | x                       ::   :: var
  | e1 op e2                ::   :: op
  | unary_op e              ::   :: unary_op
  | if e1 then e2 else e3   ::   :: if
  | ref e                   ::   :: new_ref
  | e1 := e2                ::   :: assign
  | ! e                     ::   :: deref
  | e1 ; e2                 ::   :: sequence
  | while e1 do e2          ::   :: while
  | let x = e1 in e2        ::   :: let
  | fn x : ST1 => e : ST2        ::   :: fn   {{ com function with return type annotation }}
  | pfn x : ST1 => pe : ST2      ::   :: pfn  {{ com pure function with return type annotation }}
  | e1 e2                   ::   :: app
  | ( e )                   :: M :: paren  {{ ichlo ([[e]]) }}
  | rand e                  ::   :: rand_app   {{ com random integer generation }}
  | frand e                 ::   :: frand_app  {{ com random float generation }}
  | printInt e              ::   :: printInt_app
  | printString e           ::   :: printString_app 


pe :: 'PE_' ::=            {{ com pure expressions (subset of expressions) }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | x                       ::   :: Var
  | s                       ::   :: string 
  | pe1 op pe2              ::   :: op
  | if pe1 then pe2 else pe3 ::   :: if
  | ! pe                    ::   :: deref
  | unit                    ::   :: unit
  | let x = pe1 in pe2      ::   :: let
  | ( pe )                  :: M :: paren  {{ ichlo ([[pe]]) }}
  | pe1 pe2                 ::   :: app

v :: 'V_' ::=              {{ com values }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | unit                    ::   :: unit    
  | l                       ::   :: location
  | closure ( x , e , r )   ::   :: closure   {{ com closure value }}
  | pe_closure ( x , pe , r )  ::   :: pe_closure   {{ com pure closure value }}

expr_or_value, ev :: 'EV_' ::=  {{ com expression or value }}
  | expr e                  ::   :: expr  {{ com expression }}
  | value v                 ::   :: value {{ com value }}

memory , m {{ tex \mu }} :: 'Memory_' ::=  {{ com memory }} {{ phantom }} {{ coq list (location * integer) }}
   | empty                  ::   :: empty {{ coq [] }}
   | m [ l |-> n ]          ::   :: extend  {{ coq (([[l]],[[n]])::[[m]]) }}

typ, T :: 'T_' ::=         {{ com enriched types }}
  | int                     ::   :: int
  | bool                    ::   :: bool
  | unit                    ::   :: unit
  | string                  ::   :: string 
  | ref T @ l               ::   :: ref {{ tex \mathsf{ref}\,[[T]]\,@\,[[l]] }}
  | ST1 -> ST2 # p typing_closure tcl ::   :: arrow {{ tex [[ST1]] \rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{typing\_closure}\, [[tcl]] }}
  | ST1 -> ST2 # p typing_pclosure ptcl ::   :: parrow {{ tex [[ST1]] \Rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{typing\_pclosure}\, [[ptcl]] }}

% Predicate closure contents (for cleaner syntax)
pcl :: 'PCL_' ::= {{ com predicate closure }}
  | ( x , pe , S )          ::   :: pred_closure

% Typing closures (separate for impure fn and pure pfn)
tcl :: 'TCL_' ::= {{ com typing closure for impure functions }}
  | ( x , e , S )           ::   :: fn_closure

ptcl :: 'PTCL_' ::= {{ com typing closure for pure functions }}
  | ( x , pe , S )          ::   :: pfn_closure

predicate, P :: 'P_' ::= {{ com predicate (pure function from T to bool) }}
  | guard k pred_closure pcl ::   :: pred_closure {{ com predicate as pure closure }} {{tex \mathsf{guard}\,[[k]]\,\mathsf{pred\_closure}\,[[pcl]] }}
  | guard k                   ::   :: guard_only {{ com guard tag only }} {{tex \mathsf{guard}\,[[k]] }}
  | no_pred                   ::   :: no_pred {{ com trivial predicate (always true) }} {{tex {} }}

qualified_type, Q :: 'Q_' ::= {{ com qualified type (type with poison and optional predicate) }}
  | T :> p                  ::   :: qualified {{ tex [[T]] \triangleright [[p]] }}
  | T :> p { P }            ::   :: qualified_pred {{ tex [[T]] \triangleright [[p]]\, \{ [[P]] \} }}

mem_type_assumption, ta :: 'TA_' ::= {{ com memory type assumption }}
  | l : Q                ::   :: loc

G {{ tex \Gamma }} :: G_ ::=     {{ com memory typing environments }} {{ phantom }} {{ coq list mem_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | G , ta                  ::   :: extend {{ coq ([[ta]]::[[G]]) }}
  | JoinG G1 G2             ::   :: JoinG {{ tex [[G1]] \cup [[G2]] }}
  | G [ l |-> Q ]           ::   :: UpdateG {{ tex [[G]] [ l \mapsto [[Q]] ] }}
  | indexG G idx            ::   :: indexG   {{ tex [[G]]^{[[idx]]} }}                  
  | indexedG G idx1 idx2    ::   :: indexedG {{ tex [[G]]_{[[idx1]]}^{[[idx2]]} }}                  

% Variable environment for let bindings
var_type_assumption, va :: 'VA_' ::= {{ com variable type assumption }}
  | x : Q                ::   :: var

S {{ tex \sigma }} :: S_ ::=     {{ com variable typing environments }} {{ phantom }} {{ coq list var_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | S [ x |-> Q ]       ::   :: update {{ coq (([[x]],[[Q]])::[[S]]) }}

% Tag valuation environment
tag_valuation, tv :: 'TV_' ::= {{ com tag valuation }}
  | k : b using deps     ::   :: tag_deps {{ com tag with boolean value and dependency set }}

L {{ tex \mathcal{L} }} :: L_ ::=     {{ com tag valuation environments }} {{ phantom }} {{ coq list tag_valuation }}
  | empty                   ::   :: empty {{ coq [] }}
  | L [ k |-> b using deps ] ::   :: UpdateL {{ tex [[L]] [ k \mapsto [[b]] \text{ using } [[deps]] ] }}
  | invalidate_deps L l     ::   :: InvalidateDeps {{ tex invalidate\_deps([[L]], [[l]]) }} {{ com remove from L all entries whose dependency sets contain location l }}

poison, p, pc :: 'p_' ::= {{ com poison status }} 
  | clean                    ::   :: clean
  | poisoned                 ::   :: poisoned
  | join p1 p2               ::   :: join {{ tex [[p1]] \sqcup [[p2]] }}
  | indexP p idx             ::   :: indexP   {{ tex [[p]]^{[[idx]]} }}                  
  | indexedP p idx1 idx2     ::   :: indexedP {{ tex [[p]]_{[[idx1]]}^{[[idx2]]} }}                  
  
% Variable substitution environment for operational semantics
var_binding, vb :: 'VB_' ::= {{ com variable binding }}
  | x |-> v                  ::   :: binding

var_env, r {{ tex \rho }} :: 'VE_' ::=     {{ com variable substitution environment }} {{ phantom }} {{ coq list var_binding }}
  | empty                   ::   :: empty {{ coq [] }}
  | r [ x |-> v ]          ::   :: update {{ coq (([[x]],[[v]])::[[r]]) }}                  

pure_mode, pm :: 'PM_' ::= {{ com pure mode }} {{ tex \pi }}
  | pure                     ::   :: pure
  | impure                   ::   :: impure                  

terminals :: terminals_ ::=
  | +    :: :: plus
  | -    :: :: minus
  | *    :: :: mult
  | /    :: :: div
  | >=   :: :: gteq      {{ tex \geq }}
  | <=   :: :: lteq      {{ tex \leq }}
  | >    :: :: gt
  | <    :: :: lt
  | |-   :: :: turnstile {{ tex \vdash }}
  | -|   :: :: left_turnstile {{ tex \dashv }}
  | |->  :: :: mapsto    {{ tex \mapsto }}
  | ;    :: :: seq
  | ->   :: :: red       {{ tex \longrightarrow }}
  | <    :: :: la        {{ tex \langle }}
  | >    :: :: ra        {{ tex \rangle }}
  | :>   :: :: ty_poison {{ tex \triangleright }}
  | ;    :: :: sep       {{ tex ; }}
  | AND  :: :: and       {{ tex \land }}
  | range :: :: range   {{ tex range }}
  | =    :: :: eq
  | !=   :: :: neq 
  | in   :: :: in
  | [    :: :: lsquare   {{ tex [ }}
  | ]    :: :: rsquare   {{ tex ] }}
  | @    :: :: at        {{ tex @ }}
  | =>   :: :: lmbd   {{ tex \Rightarrow }}
  | ==>   :: :: beval   {{ tex \Downarrow }}
  | <:   :: :: subtype   {{ tex <: }}

subrules
  pe <:: e

grammar 
formula :: formula_ ::=
  | judgement              :: :: judgement
  | n1 + n2 = n3           :: :: sum         {{ coq ([[n1]]+[[n2]]=[[n3]]) }}
  | n1 - n2 = n3           :: :: diff        {{ coq ([[n1]]-[[n2]]=[[n3]]) }}
  | n1 * n2 = n3           :: :: mult        {{ coq ([[n1]]*[[n2]]=[[n3]]) }}
  | n1 / n2 = n3           :: :: div         {{ coq ([[n1]]/[[n2]]=[[n3]]) }}
  | n1 >= n2 = b           :: :: geq         {{ coq ([[n1]]>=[[n2]]=[[b]]) }}
  | n1 <= n2 = b           :: :: leq         {{ coq ([[n1]]<=[[n2]]=[[b]]) }}
  | n1 > n2 = b            :: :: gt          {{ coq ([[n1]]>[[n2]]=[[b]]) }}
  | n1 < n2 = b            :: :: lt          {{ coq ([[n1]]<[[n2]]=[[b]]) }}
  | n1 = n2 = b            :: :: eq          {{ coq ([[n1]]=[[n2]]=[[b]]) }}
  | n1 != n2 = b           :: :: neq         {{ coq ([[n1]]!=[[n2]]=[[b]]) }}
  | n1 & n2 = n3           :: :: bitwise_and {{ coq ([[n1]]&[[n2]]=[[n3]]) }}
  | b1 && b2 = b3          :: :: band        {{ coq ([[b1]]&&[[b2]]=[[b3]]) }}
  | b1 || b2 = b3          :: :: bor         {{ coq ([[b1]]||[[b2]]=[[b3]]) }}
  | not b = b1             :: :: not_bool   {{ coq ([[b1]] = not [[b]]) }}
  | m ( l ) = n            :: :: lookup      {{ coq (List.find [[l]] [[m]] = Some ([[n]])) }}   
  | G ( l ) = Q        :: :: type_lookup {{ coq (lookup_location_type [[l]] [[G]] = Some ([[Q]])) }}   
  | S ( x ) = Q        :: :: var_type_lookup {{ coq (lookup_var_type [[x]] [[S]] = Some ([[Q]])) }}   
  | r ( x ) = v           :: :: var_lookup {{ coq (lookup_var [[x]] [[r]] = Some ([[v]])) }}   
  | L ( k ) = b using deps :: :: tag_lookup {{ coq (lookup_tag [[k]] [[L]] = Some ([[b]], [[deps]])) }}   
  | p1 = p2                :: :: poison_eq   {{ coq ([[p1]] = [[p2]]) }}   
  | G1 = G2                :: :: type_env_eq {{ coq ([[G1]] = [[G2]]) }}   
  | formula1 AND formula2  :: :: and         {{ tex [[formula1]] \quad [[formula2]] }} {{ coq ([[formula1]] /\ [[formula2]]) }}
  | fresh l                :: :: fresh_loc       {{ com l is fresh }}
  | fresh k                :: :: fresh_tag       {{ com k is fresh }}
  | fresh x S              :: :: fresh_var       {{ com x is fresh in S }}
  | n0 = random n1         :: :: random_gen     {{ com n0 is a random number in [0, n1] range }}
  | match_guard e G S = k with deps  :: :: match_guard  {{ com match\_guard(e, G, S) scans the predicates attached to every heap cell in G and variable in S; if it finds exactly one guard k whose test expression, when applied to its owning value, is syntactically identical to the condition e, it returns that k along with the dependencies deps—otherwise it returns "none" }}  {{ tex match\_guard([[e]], [[G]], [[S]]) = [[k]] \text{ with } [[deps]] }}
  | invalidate_deps L l = L1 :: :: invalidate_deps {{ com invalidate\_deps(L, l) removes from L all entries that have location l in their dependency set }}  {{ tex invalidate\_deps([[L]], [[l]]) = [[L1]] }}
  | ST <: T                :: :: subtype      {{ com ST is a subtype of T (surface type erasure) }} {{ tex [[ST]] <: [[T]] }}
  | pcl = range pe1 pe2 S      :: :: range {{ tex [[pcl]] = ( 0 \leq [[pe1]] \leq [[pe2]] , [[S]]) }}


defns


Jop :: '' ::=

% --- Big-step (natural) semantics below ---

defn
< pm , e , m , r > ==> < v , m1 , r1 > :: :: beval :: ''  {{ com Big-step evaluation }} by

% Literals
----------------------   :: b_lit_num
< pm, n, m, r > ==> < n, m, r >

----------------------   :: b_lit_bool
< pm, b, m, r > ==> < b, m, r >

----------------------   :: b_lit_unit
< pm, unit, m, r > ==> < unit, m, r >

----------------------   :: b_lit_string
< pm, s, m, r > ==> < s, m, r >

% Variables
r(x) = v
--------------------------- :: b_var
< pm, x, m, r > ==> < v, m, r >

% Binary operations (evaluate both operands to values, then compute)
<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 + n2 = n
----------------------   :: b_op_plus
<pm, e1 + e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 - n2 = n
----------------------   :: b_op_minus
<pm, e1 - e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 * n2 = n
----------------------   :: b_op_mult
<pm, e1 * e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 / n2 = n
----------------------   :: b_op_div
<pm, e1 / e2, m, r> ==> < n, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 >= n2 = b
----------------------   :: b_op_gteq
<pm, e1 >= e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 <= n2 = b
----------------------   :: b_op_lteq
<pm, e1 <= e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 > n2 = b
----------------------   :: b_op_gt
<pm, e1 > e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 < n2 = b
----------------------   :: b_op_lt
<pm, e1 < e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 = n2 = b
----------------------   :: b_op_eq
<pm, e1 = e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 != n2 = b
----------------------   :: b_op_neq
<pm, e1 != e2, m, r> ==> < b, m2, r2>

<pm, e1, m, r> ==> < b1, m1, r1>
<pm, e2, m1, r1> ==> < b2, m2, r2>
b1 && b2 = b3
----------------------   :: b_op_and
<pm, e1 && e2, m, r> ==> < b3, m2, r2>

<pm, e1, m, r> ==> < n1, m1, r1>
<pm, e2, m1, r1> ==> < n2, m2, r2>
n1 & n2 = n3
----------------------   :: b_op_bitwise_and
<pm, e1 & e2, m, r> ==> < n3, m2, r2>

<pm, e1, m, r> ==> < b1, m1, r1>
<pm, e2, m1, r1> ==> < b2, m2, r2>
b1 || b2 = b3
----------------------   :: b_op_or
<pm, e1 || e2, m, r> ==> < b3, m2, r2>

<pm, e, m, r> ==> < b, m1, r1>
not b = b1
--------------------------------------------------------------- :: b_unary_op_not 
<pm, not e, m, r> ==> < b1, m1, r1>

% References
<pm, e, m, r> ==> < n, m1, r1>
fresh l
------------------------------ :: b_ref
<pm, ref e, m, r> ==> < l, m1 [ l |-> n ], r1>

% Dereference
<pm, e, m, r> ==> < l, m1, r1>
m1(l) = n
------------------------------ :: b_deref
<pm, !e, m, r> ==> < n, m1, r1>

% Assignment
<pm, e1, m, r> ==> < l, m1, r1>
<pm, e2, m1, r1> ==> < n, m2, r2>
-------------------------------------- :: b_assign
< pm, e1 := e2, m, r > ==> < unit, m2 [ l |-> n ], r2 >

% Sequencing
<pm, e1, m, r> ==> < v1, m1, r1>
<pm, e2, m1, r1> ==> < v2, m2, r2>
-------------------------------------- :: b_seq
< pm, e1 ; e2, m, r > ==> < v2, m2, r2 >

% Conditionals
<pm, e, m, r> ==> < true, m1, r1>
<pm, e1, m1, r1> ==> < v, m2, r2>
---------------------------------------------- :: b_if_true
< pm, if e then e1 else e2, m, r > ==> < v, m2, r2 >

<pm, e, m, r> ==> < false, m1, r1>
<pm, e2, m1, r1> ==> < v, m2, r2>
---------------------------------------------- :: b_if_false
< pm, if e then e1 else e2, m, r > ==> < v, m2, r2 >

% While via if-expansion (keeps close to small step rule)
< pm, if e1 then ( e2 ; while e1 do e2 ) else unit, m, r > ==> < unit, m1, r1 >
--------------------------------------------------------------------------- :: b_while
< pm, while e1 do e2, m, r> ==> < unit, m1, r1 >

% Let binding
% Note: The final environment r1 excludes the let-bound variable x (lexical scoping)
<pm, e1, m, r> ==> < v, m1, r1>
<pm, e2, m1, r1[x |-> v]> ==> < v2, m2, r2>
-------------------------------------------------------- :: b_let
< pm, let x = e1 in e2, m, r > ==> < v2, m2, r1 >

% Function abstraction
--------------------------------------------------------------- :: b_fn_abs
< pm, fn x : ST1 => e : ST2, m, r > ==> < closure(x, e, r), m, r >

% Pure function abstraction
--------------------------------------------------------------- :: b_pfn_abs
< pm, pfn x : ST1 => pe : ST2, m, r > ==> < pe_closure(x, pe, r), m, r >

% Impure function application (call-by-value)
< impure , e2 , m , r > ==> < v , m1 , r1 >
< impure , e1 , m1 , r1 > ==> < closure ( x , e , r3 ) , m2 , r2 >
< impure , e , m2 , r3 [ x |-> v ] > ==> < v0 , m3 , r4 >
--------------------------------------------------------------- :: b_app_closure
< impure , e1 e2 , m , r > ==> < v0 , m3 , r4 >

% Pure function application (no effects)
< pm , pe2 , m , r > ==> < v , m , r >
< pm , pe1 , m , r > ==> < pe_closure ( x , pe , r1 ) , m , r >
< pure , pe , m , r1 [ x |-> v ] > ==> < v0 , m , r >
--------------------------------------------------------------- :: b_app_pure_closure
< pm , pe1 pe2 , m , r > ==> < v0 , m , r >

% Random integer
<pm, e, m, r> ==> < n, m1, r1>
n1 = random n
--------------------------------------------------------------- :: b_rand
<pm, rand e, m, r> ==> < n1, m1, r1>

% Faulty random (same extensional behaviour; typing distinguishes it)
<pm, e, m, r> ==> < n, m1, r1>
n1 = random n
--------------------------------------------------------------- :: b_frand
<pm, frand e, m, r> ==> < n1, m1, r1>

% printInt
<pm, e, m, r> ==> < n, m1, r1>
--------------------------------------------------------------- :: b_printInt
<pm, printInt e, m, r> ==> < unit, m1, r1>

% printString
<pm, e, m, r> ==> < s, m1, r1>
--------------------------------------------------------------- :: b_printString
<pm, printString e, m, r> ==> < unit, m1, r1>

%% --- Typing rules below ---

defn
pm ; pc ; G ; S ; L |- e : Q -| G1 ; L1 :: :: typing :: Ty_ by

------------------  :: int
pm ; pc ; G ; S ; L |- n : int :> clean { no_pred } -| G ; L

------------------  :: bool
pm ; pc ; G ; S ; L |- b : bool :> clean { no_pred } -| G ; L

------------------  :: string 
pm ; pc ; G ; S ; L |- s : string :> clean { no_pred } -| G ; L

% Variable typing - with guarded predicate that evaluates to true triggering de-poisoning.
S(x) = T :> p { guard k pred_closure pcl }
L(k) = true using deps
------------------  :: var_guard_true
pm ; pc ; G ; S ; L |- x : T :> pc { no_pred } -| G ; L

% Variable typing - with guard only that evaluates to true triggering de-poisoning.
S(x) = T :> p { guard k }
L(k) = true using deps
------------------  :: var_guard_only_true
pm ; pc ; G ; S ; L |- x : T :> pc { no_pred } -| G ; L

% Variable typing - with guarded predicate that evaluates to false, triggering poisoning.
S(x) = T :> p { guard k pred_closure pcl }
L(k) = false using deps
------------------  :: var_guard_false
pm ; pc ; G ; S ; L |- x : T :> poisoned { no_pred } -| G ; L

% Variable typing - with guard only that evaluates to false, triggering poisoning.
S(x) = T :> p { guard k }
L(k) = false using deps
------------------  :: var_guard_only_false
pm ; pc ; G ; S ; L |- x : T :> poisoned { no_pred } -| G ; L

% Variable typing - with guarded predicate but tag not in L
S(x) = T :> p { guard k pred_closure pcl }
------------------  :: var_guard_unknown
pm ; pc ; G ; S ; L |- x : T :> join pc p { guard k pred_closure pcl } -| G ; L

% Variable typing - with guard only but tag not in L
S(x) = T :> p { guard k }
------------------  :: var_guard_only_unknown
pm ; pc ; G ; S ; L |- x : T :> join pc p { guard k } -| G ; L

% Variable typing - no guard case
S(x) = T :> p { no_pred }
------------------  :: var_no_pred
pm ; pc ; G ; S ; L |- x : T :> join pc p { no_pred } -| G ; L

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_plus
pm ; pc ; G ; S ; L |- e1 + e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_gteq
pm ; pc ; G ; S ; L |- e1 >= e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_minus
pm ; pc ; G ; S ; L |- e1 - e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_mult
pm ; pc ; G ; S ; L |- e1 * e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_div
pm ; pc ; G ; S ; L |- e1 / e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_lteq
pm ; pc ; G ; S ; L |- e1 <= e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_gt
pm ; pc ; G ; S ; L |- e1 > e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_lt
pm ; pc ; G ; S ; L |- e1 < e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_eq
pm ; pc ; G ; S ; L |- e1 = e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_neq
pm ; pc ; G ; S ; L |- e1 != e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : bool :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_and
pm ; pc ; G ; S ; L |- e1 && e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : int :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : int :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_bitwise_and
pm ; pc ; G ; S ; L |- e1 & e2 : int :> join pc join p1 p2 { no_pred } -| G2 ; L2

pm ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1  
pm ; pc ; G1 ; S ; L1 |- e2 : bool :> p2 { P2 } -| G2 ; L2
-------------------------------  :: op_or
pm ; pc ; G ; S ; L |- e1 || e2 : bool :> join pc join p1 p2 { no_pred } -| G2 ; L2

% Typing for unary operators
pm ; pc ; G ; S ; L |- e : bool :> p { P } -| G1 ; L1
----------------------------------------------------------------------  :: unary_op_not_typing
pm ; pc ; G ; S ; L |- not e : bool :> join pc p { no_pred } -| G1 ; L1

% New ref creation with region types
% ref creates a reference with pc poison status and allocates fresh location l
% The region type ref T @ l precisely tracks which location is allocated
% Predicate P is preserved in the memory location
pm ; pc ; G ; S ; L |- e : T :> p { P } -| G1 ; L1
  fresh l
----------------------- :: ref
pm ; pc ; G ; S ; L |- ref e : ref T @ l :> pc { no_pred } -| G1[l |-> T :> join pc p { P }] ; L1

% Assignment through reference with region types The result of the whole
% assignment (unit) is poisoned if the reference is poisoned. The stored value
% is poisoned if the assignment is poisoned, or reference is poisoned, or the
% value is poisoned. Predicate from e2 is preserved in the memory location.
% On write to location l, invalidate all L entries whose predicates may read l.
pm ; pc ; G ; S ; L |- e1 : ref T @ l :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : T :> p2 { P2 } -| G2 ; L2
----------------------- :: assign
pm ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc p1 { no_pred } -| G2[l |-> T :> join pc join p1 p2 { P2 }] ; invalidate_deps L2 l

% Dereference - with poisoned reference always strips predicate and returns
% poisoned result.
pm ; pc ; G ; S ; L |- e : ref T @ l :> poisoned { P } -| G1 ; L1
  G1(l) = T :> p { P1 }
----------------------- :: deref_poisoned
pm ; pc ; G ; S ; L |- !e : T :> poisoned { no_pred } -| G1 ; L1

% Dereference - no predicate case.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { no_pred }
----------------------- :: deref_no_pred
pm ; pc ; G ; S ; L |- !e : T :> join pc p { no_pred } -| G1 ; L1

% Dereference - with guarded predicate that evaluates to true, triggering de-poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k pred_closure pcl }
  L1(k) = true using deps
----------------------- :: deref_guard_true
pm ; pc ; G ; S ; L |- !e : T :> pc { no_pred } -| G1 ; L1

% Dereference - with guard only that evaluates to true, triggering de-poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k }
  L1(k) = true using deps
----------------------- :: deref_guard_only_true
pm ; pc ; G ; S ; L |- !e : T :> pc { no_pred } -| G1 ; L1

% Dereference - with guarded predicate that evaluates to false, triggering poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k pred_closure pcl }
  L1(k) = false using deps
----------------------- :: deref_guard_false
pm ; pc ; G ; S ; L |- !e : T :> poisoned { no_pred } -| G1 ; L1

% Dereference - with guard only that evaluates to false, triggering poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k }
  L1(k) = false using deps
----------------------- :: deref_guard_only_false
pm ; pc ; G ; S ; L |- !e : T :> poisoned { no_pred } -| G1 ; L1

% Dereference - with guarded predicate but tag not in L
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k pred_closure pcl }
----------------------- :: deref_guard_unknown
pm ; pc ; G ; S ; L |- !e : T :> join pc p { guard k pred_closure pcl } -| G1 ; L1

% Dereference - with guard only but tag not in L
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G1 ; L1
  G1(l) = T :> p { guard k }
----------------------- :: deref_guard_only_unknown
pm ; pc ; G ; S ; L |- !e : T :> join pc p { guard k } -| G1 ; L1

-------------------------------  :: unit
pm ; pc ; G ; S ; L |- unit : unit :> clean { no_pred } -| G ; L

% Sequence: e1's poison is included because e2 only executes if e1 completes
% successfully. This captures the control dependency between e1 and e2. The
% first expression can have any type T1, but its value is discarded. The result
% type is the type of the second expression T2. This is  a conservative
% approach. Alternatively, we could ignore e1's poison in result, as the e1's
% value is propagated to e2.
pm ; pc ; G ; S ; L |- e1 : T1 :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2
-------------------------------  :: seq
pm ; pc ; G ; S ; L |- e1 ; e2  : T2 :> join p1 p2 { P2 } -| G2 ; L2

% Function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
----------------------------------------------------------------------  :: fn_abs
pm ; pc ; G ; S ; L |- fn x : ST1 => e : ST2 : ST1 -> ST2 # pc typing_closure ( x , e , S ) :> pc { no_pred } -| G ; L

% Pure function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
----------------------------------------------------------------------  :: pfn_abs
pm ; pc ; G ; S ; L |- pfn x : ST1 => pe : ST2 : ST1 -> ST2 # pc typing_pclosure ( x , pe , S ) :> pc { no_pred } -| G ; L

% Function application typing - now uses captured body and context for precise typing
% When applying a function, we extract the typing_closure containing the parameter name (x),
% function body (e), and captured variable context (S1). We then type-check the body in
% the captured context S1 extended with the actual argument's type (including predicates)
% and using the current logical environment L. This enables predicate-based de-poisoning.
% Please note that impure function application is disallowed in pure context.
impure ; pc ; G ; S ; L |- e1 : ST1 -> ST2 # p typing_closure ( x , e , S1 ) :> p1 { P1 } -| G1 ; L1
impure ; pc ; G1 ; S ; L1 |- e2 : T1 :> p2 { P2 } -| G2 ; L2
ST1 <: T1
impure ; join p join p1 pc ; G2 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L2 |- e : T2 :> p3 { P3 } -| G3 ; L3
ST2 <: T2
----------------------------------------------------------------------  :: app_fn
impure ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc p3 { P3 } -| G3 ; L3

% Pure function application typing - uses captured pure body and context
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms)
pm ; pc ; G ; S ; L |- e1 : ST1 -> ST2 # p typing_pclosure ( x , pe , S1 ) :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S ; L1 |- e2 : T1 :> p2 { P2 } -| G2 ; L2
ST1 <: T1
pure ; join p join p1 pc ; G2 ; S1[x |-> T1 :> join pc p2 { P2 }] ; L2 |- pe : T2 :> p3 { P3 } -| G3 ; L2
ST2 <: T2
----------------------------------------------------------------------  :: app_pfn
pm ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc p3 { P3 } -| G3 ; L3

% Typing for rand - takes integer argument, returns random integer
pm ; pc ; G ; S ; L |- e : int :> p { P } -| G1 ; L1
----------------------------------------------------------------------  :: rand_typing
pm ; pc ; G ; S ; L |- rand e : int :> join pc p { no_pred } -| G1 ; L1

% Typing for frand - takes integer argument n, returns faulty random integer with predicate
% the argument is a pure expression, so typechking it does not affect the typing environment
pm ; pc ; G ; S ; L |- pe : int :> p { P } -| G ; L
fresh k
fresh x S
pcl = range x pe S
----------------------------------------------------------------------  :: frand_typing
pm ; pc ; G ; S ; L |- frand pe : int :> poisoned { guard k pred_closure pcl } -| G ; L

% Typing for printInt - takes integer argument, returns unit 
pm ; pc ; G ; S ; L |- e : int :> p { P } -| G1 ; L1
----------------------------------------------------------------------  :: printInt_typing
pm ; pc ; G ; S ; L |- printInt e : unit :> join pc p { no_pred } -| G1 ; L1

% Typing for printString - takes string argument, returns unit 
pm ; pc ; G ; S ; L |- e : string :> p { P } -| G1 ; L1
----------------------------------------------------------------------  :: printString_typing
pm ; pc ; G ; S ; L |- printString e : unit :> join pc p { no_pred } -| G1 ; L1


% Typing for Let Bindings

%
% A critical consideration is whether the context poison should be combined with
% the variable poison in the result. The current approach integrates the context
% poison with the variable poison. Consider the following illustrative example:
%
% if poisoned_sensor > 0 then      // pc = poisoned
%    let y = 42 in 17       // e2 doesn1t use y
% else
%    0
% In this scenario, the let binding is deemed poisoned because the context
% poison is indeed poisoned.
%
% Predicates are propagated from e1 to x, and the result gets predicate from e2
% Note: Lexical scoping - the final variable environment S excludes the let-bound variable x
% The logical environment L1' from evaluating e2 is preserved (knowledge about predicates persists)
pm ; pc ; G ; S ; L |- e1 : T :> p1 { P1 } -| G1 ; L1
pm ; pc ; G1 ; S[x |-> T :> p1  { P1 }] ; L1 |- e2 : T2 :> p2 { P2 } -| G2 ; L2
----------------------------------------------------------------------  :: let
pm ; pc ; G ; S ; L |- let x = e1 in e2 : T2 :> join pc p2 { P2 } -| G2 ; L2


match_guard e1 G S = k with deps
pure ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G ; L
pm ; pc ; G ; S ; L[k |-> true using deps] |- e2 : T :> p2 { P2 } -| G2 ; L2
pm ; pc ; G ; S ; L[k |-> false using deps] |- e3 : T :> p3 { P3 } -| G3 ; L3
----------------------------------  :: if_depoison
pm ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p2 p3 { no_pred } -| JoinG G2 G3 ; L

% Standard conditional typing rule (when no matching predicate found)
% (used as a fallback when match_guard fails)
pm ; pc ; G ; S ; L |- e1 : bool :> p1 { P1 } -| G1 ; L1
pm ; join pc p1 ; G1 ; S ; L1 |- e2 : T :> p2 { P2 } -| G2 ; L2
pm ; join pc p1 ; G1 ; S ; L1 |- e3 : T :> p3 { P3 } -| G3 ; L3
----------------------------------  :: if_std
pm ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p1 join p2 p3 { no_pred } -| JoinG G2 G3 ; L1


%  Flow‑sensitive WHILE à la Hunt & Sands 2006 https://doi.org/10.1145/1111037.1111045

% Predicate-based while typing rule (when matching predicate found)
pm; indexP p i ; indexG G i ; S ; L |- e1 : bool :> indexedP p 1 i { P1 }  -| indexedG G 1 i ; L
match_guard e1 G S = k with deps
pm; join indexP p i indexedP p 1 i ; indexedG G 1 i ; S ; L[k |-> true using deps] |- e2 : unit :> indexedP p 2 i { P2 }  -| indexedG G 2 i ; L
indexP p 0 = pc AND indexP p i+1 = join indexP p i indexedP p 2 i
indexG G 0 = G AND indexG G i+1 = JoinG indexG G i indexedG G 2 i
%  "where n is the smallest natural number satisfying the two equalities above."
indexP p n+1 = indexP p n
indexG G n+1 = indexG G n
---------------------------------------------------------------------------  :: while_depoison
pm ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexP p n { no_pred }  -| indexG G n ; L[k |-> false using deps]

% Standard while typing rule (when no matching predicate found) (used as a
% fallback when match_guard fails) 
%
% NOTE: We now return the original L unchanged since no guard was matched
pm ; indexP p i ; indexG G i ; S ; L |- e1 : bool :> indexedP p 1 i { P1 }  -| indexedG G 1 i ; L
pm ; join indexP p i indexedP p 1 i ; indexedG G 1 i ; S ; L |- e2 : unit :> indexedP p 2 i { P2 }  -| indexedG G 2 i ; L
indexP p 0 = pc AND indexP p i+1 = join indexP p i indexedP p 2 i
indexG G 0 = G AND indexG G i+1 = JoinG indexG G i indexedG G 2 i
%  "where n is the smallest natural number satisfying the two equalities above."
indexP p n+1 = indexP p n 
indexG G n+1 = indexG G n
---------------------------------------------------------------------------  :: while_std
pm ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexP p n { no_pred }  -| indexG G n ; L


