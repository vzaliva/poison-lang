% Derived from `examples/1Bsemantics/l1.ott` in Ott distribution


metavar n, i ::=
  {{ com Numeric literals }}
  {{ phantom }}


metavar location, l ::= 
  {{ com Memory locations }}

metavar var, x ::=
  {{ com Variables }}
  {{ phantom }}
  {{ coq string }}

metavar tag, k ::=
  {{ com Tags for predicates }}
  {{ phantom }}
  {{ coq string }}

grammar 

% Index expressions for use in formulas
idx :: 'IDX_' ::=              {{ com index expressions }}
  | 0                          ::   :: zero
  | 1                          ::   :: one  
  | 2                          ::   :: two
  | i                          ::   :: var
  | n                          ::   :: nat
  | idx1 + idx2                ::   :: plus
  | idx1 - idx2                ::   :: minus
  | idx1 * idx2                ::   :: mult
  | ( idx )                    :: M :: paren  {{ ichlo ([[idx]]) }}

b :: 'B_' ::=              {{ com booleans }}  {{ phantom }} {{ coq bool }}
  | true                    ::   :: true      {{ coq true }}
  | false                   ::   :: false     {{ coq false }}

operations, op :: 'Op_' ::=            {{ com operations }}
  | +                       ::   :: plus
  | -                       ::   :: minus
  | *                       ::   :: mult
  | /                       ::   :: div
  | >=                      ::   :: gteq
  | <=                      ::   :: lteq
  | >                       ::   :: gt
  | <                       ::   :: lt
  | =                       ::   :: eq
  | !=                      ::   :: neq
  | &                       ::   :: and 
  | |                       ::   :: or

% Surface types for annotations (no runtime info)
styp, ST :: 'ST_' ::=      {{ com surface types (for annotations) }}
  | int                    ::   :: int
  | bool                   ::   :: bool
  | unit                   ::   :: unit
  | string                 ::   :: string 
  | ref ST                 ::   :: ref
  | ST1 -> ST2             ::   :: arrow



e :: 'E_'  ::=	           {{ com expressions }}
  | unit                    ::   :: unit
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | x                       ::   :: var
  | e1 op e2                ::   :: op
  | if e1 then e2 else e3   ::   :: if
  | ref e                   ::   :: new_ref
  | e1 := e2                ::   :: assign
  | ! e                     ::   :: deref
  | e1 ; e2                 ::   :: sequence
  | while e1 do e2          ::   :: while
  | let x = e1 in e2        ::   :: let
  | fn x : ST1 => e : ST2        ::   :: fn   {{ com function with return type annotation }}
  | pfn x : ST1 => pe : ST2      ::   :: pfn  {{ com pure function with return type annotation }}
  | e1 e2                   ::   :: app
  | ( e )                   :: M :: paren  {{ ichlo ([[e]]) }}
  | rand e                  ::   :: rand_app   {{ com random integer generation }}
  | frand e                 ::   :: frand_app  {{ com random float generation }}
  | printInt e              ::   :: printInt_app
  | printString e           ::   :: printString_app 
  | not_expr e              ::   :: not_expr  

pe :: 'PE_' ::=            {{ com pure expressions (subset of expressions) }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | x                       ::   :: Var
  | s                       ::   :: string 
  | pe1 op pe2              ::   :: op
  | if pe1 then pe2 else pe3 ::   :: if
  | ! pe                    ::   :: deref
  | unit                    ::   :: unit
  | let x = pe1 in pe2      ::   :: let
  | ( pe )                  :: M :: paren  {{ ichlo ([[pe]]) }}
  | pe1 pe2                 ::   :: app

v :: 'V_' ::=              {{ com values }}
  | n                       ::   :: num
  | b                       ::   :: bool
  | s                       ::   :: str
  | unit                    ::   :: unit    
  | l                       ::   :: location
  | closure ( x , e , r )   ::   :: closure   {{ com closure value }}
  | pe_closure ( x , pe , r )  ::   :: pe_closure   {{ com pure closure value }}

expr_or_value, ev :: 'EV_' ::=  {{ com expression or value }}
  | expr e                  ::   :: expr  {{ com expression }}
  | value v                 ::   :: value {{ com value }}

memory , m {{ tex \mu }} :: 'Memory_' ::=  {{ com memory }} {{ phantom }} {{ coq list (location * integer) }}
   | empty                  ::   :: empty {{ coq [] }}
   | m [ l |-> n ]          ::   :: extend  {{ coq (([[l]],[[n]])::[[m]]) }}

typ, T :: 'T_' ::=         {{ com enriched types }}
  | int                     ::   :: int
  | bool                    ::   :: bool
  | unit                    ::   :: unit
  | string                  ::   :: string 
  | ref T @ l               ::   :: ref {{ tex \mathsf{ref}\,[[T]]\,@\,[[l]] }}
  | ST1 -> ST2 # p typing_closure tcl ::   :: arrow {{ tex [[ST1]] \rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{typing\_closure}\, [[tcl]] }}
  | ST1 -> ST2 # p typing_pclosure ptcl ::   :: parrow {{ tex [[ST1]] \Rightarrow [[ST2]] \, \triangleright [[p]]\, \mathsf{typing\_pclosure}\, [[ptcl]] }}

% Predicate closure contents (for cleaner syntax)
pcl :: 'PCL_' ::= {{ com predicate closure }}
  | ( x , pe , S )          ::   :: pred_closure

% Typing closures (separate for impure fn and pure pfn)
tcl :: 'TCL_' ::= {{ com typing closure for impure functions }}
  | ( x , e , S )           ::   :: fn_closure

ptcl :: 'PTCL_' ::= {{ com typing closure for pure functions }}
  | ( x , pe , S )          ::   :: pfn_closure

predicate, P :: 'P_' ::= {{ com predicate (pure function from T to bool) }}
  | guard k pred_closure pcl ::   :: pred_closure {{ com predicate as pure closure }} {{tex \mathsf{guard}\,[[k]]\,\mathsf{pred\_closure}\,[[pcl]] }}
  | no_pred                   ::   :: no_pred {{ com trivial predicate (always true) }} {{tex {} }}

qualified_type, Q :: 'Q_' ::= {{ com qualified type (type with poison and optional predicate) }}
  | T :> p                  ::   :: qualified {{ tex [[T]] \triangleright [[p]] }}
  | T :> p { P }            ::   :: qualified_pred {{ tex [[T]] \triangleright [[p]]\, \{ [[P]] \} }}

mem_type_assumption, ta :: 'TA_' ::= {{ com memory type assumption }}
  | l : Q                ::   :: loc

G {{ tex \Gamma }} :: G_ ::=     {{ com memory typing environments }} {{ phantom }} {{ coq list mem_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | G , ta                  ::   :: extend {{ coq ([[ta]]::[[G]]) }}
  | JoinG G1 G2             ::   :: JoinG {{ tex [[G1]] \cup [[G2]] }}
  | G [ l |-> Q ]           ::   :: UpdateG {{ tex [[G]] [ l \mapsto [[Q]] ] }}
  | IndexedG G idx          ::   :: IndexedG  {{ tex [[G]]_{[[idx]]} }}                  

% Variable environment for let bindings
var_type_assumption, va :: 'VA_' ::= {{ com variable type assumption }}
  | x : Q                ::   :: var

S {{ tex \sigma }} :: S_ ::=     {{ com variable typing environments }} {{ phantom }} {{ coq list var_type_assumption }}
  | empty                   ::   :: empty {{ coq [] }}
  | S [ x |-> Q ]       ::   :: update {{ coq (([[x]],[[Q]])::[[S]]) }}

% Tag valuation environment
tag_valuation, tv :: 'TV_' ::= {{ com tag valuation }}
  | k : b                ::   :: tag

L {{ tex \mathcal{L} }} :: L_ ::=     {{ com tag valuation environments }} {{ phantom }} {{ coq list tag_valuation }}
  | empty                   ::   :: empty {{ coq [] }}
  | L , tv                  ::   :: extend {{ coq ([[tv]]::[[L]]) }}
  | L [ k |-> b ]           ::   :: UpdateL {{ tex [[L]] [ k \mapsto [[b]] ] }}

poison, p, pc :: 'p_' ::= {{ com poison status }} 
  | clean                    ::   :: clean
  | poisoned                 ::   :: poisoned
  | join p1 p2               ::   :: join {{ tex [[p1]] \sqcup [[p2]] }}
  | indexedp p idx           ::   :: indexedp  {{ tex [[p]]_{[[idx]]} }}                  
  
% Variable substitution environment for operational semantics
var_binding, vb :: 'VB_' ::= {{ com variable binding }}
  | x |-> v                  ::   :: binding

var_env, r {{ tex \rho }} :: 'VE_' ::=     {{ com variable substitution environment }} {{ phantom }} {{ coq list var_binding }}
  | empty                   ::   :: empty {{ coq [] }}
  | r [ x |-> v ]          ::   :: update {{ coq (([[x]],[[v]])::[[r]]) }}                  

pure_mode, pm :: 'PM_' ::= {{ com pure mode }} {{ tex \pi }}
  | pure                     ::   :: pure
  | impure                   ::   :: impure                  

terminals :: terminals_ ::=
  | +    :: :: plus
  | -    :: :: minus
  | *    :: :: mult
  | /    :: :: div
  | >=   :: :: gteq      {{ tex \geq }}
  | <=   :: :: lteq      {{ tex \leq }}
  | >    :: :: gt
  | <    :: :: lt
  | |-   :: :: turnstile {{ tex \vdash }}
  | -|   :: :: left_turnstile {{ tex \dashv }}
  | |->  :: :: mapsto    {{ tex \mapsto }}
  | ;    :: :: seq
  | ->   :: :: red       {{ tex \longrightarrow }}
  | <    :: :: la        {{ tex \langle }}
  | >    :: :: ra        {{ tex \rangle }}
  | :>   :: :: ty_poison {{ tex \triangleright }}
  | ;    :: :: sep       {{ tex ; }}
  | AND  :: :: and       {{ tex \land }}
  | range :: :: range   {{ tex range }}
  | =    :: :: eq
  | !=   :: :: neq 
  | in   :: :: in
  | [    :: :: lsquare   {{ tex [ }}
  | ]    :: :: rsquare   {{ tex ] }}
  | @    :: :: at        {{ tex @ }}
  | ->*   :: :: mredstar   {{ tex \xrightarrow{\ast} }}
  | =>   :: :: lmbd   {{ tex \Rightarrow }}
  | ==>   :: :: beval   {{ tex \Downarrow }}
  | <:   :: :: subtype   {{ tex <: }}

subrules
  pe <:: e

grammar 
formula :: formula_ ::=
  | judgement              :: :: judgement
  | n1 + n2 = n3           :: :: sum         {{ coq ([[n1]]+[[n2]]=[[n3]]) }}
  | n1 - n2 = n3           :: :: diff        {{ coq ([[n1]]-[[n2]]=[[n3]]) }}
  | n1 * n2 = n3           :: :: mult        {{ coq ([[n1]]*[[n2]]=[[n3]]) }}
  | n1 / n2 = n3           :: :: div         {{ coq ([[n1]]/[[n2]]=[[n3]]) }}
  | n1 >= n2 = b           :: :: geq         {{ coq ([[n1]]>=[[n2]]=[[b]]) }}
  | n1 <= n2 = b           :: :: leq         {{ coq ([[n1]]<=[[n2]]=[[b]]) }}
  | n1 > n2 = b            :: :: gt          {{ coq ([[n1]]>[[n2]]=[[b]]) }}
  | n1 < n2 = b            :: :: lt          {{ coq ([[n1]]<[[n2]]=[[b]]) }}
  | n1 = n2 = b            :: :: eq          {{ coq ([[n1]]=[[n2]]=[[b]]) }}
  | n1 != n2 = b           :: :: neq         {{ coq ([[n1]]!=[[n2]]=[[b]]) }}
  | n1 & n2 = n3           :: :: bitwise_and {{ coq ([[n1]]&[[n2]]=[[n3]]) }}
  | b1 & b2 = b3           :: :: band        {{ coq ([[b1]]&&[[b2]]=[[b3]]) }}
  | b1 | b2 = b3           :: :: bor         {{ coq ([[b1]]||[[b2]]=[[b3]]) }}
  | not b = b'             :: :: not_bool   {{ coq ([[b']] = not [[b]]) }}
  | m ( l ) = n            :: :: lookup      {{ coq (List.find [[l]] [[m]] = Some ([[n]])) }}   
  | G ( l ) = Q        :: :: type_lookup {{ coq (lookup_location_type [[l]] [[G]] = Some ([[Q]])) }}   
  | S ( x ) = Q        :: :: var_type_lookup {{ coq (lookup_var_type [[x]] [[S]] = Some ([[Q]])) }}   
  | r ( x ) = v           :: :: var_lookup {{ coq (lookup_var [[x]] [[r]] = Some ([[v]])) }}   
  | L ( k ) = b           :: :: tag_lookup {{ coq (lookup_tag [[k]] [[L]] = Some ([[b]])) }}   
  | p1 = p2                :: :: poison_eq   {{ coq ([[p1]] = [[p2]]) }}   
  | G1 = G2                :: :: type_env_eq {{ coq ([[G1]] = [[G2]]) }}   
  | formula1 AND formula2  :: :: and         {{ tex [[formula1]] \quad [[formula2]] }} {{ coq ([[formula1]] /\ [[formula2]]) }}
  | fresh l                :: :: fresh_loc       {{ com l is fresh }}
  | fresh k                :: :: fresh_tag       {{ com k is fresh }}
  | fresh x S              :: :: fresh_var       {{ com x is fresh in S }}
  | n0 = random n1         :: :: random_gen     {{ com n0 is a random number in [0, n1] range }}
  | match_guard e G S = k  :: :: match_guard  {{ com match\_guard(e, G, S) scans the predicates attached to every heap cell in G and variable in S; if it finds exactly one guard k whose test expression, when applied to its owning value, is syntactically identical to the condition e, it returns that k—otherwise it returns "none" }}  {{ tex match\_guard([[e]], [[G]], [[S]]) = [[k]] }}
  | ST <: T                :: :: subtype      {{ com ST is a subtype of T (surface type erasure) }} {{ tex [[ST]] <: [[T]] }}
  | pcl = range pe1 pe2 S      :: :: range {{ tex [[pcl]] = ( 0 \leq [[pe1]] \leq [[pe2]] , [[S]]) }}


defns


Jop :: '' ::=

defn
< pm , e , m , r > ->* < ev , m' , r' > :: :: eval :: ''  {{ com $\langle[[pm]],\,[[e]],\,[[m]],\,[[r]]\rangle$ evaluates to $\langle[[ev]],\,[[m']],\,[[r']]\rangle$ }} by

% Base case - expression reduces to a value
< pm, e, m, r > -> < pm, value v, m', r' >
--------------------------------------------------------------- :: eval_value
< pm, e, m, r > ->* < value v, m', r' >

% Transitive case - expression reduces to another expression
< pm, e, m, r > -> < pm, expr e'', m'', r'' >
  < pm, e'', m'', r'' > ->* < ev, m', r' >
--------------------------------------------------------------- :: eval_step
< pm, e, m, r > ->* < ev, m', r' >

defn
< pm , e , m , r > -> < pm' , ev , m' , r' > :: :: reduce :: ''  {{ com $\langle[[pm]],\,[[e]],\,[[m]],\,[[r]]\rangle$ reduces to $\langle[[pm']],\,[[ev]],\,[[m']],\,[[r']]\rangle$ }} by

% Literals evaluate to values
----------------------   :: lit_num
< pm, n, m, r > -> < pm, value n, m, r >

----------------------   :: lit_bool
< pm, b, m, r > -> < pm, value b, m, r >

----------------------   :: lit_unit
< pm, unit, m, r > -> < pm, value unit, m, r >

----------------------   :: lit_string
< pm, s, m, r > -> < pm, value s, m, r >

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 + n2 = n
----------------------   :: op_plus
<pm, e1 + e2, m, r> -> <pm, value n, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 - n2 = n
----------------------   :: op_minus
<pm, e1 - e2, m, r> -> <pm, value n, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 * n2 = n
----------------------   :: op_mult
<pm, e1 * e2, m, r> -> <pm, value n, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 / n2 = n
----------------------   :: op_div
<pm, e1 / e2, m, r> -> <pm, value n, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 >= n2 = b
----------------------   :: op_gteq
<pm, e1 >= e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 <= n2 = b
----------------------   :: op_lteq
<pm, e1 <= e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 > n2 = b
----------------------   :: op_gt
<pm, e1 > e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 < n2 = b
----------------------   :: op_lt
<pm, e1 < e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 = n2 = b
----------------------   :: op_eq
<pm, e1 = e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 != n2 = b
----------------------   :: op_neq
<pm, e1 != e2, m, r> -> <pm, value b, m'', r''>

<pm, e1,m,r> -> <pm, value b1, m' ,r'>
<pm, e2,m',r'> -> <pm, value b2, m'' ,r''>
b1 & b2 = b3
----------------------   :: op_and
<pm, e1 & e2, m, r> -> <pm, value b3, m'', r''>

<pm, e1,m,r> -> <pm, value n1, m' ,r'>
<pm, e2,m',r'> -> <pm, value n2, m'' ,r''>
n1 & n2 = n3
----------------------   :: op_bitwise_and
<pm, e1 & e2, m, r> -> <pm, value n3, m'', r''>

<pm, e1,m,r> -> <pm, value b1, m' ,r'>
<pm, e2,m',r'> -> <pm, value b2, m'' ,r''>
b1 | b2 = b3
----------------------   :: op_or
<pm, e1 | e2, m, r> -> <pm, value b3, m'', r''>

% reduce left
<pm, e1,m,r> -> <pm, expr e1',m',r'>
------------------------------- :: op_reduce_left
<pm, e1 op e2,m,r> -> <pm, expr (e1' op e2),m',r'>

% reduce right
<pm, e2,m,r> -> <pm, expr e2',m',r'>
------------------------------- :: op_reduce_right
<pm, e1 op e2,m,r> -> <pm, expr (e1 op e2'),m',r'>


% notExpr argument reduction
<pm, e,m,r> -> <pm, expr e',m',r'>
------------------------------ :: not_expr_reduce_arg
<pm, not_expr e,m,r> -> <pm, expr (not_expr e'),m',r'>

% Compute notExpr 
<pm, e,m,r> -> <pm, value b, m',r'>
not b = b'
--------------------------------------------------------------- :: not_expr_value
<pm, not_expr e,m,r> -> <pm, value b', m',r'>


% ref argument reduction
<pm, e,m,r> -> <pm, expr e',m',r'>
------------------------------ :: ref_reduce_arg
<pm, ref e,m,r> -> <pm, expr (ref e'),m',r'>

% New ref creation - allocates fresh location
<pm, e,m,r> -> <pm, value n,m',r'>
fresh l
------------------------------ :: ref
<pm, ref e,m,r> -> <pm, value l, m' [ l |-> n ], r'>

<pm, e,m,r> -> <pm, value l,m',r'>
m'(l) = n
------------------------------ :: deref
<pm, !e,m,r> -> <pm, value n,m',r'>

<pm, e,m,r> -> <pm, expr e',m',r'>
------------------------------ :: deref_reduce
<pm, !e,m,r> -> <pm, expr (!e'),m',r'>

<pm, e1,m,r> -> <pm, value l, m',r'>
<pm, e2,m',r'> -> <pm, value n, m'',r''>
-------------------------------------- :: assign
< pm, e1 := e2, m, r > -> < pm, value unit, m'' [ l |-> n ], r'' >

<pm, e1,m,r> -> <pm, expr e1',m',r'>
-------------------------------------- :: assign_reduce_left
< pm, e1 := e2, m, r > -> < pm, expr (e1' := e2), m', r' >

<pm, e2,m,r> -> <pm, expr e2',m',r'>
-------------------------------------- :: assign_reduce_right
< pm, e1 := e2, m, r > -> < pm, expr (e1 := e2'), m', r' >

% Sequence: reduce first expression while it can reduce
<pm, e1,m,r> -> <pm, expr e1',m',r'>
-------------------------------------- :: seq_reduce_first
< pm, e1 ; e2, m, r > -> < pm, expr (e1' ; e2), m', r' >

% Sequence: when first expression reduces to a value, discard it
<pm, e1,m,r> -> <pm, value v,m',r'>
-------------------------------------- :: seq_value
< pm, e1 ; e2, m, r > -> < pm, expr e2, m', r' >

<pm, e,m,r> -> <pm, value true, m',r'>
---------------------------------------------- :: if_true
< pm, if e then e1 else e2, m, r > -> < pm, expr e1, m', r' >

<pm, e,m,r> -> <pm, value false, m',r'>
---------------------------------------------- :: if_false
< pm, if e then e1 else e2, m, r > -> < pm, expr e2, m', r' >

<pm, e,m,r> -> <pm, expr e',m',r'>
------------------------------------------------------------ :: if_reduce_cond
< pm, if e then e1 else e2, m, r > -> < pm, expr (if e' then e1 else e2), m', r' >

--------------------------------------------------------------------------- :: while
< pm, while e1 do e2, m, r> -> < pm, expr (if e1 then ( e2 ; while e1 do e2 ) else unit), m, r >

% Variable lookup
 r(x) = v
--------------------------- :: var
< pm, x, m, r > -> < pm, value v, m, r >

% Let binding reduction
<pm, e1,m,r> -> <pm, expr e1',m',r'>
-------------------------------------------------------- :: let_reduce_arg
< pm, let x = e1 in e2, m, r > -> < pm, expr (let x = e1' in e2), m', r' >

% Let binding: when first expression reduces to a value, bind it
 <pm, e1,m,r> -> <pm, value v,m',r'>
-------------------------------------------------------- :: let_value
< pm, let x = e1 in e2, m, r > -> < pm, expr e2, m', r'[x |-> v] >

% Function abstraction creates a closure
--------------------------------------------------------------- :: fn_abs
< pm, fn x : ST1 => e : ST2, m, r > -> < pm, value closure(x, e, r), m, r >

% Pure function abstraction creates a pure closure
--------------------------------------------------------------- :: pfn_abs
< pm, pfn x : ST1 => pe : ST2, m, r > -> < pm, value pe_closure(x, pe, r), m, r >

% Function application - evaluate argument first (call-by-value)
<pm, e2,m,r> -> <pm, expr e2',m',r'>
--------------------------------------------------------------- :: app_reduce_arg
< pm, e1 e2, m, r > -> < pm, expr (e1 e2'), m', r' >

% Function application - evaluate function when argument is a value form
% the value restriction here is to enforce evaluation order.
<pm, e2,m,r> -> <pm, value v,m',r'>
<pm, e1,m',r'> -> <pm, expr e1',m'',r''>
--------------------------------------------------------------- :: app_reduce_func
< pm, e1 e2, m, r > -> < pm, expr (e1' e2), m'', r'' >

% Function application when body is a closure and the argument is a value
< impure , e2 , m , r > -> < impure , value v , m' , r' >
< impure , e1 , m' , r' > -> < impure , value closure ( x , e , r''' ) , m'' , r'' >
< impure , e , m'' , r''' [ x |-> v ] > -> < impure , ev , m'''' , r'''' >
--------------------------------------------------------------- :: app_closure_value
< impure , e1 e2 , m , r > -> < impure , ev , m'''' , r'''' >

% Pure function application - pure expressions don't modify memory or runtime
% env Note: no side effects: apply pure function to a pure argument does not
% change the memory or runtime env The result (ev) is a pure expression, but we
% type it as a regular expression (pe <: e). This is a shortcoming of ott
% definition, which perahps should be fixed (e.g. adding separate rule section
% for pure expressions)
< pm , pe2 , m , r > -> < pm , value v , m , r >
< pm , pe1 , m , r > -> < pm , value pe_closure ( x , pe , r' ) , m , r >
< pure , pe , m , r' [ x |-> v ] > -> < pure , ev , m , r >
--------------------------------------------------------------- :: app_pure_closure_value
< pm , pe1 pe2 , m , r > -> < pm , ev , m , r >

% Evaluate argument for rand
<pm, e,m,r> -> <pm, expr e',m',r'>
--------------------------------------------------------------- :: rand_arg_reduce
<pm, rand e,m,r> -> <pm, expr (rand e'),m',r'>

% Compute rand
<pm, e,m,r> -> <pm, value n, m',r'>
n' = random n
--------------------------------------------------------------- :: rand_value
<pm, rand e,m,r> -> <pm, value n', m',r'>

% Evaluate argument for frand
<pm, e,m,r> -> <pm, expr e',m',r'>
--------------------------------------------------------------- :: frand_arg_reduce
<pm, frand e,m,r> -> <pm, expr (frand e'),m',r'>

% Compute frand
% The syntactic defintion is the same as rand but the implementation gonna be faulty
% and typing rules will be different.
<pm, e,m,r> -> <pm, value n, m',r'>
n' = random n
--------------------------------------------------------------- :: frand_value
<pm, frand e,m,r> -> <pm, value n', m',r'>

% Evaluate argument for printInt
<pm, e,m,r> -> <pm, expr e',m',r'>
--------------------------------------------------------------- :: printInt_arg_reduce
<pm, printInt e,m,r> -> <pm, expr (printInt e'),m',r'>

% Compute printInt 
<pm, e,m,r> -> <pm, value n, m',r'>
--------------------------------------------------------------- :: printInt_value
<pm, printInt e,m,r> -> <pm, value unit, m',r'>

% Evaluate argument for printString 
<pm, e,m,r> -> <pm, expr e',m',r'>
--------------------------------------------------------------- :: printString_arg_reduce
<pm, printString e,m,r> -> <pm, expr (printString e'),m',r'>

% Compute printString 
<pm, e,m,r> -> <pm, value s, m',r'>
--------------------------------------------------------------- :: printString_value
<pm, printString e,m,r> -> <pm, value unit, m',r'>


% --- Big-step (natural) semantics below ---

defn
< pm , e , m , r > ==> < v , m' , r' > :: :: beval :: ''  {{ com Big-step evaluation }} by

% Literals
----------------------   :: b_lit_num
< pm, n, m, r > ==> < n, m, r >

----------------------   :: b_lit_bool
< pm, b, m, r > ==> < b, m, r >

----------------------   :: b_lit_unit
< pm, unit, m, r > ==> < unit, m, r >

----------------------   :: b_lit_string
< pm, s, m, r > ==> < s, m, r >

% Variables
r(x) = v
--------------------------- :: b_var
< pm, x, m, r > ==> < v, m, r >

% Binary operations (evaluate both operands to values, then compute)
<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 + n2 = n
----------------------   :: b_op_plus
<pm, e1 + e2, m, r> ==> < n, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 - n2 = n
----------------------   :: b_op_minus
<pm, e1 - e2, m, r> ==> < n, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 * n2 = n
----------------------   :: b_op_mult
<pm, e1 * e2, m, r> ==> < n, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 / n2 = n
----------------------   :: b_op_div
<pm, e1 / e2, m, r> ==> < n, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 >= n2 = b
----------------------   :: b_op_gteq
<pm, e1 >= e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 <= n2 = b
----------------------   :: b_op_lteq
<pm, e1 <= e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 > n2 = b
----------------------   :: b_op_gt
<pm, e1 > e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 < n2 = b
----------------------   :: b_op_lt
<pm, e1 < e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 = n2 = b
----------------------   :: b_op_eq
<pm, e1 = e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 != n2 = b
----------------------   :: b_op_neq
<pm, e1 = e2, m, r> ==> < b, m'', r''>

<pm, e1, m, r> ==> < b1, m', r'>
<pm, e2, m', r'> ==> < b2, m'', r''>
b1 & b2 = b3
----------------------   :: b_op_and
<pm, e1 & e2, m, r> ==> < b3, m'', r''>

<pm, e1, m, r> ==> < n1, m', r'>
<pm, e2, m', r'> ==> < n2, m'', r''>
n1 & n2 = n3
----------------------   :: b_op_bitwise_and
<pm, e1 & e2, m, r> ==> < n3, m'', r''>

<pm, e1, m, r> ==> < b1, m', r'>
<pm, e2, m', r'> ==> < b2, m'', r''>
b1 | b2 = b3
----------------------   :: b_op_or
<pm, e1 | e2, m, r> ==> < b3, m'', r''>

% Not expression  
<pm, e, m, r> ==> < b, m', r'>
not b = b'
--------------------------------------------------------------- :: b_not_expr
<pm, not_expr e, m, r> ==> < b', m', r'>

% References
<pm, e, m, r> ==> < n, m', r'>
fresh l
------------------------------ :: b_ref
<pm, ref e, m, r> ==> < l, m' [ l |-> n ], r'>

% Dereference
<pm, e, m, r> ==> < l, m', r'>
m'(l) = n
------------------------------ :: b_deref
<pm, !e, m, r> ==> < n, m', r'>

% Assignment
<pm, e1, m, r> ==> < l, m', r'>
<pm, e2, m', r'> ==> < n, m'', r''>
-------------------------------------- :: b_assign
< pm, e1 := e2, m, r > ==> < unit, m'' [ l |-> n ], r'' >

% Sequencing
<pm, e1, m, r> ==> < v1, m', r'>
<pm, e2, m', r'> ==> < v2, m'', r''>
-------------------------------------- :: b_seq
< pm, e1 ; e2, m, r > ==> < v2, m'', r'' >

% Conditionals
<pm, e, m, r> ==> < true, m', r'>
<pm, e1, m', r'> ==> < v, m'', r''>
---------------------------------------------- :: b_if_true
< pm, if e then e1 else e2, m, r > ==> < v, m'', r'' >

<pm, e, m, r> ==> < false, m', r'>
<pm, e2, m', r'> ==> < v, m'', r''>
---------------------------------------------- :: b_if_false
< pm, if e then e1 else e2, m, r > ==> < v, m'', r'' >

% While via if-expansion (keeps close to small step rule)
< pm, if e1 then ( e2 ; while e1 do e2 ) else unit, m, r > ==> < unit, m', r' >
--------------------------------------------------------------------------- :: b_while
< pm, while e1 do e2, m, r> ==> < unit, m', r' >

% Let binding
<pm, e1, m, r> ==> < v, m', r'>
<pm, e2, m', r'[x |-> v]> ==> < v2, m'', r''>
-------------------------------------------------------- :: b_let
< pm, let x = e1 in e2, m, r > ==> < v2, m'', r'' >

% Function abstraction
--------------------------------------------------------------- :: b_fn_abs
< pm, fn x : ST1 => e : ST2, m, r > ==> < closure(x, e, r), m, r >

% Pure function abstraction
--------------------------------------------------------------- :: b_pfn_abs
< pm, pfn x : ST1 => pe : ST2, m, r > ==> < pe_closure(x, pe, r), m, r >

% Impure function application (call-by-value)
< impure , e2 , m , r > ==> < v , m' , r' >
< impure , e1 , m' , r' > ==> < closure ( x , e , r''' ) , m'' , r'' >
< impure , e , m'' , r''' [ x |-> v ] > ==> < v0 , m''' , r'''' >
--------------------------------------------------------------- :: b_app_closure
< impure , e1 e2 , m , r > ==> < v0 , m''' , r'''' >

% Pure function application (no effects)
< pm , pe2 , m , r > ==> < v , m , r >
< pm , pe1 , m , r > ==> < pe_closure ( x , pe , r' ) , m , r >
< pure , pe , m , r' [ x |-> v ] > ==> < v0 , m , r >
--------------------------------------------------------------- :: b_app_pure_closure
< pm , pe1 pe2 , m , r > ==> < v0 , m , r >

% Random integer
<pm, e, m, r> ==> < n, m', r'>
n' = random n
--------------------------------------------------------------- :: b_rand
<pm, rand e, m, r> ==> < n', m', r'>

% Faulty random (same extensional behaviour; typing distinguishes it)
<pm, e, m, r> ==> < n, m', r'>
n' = random n
--------------------------------------------------------------- :: b_frand
<pm, frand e, m, r> ==> < n', m', r'>

% printInt
<pm, e, m, r> ==> < n, m', r'>
--------------------------------------------------------------- :: b_printInt
<pm, printInt e, m, r> ==> < unit, m', r'>

% printString
<pm, e, m, r> ==> < s, m', r'>
--------------------------------------------------------------- :: b_printString
<pm, printString e, m, r> ==> < unit, m', r'>

%% --- Typing rules below ---

defn
pm ; pc ; G ; S ; L |- e : Q -| G' ; L' :: :: typing :: Ty_ by

------------------  :: int
pm ; pc ; G ; S ; L |- n : int :> clean { no_pred } -| G ; L

------------------  :: bool
pm ; pc ; G ; S ; L |- b : bool :> clean { no_pred } -| G ; L

------------------  :: string 
pm ; pc ; G ; S ; L |- s : string :> clean { no_pred } -| G ; L

% Variable typing - with guarded predicate that evaluates to true triggering de-poisoning.
S(x) = T :> p { guard k pred_closure pcl }
L(k) = true
------------------  :: var_guard_true
pm ; pc ; G ; S ; L |- x : T :> pc { no_pred } -| G ; L

% Variable typing - with guarded predicate that evaluates to false, triggering poisoning.
S(x) = T :> p { guard k pred_closure pcl }
L(k) = false
------------------  :: var_guard_false
pm ; pc ; G ; S ; L |- x : T :> poisoned { no_pred } -| G ; L

% Variable typing - with guarded predicate but tag not in L
S(x) = T :> p { guard k pred_closure pcl }
------------------  :: var_guard_unknown
pm ; pc ; G ; S ; L |- x : T :> join pc p { guard k pred_closure pcl } -| G ; L

% Variable typing - no guard case
S(x) = T :> p { no_pred }
------------------  :: var_no_pred
pm ; pc ; G ; S ; L |- x : T :> join pc p { no_pred } -| G ; L

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_plus
pm ; pc ; G ; S ; L |- e1 + e2 : int :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_gteq
pm ; pc ; G ; S ; L |- e1 >= e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_minus
pm ; pc ; G ; S ; L |- e1 - e2 : int :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_mult
pm ; pc ; G ; S ; L |- e1 * e2 : int :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_div
pm ; pc ; G ; S ; L |- e1 / e2 : int :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_lteq
pm ; pc ; G ; S ; L |- e1 <= e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_gt
pm ; pc ; G ; S ; L |- e1 > e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_lt
pm ; pc ; G ; S ; L |- e1 < e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_eq
pm ; pc ; G ; S ; L |- e1 = e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_neq
pm ; pc ; G ; S ; L |- e1 != e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : bool :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : bool :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_and
pm ; pc ; G ; S ; L |- e1 & e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : int :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : int :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_bitwise_and
pm ; pc ; G ; S ; L |- e1 & e2 : int :> join pc join p' p'' { no_pred } -| G'' ; L''

pm ; pc ; G ; S ; L |- e1 : bool :> p' { P1 } -| G' ; L'  
pm ; pc ; G' ; S ; L' |- e2 : bool :> p'' { P2 } -| G'' ; L''
-------------------------------  :: op_or
pm ; pc ; G ; S ; L |- e1 | e2 : bool :> join pc join p' p'' { no_pred } -| G'' ; L''

% New ref creation with region types
% ref creates a reference with pc poison status and allocates fresh location l
% The region type ref T @ l precisely tracks which location is allocated
% Predicate P is preserved in the memory location
pm ; pc ; G ; S ; L |- e : T :> p { P } -| G' ; L'
  fresh l
----------------------- :: ref
pm ; pc ; G ; S ; L |- ref e : ref T @ l :> pc { no_pred } -| G'[l |-> T :> join pc p { P }] ; L'

% Assignment through reference with region types The result of the whole
% assignment (unit) is poisoned if the reference is poisoned. The stored value
% is poisoned if the assignment is poisoned, or reference is poisoned, or the
% value is poisoned. Predicate from e2 is preserved in the memory location
pm ; pc ; G ; S ; L |- e1 : ref T @ l :> p' { P' } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : T :> p'' { P'' } -| G'' ; L''
----------------------- :: assign
pm ; pc ; G ; S ; L |- e1 := e2 : unit :> join pc p' { no_pred } -| G''[l |-> T :> join pc join p' p'' { P'' }] ; L''

% Dereference - with poisoned reference always strips predicate and returns
% poisoned result.
pm ; pc ; G ; S ; L |- e : ref T @ l :> poisoned { P } -| G' ; L'
  G'(l) = T :> p { P' }
----------------------- :: deref_poisoned
pm ; pc ; G ; S ; L |- !e : T :> poisoned { no_pred } -| G' ; L'

% Dereference - no predicate case.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G' ; L'
  G'(l) = T :> p { no_pred }
----------------------- :: deref_no_pred
pm ; pc ; G ; S ; L |- !e : T :> join pc p { no_pred } -| G' ; L'

% Dereference - with guarded predicate that evaluates to true, triggering de-poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G' ; L'
  G'(l) = T :> p { guard k pred_closure pcl }
  L'(k) = true
----------------------- :: deref_guard_true
pm ; pc ; G ; S ; L |- !e : T :> pc { no_pred } -| G' ; L'

% Dereference - with guarded predicate that evaluates to false, triggering poisoning.
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G' ; L'
  G'(l) = T :> p { guard k pred_closure pcl }
  L'(k) = false
----------------------- :: deref_guard_false
pm ; pc ; G ; S ; L |- !e : T :> poisoned { no_pred } -| G' ; L'

% Dereference - with guarded predicate but tag not in L
pm ; pc ; G ; S ; L |- e : ref T @ l :> clean { P } -| G' ; L'
  G'(l) = T :> p { guard k pred_closure pcl }
----------------------- :: deref_guard_unknown
pm ; pc ; G ; S ; L |- !e : T :> join pc p { guard k pred_closure pcl } -| G' ; L'

-------------------------------  :: unit
pm ; pc ; G ; S ; L |- unit : unit :> clean { no_pred } -| G ; L

% Sequence: e1's poison is included because e2 only executes if e1 completes
% successfully. This captures the control dependency between e1 and e2. The
% first expression can have any type T1, but its value is discarded. The result
% type is the type of the second expression T2. This is  a conservative
% approach. Alternatively, we could ignore e1's poison in result, as the e1's
% value is propagated to e2.
pm ; pc ; G ; S ; L |- e1 : T1 :> p' { P' } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : T2 :> p'' { P'' } -| G'' ; L''
-------------------------------  :: seq
pm ; pc ; G ; S ; L |- e1 ; e2  : T2 :> join p' p'' { P'' } -| G'' ; L''

% Function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
----------------------------------------------------------------------  :: fn_abs
pm ; pc ; G ; S ; L |- fn x : ST1 => e : ST2 : ST1 -> ST2 # pc typing_closure ( x , e , S ) :> pc { no_pred } -| G ; L

% Pure function abstraction typing with explicit return type annotation.
% The user provides both parameter type ST1 and return type ST2.
% We simply record the body and return type without typechecking the body.
% Body typechecking is deferred until application time.
----------------------------------------------------------------------  :: pfn_abs
pm ; pc ; G ; S ; L |- pfn x : ST1 => pe : ST2 : ST1 -> ST2 # pc typing_pclosure ( x , pe , S ) :> pc { no_pred } -| G ; L

% Function application typing - now uses captured body and context for precise typing
% When applying a function, we extract the typing_closure containing the parameter name (x),
% function body (e), and captured variable context (S'). We then type-check the body in
% the captured context S' extended with the actual argument's type (including predicates)
% and using the current logical environment L. This enables predicate-based de-poisoning.
% Please note that impure function application is disallowed in pure context.
impure ; pc ; G ; S ; L |- e1 : ST1 -> ST2 # p typing_closure ( x , e , S' ) :> p1 { P1 } -| G' ; L'
impure ; pc ; G' ; S ; L' |- e2 : T1 :> p2 { P2 } -| G'' ; L''
ST1 <: T1
impure ; join p join p1 pc ; G'' ; S'[x |-> T1 :> join pc p2 { P2 }] ; L'' |- e : T2 :> p3 { P3 } -| G''' ; L'''
ST2 <: T2
----------------------------------------------------------------------  :: app_fn
impure ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc p3 { P3 } -| G''' ; L'''

% Pure function application typing - uses captured pure body and context
% Please note that pure function application is allowed in either impure or pure context, but
% the body is always typed in pure context (to prevent use of impure forms)
pm ; pc ; G ; S ; L |- e1 : ST1 -> ST2 # p typing_pclosure ( x , pe , S' ) :> p1 { P1 } -| G' ; L'
pm ; pc ; G' ; S ; L' |- e2 : T1 :> p2 { P2 } -| G'' ; L''
ST1 <: T1
pure ; join p join p1 pc ; G'' ; S'[x |-> T1 :> join pc p2 { P2 }] ; L'' |- pe : T2 :> p3 { P3 } -| G''' ; L''
ST2 <: T2
----------------------------------------------------------------------  :: app_pfn
pm ; pc ; G ; S ; L |- e1 e2 : T2 :> join pc p3 { P3 } -| G''' ; L'''

% Typing for rand - takes integer argument, returns random integer
pm ; pc ; G ; S ; L |- e : int :> p { P } -| G' ; L'
----------------------------------------------------------------------  :: rand_typing
pm ; pc ; G ; S ; L |- rand e : int :> join pc p { no_pred } -| G' ; L'

% Typing for frand - takes integer argument n, returns faulty random integer with predicate
% the argument is a pure expression, so typechking it does not affect the typing environment
pm ; pc ; G ; S ; L |- pe : int :> p { P } -| G ; L
fresh k
fresh x S
pcl = range x pe S
----------------------------------------------------------------------  :: frand_typing
pm ; pc ; G ; S ; L |- frand pe : int :> poisoned { guard k pred_closure pcl } -| G ; L

% Typing for printInt - takes integer argument, returns unit 
pm ; pc ; G ; S ; L |- e : int :> p { P } -| G' ; L'
----------------------------------------------------------------------  :: printInt_typing
pm ; pc ; G ; S ; L |- printInt e : unit :> join pc p { no_pred } -| G' ; L'

% Typing for printString - takes string argument, returns unit 
pm ; pc ; G ; S ; L |- e : string :> p { P } -| G' ; L'
----------------------------------------------------------------------  :: printString_typing
pm ; pc ; G ; S ; L |- printString e : unit :> join pc p { no_pred } -| G' ; L'

% Typing for not_expr - takes boolean argument, returns boolean 
pm ; pc ; G ; S ; L |- e : bool :> p { P } -| G' ; L'
----------------------------------------------------------------------  :: not_expr_typing
pm ; pc ; G ; S ; L |- not_expr e : bool :> join pc p { no_pred } -| G' ; L'

% Typing for Let Bindings

%
% A critical consideration is whether the context poison should be combined with
% the variable poison in the result. The current approach integrates the context
% poison with the variable poison. Consider the following illustrative example:
%
% if poisoned_sensor > 0 then      // pc = poisoned
%    let y = 42 in 17       // e2 doesn't use y
% else
%    0
% In this scenario, the let binding is deemed poisoned because the context
% poison is indeed poisoned.
%
% Predicates are propagated from e1 to x, and the result gets predicate from e2
pm ; pc ; G ; S ; L |- e1 : T :> p1 { P1 } -| G' ; L'
pm ; pc ; G' ; S[x |-> T :> p1  { P1 }] ; L' |- e2 : T2 :> p2 { P2 } -| G'' ; L''
----------------------------------------------------------------------  :: let
pm ; pc ; G ; S ; L |- let x = e1 in e2 : T2 :> join pc p2 { P2 } -| G'' ; L''



% Conditional typing rules
%
% The conditional typing rules handle two cases:
% 1. When match_guard(e1, G, S) = k for some k (predicate case)
% 2. When no matching predicate is found (standard case)
%
% In the predicate case, we can update L with the guard's value in each branch.
% In the standard case, we simply propagate poison through both branches.
%
% Note: The JoinG operation combines memory typing environments from both branches.
% For example:
%
% if condition then 
%     let r1 = ref 42 in ...     // Creates l1, G'' = G'[l1 ↦ int]
% else 
%     let r2 = ref 7 in ...      // Creates l2, G''' = G'[l2 ↦ int]
%
% Result: JoinG G'' G''' = G'[l1 ↦ int, l2 ↦ int]
% Freshness side conditions (fresh l) allow the branch witnesses l1 and l2 to be chosen
% distinct (alpha-renamed if necessary), so the union is well-defined and conflict-free.

% Predicate-based conditional typing rule (when matching predicate found)
% 
% Note on L' propagation: We return L' (the environment after evaluating e1) rather than
% attempting to join L'' and L'''. This is conservative but sound, as L'' contains k ↦ true
% while L''' contains k ↦ false, making them contradictory. After the conditional completes,
% we don't know which branch was taken, so we revert k to unknown status.
%
% Alternative design: Implement a proper join operation for logical environments where:
% - Guards with same value in both branches are preserved
% - Guards with contradictory values are removed (become unknown)
% - Guards only present in one branch are removed
% This would be more precise but adds complexity. The current approach is simpler while
% still enabling predicate-based de-poisoning within each branch.
pm ; pc ; G ; S ; L |- e1 : bool :> p' { P' } -| G' ; L'
  match_guard e1 G S = k
pm ; pc ; G' ; S ; L'[k |-> true] |- e2 : T :> p'' { P'' } -| G'' ; L''
pm ; pc ; G' ; S ; L'[k |-> false] |- e3 : T :> p''' { P''' } -| G''' ; L'''
----------------------------------  :: if_depoison
pm ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p'' p''' { no_pred } -| JoinG G'' G''' ; L'

% Standard conditional typing rule (when no matching predicate found)
% (used as a fallback when match_guard fails)
pm ; pc ; G ; S ; L |- e1 : bool :> p' { P' } -| G' ; L'
pm ; join pc p' ; G' ; S ; L' |- e2 : T :> p'' { P'' } -| G'' ; L''
pm ; join pc p' ; G' ; S ; L' |- e3 : T :> p''' { P''' } -| G''' ; L'''
----------------------------------  :: if_std
pm ; pc ; G ; S ; L |- if e1 then e2 else e3 : T :> join pc join p' join p'' p''' { no_pred } -| JoinG G'' G''' ; L'


%  Flow‑sensitive WHILE à la Hunt & Sands 2006 https://doi.org/10.1145/1111037.1111045

% Predicate-based while typing rule (when matching predicate found)
pm; indexedp p i ; IndexedG G i ; S ; L |- e1 : bool :> indexedp p' i { P' }  -| IndexedG G' i ; L
match_guard e1 G S = k
pm; join indexedp p i indexedp p' i ; IndexedG G' i ; S ; L[k |-> true] |- e2 : unit :> indexedp p'' i { P'' }  -| IndexedG G'' i ; L
indexedp p 0 = pc AND indexedp p i+1 = join indexedp p i indexedp p'' i
IndexedG G 0 = G AND IndexedG G i+1 = JoinG IndexedG G i IndexedG G'' i
%  "where n is the smallest natural number satisfying the two equalities above."
indexedp p n+1 = indexedp p n 
IndexedG G n+1 = IndexedG G n
---------------------------------------------------------------------------  :: while_depoison
pm ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexedp p n { no_pred }  -| IndexedG G n ; L[k |-> false]

% Standard while typing rule (when no matching predicate found) (used as a
% fallback when match_guard fails) 
%
% NOTE: We now return the original L unchanged since no guard was matched
pm ; indexedp p i ; IndexedG G i ; S ; L |- e1 : bool :> indexedp p' i { P' }  -| IndexedG G' i ; L
pm ; join indexedp p i indexedp p' i ; IndexedG G' i ; S ; L |- e2 : unit :> indexedp p'' i { P'' }  -| IndexedG G'' i ; L
indexedp p 0 = pc AND indexedp p i+1 = join indexedp p i indexedp p'' i
IndexedG G 0 = G AND IndexedG G i+1 = JoinG IndexedG G i IndexedG G'' i
%  "where n is the smallest natural number satisfying the two equalities above."
indexedp p n+1 = indexedp p n 
IndexedG G n+1 = IndexedG G n
---------------------------------------------------------------------------  :: while_std
pm ; pc ; G ; S ; L |- while e1 do e2  : unit :> indexedp p n { no_pred }  -| IndexedG G n ; L


