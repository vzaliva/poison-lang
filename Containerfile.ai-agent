# Containerfile.ai-agent
# Isolated AI coding agent environment (Claude Code, Codex, etc.) with Lean toolchain
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Base dependencies + Node.js + Python for AI agents
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates \
    build-essential clang lld cmake pkg-config \
    libgmp-dev libuv1-dev \
    xz-utils util-linux \
    python3 python3-pip \
    # Common CLI tools for AI agents
    ripgrep \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (gh)
RUN snap install gh

# Install Node.js (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install AI coding assistants globally
# Claude Code
RUN npm install -g @anthropic-ai/claude-code

# OpenAI CLI (includes codex access)
RUN pip3 install --break-system-packages openai

# Install uv (provides uvx for running Python tools)
RUN snap install astral-uv

# Note: lean-lsp-mcp MCP tool (used by both Claude and Codex) will be
# downloaded on first use via uvx. It will be cached in the ai_agent_config volume.

# --- Seed Elan toolchain into a read-only location in the image ---
ARG ELAN_TOOLCHAIN=leanprover/lean4:v4.23.0-rc2
ENV ELAN_SEED=/opt/elan-seed
RUN mkdir -p "${ELAN_SEED}" && \
    curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      | ELAN_HOME="${ELAN_SEED}" sh -s -- -y --default-toolchain "${ELAN_TOOLCHAIN}" --no-modify-path

# Non-root runtime user; make traversable to mapped UIDs
RUN useradd -m -d /home/user -s /bin/bash user || true
RUN chmod 755 /home/user
ENV HOME=/home/user
WORKDIR /work

# --- ENTRYPOINT: add host UID/GID to passwd, drop privs, exec ---
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
': "${HOST_UID:=1000}"' \
': "${HOST_GID:=1000}"' \
': "${HOST_USER:=user}"' \
': "${HOST_GROUP:=user}"' \
': "${ELAN_HOME:=/home/user/.elan}"' \
': "${XDG_CACHE_HOME:=/home/user/.cache}"' \
'' \
'# Ensure mapped identity exists (avoids $HOME warning).' \
'if ! getent group "${HOST_GID}" >/dev/null 2>&1; then echo "${HOST_GROUP}:x:${HOST_GID}:" >> /etc/group; fi' \
'if ! getent passwd "${HOST_UID}" >/dev/null 2>&1; then echo "${HOST_USER}:x:${HOST_UID}:${HOST_GID}:User:/home/user:/bin/bash" >> /etc/passwd; fi' \
'' \
'# First-run seed: if volume ELAN_HOME is empty/missing elan, copy from image seed (fast, no network).' \
'if [ ! -x "${ELAN_HOME}/bin/elan" ]; then' \
'  echo "[entrypoint] Seeding ${ELAN_HOME} from ${ELAN_SEED} …"' \
'  mkdir -p "${ELAN_HOME}"' \
'  cp -a "${ELAN_SEED}/." "${ELAN_HOME}/"' \
'  chown -R "${HOST_UID}:${HOST_GID}" "${ELAN_HOME}"' \
'fi' \
'' \
'# Prefer volume-managed elan in PATH so updates persist there.' \
'export PATH="${ELAN_HOME}/bin:${PATH}"' \
'' \
'# Drop to mapped user and exec.' \
'exec setpriv --reuid="${HOST_UID}" --regid="${HOST_GID}" --clear-groups -- "$@"' \
> /usr/local/bin/ai-agent-entrypoint.sh \
 && chmod +x /usr/local/bin/ai-agent-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/ai-agent-entrypoint.sh"]
CMD ["bash"]
