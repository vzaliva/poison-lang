# Containerfile.ai-agent
# Isolated AI coding agent environment (Claude Code, Codex, etc.) with Lean toolchain
#
# Stage 1: build gh-sub-issue extension (no GitHub auth required; gh extension install would require auth).
FROM ubuntu:24.04 AS gh-sub-issue-builder
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git golang-go \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/yahsan2/gh-sub-issue.git /tmp/gh-sub-issue \
    && cd /tmp/gh-sub-issue && go build -o gh-sub-issue .

# Stage 2: main image
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Base dependencies + Node.js + Python for AI agents
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates \
    openssh-client \
    build-essential clang lld cmake pkg-config \
    libgmp-dev libuv1-dev \
    xz-utils util-linux \
    unzip \
    m4 \
    openssl \
    python3 python3-pip \
    # Common CLI tools for AI agents
    ripgrep \
    jq \
    # LaTeX for PDF generation
    latexmk texlive-latex-extra texlive-fonts-recommended texlive-latex-recommended texlive-lang-english \
    && rm -rf /var/lib/apt/lists/*

# Install opam from the official binary installer (avoids outdated distro packages).
# See: https://opam.ocaml.org/doc/Install.html
RUN curl -fsSL https://opam.ocaml.org/install.sh -o /tmp/opam-install.sh \
    # The installer prompts once for an installation prefix; accept the default (/usr/local/bin).
    && printf '\n' | sh /tmp/opam-install.sh --no-backup --fresh \
    && rm -f /tmp/opam-install.sh

# Install Ott (requires OCaml + opam); install binary to /usr/local/bin.
# Mirror CI: `opam init -y --disable-sandboxing && opam install -y ott`.
ENV OPAMROOT=/opt/opam
RUN opam init -y --disable-sandboxing --no-setup \
    && opam install -y ott \
    && install -m 0755 "$(opam var bin)/ott" /usr/local/bin/ott


# Install GitHub CLI (gh)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Seed gh-sub-issue extension from builder; entrypoint copies to ~/.local/share/gh/extensions on first run so it persists with the home volume.
ENV GH_EXTENSIONS_SEED=/opt/gh-extensions-seed
RUN mkdir -p "${GH_EXTENSIONS_SEED}/.local/share/gh/extensions/gh-sub-issue"
COPY --from=gh-sub-issue-builder /tmp/gh-sub-issue/gh-sub-issue "${GH_EXTENSIONS_SEED}/.local/share/gh/extensions/gh-sub-issue/gh-sub-issue"
RUN chmod 0755 "${GH_EXTENSIONS_SEED}/.local/share/gh/extensions/gh-sub-issue/gh-sub-issue"

# Install Node.js (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install AI coding assistants globally
# Claude Code (native installer)
#
# Install into a read-only seed location and expose `claude` on PATH.
# Disable auto-updater in-container: updates should happen by rebuilding the image.
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_SEED=/opt/claude-seed
RUN mkdir -p "${CLAUDE_SEED}" \
    && HOME="${CLAUDE_SEED}" bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' \
    && install -m 0755 "${CLAUDE_SEED}/.local/bin/claude" /usr/local/bin/claude

# Ensure global npm installs land in /usr/local (not /usr).
# This avoids accidentally picking up an older distro-provided /usr/bin/tree-sitter.
ENV NPM_CONFIG_PREFIX=/usr/local

# Tree-sitter CLI (pin version; Parser.lean relies on flags like --config-path and -x)
RUN npm i -g tree-sitter-cli@0.25.10

# OpenAI Codex CLI. To force reinstall from npm when the package is updated, pass a new
# value to bust the cache, e.g.: --build-arg CODEX_UPDATE=2 or CODEX_UPDATE=$(date +%s)
ARG CODEX_UPDATE=1
RUN npm i -g @openai/codex

# Install uv (provides uvx for running Python tools)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && install -m 0755 /root/.local/bin/uv /usr/local/bin/uv \
    && install -m 0755 /root/.local/bin/uvx /usr/local/bin/uvx \
    && rm -rf /root/.local/bin

# Note: lean-lsp-mcp MCP tool (used by both Claude and Codex) will be
# downloaded on first use via uvx. It will be cached in the ai_agent_config volume.

# --- Seed Elan into a read-only location in the image ---
# Do not hardcode a Lean toolchain here; projects specify it via /work/lean-toolchain.
ARG ELAN_TOOLCHAIN=none
ENV ELAN_SEED=/opt/elan-seed
RUN mkdir -p "${ELAN_SEED}" && \
    curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      | ELAN_HOME="${ELAN_SEED}" sh -s -- -y --default-toolchain "${ELAN_TOOLCHAIN}" --no-modify-path

# Non-root runtime user; make usable under rootless UID mappings
RUN useradd -m -d /home/user -s /bin/bash user || true
# Rootless Podman commonly maps the host UID to container uid 0, or runs as a
# non-1000 UID under keep-id. Make HOME writable in either case.
RUN mkdir -p /home/user/.cache /home/user/.config \
    # Important: Podman may create mount parent directories as root:root when mounting
    # subdirectories (e.g. /home/user/.cache/lake). If /home/user/.cache does not already
    # exist in the image, it can end up root-owned and non-writable under --userns=keep-id,
    # breaking tools (e.g. tree-sitter) that need ~/.cache write access.
    && chmod 1777 /home/user /home/user/.cache /home/user/.config
ENV HOME=/home/user
# Some tools (Claude Code native installer, uv installer) expect ~/.local/bin on PATH.
ENV PATH=/home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /work

# --- ENTRYPOINT: add host UID/GID to passwd, drop privs, exec ---
# Bump CONFIG_SEED to force this layer to re-run (e.g. after editing seeded config.toml).
ARG CONFIG_SEED=1
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'# Preserve TZ from Podman -e so exec'\''d process sees host timezone.' \
'SAVED_TZ="${TZ:-}"' \
': "${HOST_UID:=1000}"' \
': "${HOST_GID:=1000}"' \
': "${HOST_USER:=user}"' \
': "${HOST_GROUP:=user}"' \
': "${ELAN_HOME:=/home/user/.elan}"' \
': "${XDG_CACHE_HOME:=/home/user/.cache}"' \
'# Container-local Codex state (config/auth/history). Overridable by wrapper.' \
': "${CODEX_HOME:=/home/user/.config/poison-codex}"' \
'# Container-local Claude Code state (config/auth). Overridable by wrapper.' \
': "${CLAUDE_CONFIG_DIR:=/home/user/.config/poison-claude}"' \
'' \
'# Ensure mapped identity exists (avoids $HOME warning).' \
'if [ "$(id -u)" -eq 0 ]; then' \
'  if ! getent group "${HOST_GID}" >/dev/null 2>&1; then echo "${HOST_GROUP}:x:${HOST_GID}:" >> /etc/group; fi' \
'  if ! getent passwd "${HOST_UID}" >/dev/null 2>&1; then echo "${HOST_USER}:x:${HOST_UID}:${HOST_GID}:User:/home/user:/bin/bash" >> /etc/passwd; fi' \
'fi' \
'' \
'# Ensure home/config/cache dirs are writable by mapped UID/GID.' \
'for d in "/home/user" "${XDG_CACHE_HOME}" "/home/user/.config"; do' \
'  mkdir -p "${d}"' \
 '  if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${d}" 2>/dev/null || true; fi' \
'done' \
'' \
'# Tree-sitter CLI uses ~/.config/tree-sitter/config.json to locate grammar repos.' \
'# Seed a minimal config pointing at the project parser directory (first run only).' \
'mkdir -p "${HOME}/.config/tree-sitter"' \
'if [ "$(id -u)" -eq 0 ]; then chown -R "${HOST_UID}:${HOST_GID}" "${HOME}/.config/tree-sitter" 2>/dev/null || true; fi' \
'if [ ! -f "${HOME}/.config/tree-sitter/config.json" ]; then' \
'  cat > "${HOME}/.config/tree-sitter/config.json" <<'\''EOF'\''' \
'{' \
'  "parser-directories": ["/work/parser"]' \
'}' \
'EOF' \
'  if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${HOME}/.config/tree-sitter/config.json" 2>/dev/null || true; fi' \
'fi' \
'' \
'# Ensure ~/.local/bin exists and is on PATH (some CLIs expect it).' \
'mkdir -p "/home/user/.local/bin"' \
'if [ "$(id -u)" -eq 0 ]; then chown -R "${HOST_UID}:${HOST_GID}" "/home/user/.local" 2>/dev/null || true; fi' \
'export PATH="/home/user/.local/bin:${PATH}"' \
'' \
'# First-run seed: gh extensions live under ~/.local/share/gh/extensions; copy from image seed so they persist with the home volume.' \
'GH_EXT_DIR="${XDG_DATA_HOME:-/home/user/.local/share}/gh/extensions"' \
'mkdir -p "${GH_EXT_DIR}"' \
'if [ "$(id -u)" -eq 0 ]; then chown -R "${HOST_UID}:${HOST_GID}" "${GH_EXT_DIR}" 2>/dev/null || true; fi' \
'if [ -w "${GH_EXT_DIR}" ] && [ ! -d "${GH_EXT_DIR}/gh-sub-issue" ]; then' \
'  if [ -d "${GH_EXTENSIONS_SEED:-/opt/gh-extensions-seed}/.local/share/gh/extensions" ]; then' \
'    cp -a "${GH_EXTENSIONS_SEED}/.local/share/gh/extensions/." "${GH_EXT_DIR}/"' \
'    if [ "$(id -u)" -eq 0 ]; then chown -R "${HOST_UID}:${HOST_GID}" "${GH_EXT_DIR}"; fi' \
'  fi' \
'fi' \
'' \
'# Claude Code (native installer) expects a shim at ~/.local/bin/claude.' \
'# We install the binary in /usr/local/bin/claude and keep a symlink for compatibility.' \
'if [ ! -e "/home/user/.local/bin/claude" ] && [ -x "/usr/local/bin/claude" ]; then' \
'  ln -sf "/usr/local/bin/claude" "/home/user/.local/bin/claude" 2>/dev/null || true' \
'fi' \
'' \
'# Persist SSH known_hosts (agent keys stay on host; we only keep host fingerprints).' \
'mkdir -p "${HOME}/.ssh"' \
'chmod 700 "${HOME}/.ssh" 2>/dev/null || true' \
'touch "${HOME}/.ssh/known_hosts" 2>/dev/null || true' \
'chmod 600 "${HOME}/.ssh/known_hosts" 2>/dev/null || true' \
'if ! grep -q "^github\\.com[ ,]" "${HOME}/.ssh/known_hosts" 2>/dev/null; then' \
'  ssh-keyscan -H github.com 2>/dev/null >> "${HOME}/.ssh/known_hosts" || true' \
'fi' \
'' \
'# OpenSSH picks UserKnownHostsFile based on the passwd home directory for the current uid,' \
'# not the HOME environment variable. Under rootless keep-id, the uid may map to a user whose' \
'# home is /home/ubuntu (or similar). Ensure that home dir uses the persisted /home/user/.ssh.' \
'USER_HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)"' \
'if [ -n "${USER_HOME}" ] && [ "${USER_HOME}" != "${HOME}" ]; then' \
'  mkdir -p "${USER_HOME}" 2>/dev/null || true' \
'  if [ ! -e "${USER_HOME}/.ssh" ]; then' \
'    ln -s "${HOME}/.ssh" "${USER_HOME}/.ssh" 2>/dev/null || true' \
'  fi' \
'fi' \
'' \
'# Ensure Claude Code config dir exists (for persistent auth).' \
'mkdir -p "${CLAUDE_CONFIG_DIR}"' \
'if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${CLAUDE_CONFIG_DIR}" 2>/dev/null || true; fi' \
'' \
'# Seed a minimal Claude MCP config (first run only) to enable lean-lsp via uvx.' \
'if [ ! -f "${CLAUDE_CONFIG_DIR}/mcp.json" ]; then' \
'  cat > "${CLAUDE_CONFIG_DIR}/mcp.json" <<'\''EOF'\''' \
'{' \
'  "mcpServers": {' \
'    "lean-lsp": {' \
'      "type": "stdio",' \
'      "command": "uvx",' \
'      "args": ["lean-lsp-mcp"],' \
'      "env": {' \
'        "LEAN_PROJECT_PATH": "/work",' \
'        "LEAN_LOG_LEVEL": "NONE"' \
'      }' \
'    }' \
'  }' \
'}' \
'EOF' \
'  if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${CLAUDE_CONFIG_DIR}/mcp.json" 2>/dev/null || true; fi' \
'fi' \
'' \
'# Seed a minimal Codex config in CODEX_HOME (first run only).' \
'mkdir -p "${CODEX_HOME}"' \
'if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${CODEX_HOME}" 2>/dev/null || true; fi' \
'if [ ! -f "${CODEX_HOME}/config.toml" ]; then' \
'  cat > "${CODEX_HOME}/config.toml" <<'\''EOF'\''' \
'model = "gpt-5.2"' \
'model_reasoning_effort = "xhigh"' \
'sandbox_mode = "workspace-write"' \
'approval_policy = "on-request"' \
'' \
'[projects."/work"]' \
'trust_level = "trusted"' \
'' \
'[mcp_servers.lean-lsp]' \
'command = "uvx"' \
'args = ["lean-lsp-mcp"]' \
'' \
'[mcp_servers.lean-lsp.env]' \
'LEAN_PROJECT_PATH = "/work"' \
'LEAN_LOG_LEVEL = "NONE"' \
'' \
'web_search = "live"' \
'EOF' \
'  if [ "$(id -u)" -eq 0 ]; then chown "${HOST_UID}:${HOST_GID}" "${CODEX_HOME}/config.toml" 2>/dev/null || true; fi' \
'fi' \
'' \
'# First-run seed: if volume ELAN_HOME is empty/missing elan, copy from image seed (fast, no network).' \
'if [ ! -x "${ELAN_HOME}/bin/elan" ]; then' \
'  if [ -w "${ELAN_HOME}" ]; then' \
'    echo "[entrypoint] Seeding ${ELAN_HOME} from ${ELAN_SEED} …"' \
'    mkdir -p "${ELAN_HOME}"' \
'    cp -a "${ELAN_SEED}/." "${ELAN_HOME}/"' \
'    if [ "$(id -u)" -eq 0 ]; then chown -R "${HOST_UID}:${HOST_GID}" "${ELAN_HOME}"; fi' \
'  else' \
'    # e.g. ELAN_HOME bind-mounted read-only from host; fall back to using the seed elan binary.' \
'    export PATH="${ELAN_SEED}/bin:${PATH}"' \
'  fi' \
'fi' \
'' \
'# Prefer volume-managed elan in PATH so updates persist there.' \
'export PATH="${ELAN_HOME}/bin:${PATH}"' \
'' \
'# Ensure the project-specified toolchain exists in ELAN_HOME (if writable). This avoids' \
'# surprising downloads when the toolchain is already available via a host mount or volume.' \
'if [ -f "/work/lean-toolchain" ] && [ -w "${ELAN_HOME}" ]; then' \
'  TOOLCHAIN="$(tr -d '\''\r\n'\'' < /work/lean-toolchain)"' \
'  if [ -n "${TOOLCHAIN}" ]; then' \
'    "${ELAN_HOME}/bin/elan" toolchain install "${TOOLCHAIN}" >/dev/null 2>&1 || true' \
'  fi' \
'fi' \
'' \
'# If we are already running unprivileged, we cannot (and do not need to) drop privileges.' \
'if [ "$(id -u)" -ne 0 ]; then' \
'  [ -n "${SAVED_TZ:-}" ] && export TZ="${SAVED_TZ}"' \
'  exec "$@"' \
'fi' \
'' \
'# Rootless Podman commonly maps host UID to container uid 0. In that case, dropping to' \
'# HOST_UID (e.g. 1000) can make /work bind mounts unreadable. Detect this mapping and' \
'# keep running as uid 0 when it maps directly to HOST_UID.' \
'if [ "$(id -u)" -eq 0 ] && awk '\''NR==1{print $1, $2, $3; exit}'\'' /proc/self/uid_map | grep -qx "0 ${HOST_UID} 1"; then' \
'  [ -n "${SAVED_TZ:-}" ] && export TZ="${SAVED_TZ}"' \
'  exec "$@"' \
'fi' \
'' \
'# Otherwise, drop to mapped user and exec. Avoid --clear-groups because setgroups is commonly' \
'# denied in rootless user namespaces (which would break startup even when uid/gid changes are OK).' \
'[ -n "${SAVED_TZ:-}" ] && export TZ="${SAVED_TZ}"' \
'exec setpriv --reuid="${HOST_UID}" --regid="${HOST_GID}" --keep-groups -- "$@"' \
> /usr/local/bin/ai-agent-entrypoint.sh \
 && chmod +x /usr/local/bin/ai-agent-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/ai-agent-entrypoint.sh"]
CMD ["bash"]
